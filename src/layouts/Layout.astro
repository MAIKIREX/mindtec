---
import '../styles/style.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  headerLightBg?: boolean;
  ogImage?: string;
  ogType?: string;
  canonicalUrl?: string;
  showIntroLoader?: boolean;
}

const {
  title = "Mindtec Bolivia - Investigación de Mercados y Neuromarketing B2B",
  description = "Firma boliviana que integra neurociencia, inteligencia artificial y consultoría de mercados para decisiones críticas de alta dirección.",
  keywords,
  headerLightBg = false,
  ogImage,
  ogType = 'website',
  canonicalUrl,
  showIntroLoader = false,
} = Astro.props;

// Determine active state for navigation links
const pathname = new URL(Astro.request.url).pathname;
const isWitmind = pathname.includes('witmind-consulting');

// Canonical URL: resuelve a URL absoluta para evitar canonicals relativas y locales
const canonical = canonicalUrl
  ? new URL(canonicalUrl, Astro.site).toString()
  : new URL(pathname, Astro.site).toString();

// OG Image: usa la prop si existe, sino el logo por defecto
const ogImageUrl = ogImage
  ? new URL(ogImage, Astro.site).toString()
  : new URL('/logo-mindtec.webp', Astro.site).toString();

const isCurrent = (path: string) => {
  const normPath = path.replace(/^\/|\/$/g, '');
  const normCurrent = pathname.replace(/^\/|\/$/g, '');
  if (normPath === '' && normCurrent === '') return true;
  if (normPath !== '' && normCurrent.startsWith(normPath)) return true;
  return false;
};
