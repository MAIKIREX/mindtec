---
import Layout from './Layout.astro';

interface Props {
  title: string;
  date: string;
  category: string;
  img?: string;
  suggestions: any[];
}

const { title, date, category, img, suggestions } = Astro.props;
---

<Layout
  title={`${title} | Blog Mindtec`}
  description={`Artículo: ${title}. Insights y tendencias de investigación de mercados en Bolivia.`}
  keywords={`${category}, blog mindtec, investigacion de mercados Bolivia`}
  headerLightBg={true}
>
    <main class="elementor-content">
        <!-- Article Header Hero -->
        <section class="hero-section elementor-section" style="padding: 160px 0 80px; min-height: auto; background: var(--color-secondary);">
            <!-- Floating shapes -->
            <div class="hero-shapes" aria-hidden="true">
                <div class="hero-shape" style="width: 300px; height: 300px; top: -50px; right: 10%; background: radial-gradient(circle, rgba(242,101,34,0.12), transparent 70%);"></div>
                <div class="hero-shape" style="width: 150px; height: 150px; bottom: 5%; left: 5%; border: 1.5px solid rgba(255,255,255,0.05); border-radius: 50%;"></div>
            </div>
            <div class="container" style="position: relative; z-index: 3; text-align: center; max-width: 960px;">
                <span class="article-tag" style="background: rgba(242, 101, 34, 0.15); color: var(--color-primary); border: 1px solid rgba(242, 101, 34, 0.25); display: inline-flex; margin-bottom: 1.5rem; text-transform: uppercase;">{category}</span>
                <h1 style="color: var(--color-white); font-size: clamp(2rem, 4.5vw, 3.2rem); margin-bottom: 2rem; line-height: 1.2; font-weight: 900; font-family: var(--font-display);">{title}</h1>
                <div style="display: flex; justify-content: center; align-items: center; gap: 1.5rem; color: rgba(255,255,255,0.65); font-size: 0.9rem; font-weight: 600; font-family: var(--font-display); text-transform: uppercase; letter-spacing: 0.5px;">
                    <span style="display: inline-flex; align-items: center; gap: 6px;">
                        <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24" style="opacity: 0.8;"><path d="M9 11H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2zm2-7h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V9h14v11z"/></svg>
                        {date}
                    </span>
                    <span style="display: inline-flex; align-items: center; gap: 6px;">
                        <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24" style="opacity: 0.8;"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"/></svg>
                        Wilmar Velasquez
                    </span>
                </div>
            </div>
        </section>

        <!-- Article Content Body Section -->
        <section class="elementor-section" style="padding: 5rem 0 8rem; background: #ffffff;">
            <div class="container" style="max-width: 1200px;">
                <div class="article-layout-grid">
                    
                    <!-- Left Column: Main Content -->
                    <div class="article-main-column">
                        <!-- Back Button -->
                        <div style="margin-bottom: 2.5rem;">
                            <a href="/blog" style="color: var(--color-primary); font-family: var(--font-display); font-weight: 700; font-size: 0.95rem; text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem; transition: color var(--transition-fast);">
                                <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
                                Volver a Insights
                            </a>
                        </div>

                        <!-- Featured Image -->
                        {img && (
                            <div style="border-radius: var(--radius-lg); overflow: hidden; margin-bottom: 3.5rem; box-shadow: var(--shadow-lg); border: 1px solid rgba(0,0,0,0.05); position: relative; padding-top: 56.25%;">
                                <img src={img} alt={title} style="position: absolute; top:0; left:0; width: 100%; height: 100%; object-fit: cover;" />
                            </div>
                        )}

                        <!-- Body Rich Text -->
                        <div class="article-rich-text">
                            <slot />
                        </div>
                    </div>
                    
                    <!-- Right Column: Sidebar -->
                    <aside class="article-sidebar">
                        <!-- Suggested articles box -->
                        <div class="sidebar-box">
                            <h3 class="sidebar-title">Artículos Sugeridos</h3>
                            <div class="sidebar-suggestions">
                                {suggestions.map(sug => (
                                    <a href={`/blog/${sug.slug}`} class="suggested-card">
                                        {sug.data.img && (
                                            <div class="suggested-img-wrapper">
                                                <img src={sug.data.img} alt={sug.data.title} class="suggested-img" loading="lazy" />
                                            </div>
                                        )}
                                        <div class="suggested-info">
                                            <span class="suggested-tag">{sug.data.category}</span>
                                            <h4 class="suggested-title">{sug.data.title}</h4>
                                            <span class="suggested-date">{sug.data.date}</span>
                                        </div>
                                    </a>
                                ))}
                            </div>
                        </div>
                        
                        <!-- CTA box -->
                        <div class="sidebar-box sidebar-cta" style="margin-top: 2rem;">
                            <h4>¿Necesita Consultoría de Mercado?</h4>
                            <p>En Mindtec combinamos neurociencia, IA y metodologías ágiles para guiar las decisiones críticas de su corporación.</p>
                            <a href="/contacto" class="btn btn-primary" style="font-size: 0.85rem; padding: 12px 24px; width: 100%; text-shadow: none;">Agendar Consultoría</a>
                        </div>
                    </aside>
                    
                </div>

                <!-- Footer back button -->
                <div style="margin-top: 6rem; border-top: 1px solid rgba(11, 43, 64, 0.08); padding-top: 3.5rem; text-align: center; max-width: 800px;">
                    <p style="color: var(--color-text-muted); font-size: 1.05rem; margin-bottom: 1.75rem;">¿Desea profundizar en cómo aplicar estas metodologías en su corporación?</p>
                    <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
                        <a href="/contacto" class="btn btn-primary" style="width: auto; padding: 12px 28px;">Contactar Consultoría</a>
                        <a href="/blog" class="btn btn-navy-outline" style="width: auto; padding: 12px 28px; display: inline-flex; align-items: center; gap: 8px;">
                            <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
                            Todos los Artículos
                        </a>
                    </div>
                </div>

            </div>
        </section>
    </main>
</Layout>

<style is:global>
/* Two-column Blog Layout */
.article-layout-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 4rem;
    align-items: start;
    width: 100%;
}
.article-main-column {
    min-width: 0;
}
.article-sidebar {
    position: sticky;
    top: 110px;
}
.sidebar-box {
    background: var(--color-white);
    border: 1px solid rgba(11, 43, 64, 0.06);
    border-radius: var(--radius-md);
    padding: 2.25rem 1.75rem;
    box-shadow: var(--shadow-sm);
}
.sidebar-title {
    font-family: var(--font-display);
    color: var(--color-secondary);
    font-weight: 800;
    font-size: 1.25rem;
    margin-bottom: 1.5rem;
    border-bottom: 2px solid var(--color-primary-soft);
    padding-bottom: 0.75rem;
    letter-spacing: -0.01em;
}
.sidebar-suggestions {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}
.suggested-card {
    display: flex;
    gap: 1rem;
    text-decoration: none;
    transition: all var(--transition-fast);
    align-items: center;
}
.suggested-card:hover {
    transform: translateX(4px);
}
.suggested-img-wrapper {
    width: 80px;
    height: 60px;
    border-radius: var(--radius-xs);
    overflow: hidden;
    flex-shrink: 0;
    border: 1px solid rgba(0,0,0,0.05);
    background: var(--color-secondary-deep);
    position: relative;
}
.suggested-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}
.suggested-info {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
}
.suggested-tag {
    font-family: var(--font-display);
    font-size: 0.65rem;
    font-weight: 800;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 0.25rem;
}
.suggested-title {
    font-family: var(--font-body);
    color: var(--color-text-dark);
    font-size: 0.88rem;
    font-weight: 700;
    line-height: 1.35;
    margin-bottom: 0.25rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color var(--transition-fast);
}
.suggested-card:hover .suggested-title {
    color: var(--color-primary);
}
.suggested-date {
    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-weight: 500;
}

.sidebar-cta {
    background: var(--color-secondary);
    color: var(--color-white);
    border: none;
    box-shadow: var(--shadow-md);
    text-align: center;
}
.sidebar-cta h4 {
    color: var(--color-white);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.2rem;
    margin-bottom: 0.75rem;
}
.sidebar-cta p {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.88rem;
    line-height: 1.5;
    margin-bottom: 1.5rem;
}

/* Article Rich Text Styles */
.article-rich-text {
    color: var(--color-text-main);
    font-size: 1.1rem;
    line-height: 1.85;
    font-family: var(--font-body);
}
.article-rich-text p {
    margin-bottom: 1.75rem;
    color: var(--color-text-muted);
}
.article-rich-text h2, .article-rich-text h3, .article-rich-text h4 {
    color: var(--color-secondary);
    font-family: var(--font-display);
    font-weight: 800;
    margin-top: 3rem;
    margin-bottom: 1.25rem;
    line-height: 1.25;
    letter-spacing: -0.02em;
}
.article-rich-text h2 {
    font-size: clamp(1.6rem, 3vw, 2.1rem);
}
.article-rich-text h3 {
    font-size: clamp(1.3rem, 2.5vw, 1.6rem);
}
.article-rich-text ul, .article-rich-text ol {
    margin-bottom: 1.75rem;
    padding-left: 2rem;
}
.article-rich-text ul {
    list-style-type: disc;
}
.article-rich-text ol {
    list-style-type: decimal;
}
.article-rich-text li {
    margin-bottom: 0.75rem;
    color: var(--color-text-muted);
}
.article-rich-text strong {
    color: var(--color-text-dark);
    font-weight: 700;
}
.article-rich-text a {
    color: var(--color-primary);
    text-decoration: none;
    border-bottom: 1px solid rgba(242, 101, 34, 0.3);
    font-weight: 600;
    transition: all var(--transition-fast);
}
.article-rich-text a:hover {
    color: var(--color-primary-hover);
    border-bottom-color: var(--color-primary-hover);
}
.article-rich-text blockquote {
    border-left: 4px solid var(--color-primary);
    background: var(--color-primary-soft);
    padding: 2rem 2.5rem;
    margin: 2.5rem 0;
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    font-style: italic;
    box-shadow: var(--shadow-sm);
}
.article-rich-text blockquote p {
    margin-bottom: 0;
    color: var(--color-text-dark);
    font-size: 1.15rem;
}
.article-rich-text img {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    margin: 2.5rem 0;
    box-shadow: var(--shadow-md);
}
.article-rich-text .wp-block-image {
    margin: 3rem 0;
    text-align: center;
}
.article-rich-text figcaption {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    text-align: center;
    margin-top: 0.75rem;
    font-style: italic;
}

@media (max-width: 1024px) {
    .article-layout-grid {
        grid-template-columns: 1fr;
        gap: 4rem;
    }
    .article-sidebar {
        position: static;
    }
    .article-rich-text {
        font-size: 1rem;
        line-height: 1.75;
    }
}
</style>
