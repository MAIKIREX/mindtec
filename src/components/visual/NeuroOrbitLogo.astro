---
interface Props {
  /** CSS width of the outer orbit scene (it's always square). */
  size?: string;
  /** CSS width of the inner logo/particle stage. */
  stageSize?: string;
  class?: string;
}

const {
  size = "min(82vw, 780px)",
  stageSize = "clamp(260px, 32vw, 420px)",
  class: className = "",
} = Astro.props;
---

<div
  class:list={["neuro-orbit-logo", className]}
  data-neuro-orbit-logo
  style={`--neuro-orbit-size:${size};--neuro-orbit-stage-size:${stageSize};`}
>
