<style>
  .neuro-orbit-logo {
    position: relative;
    display: grid;
    place-items: center;
    width: var(--neuro-orbit-size, min(82vw, 780px));
    aspect-ratio: 1;
    transform-style: preserve-3d;
    will-change: transform;
  }

  .neuro-orbit-logo__field {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* Stage: holds both the particle contour and its fallback SVG, stacked at
     the same size so the dots trace the logo. */
  .neuro-orbit-logo__stage {
    position: relative;
    width: var(--neuro-orbit-stage-size, clamp(260px, 32vw, 420px));
    aspect-ratio: 140 / 142;
    z-index: 1;
    --neural-glow: 0px;
    transform-style: preserve-3d;
    will-change: transform;
    filter: drop-shadow(0 0 var(--neural-glow) rgba(242, 101, 34, 0.7));
  }

  .neuro-orbit-logo__particles {
    position: absolute;
    inset: 0;
    z-index: 1;
    transform: translateZ(0);
  }

  .neuro-orbit-logo__connections {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* Static fallback: shown only when JS never runs the particle contour
     (reduced motion). Otherwise hidden — the canvas-drawn dots carry it. */
  .neuro-orbit-logo__logo {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    display: none;
    filter: drop-shadow(
      0 0 24px var(--color-primary-glow, rgba(242, 101, 34, 0.35))
    );
  }

  .neuro-orbit-logo__logo path {
    fill: var(--color-primary, #f26522);
  }

  @media (prefers-reduced-motion: reduce) {
    .neuro-orbit-logo__logo {
      display: block;
    }
  }
</style>

<script>
  // Runs once per page load — Astro only includes an identical component
  // script once even if <NeuroOrbitLogo /> is used several times, so this
  // sets up EVERY instance found on the page instead of assuming there's
  // only one (no fixed element ids anywhere, all lookups are scoped to each
  // instance's own root).
  function setupNeuroOrbitLogo(root: HTMLElement) {
    const fieldEl = root.querySelector<HTMLCanvasElement>("[data-orbit-field]");
    const stageEl = root.querySelector<HTMLElement>("[data-orbit-stage]");
    const particlesEl = root.querySelector<HTMLElement>(
      "[data-orbit-particles]",
    );
    const connectionsEl = root.querySelector<HTMLCanvasElement>(
      "[data-orbit-connections]",
    );
    if (!fieldEl || !stageEl || !particlesEl || !connectionsEl) return;

    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const orbitTilt = { x: 0, y: 0 };

    // The path data was authored inside an SVG with viewBox width 132
    // (viewBox="6 13 132 116"). The polygon-mask plugin reads that same
    // coordinate space from the raw path, so the scale factor needed to
    // match the on-screen logo size is simply renderedWidthInPx / 132
    // (140 here leaves the small margin the original artwork was drawn with).
    const PARTICLE_MASK_WIDTH = 140;

    let particlesContainer: any;

    async function initParticles() {
      const { tsParticles } = await import("@tsparticles/engine");
      const { loadSlim } = await import("@tsparticles/slim");
      const { loadPolygonMaskPlugin } = await import(
        "@tsparticles/plugin-polygon-mask"
      );
      const { loadTwinkleUpdater } = await import(
        "@tsparticles/updater-twinkle"
      );
      const { gsap } = await import("gsap");
      await loadSlim(tsParticles);
      await loadPolygonMaskPlugin(tsParticles);
      await loadTwinkleUpdater(tsParticles);

      const isMobile = window.matchMedia("(max-width: 768px)").matches;
      const stageWidth = stageEl!.clientWidth;
      const scale = stageWidth / PARTICLE_MASK_WIDTH;

      particlesContainer = await tsParticles.load({
        // Passing the element directly (instead of an id) is what makes
        // multiple instances of this component safe on the same page.
        element: particlesEl,
        options: {
          fullScreen: { enable: false },
          fpsLimit: 60,
          detectRetina: false,
          pauseOnBlur: true,
          pauseOnOutsideViewport: true,
          particles: {
            number: {
              value: isMobile ? 320 : 520,
            },
            color: { value: "#F26522" },
            opacity: {
              value: { min: 0.45, max: 1 },
              animation: {
                enable: true,
                speed: 0.8,
                sync: false,
                startValue: "random",
              },
            },
            size: { value: { min: 1.1, max: 2.7 } },
            links: { enable: false },
            move: {
              enable: false,
              outModes: { default: "none" },
            },
          },
          twinkle: {
            particles: {
              enable: true,
              frequency: 0.035,
              opacity: { min: 0.7, max: 1 },
            },
          },
          polygon: {
            enable: true,
            type: "inline",
            url: "/logos/logo-cerebro-lateral.svg",
            scale,
            inline: { arrangement: "equidistant" },
            move: { radius: 0, type: "path" },
            draw: { enable: false },
          },
          interactivity: {
            events: { resize: { enable: true, delay: 0.5 } },
          },
        },
      });

      // --- Orbital starfield: a sphere of points rotating behind the logo ---
      const fieldContext = fieldEl!.getContext("2d");
      const orbitPoints = Array.from({ length: isMobile ? 360 : 720 }, () => {
        const longitude = Math.random() * Math.PI * 2;
        const latitude = Math.acos(2 * Math.random() - 1);
        return {
          x: Math.sin(latitude) * Math.cos(longitude),
          y: Math.cos(latitude),
          z: Math.sin(latitude) * Math.sin(longitude),
          size: 0.45 + Math.random() * 1.15,
        };
      });

      const resizeField = () => {
        const pixelRatio = window.devicePixelRatio || 1;
        fieldEl!.width = root.clientWidth * pixelRatio;
        fieldEl!.height = root.clientHeight * pixelRatio;
        fieldContext?.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
      };

      const drawField = (now: number) => {
        if (!fieldContext) return;
        const width = root.clientWidth;
        const height = root.clientHeight;
        fieldContext.clearRect(0, 0, width, height);

        if (!document.hidden) {
          const yaw = now * 0.00011 + orbitTilt.x * 0.55;
          const pitch = orbitTilt.y * 0.34 + Math.sin(now * 0.00017) * 0.06;
          const yawCos = Math.cos(yaw);
          const yawSin = Math.sin(yaw);
          const pitchCos = Math.cos(pitch);
          const pitchSin = Math.sin(pitch);
          // The orbital field is intentionally larger than the logo: with
          // perspective applied it reaches the outer circular boundary.
          const radius = Math.min(width, height) * 0.78;

          for (const point of orbitPoints) {
            const rotatedX = point.x * yawCos - point.z * yawSin;
            const rotatedZ = point.x * yawSin + point.z * yawCos;
            const rotatedY = point.y * pitchCos - rotatedZ * pitchSin;
            const depth = point.y * pitchSin + rotatedZ * pitchCos;
            const perspective = 1 / (2.45 - depth * 0.72);
            const alpha = 0.07 + ((depth + 1) / 2) * 0.5;
            const size = point.size * (0.7 + perspective * 1.7);

            fieldContext.beginPath();
            fieldContext.arc(
              width / 2 + rotatedX * radius * perspective,
              height / 2 + rotatedY * radius * perspective,
              size,
              0,
              Math.PI * 2,
            );
            fieldContext.fillStyle = `rgba(172, 222, 255, ${alpha})`;
            fieldContext.fill();
          }
        }

        requestAnimationFrame(drawField);
      };

      resizeField();
      new ResizeObserver(resizeField).observe(root);
      requestAnimationFrame(drawField);

      // --- Synapse-spark connections between nearby contour particles ---
      const connectionsContext = connectionsEl!.getContext("2d");
      const particlePairs: any[] = [];
      const activeConnections: any[] = [];
      const connectionCount = isMobile ? 7 : 14;
      let nextConnectionAt = 0;

      const resizeConnections = () => {
        const pixelRatio = window.devicePixelRatio || 1;
        connectionsEl!.width = stageEl!.clientWidth * pixelRatio;
        connectionsEl!.height = stageEl!.clientHeight * pixelRatio;
        connectionsContext?.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
      };

      const collectPairs = () => {
        particlePairs.length = 0;
        const dots = particlesContainer.particles.filter(() => true);

        for (let index = 0; index < dots.length; index += 1) {
          const start = dots[index].getPosition();
          for (
            let targetIndex = index + 1;
            targetIndex < dots.length;
            targetIndex += 1
          ) {
            const end = dots[targetIndex].getPosition();
            const distance = Math.hypot(end.x - start.x, end.y - start.y);
            if (distance > 18 && distance < 68) {
              particlePairs.push([dots[index], dots[targetIndex]]);
            }
          }
        }
      };

      const addConnection = (now: number) => {
        const pair =
          particlePairs[Math.floor(Math.random() * particlePairs.length)];
        if (!pair) return;
        activeConnections.push({
          pair,
          start: now,
          duration: 750 + Math.random() * 650,
        });
      };

      const drawConnections = (now: number) => {
        if (!connectionsContext) return;
        connectionsContext.clearRect(
          0,
          0,
          stageEl!.clientWidth,
          stageEl!.clientHeight,
        );

        while (
          activeConnections.length < connectionCount &&
          now >= nextConnectionAt
        ) {
          addConnection(now);
          nextConnectionAt = now + 85;
        }

        for (
          let index = activeConnections.length - 1;
          index >= 0;
          index -= 1
        ) {
          const connection = activeConnections[index];
          const progress = (now - connection.start) / connection.duration;
          if (progress >= 1) {
            activeConnections.splice(index, 1);
            continue;
          }

          const [origin, destination] = connection.pair;
          const from = origin.getPosition();
          const to = destination.getPosition();
          const drawProgress = Math.min(progress * 2.6, 1);
          const opacity = Math.sin(progress * Math.PI) * 0.9;
          const endX = from.x + (to.x - from.x) * drawProgress;
          const endY = from.y + (to.y - from.y) * drawProgress;

          connectionsContext.beginPath();
          connectionsContext.moveTo(from.x, from.y);
          connectionsContext.lineTo(endX, endY);
          connectionsContext.strokeStyle = `rgba(255, 139, 76, ${opacity})`;
          connectionsContext.lineWidth = 1.35;
          connectionsContext.shadowColor = "rgba(255, 139, 76, 0.8)";
          connectionsContext.shadowBlur = 7;
          connectionsContext.stroke();
        }

        requestAnimationFrame(drawConnections);
      };

      resizeConnections();
      collectPairs();
      new ResizeObserver(() => {
        resizeConnections();
        collectPairs();
      }).observe(stageEl!);
      requestAnimationFrame(drawConnections);

      // --- Pointer tilt: the whole scene tilts and drifts with a small
      // spring response, preserving the particle contour at all times.
      const tiltLogo = (event: PointerEvent) => {
        const bounds = root.getBoundingClientRect();
        const x = (event.clientX - bounds.left) / bounds.width - 0.5;
        const y = (event.clientY - bounds.top) / bounds.height - 0.5;
        orbitTilt.x = x;
        orbitTilt.y = y;

        gsap.to(root, {
          x: x * 16,
          y: y * 12,
          rotationY: x * 11,
          rotationX: y * -9,
          scale: 1.015,
          duration: 0.55,
          ease: "power3.out",
          overwrite: "auto",
        });
        gsap.to(stageEl, {
          "--neural-glow": "18px",
          duration: 0.35,
          overwrite: "auto",
        });
      };

      const resetLogoTilt = () => {
        orbitTilt.x = 0;
        orbitTilt.y = 0;
        gsap.to(root, {
          x: 0,
          y: 0,
          rotationX: 0,
          rotationY: 0,
          scale: 1,
          duration: 1.1,
          ease: "elastic.out(1, 0.45)",
          overwrite: "auto",
        });
        gsap.to(stageEl, {
          "--neural-glow": "0px",
          duration: 0.8,
          ease: "power2.out",
          overwrite: "auto",
        });
      };

      root.addEventListener("pointermove", tiltLogo);
      root.addEventListener("pointerleave", resetLogoTilt);

      // Extra safety: stop the animation loop entirely when the tab isn't visible.
      document.addEventListener("visibilitychange", () => {
        if (!particlesContainer) return;
        if (document.hidden) {
          particlesContainer.pause();
        } else {
          particlesContainer.play();
        }
      });
    }

    if (!prefersReducedMotion) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              initParticles();
              observer.disconnect();
              break;
            }
          }
        },
        { rootMargin: "200px" },
      );
      observer.observe(root);
    }
  }

  document
    .querySelectorAll<HTMLElement>("[data-neuro-orbit-logo]")
    .forEach(setupNeuroOrbitLogo);
</script>
