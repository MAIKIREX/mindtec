const { variant = 'catalogo' } = Astro.props;
const data = suites[variant] || suites.catalogo;

const suiteMetrics: Record<string, Metric[]> = {
  catalogo: [{ label: 'Research', value: 86 }, { label: 'Intelligence', value: 74 }, { label: 'Retail', value: 91 }, { label: 'Strategy', value: 68 }],
