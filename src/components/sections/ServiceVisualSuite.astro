---
interface Metric {
  label: string;
  value: number;
}

interface Card {
  title: string;
  text: string;
}

interface Suite {
  eyebrow: string;
  title: string;
  intro: string;
  image: string;
  alt: string;
  accent: string;
  cards: Card[];
}

interface Props {
  variant?: string;
}

