  mercado: [{ label: 'TAM', value: 81 }, { label: 'SAM', value: 66 }, { label: 'SOM', value: 44 }, { label: 'Riesgo', value: 58 }],
  precios: [{ label: 'Margen', value: 84 }, { label: 'Valor', value: 73 }, { label: 'Dolor', value: 48 }, { label: 'Elasticidad', value: 62 }],
  marca: [{ label: 'Confianza', value: 79 }, { label: 'Diferencia', value: 54 }, { label: 'Lealtad', value: 72 }, { label: 'Precio', value: 61 }],
  retail: [{ label: 'Shelf', value: 76 }, { label: 'Precio', value: 69 }, { label: 'Stock', value: 57 }, { label: 'POP', value: 82 }],
