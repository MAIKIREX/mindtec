const metrics = suiteMetrics[variant] || suiteMetrics.catalogo;
---

<section class="service-visual-suite" data-service-visual-suite style={`--suite-accent: ${data.accent}`}>
  <div class="service-visual-suite__inner">
    <header class="service-visual-suite__content" data-suite-intro>
      <span class="service-visual-suite__eyebrow">{data.eyebrow}</span>
      <h2>{data.title}</h2>
      <p>{data.intro}</p>
      <dl class="suite-kpis" aria-label="Indicadores clave del servicio">
        {metrics.map((metric) => (
          <div class="suite-kpi">
            <dt>{metric.label}</dt>
            <dd>{metric.value}<span>%</span></dd>
          </div>
        ))}
      </dl>
      <span class="service-visual-suite__caption" aria-hidden="true">Un recorrido en tres movimientos</span>
    </header>

    <div class="suite-interactive" data-suite-interactive>
      <figure class="suite-interactive__media">
        <img src={data.image} alt={data.alt} loading="lazy" />
        <figcaption>
          <span data-suite-active-number>01</span>
          <div>
            <strong data-suite-active-title>{data.cards[0].title}</strong>
            <p data-suite-active-text>{data.cards[0].text}</p>
          </div>
        </figcaption>
      </figure>

      <div class="suite-steps" role="group" aria-label={`Proceso: ${data.title}`}>
      {data.cards.slice(0, 3).map((card, index) => (
        <button
          type="button"
          class:list={['suite-step', { 'is-active': index === 0 }]}
          data-suite-step
          data-suite-number={String(index + 1).padStart(2, '0')}
          data-suite-title={card.title}
          data-suite-text={card.text}
          aria-pressed={index === 0 ? 'true' : 'false'}
        >
          <span>{String(index + 1).padStart(2, '0')}</span>
          <div>
            <h3>{card.title}</h3>
            <p>{card.text}</p>
          </div>
        </button>
      ))}
      </div>
    </div>
  </div>
</section>

<style>
  .service-visual-suite {
    position: relative;
    overflow: clip;
    padding: clamp(4.5rem, 9vw, 8rem) 0 clamp(5.5rem, 11vw, 9rem);
    background: radial-gradient(circle at 82% 26%, color-mix(in srgb, var(--suite-accent) 18%, transparent), transparent 30rem), linear-gradient(135deg, #f8fafc, #eef3f4);
  }
  .service-visual-suite::before {
    position: absolute; inset: 0; content: ''; pointer-events: none; opacity: .56;
    background-image: linear-gradient(rgba(11,43,64,.045) 1px, transparent 1px), linear-gradient(90deg, rgba(11,43,64,.045) 1px, transparent 1px);
    background-size: 46px 46px; mask-image: linear-gradient(90deg, transparent, #000 18%, #000 88%, transparent);
  }
  .service-visual-suite__inner {
    position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, .82fr) minmax(25rem, 1.18fr);
    gap: clamp(3rem, 8vw, 9rem); align-items: center; width: min(1240px, calc(100% - 2rem)); margin: 0 auto;
  }
  .service-visual-suite__content { max-width: 34rem; }
  .service-visual-suite__eyebrow, .service-visual-suite__caption {
    color: var(--suite-accent); font-family: var(--font-display); font-size: .72rem; font-weight: 850; letter-spacing: .15em; text-transform: uppercase;
  }
  .service-visual-suite__eyebrow { display: block; margin-bottom: 1rem; }
  .service-visual-suite__content h2 {
    max-width: 12ch; margin: 0; color: var(--color-secondary); font-family: var(--font-display); font-size: clamp(2.35rem, 4.2vw, 4.35rem);
    line-height: .98; letter-spacing: -.055em; text-wrap: balance;
  }
  .service-visual-suite__content > p {
    max-width: 58ch; margin: 1.5rem 0 1.8rem; color: var(--color-text-muted); font-size: clamp(1rem, 1.3vw, 1.1rem); line-height: 1.7; text-wrap: pretty;
  }
  .suite-kpis {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem 2rem; margin: 2.2rem 0 1.9rem;
  }
  .suite-kpi { padding-top: .85rem; border-top: 2px solid color-mix(in srgb, var(--suite-accent) 58%, rgba(11,43,64,.15)); }
  .suite-kpi dt { color: var(--color-text-muted); font-size: .72rem; font-weight: 800; letter-spacing: .11em; text-transform: uppercase; }
  .suite-kpi dd { margin: .4rem 0 0; color: var(--color-secondary); font-family: var(--font-display); font-size: clamp(2.45rem, 4.6vw, 4.8rem); font-variant-numeric: tabular-nums; font-weight: 900; line-height: .8; letter-spacing: -.07em; }
  .suite-kpi dd span { margin-left: .12rem; color: var(--suite-accent); font-size: .38em; letter-spacing: 0; vertical-align: .45em; }
  .service-visual-suite__caption { display: inline-flex; align-items: center; gap: .7rem; }
  .service-visual-suite__caption::before { width: 2.2rem; height: 1px; content: ''; background: currentColor; }
  .suite-interactive { width: min(100%, 36rem); }
  .suite-interactive__media { position: relative; min-height: clamp(18rem, 29vw, 25rem); margin: 0 0 1.25rem; overflow: hidden; border-radius: 1rem; background: #0b2b40; box-shadow: 0 1.4rem 3.5rem rgba(11,43,64,.16); }
  .suite-interactive__media::after { position: absolute; inset: 0; content: ''; background: linear-gradient(180deg, rgba(6,28,43,.04), rgba(6,28,43,.82)); pointer-events: none; }
  .suite-interactive__media img { width: 100%; height: 100%; min-height: inherit; object-fit: cover; display: block; filter: saturate(.85) contrast(1.04); }
  .suite-interactive__media figcaption { position: absolute; z-index: 1; right: 0; bottom: 0; left: 0; display: grid; grid-template-columns: 2.7rem minmax(0, 1fr); gap: .9rem; padding: clamp(1.25rem, 3vw, 2rem); color: #fff; }
  .suite-interactive__media figcaption > span { color: var(--suite-accent); font-family: var(--font-display); font-size: .78rem; font-weight: 900; letter-spacing: .1em; }
  .suite-interactive__media strong { font-family: var(--font-display); font-size: clamp(1.4rem, 2.3vw, 2rem); line-height: 1; letter-spacing: -.035em; }
  .suite-interactive__media p { max-width: 36ch; margin: .5rem 0 0; color: rgba(255,255,255,.82); font-size: .95rem; line-height: 1.5; }
  .suite-steps { display: grid; gap: 0; margin: 0; padding: 0; border-top: 1px solid rgba(11,43,64,.18); }
  .suite-step { display: grid; grid-template-columns: 3.2rem minmax(0, 1fr); gap: 1rem; width: 100%; padding: clamp(1.2rem, 2.5vw, 1.8rem) 0; border: 0; border-bottom: 1px solid rgba(11,43,64,.18); background: transparent; text-align: left; cursor: pointer; transition: transform 180ms ease, color 180ms ease; }
  .suite-step:hover, .suite-step:focus-visible, .suite-step.is-active { transform: translateX(.45rem); outline: none; }
  .suite-step:focus-visible h3, .suite-step.is-active h3 { color: var(--suite-accent); }
  .suite-step:active { transform: translateX(.25rem) scale(.99); }
  .suite-step > span { color: var(--suite-accent); font-family: var(--font-display); font-size: .78rem; font-weight: 900; font-variant-numeric: tabular-nums; letter-spacing: .09em; }
  .suite-step h3, .suite-step p { margin: 0; }
  .suite-step h3 { color: var(--color-secondary); font-family: var(--font-display); font-size: clamp(1.35rem, 2vw, 1.85rem); line-height: 1; letter-spacing: -.035em; }
  .suite-step p { max-width: 42ch; margin-top: .5rem; color: var(--color-text-muted); font-size: .98rem; line-height: 1.55; }
  @media (max-width: 820px) {
    .service-visual-suite__inner { grid-template-columns: 1fr; gap: 3rem; }
    .service-visual-suite__content h2 { max-width: 15ch; }
  }
  @media (max-width: 640px) {
    .service-visual-suite { padding: 4.5rem 0 5rem; }
    .service-visual-suite__inner { width: min(100% - 1.5rem, 34rem); }
    .suite-kpis { gap: 1rem; }
    .suite-step { grid-template-columns: 2.6rem minmax(0, 1fr); }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  type SuiteRoot = HTMLElement & {
    __suiteContext?: gsap.Context;
    __suiteInteractionBound?: boolean;
  };
  type SuiteWindow = typeof window & { __suiteEventsRegistered?: boolean };

  function destroySuites(): void {
    document.querySelectorAll<SuiteRoot>('[data-service-visual-suite]').forEach((root) => {
      root.__suiteContext?.revert();
      delete root.__suiteContext;
    });
  }

  function activateSuiteStep(root: SuiteRoot, activeStep: HTMLButtonElement): void {
    root.querySelectorAll<HTMLButtonElement>('[data-suite-step]').forEach((step) => {
      const isActive = step === activeStep;
      step.classList.toggle('is-active', isActive);
      step.setAttribute('aria-pressed', String(isActive));
    });

    const number = root.querySelector<HTMLElement>('[data-suite-active-number]');
    const title = root.querySelector<HTMLElement>('[data-suite-active-title]');
    const text = root.querySelector<HTMLElement>('[data-suite-active-text]');

    if (number) number.textContent = activeStep.dataset.suiteNumber ?? '';
    if (title) title.textContent = activeStep.dataset.suiteTitle ?? '';
    if (text) text.textContent = activeStep.dataset.suiteText ?? '';
  }

  function bindSuiteInteraction(root: SuiteRoot): void {
    if (root.__suiteInteractionBound) return;
    root.__suiteInteractionBound = true;

    root.querySelectorAll<HTMLButtonElement>('[data-suite-step]').forEach((step) => {
      step.addEventListener('click', () => activateSuiteStep(root, step));
    });
  }

  function initSuites(): void {
    document.querySelectorAll<SuiteRoot>('[data-service-visual-suite]').forEach((root) => {
      root.__suiteContext?.revert();
      bindSuiteInteraction(root);
      const intro = root.querySelector<HTMLElement>('[data-suite-intro]');
      const steps = gsap.utils.toArray<HTMLElement>('[data-suite-step]', root);
      const kpis = gsap.utils.toArray<HTMLElement>('.suite-kpi', root);
      if (steps.length === 0) return;

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      root.__suiteContext = gsap.context(() => {
        if (reducedMotion) {
          gsap.set([intro, ...kpis, ...steps], { clearProps: 'transform,opacity,visibility' });
          return;
        }

        const media = gsap.matchMedia();
        media.add('(min-width: 641px)', () => {
          const timeline = gsap.timeline({
            scrollTrigger: { trigger: root, start: 'top 78%', toggleActions: 'play none none reverse', invalidateOnRefresh: true },
          });
          if (intro) timeline.fromTo(intro, { y: 28 }, { y: 0, duration: .65, ease: 'power3.out' }, 0);
          timeline.fromTo(
            [...kpis, ...steps],
            { y: 26, scale: .98 },
            { y: 0, scale: 1, duration: .7, stagger: .08, ease: 'power3.out' },
            .12,
          );
        });
        media.add('(max-width: 640px)', () => {
          gsap.fromTo([...kpis, ...steps], { y: 18, scale: .99 }, {
            y: 0, scale: 1, duration: .55, stagger: .1, ease: 'power3.out',
            scrollTrigger: { trigger: root, start: 'top 82%', toggleActions: 'play none none reverse', invalidateOnRefresh: true },
          });
        });
        return () => media.revert();
      }, root);
    });
    ScrollTrigger.refresh();
  }

  initSuites();
  const suiteWindow = window as SuiteWindow;
  if (!suiteWindow.__suiteEventsRegistered) {
    document.addEventListener('astro:page-load', initSuites);
    document.addEventListener('astro:before-swap', destroySuites);
    suiteWindow.__suiteEventsRegistered = true;
  }
  if ('fonts' in document) document.fonts.ready.then(() => ScrollTrigger.refresh());
</script>
