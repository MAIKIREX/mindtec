---
interface Props {
    class?: string;
    contentClass?: string;
    id?: string;
    /**
     * Altura mínima reservada para la sección/transición.
     * Por defecto ocupa la ventana completa (100svh), pero puede
     * recibir cualquier valor CSS válido ("auto", "40rem", etc.)
     * para secciones cuyo contenido no tiene el alto de una ventana.
     */
    minHeight?: string;
}

const {
    class: className = "",
    contentClass = "",
    id,
    minHeight = "100svh",
} = Astro.props;
---

<section
    id={id}
    class:list={["stack-section", className]}
    data-stack-section
    style={`--stack-min-height: ${minHeight};`}
>
    <div class="stack-section__pin" data-stack-pin>
        <div
            class:list={["stack-section__content", contentClass]}
            data-stack-content
        >
            <slot />
        </div>

        <div
            class="stack-section__overlay"
            data-stack-overlay
            aria-hidden="true"
        >
        </div>
    </div>
</section>

<style>
    .stack-section {
        position: relative;
        width: 100%;
        min-height: var(--stack-min-height, 100svh);
    }

    .stack-section__pin {
        position: relative;

        width: 100%;
        height: auto;
        min-height: var(--stack-min-height, 100svh);
        /*
         * GSAP fija esta caja con position:fixed mientras dura el pin.
         * Ahora permite alturas dinámicas según el contenido.
         * ScrollTrigger calculará el espacio necesario automáticamente.
         */
        overflow-x: hidden;
        -webkit-overflow-scrolling: touch;

        transform: translateZ(0);
        backface-visibility: hidden;
    }

    .stack-section__content {
        position: relative;
        z-index: 1;

        width: 100%;

        transform-origin: center center;

        will-change: transform, opacity;
    }

    .stack-section__overlay {
        position: absolute;
        z-index: 2;

        inset: 0;

        pointer-events: none;

        opacity: 0;

        background: linear-gradient(
            to bottom,
            rgba(5, 4, 10, 0.04),
            rgba(5, 4, 10, 0.48)
        );

        will-change: opacity;
    }

    /*
   * La sombra se aplica a la sección que sube.
   * Ayuda a mostrar que está pasando por encima.
   */
    .stack-section:not(:first-child) .stack-section__pin {
        box-shadow:
            0 -24px 70px rgba(0, 0, 0, 0.2),
            0 -6px 22px rgba(0, 0, 0, 0.12);
    }
</style>
