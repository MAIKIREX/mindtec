---
interface Props {
  value: number;
  decimals?: number;
  prefix?: string;
  suffix?: string;
  duration?: number;
  delay?: number;
  once?: boolean;
  separator?: boolean;
  class?: string;
  debug?: boolean;
}

const {
  value,
  decimals = 0,
  prefix = "",
  suffix = "",
  duration = 1.6,
  delay = 0,
  once = true,
  separator = true,
  class: className = "",
  debug = false,
} = Astro.props;
---

<span
  class:list={["stat-counter", className]}
  data-stat-counter
  data-value={value}
  data-decimals={decimals}
  data-prefix={prefix}
  data-suffix={suffix}
  data-duration={duration}
  data-delay={delay}
  data-once={String(once)}
  data-separator={String(separator)}
  data-debug={String(debug)}
>{prefix}{(0).toFixed(decimals)}{suffix}</span>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  type CounterElement = HTMLElement & {
    __statCounterContext?: gsap.Context;
  };

  type CounterWindow = typeof window & {
    __statCounterEventsRegistered?: boolean;
  };

  function readNumber(
    element: HTMLElement,
    key: string,
    fallback: number,
  ): number {
    const value = Number(element.dataset[key]);

    return Number.isFinite(value) ? value : fallback;
  }

  function formatValue(
    value: number,
    decimals: number,
    separator: boolean,
  ): string {
    const fixed = value.toFixed(decimals);

    if (!separator) return fixed;

    const [intPart, decimalPart] = fixed.split(".");
    const withThousands = intPart.replace(/\B(?=(\d{3})+(?!\d))/g, " ");

    return decimalPart ? `${withThousands}.${decimalPart}` : withThousands;
  }

  function destroyStatCounters(): void {
    document
      .querySelectorAll<CounterElement>("[data-stat-counter]")
      .forEach((element) => {
        element.__statCounterContext?.revert();
        delete element.__statCounterContext;
      });
  }

  function initStatCounters(): void {
    document
      .querySelectorAll<CounterElement>("[data-stat-counter]")
      .forEach((element) => {
        element.__statCounterContext?.revert();

        const target = readNumber(element, "value", 0);
        const decimals = readNumber(element, "decimals", 0);
        const duration = readNumber(element, "duration", 1.6);
        const delay = readNumber(element, "delay", 0);
        const prefix = element.dataset.prefix ?? "";
        const suffix = element.dataset.suffix ?? "";
        const once = element.dataset.once !== "false";
        const separator = element.dataset.separator !== "false";
        const markers = element.dataset.debug === "true";

        const prefersReducedMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;

        element.__statCounterContext = gsap.context(() => {
          if (prefersReducedMotion) {
            element.textContent = `${prefix}${formatValue(target, decimals, separator)}${suffix}`;

            return;
          }

          const proxy = { value: 0 };

          gsap.to(proxy, {
            value: target,
            duration,
            delay,
            ease: "power2.out",

            onUpdate: () => {
              element.textContent = `${prefix}${formatValue(proxy.value, decimals, separator)}${suffix}`;
            },

            scrollTrigger: {
              trigger: element,
              start: "top 90%",

              toggleActions: once
                ? "play none none none"
                : "play reset play reset",

              markers,
              invalidateOnRefresh: true,
            },
          });
        }, element);
      });

    ScrollTrigger.refresh();
  }

  initStatCounters();

  const globalWindow = window as CounterWindow;

  if (!globalWindow.__statCounterEventsRegistered) {
    document.addEventListener("astro:page-load", initStatCounters);
    document.addEventListener("astro:before-swap", destroyStatCounters);
    globalWindow.__statCounterEventsRegistered = true;
  }
</script>

<style>
  .stat-counter {
    display: inline-block;
    font-variant-numeric: tabular-nums;
  }
</style>
