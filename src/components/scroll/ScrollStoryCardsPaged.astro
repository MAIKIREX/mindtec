---
export interface ScrollStoryCardsCover {
  background: string;
  alt?: string;
  eyebrow?: string;
  title: string;
  description?: string;
  scrollLabel?: string;
  overlay?: string;
  textColor?: string;
  titleColor?: string;
  descriptionColor?: string;
  eyebrowColor?: string;
  scrollLabelColor?: string;
}

export interface ScrollStoryCardsItemsSection {
  background?: string;
  alt?: string;
  eyebrow?: string;
  title?: string;
  description?: string;
  overlay?: string;
  textColor?: string;
  titleColor?: string;
  descriptionColor?: string;
  eyebrowColor?: string;
}

export interface ScrollStoryCard {
  eyebrow?: string;
  title: string;
  description?: string;
  image: string;
  imageAlt?: string;
  href?: string;
  linkLabel?: string;
  accentColor?: string;
  eyebrowColor?: string;
  titleColor?: string;
  descriptionColor?: string;
  linkColor?: string;
}

interface Props {
  cover: ScrollStoryCardsCover;
  items?: ScrollStoryCardsItemsSection;
  /** Tarjetas que el wrapper renderiza dentro de la escena de items. */
  cards?: ScrollStoryCard[];
  class?: string;

  /** Suavidad con la que la animación sigue al scroll. */
  scrub?: number;

  /** Distancia de scroll expresada en múltiplos del viewport. */
  scrollDistance?: number;

  /** Separación temporal entre la entrada de cada card. */
  cardStagger?: number;

  /** Elevación vertical entre cards para crear el escalonado. */
  stepOffset?: string;

  /** Ancho base de cada card. */
  cardWidth?: string;

  /** Alto base de cada card. */
  cardHeight?: string;
}

const {
  cover,
  items = {},
  cards = [],
  class: className = "",
  scrub = 0.85,
  scrollDistance = 1.35,
  cardStagger = 0.12,
  stepOffset = "clamp(18px, 3.5vh, 42px)",
  cardWidth = "clamp(250px, 28vw, 430px)",
  cardHeight = "clamp(300px, 48vh, 520px)"
} = Astro.props;

const coverOverlay =
  cover.overlay ??
  "linear-gradient(90deg, rgba(3,7,18,.72), rgba(3,7,18,.12) 65%, rgba(3,7,18,.28))";

const itemsOverlay =
  items.overlay ??
  "linear-gradient(180deg, rgba(3,7,18,.18), rgba(3,7,18,.7))";

const cardsPerPage = 3;
const cardPages = Array.from(
  { length: Math.ceil(cards.length / cardsPerPage) },
  (_, pageIndex) => cards.slice(pageIndex * cardsPerPage, (pageIndex + 1) * cardsPerPage)
);
---

<section
  class:list={["scroll-story-cards", className]}
  data-scroll-story-cards
  data-scrub={scrub}
  data-scroll-distance={scrollDistance}
  data-card-stagger={cardStagger}
  style={`--story-step-offset:${stepOffset};--story-card-width:${cardWidth};--story-card-height:${cardHeight};--story-cover-color:${cover.textColor ?? "#fff"};--story-cover-title-color:${cover.titleColor ?? cover.textColor ?? "#fff"};--story-cover-description-color:${cover.descriptionColor ?? cover.textColor ?? "#fff"};--story-cover-eyebrow-color:${cover.eyebrowColor ?? cover.textColor ?? "#fff"};--story-cover-scroll-label-color:${cover.scrollLabelColor ?? cover.textColor ?? "#fff"};--story-items-color:${items.textColor ?? "#fff"};--story-items-title-color:${items.titleColor ?? items.textColor ?? "#fff"};--story-items-description-color:${items.descriptionColor ?? items.textColor ?? "#fff"};--story-items-eyebrow-color:${items.eyebrowColor ?? items.textColor ?? "#fff"};`}
>
  <div class="scroll-story-cards__stage" data-story-stage>
    <section class="scroll-story-cards__scene scroll-story-cards__cover" data-story-cover>
      <img
        class="scroll-story-cards__background"
        src={cover.background}
        alt={cover.alt ?? ""}
        loading="eager"
      />
      <div class="scroll-story-cards__overlay" style={`background:${coverOverlay};`}></div>

      <div class="scroll-story-cards__cover-content" data-story-cover-content>
        {cover.eyebrow && (
          <span class="scroll-story-cards__eyebrow" style={`color:${cover.eyebrowColor ?? cover.textColor ?? "inherit"};`}>
            {cover.eyebrow}
          </span>
        )}
        <h1>{cover.title}</h1>
        {cover.description && <p>{cover.description}</p>}

        <div
          class="scroll-story-cards__scroll-message"
          aria-hidden="true"
          style={`color:${cover.scrollLabelColor ?? cover.textColor ?? "inherit"};`}
        >
          <span>{cover.scrollLabel ?? "Desliza para explorar"}</span>
          <span class="scroll-story-cards__scroll-line"></span>
        </div>
      </div>
    </section>

    <section class="scroll-story-cards__scene scroll-story-cards__items-scene" data-story-items>
      {
        items.background ? (
          <img
            class="scroll-story-cards__background"
            src={items.background}
            alt={items.alt ?? ""}
            loading="eager"
            data-story-items-background
          />
        ) : (
          <div class="scroll-story-cards__background scroll-story-cards__background--fallback"></div>
        )
      }
      <div class="scroll-story-cards__overlay" style={`background:${itemsOverlay};`}></div>

      {(items.eyebrow || items.title || items.description) && (
        <header class="scroll-story-cards__items-header" data-story-items-header>
          {items.eyebrow && (
            <span class="scroll-story-cards__eyebrow" style={`color:${items.eyebrowColor ?? items.textColor ?? "inherit"};`}>
              {items.eyebrow}
            </span>
          )}
          {items.title && <h2 style={`color:${items.titleColor ?? items.textColor ?? "inherit"};`}>{items.title}</h2>}
          {items.description && (
            <p style={`color:${items.descriptionColor ?? items.textColor ?? "inherit"};`}>{items.description}</p>
          )}
        </header>
      )}

      <div class="scroll-story-cards__cards-viewport">
        <div class="scroll-story-cards__cards" data-story-cards-list>
          {
            cardPages.map((page, pageIndex) => (
              <div
                class="scroll-story-cards__cards-page"
                data-story-cards-page
                data-story-cards-page-index={pageIndex}
                style={`--story-cards-in-page:${page.length};`}
              >
                {
                  page.map((card) => (
                    <article
                      class="scroll-story-cards__card"
                      data-story-card
                      tabindex="0"
                      style={`--story-card-accent:${card.accentColor ?? "#7dd3fc"};--story-card-title-color:${card.titleColor ?? "#fff"};--story-card-description-color:${card.descriptionColor ?? "inherit"};--story-card-eyebrow-color:${card.eyebrowColor ?? "var(--story-card-accent)"};--story-card-link-color:${card.linkColor ?? "#fff"};`}
                    >
                      <div class="scroll-story-cards__card-content">
                        {card.eyebrow && <span>{card.eyebrow}</span>}
                        <h3>{card.title}</h3>
                        {card.description && <p><span>{card.description}</span></p>}
                        {
                          card.href && (
                            <a href={card.href}>
                              {card.linkLabel ?? "Conocer más"}
                              <span aria-hidden="true">→</span>
                            </a>
                          )
                        }
                      </div>

                      <span class="scroll-story-cards__card-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                          <g class="scroll-story-cards__card-icon-plus">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                          </g>
                          <g class="scroll-story-cards__card-icon-arrow">
                            <line x1="12" y1="19" x2="12" y2="5"></line>
                            <line x1="6" y1="11" x2="12" y2="5"></line>
                            <line x1="18" y1="11" x2="12" y2="5"></line>
                          </g>
                        </svg>
                      </span>
                    </article>
                  ))
                }
              </div>
            ))
          }
          <slot />
        </div>
      </div>
    </section>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  type StoryRoot = HTMLElement & { __storyContext?: gsap.Context };
  type StoryWindow = typeof window & { __storyEventsReady?: boolean };

  const numberFromDataset = (
    element: HTMLElement,
    key: string,
    fallback: number
  ): number => {
    const value = Number(element.dataset[key]);
    return Number.isFinite(value) ? value : fallback;
  };

  function destroyStories(): void {
    document.querySelectorAll<StoryRoot>("[data-scroll-story-cards]").forEach((root) => {
      root.__storyContext?.revert();
      delete root.__storyContext;
    });
  }

  function initStories(): void {
    document.querySelectorAll<StoryRoot>("[data-scroll-story-cards]").forEach((root) => {
      root.__storyContext?.revert();

      const stage = root.querySelector<HTMLElement>("[data-story-stage]");
      const cover = root.querySelector<HTMLElement>("[data-story-cover]");
      const coverContent = root.querySelector<HTMLElement>("[data-story-cover-content]");
      const items = root.querySelector<HTMLElement>("[data-story-items]");
      const itemsHeader = root.querySelector<HTMLElement>("[data-story-items-header]");
      const cards = gsap.utils.toArray<HTMLElement>("[data-story-card]", root);
      const cardPages = gsap.utils.toArray<HTMLElement>("[data-story-cards-page]", root);

      if (!stage || !cover || !items || cards.length === 0) return;

      const scrub = numberFromDataset(root, "scrub", 0.85);
      const scrollDistance = numberFromDataset(root, "scrollDistance", 1.35);
      const cardStagger = numberFromDataset(root, "cardStagger", 0.12);
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      root.__storyContext = gsap.context(() => {
        gsap.set(items, { yPercent: 100, zIndex: 2 });
        gsap.set(cover, { zIndex: 1 });
        gsap.set(cards, { y: 110, autoAlpha: 0, scale: 0.96 });
        if (cardPages.length > 0) {
          gsap.set(cardPages, { autoAlpha: 0, xPercent: 12 });
          gsap.set(cardPages[0], { autoAlpha: 1, xPercent: 0 });
        }
        if (itemsHeader) gsap.set(itemsHeader, { y: 30, autoAlpha: 0 });

        if (reduceMotion) {
          gsap.set(items, { yPercent: 0 });
          gsap.set(cover, { autoAlpha: 0 });
          gsap.set(cardPages.length > 0 ? cardPages[0] : cards, { y: 0, autoAlpha: 1, scale: 1, xPercent: 0 });
          gsap.set(cards, { y: 0, autoAlpha: 1, scale: 1 });
          if (itemsHeader) gsap.set(itemsHeader, { y: 0, autoAlpha: 1 });
          return;
        }

        const timeline = gsap.timeline({
          defaults: { ease: "none" },
          scrollTrigger: {
            trigger: root,
            start: "top top",
            end: () => `+=${window.innerHeight * scrollDistance * Math.max(cardPages.length, 1)}`,
            pin: stage,
            pinSpacing: true,
            scrub,
            refreshPriority: 10,
            snap: {
              snapTo: "labels",
              delay: 0.05,
              duration: { min: 0.15, max: 0.4 },
              ease: "power1.out",
              inertia: false
            },
            anticipatePin: 1,
            invalidateOnRefresh: true
          }
        });

        timeline
          .addLabel("story-cover", 0)
          .to(cover, { yPercent: -12, scale: 0.985, duration: 1 }, 0)
          .to(coverContent, { y: -32, autoAlpha: 0.4, duration: 0.75 }, 0)
          .to(items, { yPercent: 0, duration: 1 }, 0)
          .to(
            items.querySelector<HTMLElement>("[data-story-items-background]"),
            { scale: 1, duration: 1 },
            0
          );

        if (itemsHeader) {
          timeline.to(itemsHeader, { y: 0, autoAlpha: 1, duration: 0.45, ease: "power2.out" }, 0.58);
        }

        const firstPageCards = cardPages.length > 0
          ? gsap.utils.toArray<HTMLElement>("[data-story-card]", cardPages[0])
          : cards;

        timeline.to(
          firstPageCards,
          {
            y: 0,
            autoAlpha: 1,
            scale: 1,
            duration: 0.55,
            stagger: cardStagger,
            ease: "power3.out"
          },
          0.55
        );
        timeline.addLabel(
          "story-page-0",
          0.55 + 0.55 + Math.max(firstPageCards.length - 1, 0) * cardStagger
        );

        cardPages.slice(1).forEach((page, pageIndex) => {
          const previousPage = cardPages[pageIndex];
          const pageCards = gsap.utils.toArray<HTMLElement>("[data-story-card]", page);
          const transitionPosition = 1.3 + pageIndex;
          const pageCompletePosition =
            transitionPosition +
            0.12 +
            0.45 +
            Math.max(pageCards.length - 1, 0) * cardStagger;

          timeline
            .to(previousPage, { xPercent: -12, autoAlpha: 0, duration: 0.45 }, transitionPosition)
            .to(page, { xPercent: 0, autoAlpha: 1, duration: 0.45 }, transitionPosition)
            .to(
              pageCards,
              {
                y: 0,
                autoAlpha: 1,
                scale: 1,
                duration: 0.45,
                stagger: cardStagger,
                ease: "power3.out"
              },
              `${transitionPosition}+=0.12`
            );
          timeline.addLabel(`story-page-${pageIndex + 1}`, pageCompletePosition);
        });
      }, root);
    });

    ScrollTrigger.refresh();
  }

  initStories();

  const storyWindow = window as StoryWindow;
  if (!storyWindow.__storyEventsReady) {
    document.addEventListener("astro:page-load", initStories);
    document.addEventListener("astro:before-swap", destroyStories);
    storyWindow.__storyEventsReady = true;
  }

  if ("fonts" in document) {
    document.fonts.ready.then(() => ScrollTrigger.refresh());
  }
</script>

<style>
  @property --story-card-notch-x {
    syntax: "<percentage>";
    inherits: false;
    initial-value: 100%;
  }

  .scroll-story-cards {
    position: relative;
    width: 100%;
    min-height: 100svh;
    isolation: isolate;
    background: #061c2b;
    font-family: var(--font-body, inherit);
  }

  .scroll-story-cards__stage {
    position: relative;
    width: 100%;
    height: 100svh;
    overflow: hidden;
  }

  .scroll-story-cards__scene {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    will-change: transform;
  }

  .scroll-story-cards__background {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .scroll-story-cards__items-scene .scroll-story-cards__background {
    transform: scale(1.06);
    will-change: transform;
  }

  .scroll-story-cards__background--fallback {
    background: radial-gradient(circle at 70% 20%, #24465c, #081723 58%, #040a10);
  }

  .scroll-story-cards__overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .scroll-story-cards__cover-content,
  .scroll-story-cards__items-header {
    position: absolute;
    z-index: 3;
    left: clamp(24px, 7vw, 120px);
    width: min(860px, 82vw);
  }

  .scroll-story-cards__cover-content {
    bottom: clamp(46px, 10vh, 120px);
    color: var(--story-cover-color);
  }

  .scroll-story-cards__items-header {
    top: clamp(24px, 6vh, 72px);
    color: var(--story-items-color);
  }

  .scroll-story-cards__eyebrow {
    display: block;
    margin-bottom: 16px;
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .2em;
    text-transform: uppercase;
    opacity: .7;
  }

  .scroll-story-cards h1,
  .scroll-story-cards h2 {
    margin: 0;
    color: inherit;
    font-family: var(--font-display, inherit);
    letter-spacing: -.045em;
  }

  .scroll-story-cards__cover-content h1 {
    color: var(--story-cover-title-color);
  }

  .scroll-story-cards__cover-content p {
    color: var(--story-cover-description-color);
  }

  .scroll-story-cards h1 {
    font-size: clamp(2.2rem, 5.2vw, 5.8rem);
    line-height: .98;
  }

  .scroll-story-cards h2 {
    font-size: clamp(1.8rem, 3.4vw, 4rem);
    line-height: 1;
  }

  .scroll-story-cards p {
    max-width: 640px;
    margin: 22px 0 0;
    font-size: clamp(.95rem, 1.2vw, 1.15rem);
    line-height: 1.6;
    opacity: .78;
  }

  .scroll-story-cards__scroll-message {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-top: 38px;
    font-size: .68rem;
    letter-spacing: .14em;
    text-transform: uppercase;
    opacity: .58;
  }

  .scroll-story-cards__scroll-line {
    width: 84px;
    height: 1px;
    background: currentColor;
  }

  .scroll-story-cards__cards-viewport {
    position: absolute;
    z-index: 4;
    right: 0;
    bottom: clamp(18px, 4vh, 44px);
    left: 0;
    overflow: visible;
  }

  .scroll-story-cards__cards {
    position: relative;
    width: 100%;
    min-height: calc(var(--story-card-height) + var(--story-step-offset) * 2 + 8px);
    padding: calc(var(--story-step-offset) * 2 + 8px) clamp(22px, 4vw, 68px) 0;
  }

  .scroll-story-cards__cards-page {
    position: absolute;
    inset: 0 clamp(22px, 4vw, 68px) 0;
    display: grid;
    grid-template-columns: repeat(var(--story-cards-in-page), minmax(0, 1fr));
    align-items: end;
    gap: clamp(14px, 2vw, 30px);
  }

  .scroll-story-cards__cards-page > :global([data-story-card]),
  .scroll-story-cards__cards > :global([data-story-card]) {
    height: var(--story-card-height);
  }

  .scroll-story-cards__card {
    position: relative;
    display: grid;
    align-items: end;
    overflow: hidden;
    color: #f8fafc;
    background: #102737;
    --story-card-notch-x: 100%;
    --story-card-notch-height: 24%;
    border: 0;
    clip-path: polygon(
      0 0,
      var(--story-card-notch-x) 0,
      var(--story-card-notch-x) var(--story-card-notch-height),
      100% var(--story-card-notch-height),
      100% 100%,
      0 100%
    );
    box-shadow: 0 12px 30px rgba(1, 12, 21, 0.25);
    isolation: isolate;
    transition: --story-card-notch-x 850ms cubic-bezier(0.16, 1, 0.3, 1), box-shadow 500ms ease;
  }

  .scroll-story-cards__card-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-height: 100%;
    padding: clamp(20px, 2vw, 30px);
  }

  .scroll-story-cards__card-content > span {
    align-self: end;
    color: var(--story-card-eyebrow-color);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .scroll-story-cards__card h3 {
    max-width: 84%;
    margin: auto 0 0;
    color: var(--story-card-title-color);
    font-family: var(--font-display, inherit);
    font-size: clamp(1.5rem, 2.1vw, 2.3rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .scroll-story-cards__card p {
    display: grid;
    grid-template-rows: 0fr;
    margin: 0;
    max-width: 34ch;
    overflow: hidden;
    color: var(--story-card-description-color);
    opacity: 0;
    transform: translateY(12px);
    transition: grid-template-rows 400ms cubic-bezier(0.16, 1, 0.3, 1), opacity 300ms ease, transform 400ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .scroll-story-cards__card p span {
    min-height: 0;
    overflow: hidden;
  }

  .scroll-story-cards__card a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: fit-content;
    color: var(--story-card-link-color);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 300ms ease, transform 400ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .scroll-story-cards__card a span {
    color: var(--story-card-accent);
    font-size: 1.1rem;
    transition: transform 250ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .scroll-story-cards__card:hover p,
  .scroll-story-cards__card:focus-within p {
    grid-template-rows: 1fr;
    opacity: 0.88;
    transform: translateY(0);
  }

  .scroll-story-cards__card:hover a,
  .scroll-story-cards__card:focus-within a {
    opacity: 1;
    transform: translateY(0);
  }

  .scroll-story-cards__card a:hover span,
  .scroll-story-cards__card a:focus-visible span {
    transform: translateX(4px);
  }

  .scroll-story-cards__card a:focus-visible {
    outline: 2px solid var(--story-card-accent);
    outline-offset: 4px;
  }

  .scroll-story-cards__card-icon {
    position: absolute;
    z-index: 3;
    right: clamp(18px, 2vw, 28px);
    bottom: clamp(18px, 2vw, 28px);
    display: grid;
    width: 2.7rem;
    height: 2.7rem;
    place-items: center;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.38);
    border-radius: 50%;
    transition: background 400ms ease, border-color 400ms ease, color 400ms ease, transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .scroll-story-cards__card-icon svg {
    width: 1.15rem;
    height: 1.15rem;
    overflow: visible;
  }

  .scroll-story-cards__card-icon line {
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  .scroll-story-cards__card-icon-plus,
  .scroll-story-cards__card-icon-arrow {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1), opacity 350ms ease;
  }

  .scroll-story-cards__card-icon-arrow {
    opacity: 0;
    transform: rotate(-40deg) scale(0.5);
  }

  .scroll-story-cards__card:hover,
  .scroll-story-cards__card:focus-within {
    --story-card-notch-x: 68%;
    box-shadow: 0 28px 54px rgba(1, 12, 21, 0.34);
  }

  .scroll-story-cards__card:hover .scroll-story-cards__card-icon,
  .scroll-story-cards__card:focus-within .scroll-story-cards__card-icon {
    color: #fff;
    background: var(--story-card-accent);
    border-color: var(--story-card-accent);
    transform: scale(1.06);
  }

  .scroll-story-cards__card:hover .scroll-story-cards__card-icon-plus,
  .scroll-story-cards__card:focus-within .scroll-story-cards__card-icon-plus {
    opacity: 0;
    transform: rotate(40deg) scale(0.5);
  }

  .scroll-story-cards__card:hover .scroll-story-cards__card-icon-arrow,
  .scroll-story-cards__card:focus-within .scroll-story-cards__card-icon-arrow {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  .scroll-story-cards__cards-page > :global([data-story-card]:nth-child(3n + 1)),
  .scroll-story-cards__cards > :global([data-story-card]:nth-child(3n + 1)) {
    translate: 0 calc(var(--story-step-offset) * 2);
