---
interface Props {
    delay?: number;
    class?: string;
    yOffset?: number;
    exitScale?: number;
    exitOpacity?: number;
    exitYOffset?: number;
    once?: boolean;
    debug?: boolean;
    /** Anima los hijos directos del slot en cascada en vez del bloque completo. */
    stagger?: boolean;
    /** Intervalo en segundos entre cada hijo cuando `stagger` está activo. */
    staggerAmount?: number;
}

const {
    delay = 0,
    class: className = "",
    yOffset = 50,
    exitScale = 0.9,
    exitOpacity = 0.2,
    exitYOffset = 120,
    once = false,
    debug = false,
    stagger = false,
    staggerAmount = 0.08,
} = Astro.props;
---

<section
    class:list={["scroll-reveal", className]}
    data-scroll-reveal
    data-delay={delay}
    data-y-offset={yOffset}
    data-exit-scale={exitScale}
    data-exit-opacity={exitOpacity}
    data-exit-y-offset={exitYOffset}
    data-once={String(once)}
    data-debug={String(debug)}
    data-stagger={String(stagger)}
    data-stagger-amount={staggerAmount}
>
    <div class="scroll-reveal__content" data-scroll-reveal-content>
        <slot />
    </div>
</section>

<script>
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    type RevealRoot = HTMLElement & {
        __scrollRevealContext?: gsap.Context;
    };

    function readNumber(
        element: HTMLElement,
        key: string,
        fallback: number,
    ): number {
        const value = Number(element.dataset[key]);

        return Number.isFinite(value) ? value : fallback;
    }

    function destroyScrollReveals(): void {
        document
            .querySelectorAll<RevealRoot>("[data-scroll-reveal]")
            .forEach((root) => {
                root.__scrollRevealContext?.revert();
                delete root.__scrollRevealContext;
            });
    }

    function initScrollReveals(): void {
        document
            .querySelectorAll<RevealRoot>("[data-scroll-reveal]")
            .forEach((root) => {
                root.__scrollRevealContext?.revert();

                const content = root.querySelector<HTMLElement>(
                    "[data-scroll-reveal-content]",
                );

                if (!content) return;

                const delay = readNumber(root, "delay", 0);
                const yOffset = readNumber(root, "yOffset", 50);

                const exitScale = readNumber(root, "exitScale", 0.9);

                const exitOpacity = readNumber(root, "exitOpacity", 0.2);

                const exitYOffset = readNumber(root, "exitYOffset", 120);

                const once = root.dataset.once === "true";
                const markers = root.dataset.debug === "true";
                const staggerEnabled = root.dataset.stagger === "true";
                const staggerAmount = readNumber(root, "staggerAmount", 0.08);

                root.__scrollRevealContext = gsap.context(() => {
                    const reduceMotion = window.matchMedia(
                        "(prefers-reduced-motion: reduce)",
                    ).matches;

                    const revealTargets =
                        staggerEnabled && content.children.length > 0
                            ? Array.from(content.children)
                            : [content];

                    if (reduceMotion) {
                        gsap.set(root, {
                            clearProps: "transform,opacity,visibility",
                        });

                        gsap.set(revealTargets, {
                            clearProps: "transform,opacity,visibility",
                            autoAlpha: 1,
                        });

                        return;
                    }

                    /*
                     * Animación de entrada.
                     *
                     * Equivale a:
                     * initial={{ opacity: 0, y: yOffset }}
                     * whileInView={{ opacity: 1, y: 0 }}
                     *
                     * Con `stagger` activo, cada hijo directo del slot
                     * entra en cascada en vez del bloque completo.
                     */
                    gsap.fromTo(
                        revealTargets,
                        {
                            autoAlpha: 0,
                            y: yOffset,
                        },
                        {
                            autoAlpha: 1,
                            y: 0,
                            duration: 0.9,
                            delay,
                            stagger: staggerEnabled ? staggerAmount : 0,
                            ease: [0.21, 0.47, 0.32, 0.98], // Premium ease-out curve (exacto a Framer Motion)

                            scrollTrigger: {
                                trigger: root,

                                // Se activa cuando el elemento entra
                                // aproximadamente un 10% al viewport.
                                start: "top 90%",

                                toggleActions: once
                                    ? "play none none none"
                                    : "play reverse play reverse",

                                markers,
                            },
                        },
                    );

                    /*
                     * Animación de salida.
                     *
                     * Equivale a useScroll + useTransform.
                     */
                    gsap.fromTo(
                        root,
                        {
                            scale: 1,
                            autoAlpha: 1,
                            y: 0,
                            transformOrigin: "top center",
                        },
                        {
                            scale: exitScale,
                            autoAlpha: exitOpacity,
                            y: exitYOffset,
                            ease: "none",

                            scrollTrigger: {
                                trigger: root,

                                // Comienza cuando el inicio de la sección
                                // toca la parte superior del viewport.
                                start: "top top",

                                // Termina cuando toda la sección
                                // abandona el viewport por arriba.
                                end: "bottom top",

                                // Vincula la animación al progreso del scroll.
                                // scrub: 1 hace el efecto más suave, similar a Framer Motion
                                scrub: 1,

                                invalidateOnRefresh: true,
                                markers,
                            },
                        },
                    );
                }, root);
            });

        ScrollTrigger.refresh();
    }

    initScrollReveals();

    /*
     * Permite que las animaciones funcionen correctamente
     * cuando Astro utiliza View Transitions.
     */
    document.addEventListener("astro:page-load", initScrollReveals);

    document.addEventListener("astro:before-swap", destroyScrollReveals);
</script>

<style>
    .scroll-reveal {
        position: relative;
        transform-origin: top center;
        will-change: transform, opacity;
    }

    .scroll-reveal__content {
        will-change: transform, opacity;
    }
</style>
