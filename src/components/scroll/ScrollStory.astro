---
interface ScrollStoryCover {
  background: string;
  alt?: string;
  eyebrow?: string;
  title: string;
  description?: string;
  scrollLabel?: string;
  textColor?: string;
  titleColor?: string;
  descriptionColor?: string;
  eyebrowColor?: string;
  scrollLabelColor?: string;
}

interface ScrollStoryIntro {
  background: string;
  alt?: string;
  number?: string;
  eyebrow?: string;
  title: string;
  description: string;
  /** Chip de texto corto (p.ej. "Research"). Alternativa a los icon presets cuando no encajan con el dominio. */
  badge?: string;
  eyebrowColor?: string;
  titleColor?: string;
  descriptionColor?: string;
}

type StoryIcon = "airport" | "road" | "building" | "services" | "report" | "segments" | "funnel" | "chart" | "database" | "presentation";

const BUILT_IN_ICONS: readonly string[] = [
  "airport",
  "road",
  "building",
  "services",
  "report",
  "segments",
  "funnel",
  "chart",
  "database",
  "presentation",
];

interface ScrollStoryItem {
  background: string;
  alt?: string;
  eyebrow?: string;
  title: string;
  description: string;
  /** Uno de los íconos predefinidos, o markup SVG crudo (viewBox 0 0 24 24, sin stroke/fill inline). */
  icon?: StoryIcon | string;
  /** Chip de texto corto (p.ej. "Intelligence"). Alternativa a icon cuando no encaja con el dominio. */
  badge?: string;
  eyebrowColor?: string;
  titleColor?: string;
  descriptionColor?: string;
}

interface Props {
  cover: ScrollStoryCover;
  intro: ScrollStoryIntro;
  items: ScrollStoryItem[];
  class?: string;
  scrub?: number;
  sceneDistance?: number;
  introCardWidth?: number;
  introCardHeight?: number;
  sideCardWidth?: number;
  sideCardHeight?: number;

  /** Colores generales de la tarjeta (intro + items). */
  cardBackground?: string;
  cardTextColor?: string;
  cardMutedColor?: string;
}

const {
  cover,
  intro,
  items,
  class: className = "",
  scrub = 0.85,
  sceneDistance = 1,
  introCardWidth = 0.98,
  introCardHeight = 0.6,
  sideCardWidth = 0.48,
  sideCardHeight = 0.82,
  cardBackground = "var(--color-secondary-deep, #061c2b)",
  cardTextColor = "var(--color-text-light, #fff)",
  cardMutedColor = "rgba(255, 255, 255, 0.7)",
} = Astro.props;

const totalItems = items.length;

/*
 * .scroll-story__intro-heading h2 usa una tipografía de display muy
 * grande (hasta 7.5rem) pensada para frases cortas de impacto. Cuando
 * intro.title es una oración larga, ese tamaño desborda verticalmente
 * la tarjeta (recortada por overflow:hidden) y solo se alcanza a ver
 * un fragmento. Reducimos el tamaño según el largo del texto para que
 * siempre entre completo, sin tocar el tratamiento grande de los
 * títulos cortos ya usados en otras páginas.
 */
const introTitleLength = intro.title?.length ?? 0;
const introTitleFontSize =
  introTitleLength > 70
    ? "clamp(1.3rem, 2.4vw, 2.3rem)"
    : introTitleLength > 45
      ? "clamp(1.7rem, 3.2vw, 3.2rem)"
      : undefined;
const introTitleLineHeight = introTitleFontSize ? "1.15" : undefined;
---

<section
  class:list={["scroll-story", className]}
  data-scroll-story
  data-header-theme="dark"
  data-scrub={scrub}
  data-scene-distance={sceneDistance}
  data-intro-card-width={introCardWidth}
  data-intro-card-height={introCardHeight}
  data-side-card-width={sideCardWidth}
  data-side-card-height={sideCardHeight}
  style={`--story-card-bg:${cardBackground};--story-card-color:${cardTextColor};--story-card-muted:${cardMutedColor};--story-cover-color:${cover.textColor ?? "#fff"};--story-cover-title-color:${cover.titleColor ?? cover.textColor ?? "#fff"};--story-cover-description-color:${cover.descriptionColor ?? cover.textColor ?? "#fff"};--story-cover-eyebrow-color:${cover.eyebrowColor ?? cover.textColor ?? "#fff"};--story-cover-scroll-label-color:${cover.scrollLabelColor ?? cover.textColor ?? "#fff"};--story-intro-eyebrow-color:${intro.eyebrowColor ?? cardTextColor};--story-intro-title-color:${intro.titleColor ?? cardTextColor};--story-intro-description-color:${intro.descriptionColor ?? cardMutedColor};`}
>
  <div class="scroll-story__stage" data-story-stage>
    <div class="scroll-story__backgrounds">
      <figure class="scroll-story__background" data-story-background>
        <img src={cover.background} alt={cover.alt ?? ""} loading="eager" />

        <div class="scroll-story__image-overlay"></div>

        <div class="scroll-story__cover-content">
          {
            cover.eyebrow && (
              <span
                class="scroll-story__eyebrow"
                style={`color:${cover.eyebrowColor ?? cover.textColor ?? "inherit"};`}
              >
                {cover.eyebrow}
              </span>
            )
          }

          <h2>{cover.title}</h2>

          {cover.description && <p>{cover.description}</p>}

          <div
            class="scroll-story__scroll-message"
            style={`color:${cover.scrollLabelColor ?? cover.textColor ?? "inherit"};`}
          >
            <span>{cover.scrollLabel ?? "Desliza para explorar"}</span>
            <span class="scroll-story__scroll-line"></span>
          </div>
        </div>
      </figure>

      <figure class="scroll-story__background" data-story-background>
        <img src={intro.background} alt={intro.alt ?? ""} loading="eager" />

        <div class="scroll-story__image-overlay"></div>
      </figure>

      {
        items.map((item) => (
          <figure class="scroll-story__background" data-story-background>
            <img src={item.background} alt={item.alt ?? ""} loading="lazy" />

            <div class="scroll-story__image-overlay" />
          </figure>
        ))
      }
    </div>

    <article class="scroll-story__card" data-story-card>
      <div class="scroll-story__card-shape">
        <section
          class:list={[
            "scroll-story__card-panel",
            "scroll-story__card-panel--intro",
          ]}
          data-story-panel
        >
          <div class="scroll-story__intro-number">
            {intro.number ?? "01"}
          </div>

          <div class="scroll-story__intro-heading">
            {
              intro.badge && (
                <span class="scroll-story__badge">{intro.badge}</span>
              )
            }

            {
              intro.eyebrow && (
                <span
                  class="scroll-story__card-eyebrow"
                  style={`color:${intro.eyebrowColor ?? cardTextColor};`}
                >
                  {intro.eyebrow}
                </span>
              )
            }

            <h2
              style={`color:${intro.titleColor ?? cardTextColor};${introTitleFontSize ? `font-size:${introTitleFontSize};` : ""}${introTitleLineHeight ? `line-height:${introTitleLineHeight};` : ""}`}
            >
              {intro.title}
            </h2>
          </div>

          <div class="scroll-story__intro-description">
            <p style={`color:${intro.descriptionColor ?? cardMutedColor};`}>{intro.description}</p>
          </div>

          <div class="scroll-story__intro-footer">
            <span>01</span>
            <div class="scroll-story__intro-footer-line"></div>
            <span>Continúa</span>
          </div>
        </section>

        {
          items.map((item, index) => (
            <section
              class:list={[
                "scroll-story__card-panel",
                "scroll-story__card-panel--item",
              ]}
              data-story-panel
            >
              <header class="scroll-story__item-header">
                <span class="scroll-story__item-number">
                  {String(index + 1).padStart(2, "0")}
                </span>

                <div>
                  {item.badge && (
                    <span class="scroll-story__badge">{item.badge}</span>
                  )}

                  {item.eyebrow && (
                    <span
                      class="scroll-story__card-eyebrow"
                      style={`color:${item.eyebrowColor ?? cardTextColor};`}
                    >
                      {item.eyebrow}
                    </span>
                  )}

                  <h2 style={`color:${item.titleColor ?? cardTextColor};`}>{item.title}</h2>
                </div>
              </header>

              <div class="scroll-story__item-visual">
                {item.icon === "airport" && (
                  <svg viewBox="0 0 220 220" aria-hidden="true">
                    <path d="M110 25 L121 93 L184 111 L184 123 L121 115 L121 166 L148 181 L148 191 L110 181 L72 191 L72 181 L99 166 L99 115 L36 123 L36 111 L99 93 Z" />
                  </svg>
                )}

                {item.icon === "road" && (
                  <svg viewBox="0 0 220 220" aria-hidden="true">
                    <path d="M62 184 C66 139 76 91 102 36 L118 36 C144 91 154 139 158 184" />
                    <path d="M110 49 V74" />
                    <path d="M110 91 V119" />
                    <path d="M110 137 V169" />
                  </svg>
                )}

                {item.icon === "building" && (
                  <svg viewBox="0 0 220 220" aria-hidden="true">
                    <path d="M54 183 V65 H104 V42 H166 V183 Z" />
                    <path d="M72 86 H88" />
                    <path d="M72 108 H88" />
                    <path d="M72 130 H88" />
                    <path d="M72 152 H88" />
                    <path d="M122 65 H145" />
                    <path d="M122 89 H145" />
                    <path d="M122 113 H145" />
                    <path d="M122 137 H145" />
                  </svg>
                )}

                {item.icon === "services" && (
                  <svg viewBox="0 0 220 220" aria-hidden="true">
                    <circle cx="110" cy="110" r="66" />
                    <path d="M110 59 V110 L145 132" />
                    <path d="M77 76 L64 63" />
                    <path d="M143 76 L156 63" />
                    <path d="M77 144 L64 157" />
                    <path d="M143 144 L156 157" />
                  </svg>
                )}

                {item.icon === "report" && (
                  <svg viewBox="0 0 220 220" aria-hidden="true">
                    <rect x="55" y="40" width="110" height="140" rx="4" />
                    <path d="M75 70 H145" />
                    <path d="M75 95 H145" />
                    <path d="M75 120 H145" />
                    <path d="M75 145 H115" />
                    <circle cx="160" cy="150" r="18" />
                    <path d="M152 150 L158 156 L168 144" />
                  </svg>
                )}

                {item.icon === "segments" && (
                  <svg viewBox="0 0 220 220" aria-hidden="true">
                    <circle cx="110" cy="110" r="55" />
                    <path d="M110 55 V165" />
                    <path d="M55 110 H165" />
                    <circle cx="85" cy="85" r="8" />
                    <circle cx="135" cy="85" r="8" />
                    <circle cx="85" cy="135" r="8" />
                    <circle cx="135" cy="135" r="8" />
                  </svg>
                )}

                {item.icon === "funnel" && (
                  <svg viewBox="0 0 220 220" aria-hidden="true">
                    <path d="M40 50 L180 50 L125 110 L125 170 L95 170 L95 110 Z" />
                    <path d="M55 65 L165 65" />
                    <path d="M70 80 L150 80" />
                  </svg>
                )}

                {item.icon === "chart" && (
                  <svg viewBox="0 0 220 220" aria-hidden="true">
                    <rect x="45" y="100" width="25" height="75" />
                    <rect x="82" y="70" width="25" height="105" />
                    <rect x="119" y="50" width="25" height="125" />
                    <rect x="156" y="85" width="25" height="90" />
                    <line x1="40" y1="185" x2="185" y2="185" />
                  </svg>
                )}

                {item.icon === "database" && (
                  <svg viewBox="0 0 220 220" aria-hidden="true">
                    <ellipse cx="110" cy="55" rx="50" ry="18" />
                    <path d="M60 55 V95 C60 105 160 105 160 95 V55" />
                    <path d="M60 95 V135 C60 145 160 145 160 135 V95" />
                    <path d="M60 135 V165 C60 175 160 175 160 165 V135" />
                    <path d="M75 80 H145" />
                    <path d="M75 120 H145" />
                    <path d="M75 150 H145" />
                  </svg>
                )}

                {item.icon === "presentation" && (
                  <svg viewBox="0 0 220 220" aria-hidden="true">
                    <rect x="50" y="45" width="120" height="85" rx="4" />
                    <rect x="65" y="60" width="90" height="55" />
                    <path d="M110 130 V160" />
                    <path d="M80 160 H140" />
                    <path d="M80 175 L95 160" />
                    <path d="M140 175 L125 160" />
                  </svg>
                )}

                {item.icon && !BUILT_IN_ICONS.includes(item.icon) && (
                  <div
                    class="scroll-story__custom-icon"
                    aria-hidden="true"
                    set:html={item.icon}
                  />
                )}

                {!item.icon && (
                  <div class="scroll-story__generic-visual">
                    <span />
                    <span />
                    <span />
                  </div>
                )}
              </div>

              <div class="scroll-story__item-description">
                <p style={`color:${item.descriptionColor ?? cardMutedColor};`}>{item.description}</p>
              </div>

              <footer class="scroll-story__item-footer">
                <div
                  class="scroll-story__progress"
                  style={`--items-count: ${totalItems};`}
                >
                  {items.map((_, progressIndex) => (
                    <span
                      class:list={{
                        "is-active": progressIndex === index,
                      }}
                    />
                  ))}
                </div>

                <div class="scroll-story__pagination">
                  <span>{index + 1}</span>
                  <span>/ {totalItems}</span>
                </div>
              </footer>
            </section>
          ))
        }
      </div>
    </article>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  type StoryRoot = HTMLElement & {
    __scrollStoryContext?: gsap.Context;
  };

  type StoryWindow = typeof window & {
    __scrollStoryEventsRegistered?: boolean;
  };

  function readNumber(
    element: HTMLElement,
    property: string,
    fallback: number,
  ): number {
    const value = Number(element.dataset[property]);
    return Number.isFinite(value) ? value : fallback;
  }

  function destroyScrollStories(): void {
    document
      .querySelectorAll<StoryRoot>("[data-scroll-story]")
      .forEach((story) => {
        story.__scrollStoryContext?.revert();
        delete story.__scrollStoryContext;
      });
  }

  function initScrollStories(): void {
    document
      .querySelectorAll<StoryRoot>("[data-scroll-story]")
      .forEach((story) => {
        story.__scrollStoryContext?.revert();

        const stage = story.querySelector<HTMLElement>("[data-story-stage]");

        const card = story.querySelector<HTMLElement>("[data-story-card]");

        const backgrounds = gsap.utils.toArray<HTMLElement>(
          "[data-story-background]",
          story,
        );

        const panels = gsap.utils.toArray<HTMLElement>(
          "[data-story-panel]",
          story,
        );

        if (!stage || !card || backgrounds.length < 3 || panels.length < 2) {
          return;
        }

        const itemCount = panels.length - 1;

        const scrub = readNumber(story, "scrub", 0.85);
        const sceneDistance = readNumber(story, "sceneDistance", 1);
        const introCardWidth = readNumber(story, "introCardWidth", 0.98);
        const introCardHeight = readNumber(story, "introCardHeight", 0.6);
        const sideCardWidth = readNumber(story, "sideCardWidth", 0.48);
        const sideCardHeight = readNumber(story, "sideCardHeight", 0.82);

        const prefersReducedMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;

        story.__scrollStoryContext = gsap.context(() => {
          const getIntroLayout = () => {
            const viewportWidth = window.innerWidth;
            const viewportHeight = window.innerHeight;
            const width = viewportWidth * introCardWidth;

            return {
              left: (viewportWidth - width) / 2,
              bottom: viewportHeight * 0.025,
              width,
              height: viewportHeight * introCardHeight,
            };
          };

          const getSideLayout = () => {
            const viewportWidth = window.innerWidth;
            const viewportHeight = window.innerHeight;

            if (viewportWidth <= 560) {
              const width = viewportWidth * 0.92;

              return {
                left: (viewportWidth - width) / 2,
                bottom: viewportHeight * 0.02,
                width,
                height: viewportHeight * 0.62,
              };
            }

            if (viewportWidth <= 900) {
              const width = viewportWidth * 0.65;

              return {
                left: viewportWidth - width - viewportWidth * 0.025,
                bottom: viewportHeight * 0.03,
                width,
                height: viewportHeight * 0.78,
              };
            }

            const width = viewportWidth * sideCardWidth;

            return {
              left: viewportWidth - width - viewportWidth * 0.015,
              bottom: viewportHeight * 0.03,
              width,
              height: viewportHeight * sideCardHeight,
            };
          };

          backgrounds.forEach((background, index) => {
            gsap.set(background, {
              yPercent: index === 0 ? 0 : 100,
              zIndex: index + 1,
            });

            const image = background.querySelector("img");

            if (image) {
              /*
               * Deja siempre un margen de zoom (nunca llega a scale 1)
               * para que el parallax interno tenga espacio para
               * desplazar la imagen sin revelar bordes vacíos.
               */
              gsap.set(image, {
                scale: 1.06,
              });
            }
          });

          panels.forEach((panel, index) => {
            gsap.set(panel, {
              autoAlpha: index === 0 ? 1 : 0,
              yPercent: index === 0 ? 0 : 25,
            });
          });

          const introLayout = getIntroLayout();

          gsap.set(card, {
            left: introLayout.left,
            bottom: introLayout.bottom,
            width: introLayout.width,
            height: introLayout.height,
            yPercent: 125,
          });

          if (prefersReducedMotion) {
            const sideLayout = getSideLayout();

            backgrounds.forEach((background, index) => {
              gsap.set(background, {
                yPercent: index === backgrounds.length - 1 ? 0 : 100,
              });
            });

            gsap.set(card, {
              left: sideLayout.left,
              bottom: sideLayout.bottom,
              width: sideLayout.width,
              height: sideLayout.height,
              yPercent: 0,
            });

            panels.forEach((panel, index) => {
              gsap.set(panel, {
                autoAlpha: index === panels.length - 1 ? 1 : 0,
                yPercent: 0,
              });
            });

            return;
          }

          const transitionCount = 2 + itemCount;

          /*
           * Parallax interno: mientras una imagen de fondo está activa,
           * sigue desplazándose sutilmente con el scroll (en vez de
           * quedar estática), atado al mismo scrub que el resto de la
           * escena. Requiere el margen de zoom permanente (scale 1.05)
           * que se fija más abajo en cada tween de entrada.
           */
          backgrounds.forEach((background) => {
            const image = background.querySelector("img");

            if (!image) return;

            gsap.fromTo(
              image,
              { yPercent: -2.5 },
              {
                yPercent: 2.5,
                ease: "none",

                scrollTrigger: {
                  trigger: story,
                  start: "top top",
                  end: () =>
                    `+=${window.innerHeight * transitionCount * sceneDistance}`,
                  scrub: true,
                  invalidateOnRefresh: true,
                },
              },
            );
          });

          const timeline = gsap.timeline({
            defaults: {
              ease: "none",
            },

            scrollTrigger: {
              trigger: story,
              start: "top top",
              end: () =>
                `+=${window.innerHeight * transitionCount * sceneDistance}`,
              pin: stage,
              pinSpacing: true,
              scrub,
              anticipatePin: 1,
              invalidateOnRefresh: true,
              snap: {
                snapTo: "labels",
                delay: 0.05,
                duration: { min: 0.15, max: 0.4 },
                ease: "power1.out",
                inertia: false,
              },
            },
          });

          timeline.addLabel("scene-cover", 0);

          const introBackground = backgrounds[1];
          const introBackgroundImage = introBackground.querySelector("img");

          timeline.to(
            introBackground,
            {
              yPercent: 0,
              duration: 1,
            },
            "intro-background",
          );

          if (introBackgroundImage) {
            timeline.to(
              introBackgroundImage,
              {
                scale: 1.05,
                duration: 1,
              },
              "intro-background",
            );
          }

          timeline.to(
            card,
            {
              yPercent: 0,
              duration: 1,
              ease: "power2.out",
            },
            "intro-card",
          );

          timeline.addLabel("scene-intro");

          for (let itemIndex = 0; itemIndex < itemCount; itemIndex += 1) {
            const label = `story-item-${itemIndex}`;
            const currentBackground = backgrounds[itemIndex + 2];
            const currentBackgroundImage =
              currentBackground.querySelector("img");
            const previousPanel = panels[itemIndex];
            const currentPanel = panels[itemIndex + 1];

            timeline.to(
              currentBackground,
              {
                yPercent: 0,
                duration: 1,
              },
              label,
            );

            if (currentBackgroundImage) {
              timeline.to(
                currentBackgroundImage,
                {
                  scale: 1.05,
                  duration: 1,
                },
                label,
              );
            }

            if (itemIndex === 0) {
              timeline.to(
                card,
                {
                  left: () => getSideLayout().left,
                  bottom: () => getSideLayout().bottom,
                  width: () => getSideLayout().width,
                  height: () => getSideLayout().height,
                  duration: 0.68,
                  ease: "power2.inOut",
                },
                `${label}+=0.3`,
              );
            }

            timeline.to(
              previousPanel,
              {
                yPercent: -28,
                autoAlpha: 0,
                duration: 0.32,
                ease: "power2.in",
              },
              `${label}+=0.3`,
            );

            timeline.fromTo(
              currentPanel,
              {
                yPercent: 28,
                autoAlpha: 0,
              },
              {
                yPercent: 0,
                autoAlpha: 1,
                duration: 0.46,
                ease: "power2.out",
              },
              `${label}+=0.5`,
            );

            timeline.addLabel(`scene-item-${itemIndex}`);
          }
        }, story);
      });

    ScrollTrigger.refresh();
  }

  initScrollStories();

  const globalWindow = window as StoryWindow;

  if (!globalWindow.__scrollStoryEventsRegistered) {
    document.addEventListener("astro:page-load", initScrollStories);
    document.addEventListener("astro:before-swap", destroyScrollStories);
    globalWindow.__scrollStoryEventsRegistered = true;
  }

  if ("fonts" in document) {
    document.fonts.ready.then(() => {
      ScrollTrigger.refresh();
    });
  }
</script>

<style>
  .scroll-story {
    position: relative;
    width: 100%;
    min-height: 100svh;
    isolation: isolate;
    background: var(--color-secondary-deep, #061c2b);
    font-family: var(--font-body, inherit);
  }

  .scroll-story h1,
  .scroll-story h2 {
    font-family: var(--font-display, inherit);
  }

  .scroll-story__stage {
    position: relative;
    width: 100%;
    height: 100svh;
    overflow: hidden;
    background: var(--color-secondary-deep, #061c2b);
  }

  .scroll-story__backgrounds {
    position: absolute;
    inset: 0;
  }

  .scroll-story__background {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    overflow: hidden;
    transform: translateZ(0);
    will-change: transform;
  }

  .scroll-story__background img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    will-change: transform;
  }

  .scroll-story__image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(4, 7, 19, 0.34),
      rgba(4, 7, 19, 0.04) 58%,
      rgba(4, 7, 19, 0.1)
    );
  }

  .scroll-story__cover-content {
    position: absolute;
    z-index: 2;
    left: clamp(28px, 7vw, 120px);
    bottom: clamp(42px, 10vh, 120px);
    width: min(850px, 80vw);
    color: var(--story-cover-color);
  }

  .scroll-story__eyebrow,
  .scroll-story__card-eyebrow {
    display: block;
    margin-bottom: 22px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.7;
