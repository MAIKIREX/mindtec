---
export interface FaqSplitItem {
  question: string;
  answer: string;
}

interface Props {
  items: FaqSplitItem[];
  eyebrow?: string;
  title: string;
  class?: string;
  id?: string;
}

const { items, eyebrow, title, class: className = "", id } = Astro.props;
const instanceId = `faq-split-${Math.random().toString(36).slice(2, 8)}`;
---

<section id={id} class:list={["faq-split", className]} data-faq-split>
  <div class="faq-split__heading">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h2 class="faq-split__title">{title}</h2>
  </div>

  <div class="faq-split__panel">
    <div class="faq-split__display">
      <h3 class="faq-split__display-title" data-faq-display-title>
        {items[0]?.question}
      </h3>
      <p class="faq-split__display-desc" data-faq-display-desc>
        {items[0]?.answer}
      </p>
    </div>

    <div class="faq-split__list">
      {
        items.map((item, index) => {
          const answerId = `${instanceId}-answer-${index}`;
          return (
            <div class="faq-split__row">
              <button
                type="button"
                class:list={["faq-split__item", index === 0 && "is-active"]}
                data-faq-item
                data-question={item.question}
                data-answer={item.answer}
                aria-expanded={index === 0 ? "true" : "false"}
                aria-controls={answerId}
              >
                <span class="faq-split__icon" aria-hidden="true">+</span>
                <span class="faq-split__question">{item.question}</span>
              </button>
              <div
                class="faq-split__mobile-answer"
                id={answerId}
                data-faq-mobile-answer
                hidden={index !== 0}
              >
                <p>{item.answer}</p>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .faq-split {
    width: 100%;
    background: var(--color-secondary, #0b2b40);
    padding: 5rem 0;
  }

  .faq-split__heading {
    max-width: 900px;
    margin: 0 auto 3rem;
    padding: 0 clamp(1.25rem, 4vw, 3rem);
    text-align: center;
  }

  .faq-split__title {
    font-size: 2.2rem;
    line-height: 1.2;
    margin-top: 1rem;
    color: #fff;
  }

  .faq-split__panel {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 4vw, 3rem);
    gap: clamp(2rem, 5vw, 5rem);
  }

  .faq-split__display {
    background: var(--color-white, #fff);
    color: var(--color-text-dark, #0b2b40);
    padding: 3rem 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .faq-split__display-title {
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.25;
    margin: 0 0 1rem;
    letter-spacing: -0.01em;
  }

  .faq-split__display-desc {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text-muted, #64748b);
    margin: 0;
  }

  .faq-split__list {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .faq-split__row {
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }

  .faq-split__row:first-child .faq-split__item {
    padding-top: 0;
  }

  .faq-split__item {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.75rem 0;
    background: none;
    border: none;
    text-align: left;
    cursor: pointer;
    color: rgba(255, 255, 255, 0.45);
  }

  .faq-split__icon {
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    font-weight: 400;
    line-height: 1;
    color: inherit;
    transition: background 0.3s ease, color 0.3s ease;
  }

  .faq-split__question {
    font-size: 0.95rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    line-height: 1.35;
    transition: color 0.3s ease;
  }

  .faq-split__item.is-active {
    color: #fff;
  }

  .faq-split__item.is-active .faq-split__icon {
    background: var(--color-primary, #f26522);
    color: #fff;
  }

  .faq-split__item:hover .faq-split__question,
  .faq-split__item:focus-visible .faq-split__question {
    color: #fff;
  }

  .faq-split__mobile-answer {
    display: none;
  }

  @media (max-width: 900px) {
    .faq-split__panel {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .faq-split__display {
      display: none;
    }

    .faq-split__mobile-answer {
      display: block;
      padding: 0 0 1.5rem;
    }

    .faq-split__mobile-answer p {
      margin: 0;
      font-size: 0.95rem;
      line-height: 1.7;
      color: rgba(255, 255, 255, 0.75);
    }

    .faq-split__mobile-answer[hidden] {
      display: none;
    }
  }
</style>

<script>
  type FaqSplitElement = HTMLElement;

  function initFaqSplit(root: FaqSplitElement): void {
    const items = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-faq-item]"),
    );
    const displayTitle = root.querySelector<HTMLElement>(
      "[data-faq-display-title]",
    );
    const displayDesc = root.querySelector<HTMLElement>(
      "[data-faq-display-desc]",
    );

    function setActive(index: number): void {
      items.forEach((btn, i) => {
        const active = i === index;
        btn.classList.toggle("is-active", active);
        btn.setAttribute("aria-expanded", String(active));

        const mobileAnswer = btn
          .closest(".faq-split__row")
          ?.querySelector<HTMLElement>("[data-faq-mobile-answer]");
        if (mobileAnswer) mobileAnswer.hidden = !active;
      });

      const activeBtn = items[index];
      if (displayTitle && displayDesc && activeBtn) {
        displayTitle.textContent = activeBtn.dataset.question ?? "";
        displayDesc.textContent = activeBtn.dataset.answer ?? "";
      }
    }

    items.forEach((btn, i) => {
      btn.addEventListener("click", () => setActive(i));
    });
  }

  document
    .querySelectorAll<FaqSplitElement>("[data-faq-split]")
    .forEach(initFaqSplit);
</script>
