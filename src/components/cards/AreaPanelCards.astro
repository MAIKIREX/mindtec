---
export interface AreaPanelItem {
  /** Raw SVG markup (viewBox 0 0 256 256, stroke="currentColor"). */
  icon: string;
  title: string;
  /** Texto pequeño opcional debajo del título (ej. "(SICOES)"). */
  small?: string;
  /** Texto opcional que se revela en hover/focus, debajo del título. */
  description?: string;
  href?: string;
}

interface Props {
  items: AreaPanelItem[];
  class?: string;
  /** Tarjetas por fila en escritorio (>1100px). Por defecto 5. */
  columns?: number;
  theme?: "navy" | "orange";
  size?: "default" | "large";
}

const {
  items,
  class: className = "",
  columns = 5,
  theme = "navy",
  size = "default",
} = Astro.props;
---

<div
  class:list={["areas-grid", className]}
  style={`--apc-cols:${columns}; --apc-tablet-cols:${Math.min(columns, 3)};`}
>
  {items.map((item) => {
    const Tag = item.href ? "a" : "div";
    return (
      <Tag
        class:list={[
          "area-panel",
          `area-panel--${theme}`,
          `area-panel--${size}`,
          item.description && "area-panel--reveal",
        ]}
        href={item.href}
      >
        <span class="area-panel__top">
          <span class="area-panel__icon" aria-hidden="true" set:html={item.icon} />
          <span class="area-panel__title">
            {item.title}
            {item.small && <small>{item.small}</small>}
          </span>
        </span>
        {item.description && (
          <span class="area-panel__desc">{item.description}</span>
        )}
        <span class="area-panel__arrow" aria-hidden="true">→</span>
      </Tag>
    );
  })}
</div>

<style>
  .areas-grid {
    display: grid;
    grid-template-columns: repeat(var(--apc-cols, 5), minmax(0, 1fr));
    gap: 0.55rem;
    max-width: 1320px;
    margin: 0 auto;
    text-align: left;
  }

  .area-panel {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 290px;
    padding: 1.5rem 1.25rem;
    overflow: hidden;
    background: #082235;
    border: 1px solid rgba(141, 191, 221, 0.72);
    color: #fff;
    text-decoration: none;
    isolation: isolate;
    transition: transform 280ms cubic-bezier(0.16, 1, 0.3, 1), background-color 280ms cubic-bezier(0.16, 1, 0.3, 1), border-color 280ms cubic-bezier(0.16, 1, 0.3, 1), clip-path 550ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Variante con muesca que se rellena (clip-path -> rectángulo) y el
     bloque icono+título que sube para liberar espacio a la descripción. */
  .area-panel--reveal:nth-child(odd):hover,
  .area-panel--reveal:nth-child(odd):focus-visible {
    clip-path: polygon(0 0, 100% 0, 100% 31%, 100% 31%, 100% 69%, 100% 69%, 100% 100%, 0 100%);
  }

  .area-panel--reveal:nth-child(even):hover,
  .area-panel--reveal:nth-child(even):focus-visible {
    clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%, 0 69%, 0 69%, 0 31%, 0 31%);
  }

  .area-panel::after {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: linear-gradient(145deg, rgba(29, 82, 112, 0.42), transparent 55%);
    content: "";
    opacity: 0;
    transition: opacity 280ms ease;
  }

  .area-panel:nth-child(odd) {
    clip-path: polygon(0 0, 100% 0, 100% 31%, 88% 31%, 88% 69%, 100% 69%, 100% 100%, 0 100%);
  }

  .area-panel:nth-child(even) {
    clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%, 0 69%, 12% 69%, 12% 31%, 0 31%);
  }

  .area-panel:hover {
    transform: translateY(-6px);
    background: #0b2c43;
    border-color: var(--color-primary, #e7a548);
  }

  .area-panel:hover::after {
    opacity: 1;
  }

  .area-panel--large {
    height: clamp(320px, 32vw, 410px);
    padding: 2rem;
  }

  .area-panel--large .area-panel__top,
  .area-panel--large .area-panel__desc {
    inset: 2rem;
  }

  .area-panel--orange {
    background: var(--color-primary, #f26522);
    border-color: rgba(255, 255, 255, 0.5);
  }

  .area-panel--orange::after {
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.22), transparent 58%);
  }

  .area-panel--orange:hover {
    background: #d95519;
    border-color: #fff;
  }

  .area-panel--orange .area-panel__icon,
  .area-panel--orange:hover .area-panel__icon {
    border-color: rgba(255, 255, 255, 0.82);
    color: #fff;
  }

  .area-panel--orange .area-panel__desc,
  .area-panel--orange .area-panel__title small {
    color: rgba(255, 255, 255, 0.88);
  }

  .area-panel--orange .area-panel__arrow {
    color: #fff;
  }

  .area-panel:focus-visible {
    outline: 3px solid var(--color-primary, #e7a548);
    outline-offset: 4px;
  }

  .area-panel__top {
    position: absolute;
    inset: 1.5rem 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    opacity: 1;
    transform: translateY(0);
    transition: opacity 260ms ease, transform 380ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .area-panel--reveal:hover .area-panel__top,
  .area-panel--reveal:focus-visible .area-panel__top {
    opacity: 0;
    transform: translateY(-16px);
  }

  .area-panel__icon {
    display: grid;
    width: 76px;
    height: 76px;
    place-items: center;
    align-self: center;
    margin: auto 0;
    border: 1px solid rgba(168, 207, 232, 0.86);
    border-radius: 50%;
    color: #c5e3f3;
    transition: color 280ms ease, border-color 280ms ease, transform 280ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .area-panel:hover .area-panel__icon {
    border-color: var(--color-primary, #e7a548);
    color: var(--color-primary, #e7a548);
    transform: scale(1.06);
  }

  .area-panel__icon :global(svg) {
    width: 42px;
    height: 42px;
  }

  .area-panel__title {
    display: block;
    max-width: 14ch;
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.3vw, 1.2rem);
    font-weight: 700;
    line-height: 1.17;
    letter-spacing: -0.02em;
  }

  .area-panel__title small {
    display: block;
    margin-top: 0.15rem;
    color: rgba(255, 255, 255, 0.66);
    font-size: 0.78em;
    font-weight: 600;
    letter-spacing: 0;
  }

  .area-panel__desc {
    position: absolute;
    inset: 1.5rem 1.25rem;
    display: flex;
    align-items: center;
    padding-right: 1.5rem;
    font-size: 0.9rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.82);
    opacity: 0;
    pointer-events: none;
    transform: translateY(16px);
    transition: opacity 280ms ease 80ms, transform 380ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .area-panel--reveal:hover .area-panel__desc,
  .area-panel--reveal:focus-visible .area-panel__desc {
    opacity: 1;
    transform: translateY(0);
  }

  .area-panel__arrow {
    position: absolute;
    right: 1.2rem;
    bottom: 1.15rem;
    color: var(--color-primary, #e7a548);
    font-size: 1.3rem;
    line-height: 1;
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity 220ms ease, transform 280ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .area-panel:hover .area-panel__arrow,
  .area-panel:focus-visible .area-panel__arrow {
    opacity: 1;
    transform: translateX(0);
  }

  @media (max-width: 1100px) {
    .areas-grid {
      grid-template-columns: repeat(var(--apc-tablet-cols, 3), minmax(0, 1fr));
    }
  }

  @media (max-width: 700px) {
    .areas-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .area-panel,
    .area-panel:nth-child(odd),
    .area-panel:nth-child(even) {
      height: 235px;
      clip-path: none;
    }
  }

  @media (max-width: 460px) {
    .areas-grid {
      grid-template-columns: 1fr;
    }

    .area-panel {
      height: 205px;
    }

    .area-panel__icon {
      width: 64px;
      height: 64px;
    }

    .area-panel__icon :global(svg) {
      width: 35px;
      height: 35px;
    }
  }
</style>
