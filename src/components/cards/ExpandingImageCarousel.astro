---
export interface ExpandingCarouselItem {
  title: string;
  subtitle: string;
  description: string;
  image: string;
  alt: string;
  /** Video opcional (webm) que reemplaza la imagen estática, en loop y sin sonido. */
  video?: string;
}

interface Props {
  items: ExpandingCarouselItem[];
}

const { items } = Astro.props;
---

<div class="lab-carousel" data-lab-carousel>
  {items.map((item, index) => (
    <div class={`lab-carousel__item ${index === 0 ? 'lab-carousel__item--active' : ''}`} data-lab-item={index}>
      <div class="lab-carousel__image-container">
        {item.video ? (
          <video
            class="lab-carousel__image"
            src={item.video}
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
          />
        ) : (
          <img src={item.image} alt={item.alt} class="lab-carousel__image" loading="lazy" />
        )}
        <div class="lab-carousel__overlay"></div>
        <div class="lab-carousel__number">{String(index + 1).padStart(2, '0')}</div>
      </div>

      <div class="lab-carousel__content">
        <span class="lab-carousel__subtitle">{item.subtitle}</span>
        <h3 class="lab-carousel__title">{item.title}</h3>
        <p class="lab-carousel__description">{item.description}</p>
      </div>
    </div>
  ))}
</div>

<style>
  .lab-carousel {
    display: flex;
    gap: 1rem;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    height: 450px;
  }

  .lab-carousel__item {
    flex: 1;
    min-width: 80px;
    height: 100%;
    border-radius: 12px;
    overflow: hidden;
    position: relative;
    cursor: pointer;
    transition: flex 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    background: #f5f5f5;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .lab-carousel__item--active {
    flex: 3;
    min-width: 300px;
  }

  .lab-carousel__image-container {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .lab-carousel__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .lab-carousel__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(11, 43, 64, 0.95) 0%,
      rgba(11, 43, 64, 0.4) 50%,
      rgba(11, 43, 64, 0.2) 100%
    );
    transition: background 0.3s ease;
  }

  .lab-carousel__item:hover .lab-carousel__overlay {
    background: linear-gradient(
      to top,
      rgba(11, 43, 64, 0.98) 0%,
      rgba(11, 43, 64, 0.5) 50%,
      rgba(11, 43, 64, 0.25) 100%
    );
  }

  .lab-carousel__number {
    position: absolute;
    top: 1.5rem;
    left: 1.5rem;
    font-size: 2.5rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.9);
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
    z-index: 10;
    transition: all 0.5s ease;
  }

  .lab-carousel__item--active .lab-carousel__number {
    font-size: 1.25rem;
    opacity: 0.8;
  }

  .lab-carousel__content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 2rem;
    z-index: 10;
    color: white;
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.4s ease;
  }

  .lab-carousel__item--active .lab-carousel__content {
    opacity: 1;
    transform: translateY(0);
  }

  .lab-carousel__subtitle {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #f26522;
    margin-bottom: 0.5rem;
  }

  .lab-carousel__title {
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 0.75rem 0;
    color: white;
  }

  .lab-carousel__description {
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0;
    color: rgba(255, 255, 255, 0.85);
  }

  @media (max-width: 768px) {
    .lab-carousel {
      flex-direction: column;
      height: auto;
      gap: 0.75rem;
    }

    .lab-carousel__item {
      height: 200px;
      min-width: auto;
    }

    .lab-carousel__item--active {
      height: 320px;
      min-width: auto;
      flex: 1;
    }

    .lab-carousel__number {
      font-size: 1.75rem;
      top: 1rem;
      left: 1rem;
    }

    .lab-carousel__content {
      padding: 1.25rem;
    }

    .lab-carousel__title {
      font-size: 1.1rem;
    }

    .lab-carousel__description {
      font-size: 0.85rem;
    }
  }
</style>

<script>
  function initLabCarousel(): void {
    const carousel = document.querySelector('[data-lab-carousel]');
    if (!carousel) return;

    const items = carousel.querySelectorAll('[data-lab-item]');

    items.forEach((item) => {
      item.addEventListener('click', () => {
        // Remove active class from all items
        items.forEach(i => i.classList.remove('lab-carousel__item--active'));

        // Add active class to clicked item
        item.classList.add('lab-carousel__item--active');
      });
    });
  }

  // Initialize on load
  initLabCarousel();

  // Re-initialize on page navigation (Astro)
  document.addEventListener('astro:page-load', initLabCarousel);
</script>
