const { variant = 'catalogo' } = Astro.props;
const data = suites[variant] || suites.catalogo;
---

<section class="service-visual-suite" style={`--suite-accent: ${data.accent}`}>
  <div class="service-visual-suite__inner">
    <div class="service-visual-suite__media">
      <img src={data.image} alt={data.alt} loading="lazy" />
      <div class="suite-scan suite-scan--one"></div>
      <div class="suite-scan suite-scan--two"></div>
      <div class="suite-hotspot suite-hotspot--a"><span></span></div>
      <div class="suite-hotspot suite-hotspot--b"><span></span></div>
      <div class="suite-hotspot suite-hotspot--c"><span></span></div>
    </div>

    <div class="service-visual-suite__content">
      <span class="service-visual-suite__eyebrow">{data.eyebrow}</span>
      <h2>{data.title}</h2>
      <p>{data.intro}</p>

      <div class="suite-dashboard" aria-label="Indicadores visuales del servicio">
        {data.metrics.map((metric) => (
          <div class="suite-meter">
            <div>
              <span>{metric.label}</span>
              <strong>{metric.value}%</strong>
            </div>
            <i style={`--meter: ${metric.value}%`}></i>
          </div>
        ))}
      </div>

      <div class="suite-expander">
        {data.cards.map((card, index) => (
          <details open={index === 0}>
            <summary>
              <span>{String(index + 1).padStart(2, '0')}</span>
              {card.title}
            </summary>
            <p>{card.text}</p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .service-visual-suite {
    position: relative;
    padding: clamp(3rem, 6vw, 5rem) 0;
    background:
      radial-gradient(circle at 14% 18%, color-mix(in srgb, var(--suite-accent) 20%, transparent), transparent 30rem),
      linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    overflow: hidden;
  }

  .service-visual-suite::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(11, 43, 64, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(11, 43, 64, 0.045) 1px, transparent 1px);
    background-size: 42px 42px;
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    pointer-events: none;
  }

  .service-visual-suite__inner {
    position: relative;
    z-index: 1;
    width: min(1180px, calc(100% - 2rem));
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(360px, 0.95fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .service-visual-suite__media {
    position: relative;
    min-height: 430px;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 28px 70px rgba(11, 43, 64, 0.18);
    background: #0b2b40;
    isolation: isolate;
  }

  .service-visual-suite__media img {
    width: 100%;
    height: 100%;
    min-height: 430px;
    object-fit: cover;
    display: block;
    filter: saturate(1.02) contrast(1.02);
  }

  .service-visual-suite__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(7, 25, 39, 0.18), rgba(7, 25, 39, 0.02)),
      radial-gradient(circle at 74% 26%, color-mix(in srgb, var(--suite-accent) 16%, transparent), transparent 22rem);
    z-index: 1;
  }

  .suite-scan {
    position: absolute;
    z-index: 2;
    border: 1px solid color-mix(in srgb, var(--suite-accent) 80%, white 10%);
    box-shadow: 0 0 24px color-mix(in srgb, var(--suite-accent) 42%, transparent);
    pointer-events: none;
  }

  .suite-scan--one {
    width: 38%;
    height: 30%;
    left: 11%;
    top: 18%;
  }

  .suite-scan--two {
    width: 28%;
    height: 23%;
    right: 12%;
    bottom: 18%;
  }

  .suite-hotspot {
    position: absolute;
    z-index: 3;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--suite-accent);
    box-shadow: 0 0 0 9px color-mix(in srgb, var(--suite-accent) 18%, transparent);
  }

  .suite-hotspot span {
    position: absolute;
    inset: -12px;
    border: 1px solid color-mix(in srgb, var(--suite-accent) 70%, white 10%);
    border-radius: inherit;
    animation: suitePulse 2.4s ease-out infinite;
  }

  .suite-hotspot--a { left: 22%; top: 31%; }
  .suite-hotspot--b { right: 25%; top: 42%; }
  .suite-hotspot--c { left: 54%; bottom: 24%; }

  .service-visual-suite__eyebrow {
    display: inline-flex;
    margin-bottom: 0.85rem;
    color: var(--suite-accent);
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .service-visual-suite__content h2 {
    margin: 0 0 1rem;
    color: var(--color-secondary);
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 3rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .service-visual-suite__content > p {
    max-width: 62ch;
    margin: 0 0 1.75rem;
    color: var(--color-text-muted);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .suite-dashboard {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
    margin-bottom: 1rem;
  }

  .suite-meter {
    padding: 1rem;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.78);
    border: 1px solid rgba(11, 43, 64, 0.08);
    box-shadow: 0 12px 28px rgba(11, 43, 64, 0.07);
  }

  .suite-meter div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.65rem;
  }

  .suite-meter span {
    color: var(--color-secondary);
    font-family: var(--font-display);
    font-size: 0.86rem;
    font-weight: 800;
  }

  .suite-meter strong {
    color: var(--suite-accent);
    font-family: var(--font-display);
    font-variant-numeric: tabular-nums;
    font-size: 1rem;
  }

  .suite-meter i {
    display: block;
    height: 8px;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--suite-accent) var(--meter), rgba(11, 43, 64, 0.1) var(--meter));
  }

  .suite-expander {
    display: grid;
    gap: 0.7rem;
  }

  .suite-expander details {
    border-radius: 8px;
    background: #ffffff;
    border: 1px solid rgba(11, 43, 64, 0.08);
    overflow: hidden;
    transition: border-color 220ms ease, box-shadow 220ms ease, transform 220ms ease;
  }

  .suite-expander details:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--suite-accent) 38%, rgba(11, 43, 64, 0.08));
    box-shadow: 0 14px 32px rgba(11, 43, 64, 0.08);
  }

  .suite-expander summary {
    cursor: pointer;
    list-style: none;
    padding: 0.95rem 1rem;
    color: var(--color-secondary);
    font-family: var(--font-display);
    font-weight: 850;
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .suite-expander summary::-webkit-details-marker {
    display: none;
  }

  .suite-expander summary span {
    width: 34px;
    height: 34px;
    display: inline-grid;
    place-items: center;
    border-radius: 6px;
    background: color-mix(in srgb, var(--suite-accent) 14%, white);
    color: var(--suite-accent);
    font-size: 0.75rem;
    font-weight: 900;
  }

  .suite-expander details p {
    margin: 0;
    padding: 0 1rem 1rem 3.7rem;
    color: var(--color-text-muted);
    font-size: 0.94rem;
    line-height: 1.55;
  }

  @keyframes suitePulse {
    0% { transform: scale(0.78); opacity: 0.9; }
    100% { transform: scale(1.55); opacity: 0; }
  }

  @media (max-width: 980px) {
    .service-visual-suite__inner {
      grid-template-columns: 1fr;
    }
    .service-visual-suite__media,
    .service-visual-suite__media img {
      min-height: 340px;
    }
  }

  @media (max-width: 640px) {
    .suite-dashboard {
      grid-template-columns: 1fr;
    }
    .service-visual-suite__media,
    .service-visual-suite__media img {
      min-height: 260px;
    }
  }
</style>
