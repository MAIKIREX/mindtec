---
import ScrollStack from "../components/scroll/ScrollStack.astro";
import ScrollStackItem from "../components/scroll/ScrollStackItem.astro";

const scenes = [
    { number: "01", label: "Observación", title: "Lo que ocurre antes de elegir.", text: "Una escena se fija mientras la siguiente asciende por encima de ella.", tone: "sand" },
    { number: "02", label: "Evidencia", title: "Las señales empiezan a conectar.", text: "El fondo anterior se reduce, se desplaza y se oscurece para dar profundidad.", tone: "orange" },
    { number: "03", label: "Decisión", title: "La inteligencia se vuelve acción.", text: "La última escena queda libre para cerrar la secuencia de scroll.", tone: "blue" },
];
---

<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="description" content="Página de prueba del componente ScrollStack." />
        <title>Demo — ScrollStack</title>
    </head>
    <body>
        <header class="header"><a href="/">MINDTEC</a><span>Demo / ScrollStack</span></header>
        <main>
            <section class="intro">
                <span>Componente / ScrollStack</span>
                <h1>Escenas que se apilan con el scroll.</h1>
                <p>La siguiente sección asciende y cubre la anterior; la escena de fondo pierde escala y contraste de forma progresiva.</p>
            </section>

            <ScrollStack scale={0.92} overlayOpacity={0.52} exitYOffset={48} revealOffset={100} scrub={0.7}>
                {scenes.map((scene) => (
                    <ScrollStackItem contentClass={`scene scene--${scene.tone}`}>
                        <div class="scene__art" aria-hidden="true"><i></i><i></i><i></i></div>
                        <div class="scene__copy">
                            <span>{scene.number} / {scene.label}</span>
                            <h2>{scene.title}</h2>
                            <p>{scene.text}</p>
                        </div>
                    </ScrollStackItem>
                ))}
            </ScrollStack>

            <section class="outro"><span>Fin de la pila</span><h2>La página continúa normalmente.</h2></section>
        </main>
    </body>
</html>

<style is:global>
    :root { font-family: Inter, ui-sans-serif, system-ui, sans-serif; background: #071c2a; }
    * { box-sizing: border-box; }
    body { margin: 0; overflow-x: hidden; color: #f8f3ea; }
    .header { position: fixed; z-index: 20; top: 0; display: flex; justify-content: space-between; width: 100%; padding: 1.5rem clamp(1.25rem, 4vw, 4rem); mix-blend-mode: difference; color: white; font-size: .72rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; pointer-events: none; }
    .header a { color: inherit; text-decoration: none; pointer-events: auto; }
    .intro, .outro { min-height: 100svh; display: flex; flex-direction: column; justify-content: center; padding: clamp(2rem, 7vw, 8rem); }
    .intro { background: radial-gradient(circle at 75% 28%, #e5673a 0 10%, transparent 34%), #071c2a; }
    .intro > span, .outro > span, .scene__copy > span { font-size: .72rem; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
    .intro h1, .outro h2 { max-width: 1050px; margin: 1.5rem 0 2rem; font-size: clamp(3.4rem, 9vw, 9rem); line-height: .87; letter-spacing: -.08em; }
    .intro p { max-width: 620px; margin: 0; font-size: 1.1rem; line-height: 1.65; opacity: .72; }
    .scene { position: relative; display: grid; place-items: end start; height: 100%; padding: clamp(2rem, 7vw, 8rem); overflow: hidden; }
    .scene--sand { color: #122839; background: #e8dfce; }
    .scene--orange { background: #e5673a; }
    .scene--blue { background: #1a4c70; }
    .scene__copy { position: relative; z-index: 2; max-width: 900px; }
    .scene__copy h2 { margin: 1.25rem 0 1.5rem; font-size: clamp(3.2rem, 8vw, 8rem); line-height: .86; letter-spacing: -.075em; }
    .scene__copy p { max-width: 490px; margin: 0; font-size: 1.05rem; line-height: 1.6; }
    .scene__art { position: absolute; inset: 0; opacity: .75; }
    .scene__art i { position: absolute; display: block; border: 1px solid currentColor; border-radius: 50%; opacity: .25; }
    .scene__art i:nth-child(1) { width: min(70vw, 850px); aspect-ratio: 1; right: -12vw; top: -28vw; }
    .scene__art i:nth-child(2) { width: min(45vw, 520px); aspect-ratio: 1; right: 18vw; top: 22vh; }
    .scene__art i:nth-child(3) { width: 12px; height: 12px; right: 28vw; top: 45vh; background: currentColor; border: 0; opacity: .8; }
    .outro { color: #071c2a; background: #f8f3ea; }
    @media (max-width: 700px) { .header span { display: none; } .scene__art i:nth-child(1) { width: 135vw; right: -45vw; top: -15vw; } .scene__copy p { font-size: 1rem; } }
</style>
