---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Empresa de Investigación de Mercados en Bolivia | Mindtec"
  description="Rigor científico e inteligencia de datos para decisiones de negocio críticas. Estándares analíticos avanzados de mercado en Bolivia."
  headerLightBg={false}
>
  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "name": "Mindtec Bolivia",
        "url": "https://www.mindtecbolivia.com",
        "logo": "https://www.mindtecbolivia.com/logos/logo-mindtec-horizontal-para-fondo-oscuro.webp",
        "description": "Inteligencia de mercados con neurociencia e inteligencia artificial para la toma de decisiones estratégicas de alta dirección en Bolivia.",
        "email": "info@mindtecbolivia.com",
        "areaServed": ["La Paz", "Santa Cruz", "Cochabamba", "El Alto"],
        "address": { "@type": "PostalAddress", "addressCountry": "BO" },
        "foundingDate": "2014",
        "numberOfEmployees": { "@type": "QuantitativeValue", "value": 80 },
        "award": "Premio MAYA a la Innovación en Investigación de Mercados",
        "sameAs": [
          "https://www.facebook.com/mindtecbolivia",
          "https://www.instagram.com/mindtec_neuromarketing_bolivia/",
          "https://www.linkedin.com/company/mindtec-bolivia"
        ]
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {"@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://www.mindtecbolivia.com/"},
          {"@type": "ListItem", "position": 2, "name": "La Firma", "item": "https://www.mindtecbolivia.com/firma"}
        ]
      }
    ]
  }
  </script>
  <main class="elementor-content">
        <!-- SECCIÓN 1: Hero -->
        <section class="hero-section elementor-section" style="padding-bottom: 3rem; padding-top: 120px; min-height: auto;">

            <!-- Geometric floating shapes (always visible, CSS-animated) -->
            <div class="hero-shapes" aria-hidden="true">
                <div class="hero-shape"></div>
                <div class="hero-shape"></div>
                <div class="hero-shape"></div>
                <div class="hero-shape"></div>
                <div class="hero-shape"></div>
                <div class="hero-shape"></div>
                <div class="hero-shape"></div>
                <div class="hero-shape"></div>
                <div class="hero-shape"></div>
                <div class="hero-shape"></div>
                <div class="hero-shape"></div>
                <div class="hero-shape"></div>
                <div class="hero-shape"></div>
                <div class="hero-shape"></div>
                <div class="hero-shape"></div>
                <div class="hero-shape"></div>
                <div class="hero-shape"></div>
                <div class="hero-shape"></div>
                <div class="hero-shape"></div>
                <div class="hero-shape"></div>
                <div class="hero-shape"></div>
                <div class="hero-shape"></div>
                <div class="hero-shape"></div>
                <div class="hero-shape"></div>
                <div class="hero-shape"></div>
                <div class="hero-shape"></div>
                <div class="hero-shape"></div>
                <div class="hero-shape"></div>
                <div class="hero-shape"></div>
                <div class="hero-shape"></div>
                <div class="hero-shape"></div>
                <div class="hero-shape"></div>
                <div class="hero-shape"></div>
                <div class="hero-shape"></div>
                <div class="hero-shape"></div>
                <div class="hero-shape"></div>
                <div class="hero-shape"></div>
                <div class="hero-shape"></div>
                <div class="hero-shape"></div>
                <div class="hero-shape"></div>
            </div>
            <!-- Mobile-first neural canvas background -->
            <div class="hero-mobile-canvas" id="hero-mobile-canvas" aria-hidden="true"></div>
            <div class="container hero-container elementor-container e-con" style="display: block; text-align: center;">
                <div class="hero-content" style="max-width: 900px; margin: 0 auto;">
                    <span class="eyebrow fade-in">LA FIRMA QUE RESPALDA SU DECISIÓN</span>
                    <h1 class="hero-title" style="font-size: 3.5rem; line-height: 1.25; margin-bottom: 1.5rem;">Consultora de Investigación de Mercados en Bolivia</h1>
                    <p class="hero-subtitle" style="font-size: 1.25rem; margin-bottom: 2.5rem; max-width: 800px; margin-left: auto; margin-right: auto; line-height: 1.6;">Reduzca el riesgo en sus inversiones integrando neurociencia de consumo, inteligencia de datos y validación estratégica en el mercado boliviano.</p>
                </div>
            </div>
        </section>

        <!-- SECCIÓN 2: Quiénes somos -->
        <section class="elementor-section premium-section-padding bg-slate" style="padding: 5rem 0;">
            <div class="container elementor-container" style="max-width: 1100px;">
                <h2 class="text-navy text-center" style="font-size: 2.5rem; margin-bottom: 3rem;">El respaldo analítico detrás de su próxima decisión</h2>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 3rem; align-items: center;">
                    <div class="premium-card-white" style="text-align: left; padding: 3rem; font-size: 1.1rem; color: #4a5b6f; line-height: 1.8; margin-bottom: 0; box-shadow: var(--shadow-md); border-radius: var(--radius-md); background: #ffffff;">
                        <p style="margin-bottom: 1.5rem;">La sofisticación analítica que exigen las decisiones gerenciales críticas ya no requiere buscar fuera de Bolivia. Las corporaciones del país acceden a una metodología científica de nivel internacional, adaptada con precisión a la realidad de los canales de distribución locales.</p>
                        <p style="margin-bottom: 1.5rem;">Mediante la integración de psicólogos de consumo, analistas de datos y tecnología biométrica, es posible descifrar las verdaderas motivaciones y barreras de compra en el mercado boliviano, eliminando los sesgos comunes de la investigación tradicional.</p>
                        <p style="margin-bottom: 0;">Esta infraestructura de inteligencia de mercados está diseñada para respaldar a directorios de entidades financieras, multinacionales de consumo masivo, instituciones educativas de primer nivel y corporaciones en expansión regional.</p>
                    </div>
                    <div style="position: relative; width: 100%; border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-lg);">
                        <img src="/equipo-mindtec.webp" alt="Equipo de Consultores de Mindtec Bolivia" style="width: 100%; height: auto; object-fit: cover; display: block;" loading="lazy">
                    </div>
                </div>
            </div>
        </section>

        <!-- SECCIÓN 3: Estándares Operativos -->
        <section class="problem-section elementor-section bg-white" style="padding: 5rem 0; background-image: none;">
            <div class="container elementor-container">
                <div class="section-header text-center" style="margin-bottom: 4rem;">
                    <span class="eyebrow">ADN CORPORATIVO</span>
                    <h2 class="text-navy" style="font-size: 2.5rem;">Lo que puede esperar de Mindtec</h2>
                </div>

                <div class="problem-statement modern-quote" style="background: rgba(11, 43, 64, 0.03); border-left: 4px solid var(--color-secondary); text-align: left; margin-bottom: 4rem; max-width: 800px; margin-left: auto; margin-right: auto;">
                    <p style="color: #0b2b40;">La validez de un estudio reside en la solidez de su estructura. En lugar de ofrecer cuestionarios tácticos aislados, los proyectos se ejecutan bajo una <strong>metodología científica y estandarizada</strong>, diseñada específicamente para mitigar el riesgo en inversiones de gran escala.</p>
                </div>

                <div class="services-grid-modern">
                    <div class="service-card-v3">
                        <h4 style="color: var(--color-primary);">1. Confidencialidad Absoluta</h4>
                        <p style="margin-top: 0.5rem; font-size: 0.95rem; color: #4a5b6f;">Protocolos estrictos de resguardo sobre los próximos movimientos competitivos y debilidades de mercado detectadas.</p>
                    </div>
                    <div class="service-card-v3">
                        <h4 style="color: var(--color-primary);">2. Rigor en la Evidencia</h4>
                        <p style="margin-top: 0.5rem; font-size: 0.95rem; color: #4a5b6f;">Las decisiones críticas exigen bases sólidas. Cada conclusión estratégica cuenta con trazabilidad absoluta y respaldo matemático.</p>
                    </div>
                    <div class="service-card-v3">
                        <h4 style="color: var(--color-primary);">3. Validación en Campo Real</h4>
                        <p style="margin-top: 0.5rem; font-size: 0.95rem; color: #4a5b6f;">El análisis trasciende el escritorio. La auditoría directa en el punto de venta contrasta los modelos teóricos con la realidad comercial boliviana.</p>
                    </div>
                    <div class="service-card-v3">
                        <h4 style="color: var(--color-primary);">4. Entregables para la Acción</h4>
                        <p style="margin-top: 0.5rem; font-size: 0.95rem; color: #4a5b6f;">Hojas de ruta claras y tableros ejecutivos. Grandes volúmenes de información se sintetizan en conclusiones listas para la toma de decisiones.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECCIÓN 4: En cifras -->
        <section class="elementor-section premium-section-padding bg-navy" style="padding: 6rem 0; background-color: var(--color-secondary);">
            <div class="container elementor-container text-center">
                <h2 class="text-white" style="font-size: 2.5rem; margin-bottom: 4rem; color: white;">Alcance y Capacidad Operativa</h2>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 2rem;">
                    
                    <div style="border-right: 1px solid rgba(255,255,255,0.1); padding: 1rem;">
                        <div style="font-size: 3.5rem; font-weight: 900; color: var(--color-primary); line-height: 1; margin-bottom: 0.5rem;">80+</div>
                        <p style="color: rgba(255,255,255,0.8); font-size: 1.1rem; font-weight: 500;">Encuestadores activos en Bolivia</p>
                    </div>
                    
                    <div style="border-right: 1px solid rgba(255,255,255,0.1); padding: 1rem;">
                        <div style="font-size: 3.5rem; font-weight: 900; color: var(--color-primary); line-height: 1; margin-bottom: 0.5rem;">4+</div>
                        <p style="color: rgba(255,255,255,0.8); font-size: 1.1rem; font-weight: 500;">Ciudades con cobertura permanente</p>
                    </div>
                    
                    <div style="border-right: 1px solid rgba(255,255,255,0.1); padding: 1rem;">
                        <div style="font-size: 3.5rem; font-weight: 900; color: var(--color-primary); line-height: 1; margin-bottom: 0.5rem; text-transform: uppercase; font-size: 2.5rem; padding-top: 0.5rem; padding-bottom: 0.5rem;">1er</div>
                        <p style="color: rgba(255,255,255,0.8); font-size: 1.1rem; font-weight: 500;">Laboratorio de neuromarketing en el país</p>
                    </div>
                    
                    <div style="padding: 1rem;">
                        <div style="font-size: 3.5rem; font-weight: 900; color: var(--color-primary); line-height: 1; margin-bottom: 0.5rem;">9</div>
                        <p style="color: rgba(255,255,255,0.8); font-size: 1.1rem; font-weight: 500;">Años de experiencia</p>
                    </div>

                </div>
            </div>
        </section>

        <!-- SECCIÓN: Reconocimientos y Premios -->
        <section class="elementor-section premium-section-padding bg-white" style="padding: 6rem 0;">
            <div class="container elementor-container">
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 4rem; align-items: center;">
                    <div style="position: relative; width: 100%; border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-xl); order: 2;">
                        <img src="/premios-maya-mindtec.webp" alt="Mindtec recibiendo el Premio MAYA a la innovación en investigación de mercados" style="width: 100%; height: auto; object-fit: cover; display: block;" loading="lazy">
                        <div style="position: absolute; bottom: 0; left: 0; right: 0; background: linear-gradient(to top, rgba(11, 43, 64, 0.9), transparent); padding: 2rem 1.5rem 1rem 1.5rem; color: white;">
                            <span style="font-weight: 800; font-size: 1rem; letter-spacing: 2px; text-transform: uppercase; color: var(--color-primary);">Premio MAYA</span>
                            <p style="font-size: 0.85rem; color: rgba(255,255,255,0.8); margin: 4px 0 0 0; line-height: 1.4;">Galardón a la Innovación en Investigación de Mercados en Bolivia</p>
                        </div>
                    </div>
                    <div style="order: 1; text-align: left;">
                        <span class="eyebrow"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 256 256" fill="currentColor" style="margin-right: 4px; vertical-align: middle;"><path d="M128,16a88,88,0,0,0-80,88c0,27.52,11.23,54.89,31.62,77.06a8,8,0,0,1,2,6.59l-11.45,49A8,8,0,0,0,78,245.92l44.4-22.2,44.4,22.2a8,8,0,0,0,7.81-.76,8,8,0,0,0,3.77-7.23L167,189.28a8,8,0,0,1,2.05-6.59c20.39-22.17,31.62-49.54,31.62-77.06A88.1,88.1,0,0,0,128,16Zm40,88a40,40,0,1,1-40-40A40,40,0,0,1,168,104Z"/></svg> Logro Institucional</span>
                        <h2 class="text-navy" style="font-size: 2.5rem; margin-bottom: 1.75rem; line-height: 1.25;">Líderes de Innovación</h2>
                        <p style="font-size: 1.15rem; color: var(--color-primary); font-weight: 700; margin-bottom: 1.25rem;">La excelencia metodológica en el país cuenta con el aval oficial del Premio MAYA.</p>
                        <p style="color: #4a5b6f; font-size: 1.05rem; line-height: 1.8; margin-bottom: 1.5rem;">
                            Este galardón a la innovación reconoce la introducción sistemática de la neurociencia de consumo y la inteligencia de datos en el entorno corporativo boliviano, estableciendo nuevos estándares de confiabilidad para el sector.
                        </p>
                        <p style="color: #4a5b6f; font-size: 1.05rem; line-height: 1.8; margin-bottom: 0;">
                            El uso coordinado de herramientas biométricas avanzadas (EEG, eye-tracking) y análisis predictivos por IA permite a los directorios y comités ejecutivos comprender el comportamiento real de sus consumidores sin depender de aproximaciones teóricas. Este estándar metodológico asegura el máximo rigor científico en cada estudio estratégico.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECCIÓN 5: Equipo Directivo -->
        <section class="elementor-section premium-section-padding bg-slate" style="padding: 6rem 0;">
            <div class="container elementor-container text-center">
                <h2 class="text-navy" style="font-size: 2.5rem; margin-bottom: 4rem;">El Equipo Directivo</h2>
                
                <!-- Wilmar: insertar aquí datos reales del equipo directivo -->
                <div style="display: flex; justify-content: center; gap: 3rem; flex-wrap: wrap;">
                    
                    <!-- Director 1 -->
                    <div class="premium-card-white" style="flex: 1; min-width: 250px; max-width: 350px; padding: 3rem 2rem;">
                        <div style="width: 100px; height: 100px; background-color: var(--color-primary); border-radius: 50%; margin: 0 auto 1.5rem auto; display: flex; align-items: center; justify-content: center; color: white; font-size: 2.5rem; font-weight: 700;">WV</div>
                        <h3 style="color: var(--color-secondary); font-size: 1.3rem; margin-bottom: 0.2rem;">Ing. Wilmar Velásquez Z.</h3>
                        <p style="color: var(--color-primary); font-weight: 600; font-size: 0.95rem; margin-bottom: 1rem; text-transform: uppercase; letter-spacing: 1px;">CEO</p>
                        <p style="color: #64748b; font-size: 0.95rem; line-height: 1.6;">Especialista en análisis de datos, inteligencia artificial aplicada y comunicación no verbal. Dirige el laboratorio de neuromarketing de MindTEC.</p>
                    </div>

                    <!-- Director 2 -->
                    <div class="premium-card-white" style="flex: 1; min-width: 250px; max-width: 350px; padding: 3rem 2rem;">
                        <div style="width: 100px; height: 100px; background-color: var(--color-secondary); border-radius: 50%; margin: 0 auto 1.5rem auto; display: flex; align-items: center; justify-content: center; color: white; font-size: 2.5rem; font-weight: 700;">PP</div>
                        <h3 style="color: var(--color-secondary); font-size: 1.3rem; margin-bottom: 0.2rem;">MSc. Paola Paniagua U.</h3>
                        <p style="color: var(--color-primary); font-weight: 600; font-size: 0.95rem; margin-bottom: 1rem; text-transform: uppercase; letter-spacing: 1px;">Directora de Investigación</p>
                        <p style="color: #64748b; font-size: 0.95rem; line-height: 1.6;">Psicóloga. Máster en Ciencias Forenses y Jurídicas. Especialista en comportamiento del consumidor e investigación profunda.</p>
                    </div>

                </div>
            </div>
        </section>

        <!-- SECCIÓN 6: Para quién NO es esta consultoría -->
        <section class="offer-section elementor-section" style="background-color: #fcfcfc; padding: 6rem 0;">
            <div class="container elementor-container">
                <div class="offer-box-modern" style="padding: 4rem; text-align: center;">
                    <div class="offer-header">
                        <span class="eyebrow-light" style="color: rgba(255,255,255,0.6);">TRANSPARENCIA COMERCIAL</span>
                        <h2 style="color: #fff;">Esta consultoría no es para todos</h2>
                    </div>

                    <ul style="max-width: 800px; margin: 3rem auto 0; text-align: left; line-height: 1.8; font-size: 1.1rem; color: #f1f5f9; list-style: none;">
                        <li style="margin-bottom: 1.5rem; padding-left: 1.5rem; position: relative;"><span style="position: absolute; left: 0; color: #fc8181; font-weight: bold;">✕</span> <strong>Mindtec no es</strong> para empresas que buscan reportes académicos, teóricos y descriptivos de docenas de páginas sin ninguna conclusión ejecutable.</li>
                        <li style="margin-bottom: 1.5rem; padding-left: 1.5rem; position: relative;"><span style="position: absolute; left: 0; color: #fc8181; font-weight: bold;">✕</span> <strong>Mindtec no es</strong> para directivos que prefieren ignorar los datos que contradicen su intuición inicial y evitan enfrentar la realidad del mercado.</li>
                        <li style="margin-bottom: 1.5rem; padding-left: 1.5rem; position: relative;"><span style="position: absolute; left: 0; color: #fc8181; font-weight: bold;">✕</span> <strong>Mindtec no es</strong> una agencia de marketing digital operativa. Es una firma de validación estratégica previa a la asignación de capital comercial.</li>
                    </ul>
                </div>
            </div>
        </section>

        <!-- SECCIÓN 7: Final CTA -->
        <section class="cta-section-modern elementor-section" style="padding: 6rem 0;">
            <div class="container elementor-container glass-container" style="max-width: 900px; margin: 0 auto; text-align: center;">
                <div class="cta-content-v2">
                    <h2 style="font-size: 2.8rem; line-height: 1.25; margin-bottom: 1.5rem;">Si su empresa necesita ver lo que la competencia no ve, este es el punto de partida.</h2>
                    <p class="cta-subtitle">Agende una conversación inicial con el equipo senior de Mindtec. 45 minutos, directo al punto.</p>
                    <div class="cta-actions" style="margin-top: 2.5rem;">
                        <a href="/contacto" class="btn btn-primary lg" style="font-size: 1.1rem; padding: 1rem 2.5rem;">Agendar sesión de diagnóstico (45 min) →</a>
                    </div>
                </div>
            </div>
        </section>
    
        <section class="elementor-section bg-slate" style="padding: 4rem 0; text-align: center; border-top: 1px solid #eee;">
            <div class="container">
                <h3 class="text-navy" style="margin-bottom: 1.5rem;">Los pilares de la firma</h3>
                <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
                    <a href="/metodologia" class="btn btn-navy-outline" style="padding: 10px 20px;">Ver rigor metodológico</a>
                    <a href="/servicios" class="btn btn-outline" style="padding: 10px 20px;">Explorar soluciones por directorio</a>
                </div>
            </div>
        </section>

        <!-- BREADCRUMB -->
        <nav aria-label="Breadcrumb" class="breadcrumb-bottom">
          <div class="container">
            <ol>
              <li><a href="/" style="color: rgba(255,255,255,0.6); text-decoration: none;">Inicio</a></li>
              <li style="color: rgba(255,255,255,0.3);">›</li>
              <li aria-current="page" style="color: #fff; font-weight: 600;">La Firma</li>
            </ol>
          </div>
        </nav>
    </main>
</Layout>
