    before: 'Muestra diseñada genéricamente por ciudad',
    after: 'Diseño muestral estratificado que refleja la diversidad cultural y económica del mercado boliviano real',
  },
  {
    before: 'Solo método presencial o solo online',
    after: 'Metodología mixta (presencial + CATI + CAWI) según el perfil del segmento objetivo',
  },
  {
    before: 'Cuestionario estándar aplicado igual en todo el país',
    after: 'Cuestionarios adaptados por región para capturar diferencias culturales entre Santa Cruz, La Paz y el interior',
  },
  {
    before: 'Datos declarativos puros (lo que la gente dice)',
    after: 'Validación cruzada con biometría y datos observacionales cuando la intención declarada no basta',
  },
];

const processSteps = [
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>`,
    title: "Diagnóstico y diseño metodológico",
    small: "45 min · sin costo",
    description: "45 min para definir el objetivo de investigación, el universo, la muestra óptima, el método de recolección y las variables clave. Le entregamos el plan metodológico antes de iniciar.",
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>`,
    title: "Diseño del instrumento",
    small: "3–5 días hábiles",
    description: "Construcción del cuestionario con técnicas de psicología del cuestionario para minimizar sesgos de respuesta. Piloto de campo para validar tiempos y comprensión antes del despliegue masivo.",
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1" ry="1"/></svg>`,
    title: "Recolección y control de calidad",
    small: "2–5 semanas en campo",
    description: "Despliegue de la red de encuestadores con supervisión en tiempo real, georreferenciación y revisión lógica de cuestionarios. Tasa de rechazo y sustitución controlada para garantizar representatividad.",
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/><line x1="2" y1="20" x2="22" y2="20"/></svg>`,
    title: "Análisis y presentación",
    small: "5–7 días post-campo",
    description: "Procesamiento estadístico, análisis multivariado donde aplica y síntesis ejecutiva con recomendaciones priorizadas. Presentación ante el equipo directivo con sesión de preguntas.",
  },
];

const sectorItems = [
  {
    icon: `<svg viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="15" stroke-linecap="round" stroke-linejoin="round"><path d="M64 96V72a64 64 0 0 1 128 0v24"></path><rect x="40" y="96" width="176" height="128" rx="8"></rect></svg>`,
    title: "Consumo masivo y retail",
    href: "/contacto",
  },
  {
    icon: `<svg viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="15" stroke-linecap="round" stroke-linejoin="round"><path d="M32 96h192L128 32z"></path><path d="M48 96v104M96 96v104M160 96v104M208 96v104"></path><path d="M32 224h192"></path></svg>`,
