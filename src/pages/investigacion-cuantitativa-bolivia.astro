    title: "Telecomunicaciones",
    href: "/contacto",
  },
  {
    icon: `<svg viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="15" stroke-linecap="round" stroke-linejoin="round"><circle cx="128" cy="128" r="96"></circle><path d="M128 88v80M88 128h80"></path></svg>`,
    title: "Farmacéutico y salud",
    href: "/contacto",
  },
  {
    icon: `<svg viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="15" stroke-linecap="round" stroke-linejoin="round"><path d="M128 224V64"></path><path d="M128 64c0 0-64 8-64 72 64 0 64-72 64-72z"></path><path d="M128 100c0 0 64 8 64 72-64 0-64-72-64-72z"></path></svg>`,
    title: "Agroindustria y alimentos",
    href: "/contacto",
  },
  {
    icon: `<svg viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="15" stroke-linecap="round" stroke-linejoin="round"><path d="M16 96l112-48 112 48-112 48z"></path><path d="M72 120v48c0 16 24 32 56 32s56-16 56-32v-48"></path><path d="M224 96v56"></path></svg>`,
    title: "Educación e instituciones",
    href: "/contacto",
  },
  {
    icon: `<svg viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="15" stroke-linecap="round" stroke-linejoin="round"><path d="M48 224V96l64-32 64 32v128"></path><path d="M176 224V64l32-16 32 16v176"></path><path d="M24 224h208"></path><path d="M80 128h16M80 168h16M136 128h16M136 168h16"></path></svg>`,
    title: "Construcción e inmobiliario",
    href: "/contacto",
  },
  {
    icon: `<svg viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="15" stroke-linecap="round" stroke-linejoin="round"><circle cx="128" cy="128" r="96"></circle><path d="M32 128h192"></path><path d="M128 32c40 32 40 160 0 192M128 32c-40 32-40 160 0 192"></path></svg>`,
    title: "ONGs y organismos internacionales",
    href: "/contacto",
  },
];

const faqItems = [
  {
    question:
      "¿Qué tamaño de muestra necesita una encuesta representativa en Bolivia?",
    answer:
      "Depende del universo y el nivel de confianza requerido. Para mercados urbanos con universos de más de 100.000 personas, una muestra de 384 casos garantiza representatividad estadística con 95% de confianza y 5% de margen de error. Para análisis por segmentos o ciudades específicas, la muestra se amplía. Definimos el diseño muestral según la decisión que necesita tomar.",
  },
  {
    question:
      "¿Cuál es la diferencia entre una encuesta y un estudio de mercado cuantitativo?",
    answer:
      "Una encuesta es el instrumento de recolección. Un estudio de mercado cuantitativo es el proceso completo: diseño metodológico, selección de muestra, recolección en campo, procesamiento estadístico e interpretación estratégica. Mindtec no entrega tablas de datos — entrega conclusiones accionables con sustento estadístico.",
  },
  {
    question: "¿Pueden cubrir varias ciudades de Bolivia en simultáneo?",
    answer:
      "Sí. Contamos con una red de más de 80 encuestadores activos en Santa Cruz, La Paz, Cochabamba, El Alto y ciudades intermedias. Esto permite recolectar datos en múltiples ciudades de forma simultánea, asegurando comparabilidad temporal entre regiones y reduciendo el tiempo total de campo.",
  },
  {
    question: "¿Cuánto tarda una investigación cuantitativa en Bolivia?",
    answer:
      "Un estudio cuantitativo estándar en una ciudad tarda entre 3 y 5 semanas desde el diseño hasta la presentación final. Estudios nacionales con muestras en 4 o más ciudades pueden tomar de 5 a 8 semanas. Contamos con modalidad express para decisiones urgentes.",
  },
  {
    question: "¿En qué se diferencia Mindtec de una encuestadora tradicional?",
    answer:
      "Las encuestadoras tradicionales entregan tablas de frecuencias. Mindtec integra la metodología cuantitativa con análisis de comportamiento del consumidor, cruce con datos cualitativos y biometría cuando el proyecto lo requiere, entregando recomendaciones estratégicas que el equipo directivo puede defender ante el directorio.",
  },
];

const title = "Investigación Cuantitativa en Bolivia | Mindtec";
const description = "Investigación cuantitativa en Bolivia: encuestas presenciales y digitales con respaldo estadístico de nuestra red nacional de encuestadores. Mindtec.";

const relatedProductsCards = [
  {
    href: "/investigacion-cualitativa-bolivia",
    eyebrow: "Investigación Cualitativa",
    title: "Investigación Cualitativa",
    description: "Entienda el por qué detrás de los números: grupos focales, etnografía y entrevistas en profundidad.",
  },
  {
    href: "/estudio-de-mercado-bolivia",
    eyebrow: "Análisis Integral",
    title: "Estudio de Mercado",
    description: "Evaluación integral de viabilidad que combina métodos cuantitativos y cualitativos con análisis competitivo.",
  },
  {
    href: "/estudio-de-precios-bolivia",
    eyebrow: "Precios & Neuro-pricing",
    title: "Estudio de Precios",
    description: "Mida la sensibilidad al precio y el rango aceptable del consumidor con evidencia estadística y neuro-pricing.",
  },
];
---

<Layout
  title={title}
  description={description}
  headerLightBg={false}
  canonicalUrl="/investigacion-cuantitativa-bolivia"
>
  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Service",
        "@id": "https://www.mindtecbolivia.com/investigacion-cuantitativa-bolivia",
        "name": "Investigación Cuantitativa en Bolivia",
        "description": "Servicio de investigación cuantitativa en Bolivia: encuestas presenciales, telefónicas y online con muestras estadísticamente representativas para dimensionar mercados, medir actitudes y sustentar decisiones corporativas.",
        "provider": {
          "@type": "Organization",
          "name": "Mindtec Bolivia",
          "url": "https://www.mindtecbolivia.com"
        },
        "areaServed": {"@type": "Country", "name": "Bolivia"},
        "serviceType": "Investigación Cuantitativa / Encuestas de Mercado",
        "url": "https://www.mindtecbolivia.com/investigacion-cuantitativa-bolivia"
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "¿Qué tamaño de muestra necesita una encuesta representativa en Bolivia?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Depende del universo y el nivel de confianza requerido. Para mercados urbanos con universos de más de 100.000 personas, una muestra de 384 casos garantiza representatividad estadística con 95% de confianza y 5% de margen de error. Para análisis por segmentos o ciudades específicas, la muestra se amplía. Definimos el diseño muestral según la decisión que necesitas tomar."
            }
          },
          {
            "@type": "Question",
            "name": "¿Cuál es la diferencia entre una encuesta y un estudio de mercado cuantitativo?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Una encuesta es el instrumento de recolección. Un estudio de mercado cuantitativo es el proceso completo: diseño metodológico, selección de muestra, recolección en campo, procesamiento estadístico e interpretación estratégica. Mindtec no entrega tablas de datos — entrega conclusiones accionables con sustento estadístico."
            }
          },
          {
            "@type": "Question",
            "name": "¿Pueden cubrir varias ciudades de Bolivia en simultáneo?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Sí. Contamos con una red de más de 80 encuestadores activos en Santa Cruz, La Paz, Cochabamba, El Alto y ciudades intermedias. Esto permite recolectar datos en múltiples ciudades de forma simultánea, asegurando comparabilidad temporal entre regiones y reduciendo el tiempo total de campo."
            }
          },
          {
            "@type": "Question",
            "name": "¿Cuánto tarda una investigación cuantitativa en Bolivia?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Un estudio cuantitativo estándar en una ciudad tarda entre 3 y 5 semanas desde el diseño hasta la presentación final. Estudios nacionales con muestras en 4 o más ciudades pueden tomar de 5 a 8 semanas. Contamos con modalidad express para decisiones urgentes."
            }
          },
          {
            "@type": "Question",
            "name": "¿En qué se diferencia Mindtec de una encuestadora tradicional?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Las encuestadoras tradicionales entregan tablas de frecuencias. Mindtec integra la metodología cuantitativa con análisis de comportamiento del consumidor, cruce con datos cualitativos y biometría cuando el proyecto lo requiere, entregando recomendaciones estratégicas que el equipo directivo puede defender ante el directorio."
            }
          }
        ]
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {"@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://www.mindtecbolivia.com/"},
          {"@type": "ListItem", "position": 2, "name": "Servicios", "item": "https://www.mindtecbolivia.com/servicios"},
          {"@type": "ListItem", "position": 3, "name": "Investigación Cuantitativa en Bolivia", "item": "https://www.mindtecbolivia.com/investigacion-cuantitativa-bolivia"}
        ]
      }
    ]
  }
  </script>

  <main>
    <StackedSections>

    <!-- 1. HERO -->
    <section class="hero-section" style="padding-bottom: 4rem; padding-top: 4rem;" data-stack-section>
      <div class="hero-shapes" aria-hidden="true">
        <div class="hero-shape"></div><div class="hero-shape"></div><div class="hero-shape"></div>
        <div class="hero-shape"></div><div class="hero-shape"></div><div class="hero-shape"></div>
        <div class="hero-shape"></div><div class="hero-shape"></div><div class="hero-shape"></div>
        <div class="hero-shape"></div><div class="hero-shape"></div><div class="hero-shape"></div>
        <div class="hero-shape"></div><div class="hero-shape"></div><div class="hero-shape"></div>
        <div class="hero-shape"></div>
      </div>
      <div class="hero-mobile-canvas" id="hero-mobile-canvas" aria-hidden="true"></div>
      <div class="container hero-container">
        <div class="hero-content">
          <span class="eyebrow fade-in">INVESTIGACIÓN CUANTITATIVA · ENCUESTAS · ANÁLISIS ESTADÍSTICO</span>
          <span class="freshness-tag">Actualizado: julio 2026</span>
          <h1 class="hero-title" style="font-size: 3.5rem; line-height: 1.25; margin-bottom: 1.5rem;">
            Investigación Cuantitativa en Bolivia — Evidencia estadística que su Directorio puede defender.
          </h1>
          <div class="direct-answer-box">
            <strong>En resumen</strong>
            <p>Mindtec realiza investigación cuantitativa en Bolivia: encuestas presenciales, telefónicas y online con muestras estadísticamente representativas para dimensionar mercados, medir actitudes y sustentar decisiones corporativas.</p>
          </div>
          <p class="hero-subtitle" style="font-size: 1.25rem; margin-bottom: 1.5rem; max-width: 800px;">
            Encuestas presenciales, telefónicas y online con muestras estadísticamente representativas del mercado boliviano. Red de 80+ encuestadores activos en 4 ciudades. Análisis que va más allá de las tablas de frecuencias.
          </p>
          <p style="font-size: 1.05rem; color: rgba(255,255,255,0.75); max-width: 800px; margin-bottom: 2.5rem;">
            No entregamos reportes de datos. Entregamos conclusiones accionables con sustento estadístico que permiten tomar decisiones de lanzamiento, precio, distribución y posicionamiento con certeza científica.
          </p>
          <div style="display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 2.5rem;">
            <span style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #fff; padding: 0.4rem 1rem; border-radius: 20px; font-size: 0.85rem; font-weight: 600;">Encuestas presenciales · telefónicas · online</span>
            <span style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #fff; padding: 0.4rem 1rem; border-radius: 20px; font-size: 0.85rem; font-weight: 600;">80+ encuestadores en Bolivia</span>
            <span style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #fff; padding: 0.4rem 1rem; border-radius: 20px; font-size: 0.85rem; font-weight: 600;">Muestras representativas</span>
            <span style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #fff; padding: 0.4rem 1rem; border-radius: 20px; font-size: 0.85rem; font-weight: 600;">Cobertura nacional</span>
          </div>
          <a href="/contacto" class="btn btn-primary lg">Agendar diagnóstico estratégico (45 min) →</a>
        </div>
        <div class="hero-visual">
          <div class="glass-card main-visual">
            <div class="neuro-visual-bg"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. EL PROBLEMA -->
    <section class="bg-slate" style="padding: 5rem 0;" data-stack-section>
      <div class="container">
        <div style="max-width: 900px; margin: 0 auto;">
          <span class="eyebrow">EL PROBLEMA REAL</span>
          <h2 class="text-navy" style="font-size: 2.5rem; margin-top: 1rem; margin-bottom: 2rem; line-height: 1.2;">Decidir con datos anecdóticos en un mercado de 12 millones es demasiado costoso.</h2>
          <p class="text-gray-dark leading-relaxed" style="font-size: 1.15rem; margin-bottom: 1.5rem; line-height: 1.7;">
            Bolivia tiene 9 departamentos, 3 pisos ecológicos y docenas de culturas activas. Un gerente que toma decisiones basado en lo que "ve en el mercado" o en la opinión de 5 distribuidores no tiene datos — tiene anécdotas. Y las anécdotas no escalan.
          </p>
          <p class="text-gray-dark leading-relaxed" style="font-size: 1.05rem; line-height: 1.7;">
            ¿Reconoce alguno de estos escenarios?
          </p>
        </div>

        <AreaPanelCards items={problemScenarios} columns={4} theme="navy" class="problem-panels" />

        <div style="max-width: 900px; margin: 2.5rem auto 0; background: var(--color-secondary); color: #fff; padding: 1.5rem 2rem; border-radius: var(--radius-md, 8px); font-weight: 600; font-size: 1.1rem; text-align: center;">
          Sin evidencia estadística representativa, la aprobación del Directorio es una promesa — no una decisión informada.
        </div>
      </div>
    </section>

    <!-- 3. MINDTEC+ -->
    <section style="padding: 5rem 0; background: #fff;" data-stack-section>
      <div class="container">
        <div class="section-title-center" style="text-align: center; margin-bottom: 3rem;">
          <span class="eyebrow">MINDTEC+</span>
          <h2 class="text-navy" style="font-size: 2.2rem; line-height: 1.2; margin-top: 1rem; margin-bottom: 1rem;">Más que un recopilador de encuestas: inteligencia estratégica respaldada por infraestructura de campo nacional.</h2>
        </div>

        <ComparisonRows
          columnLabels={{ left: 'Encuestadora tradicional', right: 'Mindtec — Investigación Cuantitativa' }}
          rows={comparisonRows}
        />

        <p class="text-gray-dark" style="font-size: 1.05rem; margin-top: 1.5rem; max-width: 800px; margin-left: auto; margin-right: auto; text-align: center; line-height: 1.7;">
          La diferencia no está en el tamaño de la muestra. Está en lo que hacemos con los datos después de recolectarlos.
        </p>
      </div>
    </section>
    </StackedSections>

    <!-- 4. ENTREGABLES -->
    <ScrollStory
      scrub={0.85}
      sceneDistance={1.1}
      cover={{
        background: "/imagenes-mindtec/generated/investigacion-cuantitativa/entregables/entregables-cover.webp",
        eyebrow: "Qué recibe",
        title: "Entregables que sustentan decisiones de inversión, lanzamiento y posicionamiento.",
        description: "Documentos y análisis diseñados para traducir la evidencia estadística en decisiones de negocio."
      }}
      intro={{
        background: "/imagenes-mindtec/generated/investigacion-cuantitativa/entregables/entregables-intro.webp",
        number: "00",
        eyebrow: "Plazo de entrega",
        title: "3–8 semanas según alcance. Cobertura: eje troncal boliviano y ciudades intermedias.",
        description: "Recorra los seis entregables que puede esperar de un estudio cuantitativo Mindtec."
      }}
      items={[
        {
          background: "/imagenes-mindtec/generated/investigacion-cuantitativa/entregables/entregable-01-reporte-ejecutivo.webp",
          eyebrow: "Síntesis",
          title: "Reporte Ejecutivo con Conclusiones Accionables",
          description: "Síntesis de hallazgos clave con lenguaje directivo. Sin jerga estadística. Directo a las implicaciones para su negocio, con recomendaciones priorizadas por impacto.",
          icon: "road"
        },
        {
          background: "/imagenes-mindtec/generated/investigacion-cuantitativa/entregables/entregable-02-segmentacion.webp",
          eyebrow: "Segmentos",
          title: "Segmentación Estadística del Mercado",
          description: "Identificación y dimensionamiento de segmentos de consumidores con perfil sociodemográfico, psicográfico y conductual. La base para cualquier estrategia de targeting real.",
          icon: "building"
        },
        {
          background: "/imagenes-mindtec/generated/investigacion-cuantitativa/entregables/entregable-03-awareness-preferencia.webp",
          eyebrow: "Embudo de marca",
          title: "Medición de Awareness, Preferencia y Compra",
          description: "Top of mind, reconocimiento espontáneo y asistido, preferencia de marca y penetración de consumo. El embudo de marca medido estadísticamente en su mercado objetivo.",
          icon: "services"
        },
        {
          background: "/imagenes-mindtec/generated/investigacion-cuantitativa/entregables/entregable-04-demanda-dimensionamiento.webp",
          eyebrow: "Demanda",
          title: "Análisis de Demanda y Dimensionamiento",
          description: "Estimación del tamaño del mercado objetivo, frecuencia de compra, intención de adopción y potencial de penetración. Los números que justifican la inversión ante el directorio.",
          icon: "airport"
        },
        {
          background: "/imagenes-mindtec/generated/investigacion-cuantitativa/entregables/entregable-05-dashboard-datos.webp",
          eyebrow: "Datos",
          title: "Dashboard de Datos y Base Completa",
          description: "Entrega de la base de datos procesada, tablas de frecuencias y cruce de variables para que su equipo de analítica pueda profundizar en los hallazgos más relevantes.",
          icon: "road"
        },
        {
          background: "/imagenes-mindtec/generated/investigacion-cuantitativa/entregables/entregable-06-presentacion-directorio.webp",
          eyebrow: "Presentación",
          title: "Presentación ante Directorio",
          description: "Sesión de presentación de hallazgos con el equipo de Mindtec, diseñada para el formato de Directorio o Gerencia: máximo impacto en mínimo tiempo.",
          icon: "building"
        }
      ]}
    />

    <StackedSections>
    <!-- 5. PROCESO -->
    <section style="padding: 5rem 0; background: #f8fafc;" data-stack-section>
      <div class="container">
        <div class="section-title-center" style="text-align: center; margin-bottom: 4rem;">
          <span class="eyebrow">CÓMO FUNCIONA</span>
          <h2 class="text-navy" style="font-size: 2.2rem; line-height: 1.2; margin-top: 1rem;">Del diagnóstico a la evidencia estadística en 4 pasos.</h2>
        </div>
        <AreaPanelCards items={processSteps} columns={4} />
      </div>
    </section>

    <!-- 6. SECTORES -->
    <section class="problem-section bg-slate" style="padding: 5rem 0;" data-stack-section>
      <div class="container">
        <div class="section-title-center" style="text-align: center; margin-bottom: 3rem;">
          <span class="eyebrow">SECTORES</span>
          <h2 class="text-navy" style="font-size: 2.2rem; line-height: 1.2; margin-top: 1rem;">¿Su sector está aquí?</h2>
        </div>
        <AreaPanelCards items={sectorItems} columns={4} />
      </div>
    </section>

    <!-- 7. FAQ -->
    <div data-stack-section>
      <FaqSplit
        eyebrow="PREGUNTAS FRECUENTES"
        title="Lo que suelen preguntar antes de contratar."
        items={faqItems}
      />
    </div>

    <!-- 8. PRUEBA SOCIAL -->
    <section style="padding: 4rem 0; background: #f8fafc; border-top: 1px solid #e2e8f0; border-bottom: 1px solid #e2e8f0;" data-stack-section>
      <div class="container" style="text-align: center; max-width: 800px;">
        <p class="text-navy" style="font-size: 1.2rem; font-weight: 700; margin-bottom: 1.5rem; line-height: 1.5;">
          Empresas de consumo masivo, banca, telecomunicaciones y organismos internacionales en Bolivia han usado la investigación cuantitativa de Mindtec para dimensionar mercados, evaluar lanzamientos y medir posicionamiento de marca con rigor estadístico.
        </p>
        <div style="display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center;">
          <span style="background: #fff; border: 1px solid #e2e8f0; color: #475569; padding: 0.4rem 1rem; border-radius: 20px; font-size: 0.85rem; font-weight: 600;">Consumo masivo</span>
          <span style="background: #fff; border: 1px solid #e2e8f0; color: #475569; padding: 0.4rem 1rem; border-radius: 20px; font-size: 0.85rem; font-weight: 600;">Banca y finanzas</span>
          <span style="background: #fff; border: 1px solid #e2e8f0; color: #475569; padding: 0.4rem 1rem; border-radius: 20px; font-size: 0.85rem; font-weight: 600;">Telecomunicaciones</span>
          <span style="background: #fff; border: 1px solid #e2e8f0; color: #475569; padding: 0.4rem 1rem; border-radius: 20px; font-size: 0.85rem; font-weight: 600;">Organismos internacionales</span>
          <span style="background: #fff; border: 1px solid #e2e8f0; color: #475569; padding: 0.4rem 1rem; border-radius: 20px; font-size: 0.85rem; font-weight: 600;">Farmacéutico</span>
        </div>
      </div>
    </section>

    <!-- 9. PRODUCTOS RELACIONADOS -->
    <section style="padding: 5rem 0; background: #fff;" data-stack-section>
      <div class="container">
        <h3
          class="text-navy"
          style="font-size: 1.8rem; margin-bottom: 2.5rem; text-align: center;"
        >
          También puede interesarle
        </h3>
      </div>
      <div class="related-products-bleed">
        <HoverStepCards items={relatedProductsCards} minColumnWidth="300px" />
      </div>
      <div class="container">
        <div style="text-align: center; margin-top: 2.5rem;">
          <a
            href="/servicios"
            style="color: var(--color-primary); font-weight: 700; text-decoration: none; font-size: 0.95rem;"
            >Ver todos los servicios →</a
          >
        </div>
      </div>
    </section>

    <!-- 10. CTA FINAL -->
    <section class="cta-section-modern cta-section-modern--viewport" data-stack-section>
      <div class="container" style="max-width: 900px; margin: 0 auto; text-align: center;">
        <div class="cta-content-v2">
          <h2 style="font-size: 2.8rem; line-height: 1.25; margin-bottom: 1.5rem;">¿Necesita evidencia estadística para su próxima decisión de mercado en Bolivia?</h2>
          <p class="cta-subtitle" style="font-size: 1.2rem; margin-bottom: 2.5rem; opacity: 0.9;">
            Hablemos 45 minutos. Definimos el diseño muestral, el método y el alcance de su investigación. Se lleva un plan claro antes de comprometer inversión.
          </p>
          <div class="cta-actions" style="justify-content: center; flex-direction: column; align-items: center;">
            <a href="/contacto" class="btn btn-primary lg" style="font-size: 1.1rem; padding: 1rem 2.5rem;">Agendar diagnóstico estratégico (45 min) →</a>
            <p style="margin-top: 1.5rem; font-size: 0.95rem; color: rgba(255,255,255,0.7); font-weight: 500;">Confidencial · Sin costo · Sin compromiso · Por Zoom o Teams</p>
          </div>
        </div>
      </div>
    </section>
    </StackedSections>

    <style>
      /* Espacio entre la intro de "El Problema" y el grid de escenarios.
         :global() porque la clase se aplica dentro de AreaPanelCards.astro;
         doble clase para ganarle en especificidad al margin:0 auto de .areas-grid. */
      :global(.areas-grid.problem-panels) {
        margin-top: 3.5rem;
      }

      /* CTA final del StackedSections: el fondo naranja ocupa toda la ventana. */
      .cta-section-modern--viewport {
        min-height: 100svh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 4rem 0;
        background: linear-gradient(135deg, var(--color-primary), #D94E10);
      }

      .cta-section-modern--viewport .cta-content-v2 {
        background: transparent;
        box-shadow: none;
        max-width: none;
        margin: 0;
        padding: 0;
      }
    </style>

    <!-- BREADCRUMB -->
    <nav aria-label="Breadcrumb" class="breadcrumb-bottom">
      <div class="container">
        <ol>
          <li><a href="/" style="color: rgba(255,255,255,0.6); text-decoration: none;">Inicio</a></li>
          <li style="color: rgba(255,255,255,0.3);">›</li>
          <li><a href="/servicios" style="color: rgba(255,255,255,0.6); text-decoration: none;">Servicios</a></li>
          <li style="color: rgba(255,255,255,0.3);">›</li>
          <li aria-current="page" style="color: #fff; font-weight: 600;">Investigación Cuantitativa en Bolivia</li>
        </ol>
      </div>
    </nav>

  </main>

  <style>
    /* 9. PRODUCTOS RELACIONADOS */
    .related-products-bleed {
      padding: 0 2rem;
    }

    @media (min-width: 900px) {
      .related-products-bleed {
        width: 100vw;
        position: relative;
        left: 50%;
        right: 50%;
        margin-left: -50vw;
        margin-right: -50vw;
        padding: 0 clamp(1.5rem, 4vw, 4rem);
      }
    }
  </style>

</Layout>
