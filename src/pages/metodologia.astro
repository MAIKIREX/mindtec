    <script>
        import { ScrollTrigger } from "gsap/ScrollTrigger";

        /*
         * Esta página combina MorphScrollStory y ScrollStoryLeft,
         * uno detrás de otro. Cada componente crea
         * sus propios ScrollTrigger y hace su propio refresh() en
         * cuanto termina de inicializarse, sin esperar a que los
         * demás componentes de la página también hayan reservado su
         * espacio de pin. Eso hace que una animación calcule su punto
         * de inicio antes de que la anterior haya terminado de reservar
         * el alto de su propia animación, y ambas animaciones "chocan" y se
         * muestran a la vez.
         *
         * Un refresh() final, después de que todos los scripts de la
         * página ya corrieron (siguiente frame tras "load"), vuelve a
         * calcular la posición de inicio/fin de TODOS los triggers ya
         * creados con el layout definitivo del documento.
         */
        function finalizeScrollTriggers() {
            requestAnimationFrame(() => {
                requestAnimationFrame(() => {
                    ScrollTrigger.refresh();
                });
            });
        }

        if (document.readyState === "complete") {
            finalizeScrollTriggers();
        } else {
            window.addEventListener("load", finalizeScrollTriggers, {
                once: true,
            });
        }

        document.addEventListener("astro:page-load", finalizeScrollTriggers);
    </script>

