---
import Layout from '../layouts/Layout.astro';

const title = "Página no encontrada (404) | Mindtec Bolivia";
const description = "La página que busca no existe, ha sido movida o no está disponible temporalmente. Regrese al inicio o explore nuestras soluciones.";
---

<Layout
  title={title}
  description={description}
  headerLightBg={false}
>
  <meta slot="head" name="robots" content="noindex, follow" />

  <main class="error-page-container">
    <div class="glow-effect" aria-hidden="true">
      <div class="glow-orb orange-glow"></div>
      <div class="glow-orb blue-glow"></div>
    </div>

    <section class="error-content container text-center">
      <div class="error-badge">404</div>
      <h1>Página No Encontrada</h1>
      <p class="error-description">
        Lo sentimos, el enlace que ha seguido puede estar roto, la página ha sido renombrada o ya no existe en nuestro sitio web.
      </p>
      
      <div class="solutions-teaser">
        <h3>¿Qué estaba buscando?</h3>
        <p>Explore nuestras principales soluciones en investigación de mercados:</p>
        
        <div class="teaser-links">
          <a href="/estudio-de-mercado-bolivia/" class="teaser-link">Estudios de Mercado</a>
          <a href="/servicios/" class="teaser-link">Nuestros Servicios</a>
          <a href="/blog/" class="teaser-link">Insights & Blog</a>
          <a href="/contacto/" class="teaser-link">Contacto</a>
        </div>
      </div>

      <div class="cta-actions">
        <a href="/" class="btn btn-primary">Volver al Inicio</a>
        <a href="/contacto/" class="btn btn-outline-light">Escríbanos</a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .error-page-container {
    background-color: var(--color-secondary-deep, #071621);
    color: var(--color-text-light, #ffffff);
    min-height: 85vh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    padding: 120px 20px 80px 20px;
  }

  /* Decorative Background Glow Orbs */
  .glow-effect {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
    z-index: 0;
  }

  .glow-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.15;
  }

  .orange-glow {
    top: 20%;
    left: 15%;
    width: 350px;
    height: 350px;
    background-color: var(--color-primary, #f26522);
  }

  .blue-glow {
    bottom: 20%;
    right: 15%;
    width: 400px;
    height: 400px;
    background-color: #0b2b40;
  }

  /* Content Styling */
  .error-content {
    max-width: 680px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  .error-badge {
    font-family: var(--font-display, 'Outfit', sans-serif);
    font-size: clamp(6rem, 12vw, 9rem);
    font-weight: 900;
    line-height: 1;
    background: linear-gradient(135deg, var(--color-primary, #f26522) 0%, #ff8c52 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 1rem;
    letter-spacing: -2px;
    filter: drop-shadow(0 4px 20px rgba(242, 101, 34, 0.15));
  }

  .error-content h1 {
    font-family: var(--font-display, 'Outfit', sans-serif);
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-weight: 800;
    color: #ffffff !important;
    margin-bottom: 1.2rem;
    letter-spacing: -0.5px;
  }

  .error-description {
    font-size: clamp(1rem, 2vw, 1.15rem);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.8) !important;
    margin-bottom: 2.5rem;
  }

  /* Solutions Teaser Card */
  .solutions-teaser {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 16px;
    padding: 2rem;
    margin-bottom: 2.5rem;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  }

  .solutions-teaser h3 {
    font-size: 1.15rem;
    font-weight: 700;
    color: #ffffff !important;
    margin-bottom: 0.5rem;
  }

  .solutions-teaser p {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.6) !important;
    margin-bottom: 1.25rem;
  }

  .teaser-links {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .teaser-link {
    font-size: 0.88rem;
    font-weight: 500;
    color: #ffffff;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 30px;
    padding: 8px 18px;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .teaser-link:hover {
    background: rgba(242, 101, 34, 0.1);
    border-color: var(--color-primary, #f26522);
    color: var(--color-primary, #f26522);
    transform: translateY(-2px);
  }

  /* Action Buttons */
  .cta-actions {
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .cta-actions .btn {
    padding: 12px 30px;
    font-weight: 600;
    font-size: 0.95rem;
  }

  @media (max-width: 576px) {
    .solutions-teaser {
      padding: 1.5rem 1rem;
    }
    
    .teaser-links {
      flex-direction: column;
      align-items: stretch;
      gap: 8px;
    }

    .cta-actions {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
    }
  }
</style>
