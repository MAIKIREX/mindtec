---
import MorphScrollStory from "../components/MorphScrollStory.astro";

const cover = {
  background:
    "https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=2400&q=85",
  alt: "Edificio empresarial contemporáneo",
  eyebrow: "Arquitectura corporativa",
  title: "Una estructura que transforma el horizonte.",
  description:
    "Una demostración de fondos superpuestos y tarjetas que modifican su silueta de forma continua mediante GSAP."
};

const intro = {
  background:
    "https://images.unsplash.com/photo-1497366754035-f200968a6e72?auto=format&fit=crop&w=2400&q=85",
  alt: "Interior corporativo moderno",
  number: "01",
  eyebrow: "Visión general",
  title: "Una identidad construida por capas.",
  description:
    "Primero entra el fondo. Después, la tarjeta asciende desde debajo del viewport mientras revela gradualmente su forma escalonada.",
  shape: "intro-step" as const,
  card: {
    width: 98,
    height: 60,
    left: 1,
    bottom: 2.5
  }
};

const items = [
  {
    background:
      "https://images.unsplash.com/photo-1487958449943-2429e8be8625?auto=format&fit=crop&w=2400&q=85",
    alt: "Fachada moderna con niveles elevados",
    eyebrow: "Volumen",
    title: "Algunas áreas del edificio se elevan sobre el terreno.",
    description:
      "La primera forma combina un escalón superior y una reducción lateral para dejar visible una mayor parte del fondo.",
    shape: "step-right" as const,
    card: {
      width: 84,
      height: 80,
      left: 0.6,
      bottom: 2
    }
  },
  {
    background:
      "https://images.unsplash.com/photo-1511818966892-d7d671e672a2?auto=format&fit=crop&w=2400&q=85",
    alt: "Fachada con elementos verticales",
    eyebrow: "Ritmo vertical",
    title: "Las lamas enfatizan el movimiento ascendente del edificio.",
    description:
      "El nuevo fondo cubre al anterior mientras la tarjeta adopta un doble escalón y el contenido cambia durante el último tramo.",
    shape: "double-step" as const,
    card: {
      width: 84,
      height: 82,
      left: 0.7,
      bottom: 1.5
    }
  },
  {
    background:
      "https://images.unsplash.com/photo-1497366811353-6870744d04b2?auto=format&fit=crop&w=2400&q=85",
    alt: "Edificio de vidrio y acero",
    eyebrow: "Ligereza",
    title: "Los niveles inferiores acristalados generan ligereza estructural.",
    description:
      "La tercera forma desplaza su escalón hacia el centro superior y conserva una salida lateral en la zona inferior.",
    shape: "upper-center" as const,
    card: {
      width: 83,
      height: 78,
      left: 3.5,
      bottom: 3
    }
  },
  {
    background:
      "https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=2400&q=85",
    alt: "Espacio corporativo luminoso",
    eyebrow: "Profundidad",
    title: "La tarjeta abre una entrada lateral para mostrar el entorno.",
    description:
      "Cada elemento puede controlar su ancho, alto, posición y silueta sin modificar la lógica principal del wrapper.",
    shape: "side-notch" as const,
    card: {
      width: 80,
      height: 76,
      left: 7,
      bottom: 4
    }
  },
  {
    background:
      "https://images.unsplash.com/photo-1524758631624-e2822e304c36?auto=format&fit=crop&w=2400&q=85",
    alt: "Oficina contemporánea",
    eyebrow: "Forma personalizada",
    title: "El último item utiliza un polígono definido manualmente.",
    description:
      "Puedes usar una forma predefinida o introducir diez puntos personalizados con coordenadas entre cero y cien.",
    shape: [
      [0, 14],
      [29, 14],
      [29, 7],
      [61, 7],
      [61, 0],
      [100, 0],
      [100, 70],
      [91, 70],
      [91, 100],
      [0, 100]
    ] as [number, number][],
    mobileShape: "inverse-step" as const,
    card: {
      width: 82,
      height: 80,
      left: 2.5,
      bottom: 2
    }
  }
];
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Demostración de MorphScrollStory con Astro y GSAP"
    />
    <title>MorphScrollStory · Astro + GSAP</title>
  </head>

  <body>
    <header class="demo-header">
      <button
        class="demo-header__menu"
        type="button"
        aria-label="Abrir menú"
      >
        <span></span>
        <span></span>
      </button>

      <a href="/" class="demo-header__brand">
        MORPH
      </a>

      <nav class="demo-header__navigation">
        <a href="#">Arquitectura</a>
        <a href="#">Proyecto</a>
        <a href="#">Contacto</a>
      </nav>
    </header>

    <main>
      <MorphScrollStory
        cover={cover}
        intro={intro}
        items={items}
        scrub={0.9}
        sceneDistance={1}
        cardColor="#05091f"
      />

      <section class="after-story">
        <span>Fin de la secuencia</span>

        <h2>
          La página continúa después del wrapper.
        </h2>

        <p>
          Agrega más objetos al array para crear nuevas escenas. Cada item puede
          cambiar el fondo, el contenido, la forma, las dimensiones y la posición
          de la tarjeta.
        </p>
      </section>
    </main>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  html {
    margin: 0;
    padding: 0;
    background: #05091f;
    scroll-behavior: auto;
  }

  body {
    margin: 0;
    padding: 0;
    overflow-x: hidden;
    color: white;
    background: #05091f;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  .demo-header {
    position: fixed;
    z-index: 100;
    top: 0;
    left: 0;
    right: 0;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    min-height: 72px;
    padding: 0 clamp(18px, 4vw, 70px);
    color: white;
    pointer-events: none;
  }

  .demo-header a,
  .demo-header button {
    pointer-events: auto;
  }

  .demo-header__menu {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 58px;
    padding: 10px 0;
    color: white;
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .demo-header__menu span {
    display: block;
    width: 100%;
    height: 1px;
    background: currentColor;
  }

  .demo-header__brand {
    margin-left: clamp(30px, 5vw, 90px);
    color: white;
    font-size: 1.35rem;
    font-weight: 400;
    letter-spacing: 0.28em;
    text-decoration: none;
  }

  .demo-header__navigation {
    display: flex;
    gap: clamp(22px, 4vw, 65px);
  }

  .demo-header__navigation a {
    color: white;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .after-story {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(40px, 8vw, 130px);
    background:
      radial-gradient(
        circle at 70% 40%,
        rgba(86, 107, 180, 0.22),
        transparent 36%
      ),
      #0b0d19;
  }

  .after-story > span {
    margin-bottom: 25px;
    color: #aab9ef;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .after-story h2 {
    max-width: 1000px;
    margin: 0;
    font-size: clamp(3rem, 7vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.06em;
  }

  .after-story p {
    max-width: 680px;
    margin: 35px 0 0;
    color: rgba(255, 255, 255, 0.64);
    font-size: 1.1rem;
    line-height: 1.7;
  }

  @media (max-width: 700px) {
    .demo-header {
      grid-template-columns: auto 1fr;
      min-height: 62px;
      padding: 0 18px;
    }

    .demo-header__menu {
      width: 42px;
    }

    .demo-header__brand {
      justify-self: end;
      margin-left: 0;
      font-size: 1rem;
    }

    .demo-header__navigation {
      display: none;
    }
  }
</style>
