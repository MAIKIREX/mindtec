---
import Layout from "../layouts/Layout.astro";
import NeuroOrbitLogo from "../components/visual/NeuroOrbitLogo.astro";

const title = "Neurotecnología 3D | Mindtec Bolivia";
const description =
  "Explora cómo Mindtec combina neurociencia e inteligencia artificial: visualización interactiva de datos en 3D sobre una red neuronal animada.";
---

<Layout
  title={title}
  description={description}
  headerLightBg={false}
  canonicalUrl="/neurotecnologia-3d/"
>
  <main class="neuro3d-page">
    <!-- Hero: logo centrado en la ventana + partículas trazando su contorno -->
    <section class="neuro-hero" id="neuro-hero">
      <NeuroOrbitLogo />
    </section>
  </main>

  <style>
    :global(.site-header),
    :global(.site-footer),
    :global(.float-wa) {
      display: none;
    }

    .neuro3d-page {
      background: var(--color-secondary-deep);
      color: var(--color-text-light);
    }

    /* ---------- Hero ---------- */
    .neuro-hero {
      position: relative;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      gap: 2.5rem;
      perspective: 1000px;
      background: radial-gradient(
        circle at 50% 30%,
        var(--color-secondary) 0%,
        var(--color-secondary-deep) 70%
      );
    }

    .neuro-hero-inner {
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 1rem;
      padding: 0 1.5rem 2rem;
    }

    .neuro-hero-inner h1 {
      font-size: 2.4rem;
      font-weight: 800;
      color: var(--color-text-light);
      margin: 0.25rem 0;
    }

    .neuro-subtitle {
      max-width: 560px;
      color: rgba(255, 255, 255, 0.75);
      font-size: 1.05rem;
      line-height: 1.6;
    }

    /* ---------- Charts section ---------- */
    .neuro-charts {
      padding: 5rem 0 6rem;
      background: var(--color-secondary-deep);
    }

    .charts-title {
      text-align: center;
      font-size: 1.9rem;
      font-weight: 700;
      color: var(--color-text-light);
      margin-bottom: 0.5rem;
    }

    .charts-subtitle {
      text-align: center;
      color: rgba(255, 255, 255, 0.6);
      max-width: 560px;
      margin: 0 auto 3rem;
    }

    .chart3d-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 2.5rem;
    }

    .chart3d-card {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 16px;
      padding: 2rem;
    }

    .chart3d-card h3 {
      color: var(--color-text-light);
      font-size: 1.15rem;
      margin-bottom: 2rem;
      text-align: center;
    }

    /* 3D bar chart (pure CSS perspective, GPU-accelerated transforms) */
    .bar3d-scene {
      display: flex;
      align-items: flex-end;
      justify-content: center;
      gap: 1.75rem;
      height: 220px;
      perspective: 700px;
      perspective-origin: 50% 100%;
    }

    .bar3d {
      --w: 34px;
      position: relative;
      width: var(--w);
      height: calc(var(--h) * 1.9px);
      background: linear-gradient(
        180deg,
        var(--color-primary) 0%,
        var(--color-primary-hover) 100%
      );
      border-radius: 4px 4px 0 0;
      transform-style: preserve-3d;
      transform: rotateX(8deg) rotateY(-18deg);
      box-shadow: 6px 6px 0 rgba(11, 43, 64, 0.5);
      will-change: transform;
    }

    .bar3d::after {
      content: attr(data-label);
      position: absolute;
      bottom: -1.6rem;
      left: 50%;
      transform: translateX(-50%);
      font-size: 0.7rem;
      color: rgba(255, 255, 255, 0.55);
      white-space: nowrap;
    }

    .bar3d-value {
      position: absolute;
      top: -1.6rem;
      left: 50%;
      transform: translateX(-50%);
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--color-text-light);
    }

    /* 3D radar chart (layered rings + rotating shape) */
    .radar3d-scene {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 220px;
      perspective: 700px;
    }

    .radar3d {
      position: relative;
      width: 180px;
      height: 180px;
      transform-style: preserve-3d;
      transform: rotateX(55deg) rotateZ(0deg);
      animation: radar-spin 16s linear infinite;
    }

    .radar3d-ring {
      position: absolute;
      inset: 0;
      border: 1px solid rgba(242, 101, 34, 0.35);
      border-radius: 50%;
    }
    .radar3d-ring.r2 {
      inset: 22px;
      border-color: rgba(242, 101, 34, 0.25);
    }
    .radar3d-ring.r3 {
      inset: 44px;
      border-color: rgba(242, 101, 34, 0.18);
    }

    .radar3d-shape {
      position: absolute;
      inset: 18%;
      background: rgba(242, 101, 34, 0.35);
      clip-path: polygon(50% 0%, 95% 30%, 80% 90%, 20% 90%, 5% 30%);
      border: 1px solid var(--color-primary);
    }

    @keyframes radar-spin {
      to {
        transform: rotateX(55deg) rotateZ(360deg);
      }
    }

    /* Respect reduced motion: disable rotation-based animation */
    @media (prefers-reduced-motion: reduce) {
      .radar3d {
        animation: none;
      }
    }

    @media (max-width: 640px) {
      .neuro-hero-inner h1 {
        font-size: 1.8rem;
      }
      .bar3d-scene {
        gap: 1rem;
      }
      .bar3d {
        --w: 24px;
      }
    }
  </style>
</Layout>
