---
import ScrollStory from "../components/scroll/ScrollStory.astro";

const cover = {
  background:
    "https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=2400&q=85",
  alt: "Edificio empresarial moderno",
  eyebrow: "Centro empresarial",
  title: "Un espacio diseñado para crecer.",
  description:
    "Arquitectura, conectividad y ubicación estratégica reunidas en una experiencia corporativa."
};

const intro = {
  background:
    "https://images.unsplash.com/photo-1497366754035-f200968a6e72?auto=format&fit=crop&w=2400&q=85",
  alt: "Oficina empresarial moderna",
  number: "02",
  eyebrow: "Ubicación",
  title: "El punto de partida de nuevas oportunidades.",
  description:
    "Un centro empresarial situado en una zona estratégica, conectado con los principales servicios, vías y espacios comerciales de la ciudad."
};

const items = [
  {
    background:
      "https://images.unsplash.com/photo-1436491865332-7a61a109cc05?auto=format&fit=crop&w=2400&q=85",
    alt: "Avión sobrevolando una zona urbana",
    eyebrow: "Conectividad",
    title: "Proximidad al aeropuerto",
    description:
      "Una ubicación que permite llegar rápidamente al aeropuerto y conectar con destinos nacionales e internacionales.",
    icon: "airport" as const
  },
  {
    background:
      "https://images.unsplash.com/photo-1449824913935-59a10b8d2000?auto=format&fit=crop&w=2400&q=85",
    alt: "Carretera moderna iluminada",
    eyebrow: "Movilidad",
    title: "Red vial en crecimiento",
    description:
      "Acceso directo a avenidas principales y nuevas rutas que simplifican los desplazamientos dentro de la ciudad.",
    icon: "road" as const
  },
  {
    background:
      "https://images.unsplash.com/photo-1497366811353-6870744d04b2?auto=format&fit=crop&w=2400&q=85",
    alt: "Espacio corporativo moderno",
    eyebrow: "Entorno empresarial",
    title: "Un ecosistema para los negocios",
    description:
      "Oficinas, servicios, restaurantes y espacios de encuentro reunidos en un entorno pensado para empresas modernas.",
    icon: "building" as const
  },
  {
    background:
      "https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=2400&q=85",
    alt: "Zona de servicios empresariales",
    eyebrow: "Servicios",
    title: "Todo lo que necesitas cerca",
    description:
      "Áreas de reunión, comercios, gastronomía y servicios complementarios disponibles en un mismo entorno.",
    icon: "services" as const
  }
];
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Demostración dinámica de ScrollStory con cuatro items"
    />
    <title>ScrollStory dinámico con Astro y GSAP</title>
  </head>

  <body>
    <header class="site-header">
      <button
        class="site-header__menu"
        type="button"
        aria-label="Abrir menú"
      >
        <span></span>
        <span></span>
      </button>

      <a href="/" class="site-header__brand">
        NEUROLAB
      </a>

      <nav class="site-header__navigation">
        <a href="#">Servicios</a>
        <a href="#">Proyectos</a>
        <a href="#">Contacto</a>
      </nav>
    </header>

    <main>
      <ScrollStory
        cover={cover}
        intro={intro}
        items={items}
        scrub={0.85}
        sceneDistance={1}
        introCardWidth={0.98}
        introCardHeight={0.6}
        sideCardWidth={0.48}
        sideCardHeight={0.82}
      />

      <section class="after-story">
        <span>Fin de la experiencia</span>
        <h2>La página continúa después del wrapper.</h2>
        <p>
          Puedes agregar o quitar objetos del array items sin modificar la
          lógica de GSAP. El progreso, la numeración y la duración se ajustan
          automáticamente.
        </p>
      </section>
    </main>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  html {
    margin: 0;
    padding: 0;
    background: #05091f;
    scroll-behavior: auto;
  }

  body {
    margin: 0;
    padding: 0;
    overflow-x: hidden;
    color: white;
    background: #05091f;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  .site-header {
    position: fixed;
    z-index: 100;
    top: 0;
    left: 0;
    right: 0;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    min-height: 72px;
    padding: 0 clamp(18px, 4vw, 70px);
    color: white;
    pointer-events: none;
  }

  .site-header a,
  .site-header button {
    pointer-events: auto;
  }

  .site-header__menu {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 58px;
    padding: 10px 0;
    color: white;
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .site-header__menu span {
    display: block;
    width: 100%;
    height: 1px;
    background: currentColor;
  }

  .site-header__brand {
    margin-left: clamp(30px, 5vw, 90px);
    color: white;
    font-size: 1.45rem;
    font-weight: 400;
    letter-spacing: 0.28em;
    text-decoration: none;
  }

  .site-header__navigation {
    display: flex;
    gap: clamp(22px, 4vw, 65px);
  }

  .site-header__navigation a {
    color: white;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .after-story {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(40px, 8vw, 130px);
    background:
      radial-gradient(
        circle at 70% 40%,
        rgba(94, 66, 190, 0.25),
        transparent 35%
      ),
      #0b0d19;
  }

  .after-story > span {
    margin-bottom: 25px;
    color: #a996ff;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .after-story h2 {
    max-width: 1000px;
    margin: 0;
    font-size: clamp(3rem, 7vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.06em;
  }

  .after-story p {
    max-width: 650px;
    margin: 35px 0 0;
    color: rgba(255, 255, 255, 0.65);
    font-size: 1.1rem;
    line-height: 1.7;
  }

  @media (max-width: 700px) {
    .site-header {
      grid-template-columns: auto 1fr;
      min-height: 62px;
      padding: 0 18px;
    }

    .site-header__menu {
      width: 42px;
    }

    .site-header__brand {
      justify-self: end;
      margin-left: 0;
      font-size: 1rem;
    }

    .site-header__navigation {
      display: none;
    }
  }
</style>
