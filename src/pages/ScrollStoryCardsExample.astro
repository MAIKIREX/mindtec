---
import ScrollStoryCardsPaged from "../components/scroll/ScrollStoryCardsPaged.astro";

const cards = [
  {
    eyebrow: "Desarrollo",
    title: "Aplicaciones web",
    description:
      "Creamos plataformas rápidas, escalables y fáciles de mantener utilizando Astro, React y arquitecturas modernas.",
    icon: "⌘",
    image: "/images/story/development.jpg",
    imageAlt: "Equipo desarrollando una aplicación web",
    href: "/servicios/desarrollo",
    linkLabel: "Explorar servicio",
    accentColor: "#7dd3fc"
  },
  {
    eyebrow: "Diseño",
    title: "Experiencias digitales",
    description:
      "Diseñamos interfaces claras y atractivas, enfocadas en guiar al usuario y mejorar cada interacción.",
    icon: "✦",
    image: "/images/story/design.jpg",
    imageAlt: "Diseño de una interfaz digital",
    href: "/servicios/diseno",
    accentColor: "#f9a8d4"
  },
  {
    eyebrow: "Datos",
    title: "Decisiones inteligentes",
    description:
      "Transformamos información compleja en paneles, métricas y herramientas que facilitan la toma de decisiones.",
    icon: "⌁",
    image: "/images/story/data.jpg",
    imageAlt: "Visualización de datos",
    href: "/servicios/datos",
    accentColor: "#86efac"
  },
  {
    eyebrow: "Automatización",
    title: "Procesos conectados",
    description:
      "Integramos sistemas, servicios y flujos de trabajo para reducir tareas repetitivas y errores operativos.",
    icon: "⚙",
    image: "/images/story/automation.jpg",
    imageAlt: "Sistema automatizado",
    href: "/servicios/automatizacion",
    accentColor: "#fcd34d"
  }
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Ejemplo Scroll Story Cards</title>
  </head>

  <body>
    <ScrollStoryCardsPaged
      cover={{
        background: "/images/story/cover.jpg",
        alt: "Portada de servicios digitales",
        eyebrow: "Estudio digital",
        title: "Diseñamos experiencias que conectan ideas y personas",
        description:
          "Haz scroll para descubrir nuestras principales áreas de trabajo.",
        scrollLabel: "Descubrir servicios"
      }}
      items={{
        background: "/images/story/items-background.jpg",
        alt: "Fondo de la sección de servicios",
        eyebrow: "Servicios",
        title: "Lo que podemos construir contigo",
        description:
          "Pasa el cursor sobre una tarjeta. En móvil, toca una tarjeta para abrir su descripción."
      }}
      cards={cards}
      scrub={0.9}
      scrollDistance={1.55}
      cardStagger={0.13}
      stepOffset="clamp(14px, 3vh, 38px)"
      cardWidth="clamp(260px, 27vw, 410px)"
      cardHeight="clamp(330px, 50vh, 520px)"
    />

    <section class="after-story">
      <span>Contenido siguiente</span>
      <h2>La página continúa normalmente</h2>
      <p>
        Esta sección sirve para comprobar que ScrollTrigger libera correctamente el scroll
        después de finalizar la transición.
      </p>
    </section>
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; }

  html, body { margin: 0; }

  body {
    color: #f8fafc;
    background: #06131f;
    font-family: Inter, system-ui, sans-serif;
  }

  .after-story {
    display: grid;
    place-content: center;
    min-height: 100svh;
    padding: 48px 24px;
    text-align: center;
    background: #f3f4ef;
    color: #0f172a;
  }

  .after-story span {
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  .after-story h2 {
    max-width: 760px;
    margin: 18px auto 0;
    font-size: clamp(2.4rem, 6vw, 6rem);
    line-height: .95;
    letter-spacing: -.055em;
  }

  .after-story p {
    max-width: 620px;
    margin: 28px auto 0;
    font-size: 1.05rem;
    line-height: 1.7;
  }
</style>
