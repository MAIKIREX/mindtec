      "Emociones puras vs. respuestas filtradas: Mapeamos la actividad biológica espontánea, eliminando la censura social, la cortesía cultural y la intelectualización artificial del participante.",
  },
];

const comparisonRows = [
  {
    before: 'Evaluación de gusto autodeclarativo ("¿Le agrada?")',
    after: "Medición objetiva de la atención focal y respuesta galvánica",
  },
  {
    before: "Respuestas lógicas y justificadas artificialmente",
    after:
      "Captura del procesamiento cognitivo no consciente (fricción o agrado)",
  },
  {
    before: "Interpretación descriptiva y subjetiva del moderador",
    after: "Visualización de datos biométricos estructurados de laboratorio",
  },
  {
    before:
      "Foco grupal (sesgado por la opinión del líder de opinión del focus)",
    after:
      "Auditoría y registros cuantitativos de atención individual por sujeto",
  },
  {
    before: "Decisiones comerciales basadas en preferencias del director",
    after: "Estrategias respaldadas por el comportamiento real de su mercado",
  },
];

const mindtecModelItems = [
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2v7.586a1 1 0 0 1-.293.707l-6.414 6.414a1 1 0 0 0-.293.707V21a1 1 0 0 0 1 1h16a1 1 0 0 0 1-1v-3.586a1 1 0 0 0-.293-.707l-6.414-6.414a1 1 0 0 1-.293-.707V2z"/><line x1="8" y1="2" x2="16" y2="2"/></svg>`,
    title: "Decodificación Psicoantropológica",
