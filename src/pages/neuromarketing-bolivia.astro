---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Estudios de Neuromarketing en Bolivia | Validar Atención y Emoción | Mindtec"
  description="Neuromarketing en Bolivia: eye tracking, EEG y facial coding para validar campañas, packaging y UX antes de invertir. Mindtec."
  keywords="neuromarketing en Bolivia, estudio de neuromarketing Bolivia, eye tracking Bolivia, estudios de neuromarketing para validar campañas y packaging en Bolivia, EEG, facial coding, atención visual, respuesta emocional, biometría"
  headerLightBg={false}
>
  <main>
    <!-- 🟦 1️⃣ HERO -->
    <section class="hero-section" style="padding-bottom: 4rem; padding-top: 4rem;">
      <!-- Geometric floating shapes (always visible, CSS-animated) -->
      <div class="hero-shapes" aria-hidden="true">
        <div class="hero-shape"></div>
        <div class="hero-shape"></div>
        <div class="hero-shape"></div>
        <div class="hero-shape"></div>
        <div class="hero-shape"></div>
        <div class="hero-shape"></div>
        <div class="hero-shape"></div>
        <div class="hero-shape"></div>
        <div class="hero-shape"></div>
        <div class="hero-shape"></div>
        <div class="hero-shape"></div>
        <div class="hero-shape"></div>
        <div class="hero-shape"></div>
        <div class="hero-shape"></div>
        <div class="hero-shape"></div>
        <div class="hero-shape"></div>
      </div>
      <!-- Mobile-first neural canvas background -->
      <div class="hero-mobile-canvas" id="hero-mobile-canvas" aria-hidden="true"></div>
      <div class="container hero-container">
        <div class="hero-content">
          <span class="eyebrow fade-in">MEDICIÓN DEL INCONSCIENTE Y VALIDACIÓN PREVIA</span>
          <h1 class="hero-title" style="font-size: 3.5rem; line-height: 1.25; margin-bottom: 1.5rem;">
            Estudios de Neuromarketing en Bolivia
          </h1>
          <p class="hero-subtitle" style="font-size: 1.25rem; margin-bottom: 1.5rem; max-width: 800px;">
            Antes de invertir en campañas, packaging o piezas creativas, mida lo que el consumidor no verbaliza. El neuromarketing reduce el riesgo al evaluar atención visual, respuesta emocional y aceptación no consciente.
          </p>
          <p style="font-size: 1.1rem; color: rgba(255, 255, 255, 0.75); max-width: 800px; margin-bottom: 2.5rem;">
            Integramos biometría en laboratorio, análisis cultural y validación estratégica para comités de dirección que requieren decisiones comerciales defendibles antes del lanzamiento comercial.
          </p>
          <div class="cta-actions" style="display: flex; flex-wrap: wrap; gap: 1rem; align-items: center;">
            <a href="/contacto" class="btn btn-primary lg">Agendar diagnóstico de neuromarketing</a>
            <a href="/contacto" class="btn btn-navy-outline lg" style="border-color: rgba(255,255,255,0.4); color: #fff;">Evaluar pieza creativa o packaging</a>
          </div>
          <p style="margin-top: 1rem; font-size: 0.9rem; color: #64748b; font-weight: 500;">Sesión inicial: 20 minutos | Confidencial | Sin compromiso</p>
        </div>
      </div>
    </section>

    <!-- MINI NAVEGACIÓN ANCLAS -->
    <div style="background: rgba(11, 43, 64, 0.95); border-bottom: 1px solid rgba(255, 255, 255, 0.08); padding: 1.25rem 0; position: sticky; top: 80px; z-index: 999; backdrop-filter: blur(10px);">
      <div class="container" style="display: flex; flex-wrap: wrap; justify-content: center; gap: 1.5rem; align-items: center; font-size: 0.92rem; font-weight: 600; color: rgba(255, 255, 255, 0.7);">
        <span style="color: var(--color-primary); text-transform: uppercase; font-size: 0.78rem; letter-spacing: 1.5px; font-weight: 800;">En esta página:</span>
        <a href="#problema" style="color: #fff; text-decoration: none; transition: color 0.3s;" onmouseover="this.style.color='var(--color-primary)'" onmouseout="this.style.color='#fff'">Decisión Racional</a>
        <span style="color: rgba(255, 255, 255, 0.3);">|</span>
        <a href="#medicion" style="color: #fff; text-decoration: none; transition: color 0.3s;" onmouseover="this.style.color='var(--color-primary)'" onmouseout="this.style.color='#fff'">Variables de Medición</a>
        <span style="color: rgba(255, 255, 255, 0.3);">|</span>
        <a href="#aplicaciones" style="color: #fff; text-decoration: none; transition: color 0.3s;" onmouseover="this.style.color='var(--color-primary)'" onmouseout="this.style.color='#fff'">Casos de Uso</a>
        <span style="color: rgba(255, 255, 255, 0.3);">|</span>
        <a href="#modelo" style="color: #fff; text-decoration: none; transition: color 0.3s;" onmouseover="this.style.color='var(--color-primary)'" onmouseout="this.style.color='#fff'">Modelo Mindtec</a>
        <span style="color: rgba(255, 255, 255, 0.3);">|</span>
        <a href="#comparativa" style="color: #fff; text-decoration: none; transition: color 0.3s;" onmouseover="this.style.color='var(--color-primary)'" onmouseout="this.style.color='#fff'">Tradicional vs. Neuro</a>
        <span style="color: rgba(255, 255, 255, 0.3);">|</span>
        <a href="#faqs" style="color: #fff; text-decoration: none; transition: color 0.3s;" onmouseover="this.style.color='var(--color-primary)'" onmouseout="this.style.color='#fff'">FAQs</a>
      </div>
    </div>

    <!-- 🟦 2️⃣ EL PROBLEMA REAL -->
    <section id="problema" class="problem-section bg-slate" style="padding: 5rem 0;">
      <div class="container">
        <div class="premium-card-white" style="max-width: 900px; margin: 0 auto; padding: 4rem;">
          <h2 class="text-navy" style="font-size: 2.5rem; margin-bottom: 2rem;">El consumidor decide de forma inconsciente y justifica de forma racional</h2>
          <p class="text-gray-dark leading-relaxed" style="font-size: 1.2rem; margin-bottom: 2rem;">
            El principal riesgo de depender de encuestas tradicionales es que el consumidor tiende a intelectualizar y justificar sus opiniones a posteriori.
          </p>
          <ul class="cap-list" style="margin-bottom: 2.5rem; font-size: 1.1rem;">
            <li>El usuario suele complacer al encuestador en lugar de reportar su comportamiento real.</li>
            <li>Las personas no pueden verbalizar el mapa de calor de su atención en los primeros 3 segundos.</li>
            <li>La respuesta emocional a una tipografía o color de empaque ocurre de forma instantánea.</li>
            <li>La fricción cognitiva (confusión o recelo) se experimenta a nivel neurofisiológico.</li>
          </ul>
          <div style="background-color: var(--color-secondary); color: white; padding: 1.5rem 2rem; border-radius: 8px; font-weight: 600; font-size: 1.2rem; text-align: center;">
            El neuromarketing mide la atención y la emoción directamente antes de que comience el sesgo declarativo.
          </div>
        </div>
      </div>
    </section>

    <!-- 🟦 3️⃣ QUÉ SE MIDE (MÉTRICAS CLARAS Y ASOCIADAS A IMÁGENES) -->
    <section id="medicion" class="premium-section-padding bg-light-gray" style="padding: 5rem 0;">
      <div class="container">
        <div class="section-title-center" style="margin-bottom: 4rem; text-align: center;">
          <h2 class="text-navy" style="font-size: 2.5rem;">Variables biométricas del laboratorio de Mindtec</h2>
          <p class="text-gray-dark" style="font-size: 1.1rem; margin-top: 1rem;">Cuantificamos lo invisible para optimizar la conversión comercial final.</p>
        </div>
        <div class="premium-grid-3">
          <div class="premium-card-white" style="padding: 2.5rem; display: flex; flex-direction: column; justify-content: space-between; min-height: 480px;">
            <div>
              <img src="/eyetracker-mindtec.webp" alt="Eye Tracker en el laboratorio de neuromarketing - Mindtec" class="img-card-visual" loading="lazy" style="height: 180px; width: 100%; object-fit: cover; border-radius: 6px; margin-bottom: 1.5rem;">
              <h3 class="text-primary" style="font-size: 1.25rem; margin-bottom: 1rem; border-bottom: 2px solid rgba(11, 43, 64, 0.06); padding-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                Atención Visual (Eye Tracking)
              </h3>
              <ul class="cap-list text-gray-dark" style="font-size: 0.95rem;">
                <li>Zonas de fijación prioritarias en empaques.</li>
                <li>Orden exacto del flujo de lectura visual.</li>
                <li>Análisis de puntos ciegos o zonas ignoradas.</li>
                <li>Mapas de calor cuantitativos de atención.</li>
              </ul>
            </div>
          </div>

          <div class="premium-card-white" style="padding: 2.5rem; display: flex; flex-direction: column; justify-content: space-between; min-height: 480px;">
            <div>
              <img src="/eeg-mindtec.webp" alt="Electroencefalograma (EEG) en laboratorio - Mindtec" class="img-card-visual" loading="lazy" style="height: 180px; width: 100%; object-fit: cover; border-radius: 6px; margin-bottom: 1.5rem;">
              <h3 class="text-primary" style="font-size: 1.25rem; margin-bottom: 1rem; border-bottom: 2px solid rgba(11, 43, 64, 0.06); padding-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96-.44 2.5 2.5 0 0 1 0-3.12 3 3 0 0 1 0-3.88 2.5 2.5 0 0 1 0-3.12A2.5 2.5 0 0 1 9.5 2Z"/><path d="M14.5 2A2.5 2.5 0 0 0 12 4.5v15a2.5 2.5 0 0 0 4.96-.44 2.5 2.5 0 0 0 0-3.12 3 3 0 0 0 0-3.88 2.5 2.5 0 0 0 0-3.12A2.5 2.5 0 0 0 14.5 2Z"/></svg>
                Respuesta Emocional (EEG & GSR)
              </h3>
              <ul class="cap-list text-gray-dark" style="font-size: 0.95rem;">
                <li>Engagement emocional no consciente al spot publicitario.</li>
                <li>Nivel de fatiga o sobrecarga cognitiva de la interfaz.</li>
                <li>Micro-estímulos que disparan agrado o incomodidad.</li>
                <li>Asociaciones y respuestas electrodermales rápidas.</li>
              </ul>
            </div>
          </div>

          <div class="premium-card-white" style="padding: 2.5rem; display: flex; flex-direction: column; justify-content: space-between; min-height: 480px;">
            <div>
              <img src="/heatmap.webp" alt="Mapa de calor de atención visual - Mindtec" class="img-card-visual" loading="lazy" style="height: 180px; width: 100%; object-fit: cover; border-radius: 6px; margin-bottom: 1.5rem;">
              <h3 class="text-primary" style="font-size: 1.25rem; margin-bottom: 1rem; border-bottom: 2px solid rgba(11, 43, 64, 0.06); padding-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
                Reconocimiento Facial (Facial Coding)
              </h3>
              <ul class="cap-list text-gray-dark" style="font-size: 0.95rem;">
                <li>Análisis de microexpresiones faciales involuntarias.</li>
                <li>Frecuencia de emociones básicas (alegría, sorpresa, confusión).</li>
                <li>Segundos exactos de quiebre dramático en videos.</li>
                <li>Evidencia objetiva de agrado y claridad de pauta.</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 🟦 4️⃣ APLICACIONES (CASOS DE USO) -->
    <section id="aplicaciones" class="premium-section-padding bg-white" style="padding: 5rem 0;">
      <div class="container text-center" style="max-width: 900px;">
        <h2 class="text-navy" style="font-size: 2.5rem; margin-bottom: 3rem;">Escenarios de negocio críticos para Neurociencia</h2>
        
        <div style="text-align: left; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">
          <div class="premium-card-white" style="border-left: 4px solid var(--color-primary); padding: 2rem;">
            <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem;">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#F26522" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
              <h4 style="font-size: 1.15rem; color: #0f172a; margin: 0;">Packaging y Anaquel</h4>
            </div>
            <p class="text-gray-dark" style="font-size: 0.95rem; margin: 0;">Validación de la velocidad de contraste visual y lectura de marca en góndolas reales.</p>
          </div>

          <div class="premium-card-white" style="border-left: 4px solid var(--color-primary); padding: 2rem;">
            <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem;">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#F26522" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5L6 9H2v6h4l5 4V5z"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/></svg>
              <h4 style="font-size: 1.15rem; color: #0f172a; margin: 0;">Spots y Publicidad</h4>
            </div>
            <p class="text-gray-dark" style="font-size: 0.95rem; margin: 0;">Auditoría segundo a segundo de piezas publicitarias audiovisuales antes de la inversión en pauta.</p>
          </div>

          <div class="premium-card-white" style="border-left: 4px solid var(--color-primary); padding: 2rem;">
            <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem;">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#F26522" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
              <h4 style="font-size: 1.15rem; color: #0f172a; margin: 0;">Diseño de Tienda (Retail)</h4>
            </div>
            <p class="text-gray-dark" style="font-size: 0.95rem; margin: 0;">Mapeo de la navegación visual del consumidor al ingresar al circuito de su punto de venta.</p>
          </div>

          <div class="premium-card-white" style="border-left: 4px solid var(--color-primary); padding: 2rem;">
            <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem;">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#F26522" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
              <h4 style="font-size: 1.15rem; color: #0f172a; margin: 0;">UX/UI Digital</h4>
            </div>
            <p class="text-gray-dark" style="font-size: 0.95rem; margin: 0;">Detección de puntos de confusión en pasarelas de pago, aplicaciones de banca o e-commerce.</p>
          </div>

          <div class="premium-card-white" style="border-left: 4px solid var(--color-primary); padding: 2rem;">
            <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem;">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#F26522" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              <h4 style="font-size: 1.15rem; color: #0f172a; margin: 0;">Pre-Rebranding</h4>
            </div>
            <p class="text-gray-dark" style="font-size: 0.95rem; margin: 0;">Validación de la pregnancia y asociación emocional inconsciente del nuevo isotipo.</p>
          </div>
        </div>
        <p style="font-size: 1.4rem; font-weight: 700; color: var(--color-primary); margin-top: 3rem;">
          Tome decisiones respaldadas en el comportamiento biológico de su audiencia.
        </p>
      </div>
    </section>

    <!-- 🟦 5️⃣ MODELO MINDTEC: NEURO + ESTRATEGIA + CULTURA -->
    <section id="modelo" class="premium-section-padding bg-slate" style="padding: 5rem 0;">
      <div class="container">
        <div class="section-title-center" style="max-width: 800px; margin: 0 auto 3rem auto; text-align: center;">
          <h2 class="text-navy" style="font-size: 2.2rem;">El Enfoque Mindtec: Más allá de los datos biométricos</h2>
          <p class="text-gray-dark" style="font-size: 1.1rem; margin-top: 1rem;">Un gráfico plano no cambia la pauta. Traducimos biometría en decisiones tácticas.</p>
        </div>

        <div class="premium-grid-4">
          <div class="premium-card-white text-center" style="padding: 2.5rem 1.5rem;">
            <div style="margin: 0 auto 1.5rem auto; display: inline-flex; justify-content: center; align-items: center; width: 50px; height: 50px; border-radius: 50%; background: rgba(242, 101, 34, 0.08);">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#F26522" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2v7.586a1 1 0 0 1-.293.707l-6.414 6.414a1 1 0 0 0-.293.707V21a1 1 0 0 0 1 1h16a1 1 0 0 0 1-1v-3.586a1 1 0 0 0-.293-.707l-6.414-6.414a1 1 0 0 1-.293-.707V2z"/><line x1="8" y1="2" x2="16" y2="2"/></svg>
            </div>
            <h4 style="font-size: 1.1rem; color: #0f172a; font-weight: 700; margin-bottom: 0.5rem;">Rigurosidad Científica</h4>
            <p class="text-gray-dark" style="font-size: 0.9rem; margin: 0; line-height: 1.5;">Mediciones cuantitativas y calibración individual del hardware en laboratorio.</p>
          </div>

          <div class="premium-card-white text-center" style="padding: 2.5rem 1.5rem;">
            <div style="margin: 0 auto 1.5rem auto; display: inline-flex; justify-content: center; align-items: center; width: 50px; height: 50px; border-radius: 50%; background: rgba(242, 101, 34, 0.08);">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#F26522" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/><line x1="2" y1="20" x2="22" y2="20"/></svg>
            </div>
            <h4 style="font-size: 1.1rem; color: #0f172a; font-weight: 700; margin-bottom: 0.5rem;">Estrategia Comercial</h4>
            <p class="text-gray-dark" style="font-size: 0.9rem; margin: 0; line-height: 1.5;">Traducción de los mapas de calor en cambios inmediatos en el orden y copywriting visual.</p>
          </div>

          <div class="premium-card-white text-center" style="padding: 2.5rem 1.5rem;">
            <div style="margin: 0 auto 1.5rem auto; display: inline-flex; justify-content: center; align-items: center; width: 50px; height: 50px; border-radius: 50%; background: rgba(242, 101, 34, 0.08);">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#F26522" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
            </div>
            <h4 style="font-size: 1.1rem; color: #0f172a; font-weight: 700; margin-bottom: 0.5rem;">Contexto Cultural</h4>
            <p class="text-gray-dark" style="font-size: 0.9rem; margin: 0; line-height: 1.5;">Interpretación matizada según arquetipos, códigos y costumbres del mercado boliviano.</p>
          </div>

          <div class="premium-card-white text-center" style="padding: 2.5rem 1.5rem;">
            <div style="margin: 0 auto 1.5rem auto; display: inline-flex; justify-content: center; align-items: center; width: 50px; height: 50px; border-radius: 50%; background: rgba(242, 101, 34, 0.08);">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#F26522" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <h4 style="font-size: 1.1rem; color: #0f172a; font-weight: 700; margin-bottom: 0.5rem;">Benchmark Real</h4>
            <p class="text-gray-dark" style="font-size: 0.9rem; margin: 0; line-height: 1.5;">Evaluamos sus activos visuales colocados físicamente al lado de la competencia.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 🟦 6️⃣ TABLA COMPARATIVA -->
    <section id="comparativa" class="premium-section-padding bg-white" style="padding: 5rem 0;">
      <div class="container">
        <div class="section-title-center" style="max-width: 800px; margin: 0 auto 3rem auto; text-align: center;">
          <h2 class="text-navy" style="font-size: 2.2rem;">Por qué neuromarketing supera la validación tradicional</h2>
          <p class="text-gray-dark" style="font-size: 1.1rem; margin-top: 1rem;">Mapeamos reacciones neurofisiológicas en lugar de recabar opiniones racionales.</p>
        </div>

        <div class="comparison-table-wrapper">
          <table class="comparison-table">
            <thead>
              <tr>
                <th>Validación e Investigación Tradicional</th>
                <th>Estudio Científico de Neuromarketing Mindtec</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Evaluación de gusto autodeclarativo ("¿Le agrada?")</td>
                <td>Medición objetiva de la atención focal y respuesta galvánica</td>
              </tr>
              <tr>
                <td>Respuestas lógicas y justificadas artificialmente</td>
                <td>Captura del procesamiento cognitivo no consciente (fricción o agrado)</td>
              </tr>
              <tr>
