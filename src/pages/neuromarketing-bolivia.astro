const idealClientItems = [
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M5 21V7l8-4v18"/><path d="M19 21V11l-6-4"/><path d="M9 9h.01M9 13h.01M9 17h.01"/></svg>`,
    title: "01. Marcas de Consumo Masivo",
    description:
      "Gerencias de marketing que aprueban lanzamientos de packaging y campañas de alto presupuesto.",
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20V10"/><path d="m18 20-6-6-6 6"/><path d="M12 4v2"/></svg>`,
    title: "02. Directores de Producto",
    description:
      "Líderes de producto que requieren respaldos científicos sólidos ante juntas de accionistas o directorios.",
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m7 16 4-5 3 3 5-7"/></svg>`,
    title: "03. Firmas en Rebranding",
    description:
      "Compañías en proceso de actualización de marca que desean mitigar el riesgo de perder pregnancia.",
