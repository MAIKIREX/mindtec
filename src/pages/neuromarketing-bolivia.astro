const relatedProductsItems = [
  {
    eyebrow: "SERVICIO RELACIONADO",
    title: "Percepción de Marca",
    description:
      "Audite el posicionamiento y la reputación mental real de su firma en el mercado.",
    href: "/percepcion-de-marca-bolivia/",
  },
  {
    eyebrow: "SERVICIO RELACIONADO",
    title: "Auditoría Retail",
    description:
      "Monitoree el canal físico para validar el cumplimiento de precios y planogramas.",
    href: "/auditoria-retail-bolivia/",
  },
  {
    eyebrow: "SERVICIO RELACIONADO",
    title: "Comportamiento del Consumidor Boliviano",
    description:
      "Datos reales de Mindtec sobre hábitos de compra por región y contexto económico.",
    href: "/comportamiento-consumidor-boliviano/",
  },
];

const faqItems = [
  {
    question: "¿El neuromarketing reemplaza a las encuestas tradicionales?",
    answer:
      "No, actúan en complemento. Las encuestas tradicionales cuantifican y capturan opiniones declarativas conscientes. El neuromarketing audita la atención espontánea, respuesta emocional y rechazo biológico, removiendo sesgos.",
  },
  {
    question: "¿Cuánto tiempo toma un estudio de neuromarketing en Bolivia?",
    answer:
      "Varía según el alcance. Desde auditorías de diseño rápidas en 7 días para piezas específicas, hasta validaciones complejas de 30 días para rediseños integrales de empaques o testeo de campañas.",
  },
  {
    question:
      "¿Pueden realizar estudios combinados con benchmark de competencia?",
    answer:
      "Es la práctica recomendada. Evaluamos sus piezas (anuncios o empaques) colocándolos en paralelo con los competidores líderes, midiendo cuál marca retiene el ojo del consumidor por más tiempo.",
  },
  {
    question:
      "¿Se puede testear el impacto visual en entornos móviles y de desktop?",
    answer:
      "Sí. El Eye Tracker de pantalla de Mindtec se calibra para flujos en e-commerce y aplicaciones móviles, registrando la facilidad de escaneo visual y la fricción que reduce la conversión.",
  },
];
---

<Layout
  title="Estudios de Neuromarketing en Bolivia | Mindtec"
  description="Neuromarketing en Bolivia: eye tracking, EEG y facial coding para validar campañas, packaging y UX antes de invertir. Mindtec."
  headerLightBg={false}
>
  <script type="application/ld+json" slot="head">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Service",
          "name": "Estudios de Neuromarketing en Bolivia",
          "provider": {
            "@type": "LocalBusiness",
            "name": "Mindtec Bolivia"
          },
          "description": "Estudios científicos de neuromarketing en Bolivia usando eye tracking, electroencefalograma (EEG) y codificación facial para validar empaques, publicidad y UX.",
          "areaServed": ["La Paz", "Santa Cruz", "Cochabamba", "El Alto"]
        },
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "Inicio",
              "item": "https://www.mindtecbolivia.com/"
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": "Servicios",
              "item": "https://www.mindtecbolivia.com/servicios"
            },
            {
              "@type": "ListItem",
              "position": 3,
              "name": "Neuromarketing en Bolivia",
              "item": "https://www.mindtecbolivia.com/neuromarketing-bolivia"
            }
          ]
        }
      ]
    }
  </script>
  <script type="application/ld+json" slot="head">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿El neuromarketing reemplaza a las encuestas tradicionales?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No, actúan en complemento. Las encuestas tradicionales cuantifican y capturan opiniones declarativas conscientes. El neuromarketing audita la atención espontánea, respuesta emocional y rechazo biológico, removiendo sesgos."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuánto tiempo toma un estudio de neuromarketing en Bolivia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Varía según el alcance. Desde auditorías de diseño rápidas en 7 días para piezas específicas, hasta validaciones complejas de 30 días para rediseños integrales de empaques o testeo de campañas."
          }
        },
        {
          "@type": "Question",
          "name": "¿Pueden realizar estudios combinados con benchmark de competencia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Es la práctica recomendada. Evaluamos sus piezas (anuncios o empaques) colocándolos en paralelo con los competidores líderes, midiendo cuál marca retiene el ojo del consumidor por más tiempo."
          }
        },
        {
          "@type": "Question",
          "name": "¿Se puede testear el impacto visual en entornos móviles y de desktop?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. El Eye Tracker de pantalla de Mindtec se calibra para flujos en e-commerce y aplicaciones móviles, registrando la facilidad de escaneo visual y la fricción que reduce la conversión."
          }
        }
      ]
    }
  </script>
  <main>
    <StackedSections>
      <!-- 🟦 1️⃣ HERO -->
      <section
        class="hero-section"
        style="padding-bottom: 4rem; padding-top: 4rem;"
        data-stack-section
      >
        <!-- Geometric floating shapes (always visible, CSS-animated) -->
        <div class="hero-shapes" aria-hidden="true">
          <div class="hero-shape"></div>
          <div class="hero-shape"></div>
          <div class="hero-shape"></div>
          <div class="hero-shape"></div>
          <div class="hero-shape"></div>
          <div class="hero-shape"></div>
          <div class="hero-shape"></div>
          <div class="hero-shape"></div>
          <div class="hero-shape"></div>
          <div class="hero-shape"></div>
          <div class="hero-shape"></div>
          <div class="hero-shape"></div>
          <div class="hero-shape"></div>
          <div class="hero-shape"></div>
          <div class="hero-shape"></div>
          <div class="hero-shape"></div>
        </div>
        <!-- Mobile-first neural canvas background -->
        <div
          class="hero-mobile-canvas"
          id="hero-mobile-canvas"
          aria-hidden="true"
        >
        </div>
        <div class="container hero-container">
          <div class="hero-content">
            <span class="eyebrow fade-in"
              >MEDICIÓN DEL INCONSCIENTE Y VALIDACIÓN PREVIA</span
            >
            <span class="freshness-tag">Actualizado: julio 2026</span>
            <h1
              class="hero-title"
              style="font-size: 3.5rem; line-height: 1.25; margin-bottom: 1.5rem;"
            >
              Estudios de Neuromarketing en Bolivia
            </h1>
            <div class="direct-answer-box">
              <strong>En resumen</strong>
              <p>
                Mindtec ofrece estudios científicos de neuromarketing en Bolivia
                usando eye tracking, EEG y codificación facial para validar
                empaques, publicidad y experiencia de usuario antes de invertir
                en producción o pauta masiva.
              </p>
            </div>
            <p
              class="hero-subtitle"
              style="font-size: 1.25rem; margin-bottom: 1.5rem; max-width: 800px;"
            >
              Antes de invertir en campañas, packaging o piezas creativas, mida
              lo que el consumidor no verbaliza. El neuromarketing reduce el
              riesgo al evaluar atención visual, respuesta emocional y
              aceptación no consciente.
            </p>
            <p
              style="font-size: 1.1rem; color: rgba(255, 255, 255, 0.75); max-width: 800px; margin-bottom: 2.5rem;"
            >
              Integramos biometría en laboratorio, análisis cultural &
              validación estratégica para comités de dirección que requieren
              decisiones comerciales defendibles antes del lanzamiento
              comercial.
            </p>
            <div
              class="cta-actions"
              style="display: flex; flex-wrap: wrap; gap: 1rem; align-items: center;"
            >
              <a href="/contacto/" class="btn btn-primary lg"
                >Agendar sesión de diagnóstico (45 min)</a
              >
              <a
                href="/contacto/"
                class="btn btn-navy-outline lg"
                style="border-color: rgba(255,255,255,0.4); color: #fff;"
                >Evaluar pieza creativa o packaging</a
              >
            </div>
            <p
              style="margin-top: 1rem; font-size: 0.9rem; color: #64748b; font-weight: 500;"
            >
              Sesión inicial: 45 minutos | Confidencial | Sin compromiso
            </p>
          </div>
          <div class="hero-visual">
            <div class="glass-card main-visual">
              <div
                class="neuro-visual-bg"
                style="background-image: url('/heroes/hero-neuromarketing-bolivia.jpg');"
              >
              </div>
            </div>
          </div>
        </div>
      </section>

      <div data-stack-section>
        <ServiceVisualSuite variant="neuromarketing" />
      </div>
    </StackedSections>

    <!-- MINI NAVEGACIÓN ANCLAS -->
    <div
      style="background: rgba(11, 43, 64, 0.95); border-bottom: 1px solid rgba(255, 255, 255, 0.08); padding: 1.25rem 0; position: sticky; top: 80px; z-index: 999; backdrop-filter: blur(10px);"
    >
      <div
        class="container"
        style="display: flex; flex-wrap: wrap; justify-content: center; gap: 1.5rem; align-items: center; font-size: 0.92rem; font-weight: 600; color: rgba(255, 255, 255, 0.7);"
      >
        <span
          style="color: var(--color-primary); text-transform: uppercase; font-size: 0.78rem; letter-spacing: 1.5px; font-weight: 800;"
          >En esta página:</span
        >
        <a
          href="#problema"
          style="color: #fff; text-decoration: none; transition: color 0.3s;"
          onmouseover="this.style.color='var(--color-primary)'"
          onmouseout="this.style.color='#fff'">Decisión Racional</a
        >
        <span style="color: rgba(255, 255, 255, 0.3);">|</span>
        <a
          href="#medicion"
          style="color: #fff; text-decoration: none; transition: color 0.3s;"
          onmouseover="this.style.color='var(--color-primary)'"
          onmouseout="this.style.color='#fff'">Variables de Medición</a
        >
        <span style="color: rgba(255, 255, 255, 0.3);">|</span>
        <a
          href="#aplicaciones"
          style="color: #fff; text-decoration: none; transition: color 0.3s;"
          onmouseover="this.style.color='var(--color-primary)'"
          onmouseout="this.style.color='#fff'">Casos de Uso</a
        >
        <span style="color: rgba(255, 255, 255, 0.3);">|</span>
        <a
          href="#modelo"
          style="color: #fff; text-decoration: none; transition: color 0.3s;"
          onmouseover="this.style.color='var(--color-primary)'"
          onmouseout="this.style.color='#fff'">Modelo Mindtec</a
        >
        <span style="color: rgba(255, 255, 255, 0.3);">|</span>
        <a
          href="#comparativa"
          style="color: #fff; text-decoration: none; transition: color 0.3s;"
          onmouseover="this.style.color='var(--color-primary)'"
          onmouseout="this.style.color='#fff'">Tradicional vs. Neuro</a
        >
        <span style="color: rgba(255, 255, 255, 0.3);">|</span>
        <a
          href="#faqs"
          style="color: #fff; text-decoration: none; transition: color 0.3s;"
          onmouseover="this.style.color='var(--color-primary)'"
          onmouseout="this.style.color='#fff'">FAQs</a
        >
      </div>
    </div>

    <StackedSections>
      <!-- 🟦 2️⃣ EL PROBLEMA REAL -->
      <section
        id="problema"
        class="bg-slate"
        style="padding: 5rem 0;"
        data-stack-section
      >
        <div class="container">
          <div style="max-width: 900px; margin: 0 auto;">
            <span class="eyebrow">EL PROBLEMA REAL</span>
            <h2
              class="text-navy"
              style="font-size: 2.5rem; margin-top: 1rem; margin-bottom: 2rem; line-height: 1.2;"
            >
              Focus groups tradicionales: El arte involuntario de mentir por
              cortesía
            </h2>
            <p
              class="text-gray-dark leading-relaxed"
              style="font-size: 1.2rem; margin-bottom: 2rem;"
            >
              Confiar el lanzamiento de un empaque o una costosa pauta
              publicitaria a la opinión lógica de un focus group tradicional es
              sumamente riesgoso. El consumidor no compra con la lógica; decide
              en milisegundos a nivel inconsciente y luego justifica
              racionalmente su acción. En una sala de reuniones, los
              participantes tienden a responder bajo el sesgo de complacencia o
              a seguir la opinión del miembro más ruidoso del grupo.
            </p>
            <p
              class="text-gray-dark leading-relaxed"
              style="font-size: 1.1rem; line-height: 1.7; font-weight: 600;"
            >
              La respuesta neurofisiológica inconsciente es el único predictor
              real de éxito de su pauta o packaging:
            </p>
          </div>

          <AreaPanelCards
            items={problemScenarios}
            columns={3}
            theme="navy"
            class="problem-panels"
          />

          <div
            style="max-width: 900px; margin: 2.5rem auto 0; background: var(--color-secondary); color: #fff; padding: 1.5rem 2rem; border-radius: var(--radius-md, 8px); font-weight: 600; font-size: 1.1rem; text-align: center;"
          >
            No le pregunte al cliente si comprará su producto. Mida la reacción
            de su cerebro ante él.
          </div>
        </div>
      </section>

      <!-- 🟦 3️⃣ QUÉ SE MIDE (MÉTRICAS CLARAS Y ASOCIADAS A IMÁGENES) -->
      <section
        id="medicion"
        class="measurement-section bg-light-gray"
        data-stack-section
      >
        <div class="container measurement-section__intro">
          <div class="section-title-center" style="text-align: center;">
            <h2 class="text-navy" style="font-size: 2.5rem; line-height: 1.2;">
              Métricas de laboratorio: Traduciendo biometría en ahorro
              presupuestario
            </h2>
            <p
              class="text-gray-dark"
              style="font-size: 1.1rem; margin-top: 1rem;"
            >
              Optimice su presupuesto de marketing masivo e impresión validando
              científicamente el impacto en milisegundos.
            </p>
          </div>
        </div>

        <div class="measurement-windows">
          <article class="measurement-window">
            <div class="measurement-window__content">
              <div class="measurement-window__copy">
                <span class="measurement-window__eyebrow">01 / Atención</span>
                <h3 class="text-primary">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"
                    ></path><circle cx="12" cy="12" r="3"></circle></svg
                  >
                  Atención Visual (Eye Tracking)
                </h3>
                <ul class="cap-list text-gray-dark" style="font-size: 0.95rem;">
                  <li>
                    <strong class="text-navy"
                      >Ahorro en pauta publicitaria:</strong
                    > Compruebe que el logotipo, marca y llamada a la acción realmente
                    capturen la mirada en los primeros segundos, evitando desperdiciar
                    presupuesto en spots ineficaces.
                  </li>
                  <li>
                    <strong class="text-navy">Mapas de fijación reales:</strong> Mapee
                    el flujo ocular exacto en empaques para reordenar la jerarquía
                    gráfica antes de iniciar la impresión a gran escala.
                  </li>
                  <li>
                    <strong class="text-navy"
                      >Detección de puntos ciegos:</strong
                    > Aísle las zonas de su diseño que pasan completamente desapercibidas
                    y no aportan a la decisión de compra.
                  </li>
                </ul>
              </div>
            </div>
            <div class="measurement-window__media">
              <img
                src="/laboratorio/IMG 3.jpg"
                alt="Eye Tracker en el laboratorio de neuromarketing - Mindtec"
                loading="lazy"
              />
            </div>
          </article>

          <article class="measurement-window measurement-window--reverse">
            <div class="measurement-window__content">
              <div class="measurement-window__copy">
                <span class="measurement-window__eyebrow">02 / Emoción</span>
                <h3 class="text-primary">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
