---
import Layout from "../layouts/Layout.astro";
import ServiceVisualSuite from "../components/sections/ServiceVisualSuite.astro";
import HoverStepCards from "../components/cards/HoverStepCards.astro";
import StackedSections from "../components/scroll/StackedSections.astro";
import ComparisonRows from "../components/cards/ComparisonRows.astro";

const audienceCards = [
  {
    eyebrow: "Marketing & Brand",
    title: "CMOs y Gerentes de Marketing",
    description:
      "Valida campañas, entiende qué percibe el mercado de tu marca y detecta dónde tu posicionamiento se desvía de la realidad del consumidor.",
    services: [
      "Diagnóstico de Marca",
      "Código del Consumidor",
      "Validación Neurocientífica",
      "Monitor de Marca",
      "Radar Competitivo",
    ],
  },
  {
    eyebrow: "Producto & Innovación",
    title: "Directores de Producto",
    description:
      "Lanza con certeza. Valida conceptos, precios y empaques con respuesta real del consumidor antes de comprometer el presupuesto de desarrollo.",
    services: [
      "Mapa Integral del Consumidor",
      "Validación Neurocientífica",
      "Focus Group MindTEC",
      "Perfil de Audiencias IA",
      "Sprint de Estrategia de Marca",
    ],
  },
  {
    eyebrow: "Ventas & Comercial",
    title: "Directores Comerciales",
    description:
      "Entiende por qué el equipo de campo pierde ventas en el punto de contacto y qué hace tu competencia en el canal que tú no estás viendo.",
    services: [
      "Auditoría de Experiencia en PDV",
      "Censo Estratégico de PDV",
      "Shopper Insights",
      "Radar Competitivo",
      "Monitor de Marca",
    ],
  },
  {
    eyebrow: "ONG & Cooperación Internacional",
    title: "Coordinadores de Proyectos y M&E",
    description:
      "Líneas de base, evaluaciones de impacto, estudios CAP y percepción de programas, con metodología validada para reportes a donantes.",
    services: [
      "Mapa Integral del Consumidor (Línea de Base)",
      "Código del Consumidor (Estudio CAP)",
      "Taller de Activación Estratégica",
      "Evaluaciones de Impacto",
      "Research Lab con IA",
    ],
  },
  {
    eyebrow: "Estado & Sector Público",
    title: "Equipos de Licitación (SICOES)",
    description:
      "Respondemos a TDRs y licitaciones SICOES con propuestas técnicas estructuradas, cronogramas, diseño muestral y entregables ejecutivos.",
    services: [
      "Consultoría por Producto (SICOES)",
      "Estudio de Mercado sectorial",
      "Censo de PDV y canal",
      "Diagnóstico de percepción de servicios públicos",
      "Línea de Base para programas sociales",
    ],
  },
];

const title = "Servicios de Investigación de Mercados en Bolivia | Mindtec";
const description =
  "Explore el catálogo de servicios de investigación de mercados en Bolivia. Soluciones de Research, Intelligence, Retail y Strategy con IA y neurociencia.";
---

<Layout
  title={title}
  description={description}
  headerLightBg={false}
  canonicalUrl="/servicios/"
>
  <script type="application/ld+json" slot="head">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "ItemList",
          "name": "Servicios MindTEC Bolivia",
          "description": "Catálogo de servicios de investigación de mercados, inteligencia competitiva, retail analytics y estrategia de marca en Bolivia.",
          "url": "https://www.mindtecbolivia.com/servicios",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "Focus Group en Bolivia",
              "url": "https://www.mindtecbolivia.com/focus-group-bolivia"
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": "Mapa Integral del Consumidor",
              "url": "https://www.mindtecbolivia.com/estudio-de-mercado-bolivia"
            },
            {
              "@type": "ListItem",
              "position": 3,
              "name": "Radar Competitivo",
              "url": "https://www.mindtecbolivia.com/benchmarking-competitivo-bolivia"
            },
            {
              "@type": "ListItem",
              "position": 4,
              "name": "Diagnóstico de Marca",
              "url": "https://www.mindtecbolivia.com/percepcion-de-marca-bolivia"
            },
            {
              "@type": "ListItem",
              "position": 5,
              "name": "Auditoría de Experiencia en PDV",
              "url": "https://www.mindtecbolivia.com/cliente-misterioso-bolivia"
            },
            {
              "@type": "ListItem",
              "position": 6,
              "name": "Shopper Insights",
              "url": "https://www.mindtecbolivia.com/shopper-insights-bolivia"
            },
            {
              "@type": "ListItem",
              "position": 7,
              "name": "Auditoría Retail",
              "url": "https://www.mindtecbolivia.com/auditoria-retail-bolivia"
            },
            {
              "@type": "ListItem",
              "position": 8,
              "name": "Validación Neurocientífica",
              "url": "https://www.mindtecbolivia.com/neuromarketing-bolivia"
            },
            {
              "@type": "ListItem",
              "position": 9,
              "name": "Inteligencia de Mercados B2B",
              "url": "https://www.mindtecbolivia.com/inteligencia-de-mercados-b2b-bolivia"
            },
            {
              "@type": "ListItem",
              "position": 10,
              "name": "Neuromarketing para Empresas",
              "url": "https://www.mindtecbolivia.com/neuromarketing-para-empresas-bolivia"
            }
          ]
        },
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "Inicio",
              "item": "https://www.mindtecbolivia.com/"
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": "Servicios",
              "item": "https://www.mindtecbolivia.com/servicios"
            }
          ]
        }
      ]
    }
  </script>

  <main>
    <StackedSections>
    <!-- 1. HERO -->
    <section
      class="hero-section"
      style="padding-bottom: 4rem; padding-top: 4rem;"
      data-stack-section
    >
      <div class="hero-shapes" aria-hidden="true">
        <div class="hero-shape"></div><div class="hero-shape"></div><div
          class="hero-shape"
        >
        </div>
        <div class="hero-shape"></div><div class="hero-shape"></div><div
          class="hero-shape"
        >
        </div>
        <div class="hero-shape"></div><div class="hero-shape"></div><div
          class="hero-shape"
        >
        </div>
        <div class="hero-shape"></div><div class="hero-shape"></div><div
          class="hero-shape"
        >
        </div>
        <div class="hero-shape"></div><div class="hero-shape"></div><div
          class="hero-shape"
        >
        </div>
        <div class="hero-shape"></div>
      </div>
      <div
        class="hero-mobile-canvas"
        id="hero-mobile-canvas"
        aria-hidden="true"
      >
      </div>
      <div class="container hero-container">
        <div class="hero-content">
          <span class="eyebrow fade-in">CATÁLOGO DE SERVICIOS MINDTEC</span>
          <h1
            class="hero-title"
            style="font-size: 3.5rem; line-height: 1.25; margin-bottom: 1.5rem;"
          >
            Investigación que termina en decisiones, no en archivos.
          </h1>
          <p
            class="hero-subtitle"
            style="font-size: 1.25rem; margin-bottom: 1.5rem; max-width: 580px;"
          >
            Research, Intelligence, Retail y Strategy — cuatro líneas, un solo
            estándar: evidencia que mueve decisiones de directorio.
          </p>
          <div
            style="display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 2rem 0;"
          >
            <span
              style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.25); color: #fff; padding: 0.4rem 1rem; border-radius: 20px; font-size: 0.85rem; font-weight: 600; letter-spacing: 0.5px;"
              >Research</span
            >
            <span
              style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.25); color: #fff; padding: 0.4rem 1rem; border-radius: 20px; font-size: 0.85rem; font-weight: 600; letter-spacing: 0.5px;"
              >Intelligence</span
            >
            <span
              style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.25); color: #fff; padding: 0.4rem 1rem; border-radius: 20px; font-size: 0.85rem; font-weight: 600; letter-spacing: 0.5px;"
              >Retail</span
            >
            <span
              style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.25); color: #fff; padding: 0.4rem 1rem; border-radius: 20px; font-size: 0.85rem; font-weight: 600; letter-spacing: 0.5px;"
              >Strategy</span
            >
            <span
              style="background: rgba(242,101,34,0.2); border: 1px solid rgba(242,101,34,0.4); color: #F26522; padding: 0.4rem 1rem; border-radius: 20px; font-size: 0.85rem; font-weight: 600; letter-spacing: 0.5px;"
              >Neuromarketing</span
            >
            <span
              style="background: rgba(242,101,34,0.2); border: 1px solid rgba(242,101,34,0.4); color: #F26522; padding: 0.4rem 1rem; border-radius: 20px; font-size: 0.85rem; font-weight: 600; letter-spacing: 0.5px;"
              >IA Aplicada</span
            >
          </div>
          <a href="/contacto" class="btn btn-primary lg"
            >Agendar diagnóstico estratégico (45 min) →</a
          >
        </div>
        <div class="hero-visual">
          <div class="glass-card main-visual">
            <div
              class="neuro-visual-bg"
              style="background-image: url('/imagenes-mindtec/generated/investigacion-profunda-hero.png');"
            >
            </div>
          </div>
        </div>
      </div>
    </section>

    <div data-stack-section>
      <ServiceVisualSuite variant="catalogo" />
    </div>

    <!-- 2. FILTRO POR ROL -->
      <section
        data-stack-section
        class="problem-section bg-slate"
        style="padding: 3rem 0;"
      >
        <div class="container" style="text-align: center;">
          <p
            class="text-gray-dark"
            style="font-size: 1rem; font-weight: 600; margin-bottom: 1.5rem; text-transform: uppercase; letter-spacing: 1px;"
          >
            ¿Desde qué área trabajas?
          </p>
          <div
            id="filtro-roles"
            style="display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center;"
          >
            <button
              data-rol="todos"
              data-panel="research"
              class="rol-activo"
              style="padding: 0.6rem 1.25rem; border: 2px solid var(--color-primary); border-radius: 6px; background: var(--color-primary); color: #fff; font-weight: 700; font-size: 0.9rem; cursor: pointer;"
              >Ver todo</button
            >
            <button
              data-rol="marketing"
              data-panel="research"
              style="padding: 0.6rem 1.25rem; border: 2px solid rgba(11, 43, 64, 0.15); border-radius: 6px; background: transparent; color: var(--color-secondary); font-weight: 600; font-size: 0.9rem; cursor: pointer;"
              >Marketing</button
            >
            <button
              data-rol="producto"
              data-panel="research"
              style="padding: 0.6rem 1.25rem; border: 2px solid rgba(11, 43, 64, 0.15); border-radius: 6px; background: transparent; color: var(--color-secondary); font-weight: 600; font-size: 0.9rem; cursor: pointer;"
              >Producto</button
            >
            <button
              data-rol="ventas"
              data-panel="retail"
              style="padding: 0.6rem 1.25rem; border: 2px solid rgba(11, 43, 64, 0.15); border-radius: 6px; background: transparent; color: var(--color-secondary); font-weight: 600; font-size: 0.9rem; cursor: pointer;"
              >Ventas / Comercial</button
            >
            <button
              data-rol="ong"
              data-panel="research"
              style="padding: 0.6rem 1.25rem; border: 2px solid rgba(11, 43, 64, 0.15); border-radius: 6px; background: transparent; color: var(--color-secondary); font-weight: 600; font-size: 0.9rem; cursor: pointer;"
              >ONG / Cooperación</button
            >
            <button
              data-rol="estado"
              data-panel="strategy"
              style="padding: 0.6rem 1.25rem; border: 2px solid rgba(11, 43, 64, 0.15); border-radius: 6px; background: transparent; color: var(--color-secondary); font-weight: 600; font-size: 0.9rem; cursor: pointer;"
              >Estado / Licitación</button
            >
          </div>
        </div>
      </section>

      <!-- 3. CATÁLOGO CON TABS -->

      <section
        data-stack-section
        class="catalog-section"
        style="padding: 5rem 0;"
      >
        <div class="container">
          <div
            class="section-title-center"
            style="text-align: center; margin-bottom: 3rem;"
          >
            <span class="eyebrow">CATÁLOGO COMPLETO</span>
            <h2
              class="text-navy"
              style="font-size: 2.5rem; line-height: 1.2; margin-top: 1rem; margin-bottom: 1rem;"
            >
              Elige el servicio que resuelve la decisión que necesitas tomar.
            </h2>
            <p
              class="text-gray-dark"
              style="font-size: 1.1rem; max-width: 700px; margin: 0 auto;"
            >
              Cada línea tiene un punto de entrada bajo y un techo premium.
              Empieza donde tengas certeza y escala cuando veas el valor.
            </p>
          </div>

          <!-- Tabs de línea -->
          <div
            id="tabs-linea"
            role="tablist"
            style="display: flex; gap: 0; border-bottom: 2px solid #e2e8f0; margin-bottom: 3rem; overflow-x: auto;"
          >
            <button
              role="tab"
              data-panel="research"
              aria-selected="true"
              aria-controls="panel-research"
              style="padding: 1rem 2rem; border: none; border-bottom: 3px solid var(--color-primary); background: none; font-weight: 800; font-size: 1rem; color: var(--color-primary); cursor: pointer; white-space: nowrap; margin-bottom: -2px;"
              >Research</button
            >
            <button
              role="tab"
              data-panel="intelligence"
              aria-selected="false"
              aria-controls="panel-intelligence"
              style="padding: 1rem 2rem; border: none; border-bottom: 3px solid transparent; background: none; font-weight: 700; font-size: 1rem; color: #64748b; cursor: pointer; white-space: nowrap; margin-bottom: -2px;"
              >Intelligence</button
            >
            <button
              role="tab"
              data-panel="retail"
              aria-selected="false"
              aria-controls="panel-retail"
              style="padding: 1rem 2rem; border: none; border-bottom: 3px solid transparent; background: none; font-weight: 700; font-size: 1rem; color: #64748b; cursor: pointer; white-space: nowrap; margin-bottom: -2px;"
              >Retail</button
            >
            <button
              role="tab"
              data-panel="strategy"
              aria-selected="false"
              aria-controls="panel-strategy"
              style="padding: 1rem 2rem; border: none; border-bottom: 3px solid transparent; background: none; font-weight: 700; font-size: 1rem; color: #64748b; cursor: pointer; white-space: nowrap; margin-bottom: -2px;"
              >Strategy</button
            >
          </div>

          <!-- PANEL RESEARCH -->
          <div id="panel-research" role="tabpanel" aria-hidden="false">
            <div
              style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 3rem; align-items: center; margin-bottom: 3rem;"
            >
              <div>
                <h3
                  class="text-navy"
                  style="font-size: 1.8rem; margin-bottom: 1rem;"
                >
                  Research — Investigación Profunda
                </h3>
                <p
                  class="text-gray-dark"
                  style="font-size: 1.05rem; margin-bottom: 1.5rem; line-height: 1.6;"
                >
                  Más allá de lo que dicen. Hasta lo que realmente mueve la
                  decisión.
                </p>
                <p
                  class="text-gray-dark"
                  style="font-size: 0.95rem; margin-bottom: 2rem; color: var(--color-text-muted); line-height: 1.6;"
                >
                  Combinamos psicoantropología, sensores biométricos avanzadas e
                  inteligencia artificial para extraer motivadores profundos de
                  consumo que los focus groups y encuestas convencionales pasan
                  por alto.
                </p>
                <a
                  href="/contacto"
                  class="btn btn-primary"
                  style="font-size: 0.9rem;">Consultar sobre Research →</a
                >
              </div>
              <div
                class="research-visual"
                style="position: relative; overflow: hidden; border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); border: 1px solid rgba(11, 43, 64, 0.08); max-width: 540px; justify-self: center; width: 100%;"
              >
                <img
                  src="/imagenes-mindtec/generated/investigacion-profunda.png"
                  alt="Analistas de Mindtec investigando profundamente con heatmaps y biometría"
                  style="width: 100%; height: 280px; object-fit: cover; border-radius: inherit; display: block; filter: saturate(1.02) contrast(1.02);"
                  loading="lazy"
                />
                <div
                  style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(6, 28, 43, 0) 40%, rgba(6, 28, 43, 0.82) 100%); pointer-events: none;"
                >
                </div>
                <div
                  style="position: absolute; left: 1.5rem; bottom: 1.5rem; z-index: 2; color: #fff;"
                >
                  <span
                    style="display: inline-block; padding: 4px 10px; background: var(--color-primary); border-radius: 4px; font-family: var(--font-display); font-size: 0.7rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 0.5rem;"
                    >Neuro-Research</span
                  >
                  <strong
                    style="display: block; font-size: 1.1rem; font-family: var(--font-display); font-weight: 700; color: #ffffff;"
                    >Modelos de comportamiento basados en biometría e IA</strong
                  >
                </div>
              </div>
            </div>
            <div class="catalog-services-grid" data-catalog-services>
              <!-- R1 -->
              <article class="premium-card-white" style="padding: 2rem;">
                <header
                  style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;"
                >
                  <span
                    style="background: rgba(11,43,64,0.08); color: var(--color-secondary); font-size: 0.75rem; font-weight: 800; padding: 0.25rem 0.75rem; border-radius: 4px; text-transform: uppercase; letter-spacing: 0.5px;"
                    >Estratégico</span
                  >
                  <button
                    aria-expanded="false"
                    aria-controls="detalle-r1"
                    class="arrow-btn"
                    style="background: none; border: 1px solid #e2e8f0; border-radius: 4px; width: 28px; height: 28px; cursor: pointer; font-size: 1rem; color: #64748b;"
                    >▾</button
                  >
                </header>
                <p
                  style="font-size: 0.8rem; color: #94a3b8; margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 0.5px;"
                >
                  Estudio de mercado cualitativo en Bolivia
                </p>
                <h4 style="font-size: 1.1rem; margin: 0; line-height: 1.3;">
                  <a
                    href="/estudio-de-mercado-bolivia"
                    class="text-navy"
                    style="text-decoration: none;"
                    >Mapa Integral del Consumidor</a
                  >
                </h4>
                <div style="margin-top: 0.75rem;">
                  <button
                    aria-expanded="false"
                    aria-controls="detalle-r1"
                    class="ver-mas-btn"
                  >
                    Ver detalles <span style="font-size: 0.75rem;">▾</span>
                  </button>
                </div>
                <div
                  id="detalle-r1"
                  hidden
                  style="margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid #f1f5f9;"
                >
                  <p style="margin-bottom: 0.5rem;">
                    <strong class="text-navy">MindTEC +</strong>
                  </p>
                  <p
                    class="text-gray-dark"
                    style="font-size: 0.95rem; margin-bottom: 1rem; line-height: 1.6;"
                  >
                    Etnografía profunda + entrevistas a profundidad + análisis
                    de IA. El modelo estándar pregunta qué compra el consumidor.
                    Nosotros llegamos hasta por qué lo compra, cómo lo siente y
                    qué le impediría cambiar.
                  </p>
                  <blockquote
                    style="border-left: 3px solid var(--color-primary); padding-left: 1rem; margin: 1rem 0; font-style: italic; color: #475569; font-size: 0.9rem;"
                  >
                    "Pasamos de reportes descriptivos a mapas de decisión que
                    nuestro directorio entendió y usó en la primera reunión."
                  </blockquote>
                  <p style="margin-bottom: 0.5rem;">
                    <strong class="text-navy">Aplica para</strong>
                  </p>
                  <ul
                    class="cap-list"
                    style="font-size: 0.9rem; margin-bottom: 1rem;"
                  >
                    <li>Empresas que lanzan un producto o categoría nueva</li>
                    <li>
                      Equipos de marketing que no conocen el ecosistema de
                      decisión del consumidor
                    </li>
                  </ul>
                  <a
                    href="/estudio-de-mercado-bolivia"
                    class="text-primary"
                    style="font-weight: 700; font-size: 0.9rem; text-decoration: none;"
                    >Ver este servicio →</a
                  >
                </div>
              </article>

              <!-- R2 -->
              <article class="premium-card-white" style="padding: 2rem;">
                <header
                  style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;"
                >
                  <span
                    style="background: rgba(242,101,34,0.1); color: var(--color-primary); font-size: 0.75rem; font-weight: 800; padding: 0.25rem 0.75rem; border-radius: 4px; text-transform: uppercase; letter-spacing: 0.5px;"
                    >Premium</span
                  >
                  <button
                    aria-expanded="false"
                    aria-controls="detalle-r2"
                    class="arrow-btn"
                    style="background: none; border: 1px solid #e2e8f0; border-radius: 4px; width: 28px; height: 28px; cursor: pointer; font-size: 1rem; color: #64748b;"
                    >▾</button
                  >
                </header>
                <p
                  style="font-size: 0.8rem; color: #94a3b8; margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 0.5px;"
                >
                  Investigación psicoantropológica del consumidor boliviano
                </p>
                <h4 style="font-size: 1.1rem; margin: 0; line-height: 1.3;">
                  <a
                    href="/estudio-de-mercado-bolivia"
                    class="text-navy"
                    style="text-decoration: none;">Código del Consumidor</a
                  >
                </h4>
                <div style="margin-top: 0.75rem;">
                  <button
                    aria-expanded="false"
                    aria-controls="detalle-r2"
                    class="ver-mas-btn"
                  >
                    Ver detalles <span style="font-size: 0.75rem;">▾</span>
                  </button>
                </div>
                <div
                  id="detalle-r2"
                  hidden
                  style="margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid #f1f5f9;"
                >
                  <p style="margin-bottom: 0.5rem;">
                    <strong class="text-navy">MindTEC +</strong>
                  </p>
                  <p
                    class="text-gray-dark"
                    style="font-size: 0.95rem; margin-bottom: 1rem; line-height: 1.6;"
                  >
                    Metodología propietaria de decodificación cultural. Cruzamos
                    patrones lingüísticos, simbología implícita y mapas de
                    valores con análisis semiótico para extraer el código que
                    mueve la decisión de compra más allá de la racionalización.
                  </p>
                  <blockquote
                    style="border-left: 3px solid var(--color-primary); padding-left: 1rem; margin: 1rem 0; font-style: italic; color: #475569; font-size: 0.9rem;"
