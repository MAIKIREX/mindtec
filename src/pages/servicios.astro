  <script>
    // --- TABS DE LÍNEA ---
    const tabs = document.querySelectorAll('[role="tab"]');
    const panels = document.querySelectorAll('[role="tabpanel"]');

    function activarTab(panelId) {
      tabs.forEach(tab => {
        const activo = tab.dataset.panel === panelId;
        tab.setAttribute('aria-selected', activo ? 'true' : 'false');
        tab.style.color = activo ? 'var(--color-primary)' : '#64748b';
        tab.style.fontWeight = activo ? '800' : '700';
        tab.style.borderBottomColor = activo ? 'var(--color-primary)' : 'transparent';
      });
      panels.forEach(panel => {
        const visible = panel.id === 'panel-' + panelId;
        panel.setAttribute('aria-hidden', visible ? 'false' : 'true');
        if (visible) {
          panel.removeAttribute('hidden');
        } else {
          panel.setAttribute('hidden', '');
        }
      });
    }

    tabs.forEach(tab => {
      tab.addEventListener('click', () => activarTab(tab.dataset.panel));
    });

    // Estado inicial
    activarTab('research');

    // --- FILTRO DE ROL ---
    const botonesRol = document.querySelectorAll('[data-rol]');

    botonesRol.forEach(btn => {
      btn.addEventListener('click', () => {
        botonesRol.forEach(b => {
          b.style.background = 'transparent';
          b.style.color = 'var(--color-secondary)';
          b.style.borderColor = 'rgba(11, 43, 64, 0.15)';
        });
        btn.style.background = 'var(--color-primary)';
        btn.style.color = '#fff';
        btn.style.borderColor = 'var(--color-primary)';
        activarTab(btn.dataset.panel);
      });
    });

    // --- EXPANSIÓN DE PRODUCTO-CARDS ---
    const botonesCard = document.querySelectorAll('article button[aria-controls]');

    botonesCard.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const card = btn.closest('article');
        const targetId = btn.getAttribute('aria-controls');
        if (!targetId || !targetId.startsWith('detalle-')) return;
        const detalle = document.getElementById(targetId);
        if (!detalle) return;

        const estaCerrado = detalle.hidden; // true si está cerrado

        const panelActual = card.closest('[role="tabpanel"]');

        // 1. Cerrar todos los demás paneles en este tab-panel
        panelActual.querySelectorAll('[id^="detalle-"]').forEach(otroDetalle => {
          if (otroDetalle.id !== targetId) {
            otroDetalle.hidden = true;
            // Restaurar todos los botones asociados de los otros paneles a estado colapsado
            const otrosBotones = panelActual.querySelectorAll(`button[aria-controls="${otroDetalle.id}"]`);
            otrosBotones.forEach(b => {
              b.setAttribute('aria-expanded', 'false');
              if (b.classList.contains('arrow-btn')) {
                b.textContent = '▾';
              } else {
                b.innerHTML = 'Ver detalles <span style="font-size: 0.75rem;">▾</span>';
              }
            });
          }
        });

        // 2. Toggle del panel actual y sincronización de sus botones
        if (estaCerrado) {
          // Abrir/Expandir
          detalle.hidden = false;
          const botonesAsociados = panelActual.querySelectorAll(`button[aria-controls="${targetId}"]`);
          botonesAsociados.forEach(b => {
            b.setAttribute('aria-expanded', 'true');
            if (b.classList.contains('arrow-btn')) {
              b.textContent = '▴';
            } else {
              b.innerHTML = 'Ocultar detalles <span style="font-size: 0.75rem;">▴</span>';
            }
          });
        } else {
          // Cerrar/Colapsar
          detalle.hidden = true;
          const botonesAsociados = panelActual.querySelectorAll(`button[aria-controls="${targetId}"]`);
          botonesAsociados.forEach(b => {
            b.setAttribute('aria-expanded', 'false');
            if (b.classList.contains('arrow-btn')) {
              b.textContent = '▾';
            } else {
              b.innerHTML = 'Ver detalles <span style="font-size: 0.75rem;">▾</span>';
            }
          });
        }
      });
    });
  </script>

