      text-transform: uppercase;
    }

    .catalog-service-selector-title {
      font-size: 0.94rem;
      font-weight: 800;
      line-height: 1.3;
    }

    .catalog-service-selector-desc {
      margin-top: 0.25rem;
      overflow: hidden;
      color: rgba(255, 255, 255, 0.48);
      font-size: 0.76rem;
      line-height: 1.35;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .catalog-services-grid .premium-card-white {
      grid-column: 2;
      grid-row: 1;
      width: 100%;
      min-height: 100%;
      margin: 0;
      border: 1px solid rgba(11, 43, 64, 0.1);
      box-shadow: 0 1.5rem 3rem rgba(6, 28, 43, 0.1);
    }

    .catalog-services-grid .premium-card-white[hidden] {
      display: none;
    }

    .catalog-services-grid .premium-card-white .arrow-btn,
    .catalog-services-grid .premium-card-white .ver-mas-btn {
      display: none;
    }

    .catalog-services-grid .premium-card-white [id^="detalle-"] {
      display: block;
    }

    .catalog-services-grid .premium-card-white [id^="detalle-"][hidden] {
      display: block;
    }

    @media (max-width: 900px) {
      .catalog-services-grid {
        display: block;
      }

      .catalog-service-list,
      .catalog-service-row {
        display: block;
      }

      .catalog-service-row {
        background: var(--color-secondary);
        border-bottom: 1px solid rgba(255, 255, 255, 0.14);
      }

      .catalog-service-row:first-child {
        border-radius: 0.5rem 0.5rem 0 0;
      }

      .catalog-service-row:last-child {
        border-bottom: 0;
        border-radius: 0 0 0.5rem 0.5rem;
      }

      .catalog-service-selector {
        display: grid;
        border: 0;
        border-radius: 0 !important;
      }

      .catalog-services-grid .premium-card-white {
        display: none;
        min-height: auto;
        margin: 0;
        border: 0;
        border-radius: 0;
        box-shadow: none;
      }

      .catalog-services-grid .premium-card-white.is-active {
        display: block;
      }
    }

    /* Variante invertida de FaqSplit: el catálogo vive en un único bloque navy. */
    .catalog-section {
      background: var(--color-secondary) !important;
      color: #fff;
    }

    .catalog-section .text-navy,
    .catalog-section .text-gray-dark {
      color: #fff !important;
    }

    .catalog-section .section-title-center > p,
    .catalog-section [role="tabpanel"] > div:first-child > p {
      color: rgba(255, 255, 255, 0.72) !important;
    }

    .catalog-section #tabs-linea {
      border-bottom-color: rgba(255, 255, 255, 0.2) !important;
    }

    .catalog-section #tabs-linea [role="tab"] {
      color: rgba(255, 255, 255, 0.6) !important;
    }

    .catalog-section #tabs-linea [role="tab"][aria-selected="true"] {
      color: var(--color-primary) !important;
      border-bottom-color: var(--color-primary) !important;
    }

    .catalog-services-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(2rem, 5vw, 5rem);
      max-width: 1600px;
    }

    .catalog-service-selector {
      padding: 1.75rem 0;
      background: transparent;
      border-radius: 0 !important;
      color: rgba(255, 255, 255, 0.45);
    }

    .catalog-service-row:first-child .catalog-service-selector {
      padding-top: 0;
    }

    .catalog-service-selector:hover,
    .catalog-service-selector:focus-visible,
    .catalog-service-selector.is-active {
      background: transparent;
      color: #fff;
    }

    .catalog-service-selector:focus-visible {
      outline-offset: 0.25rem;
    }

    .catalog-service-indicator {
      width: 2rem;
      height: 2rem;
      border: 0;
      background: rgba(255, 255, 255, 0.08);
      font-size: 1.1rem;
      font-weight: 400;
    }

    .catalog-service-selector-title {
      font-size: 0.95rem;
      letter-spacing: 0.01em;
      text-transform: uppercase;
    }

    .catalog-service-selector-level {
      display: none;
    }

    .catalog-service-selector-desc {
      color: rgba(255, 255, 255, 0.52);
    }

    .catalog-services-grid .premium-card-white {
      padding: 3rem 2.5rem !important;
      border: 0;
      border-radius: 0;
      box-shadow: none;
      transform: none !important;
      opacity: 1 !important;
      filter: none !important;
    }

    .catalog-services-grid .premium-card-white .text-navy {
      color: var(--color-secondary) !important;
    }

    .catalog-services-grid .premium-card-white .text-gray-dark {
      color: var(--color-text-muted, #64748b) !important;
    }

    @media (min-width: 901px) {
      .catalog-services-grid {
        position: relative;
      }

      .catalog-service-list {
        display: flex;
        grid-column: 1;
        grid-row: 1;
        flex-direction: column;
      }

      .catalog-service-row {
        display: block;
      }

      .catalog-service-display {
        display: block;
        grid-column: 2;
        grid-row: 1;
        min-width: 0;
      }

      .catalog-services-grid .premium-card-white {
        position: static;
        width: 100%;
      }
    }

    .catalog-section [aria-label="Leyenda de niveles de servicio"] {
      background: rgba(255, 255, 255, 0.08) !important;
      color: rgba(255, 255, 255, 0.72);
    }

    .services-final-cta {
      display: grid;
      min-height: 100dvh;
      padding: clamp(4rem, 8vw, 8rem) 0;
      background: var(--color-primary) !important;
      place-items: center;
    }

    .services-final-cta .container {
      width: 100%;
      min-width: 0;
    }

    .services-final-cta .cta-content-v2 {
      max-width: 900px;
      padding: 0;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
    }

    .services-final-cta .cta-content-v2::before,
    .services-final-cta .cta-content-v2::after {
      display: none;
    }

    @media (max-width: 900px) {
      .catalog-service-row {
        background: transparent;
      }

      .catalog-service-display {
        display: none;
      }

      .catalog-service-selector {
        padding: 1.4rem 0;
      }

      .catalog-service-row:first-child .catalog-service-selector {
        padding-top: 0;
      }

      .catalog-services-grid .premium-card-white {
        position: static;
        width: auto;
        margin: 0 0 1.5rem;
        padding: 2rem 1.5rem !important;
        border-radius: 0;
      }
    }

    /* AreaPanelCards visual language adapted to the four process steps. */
    .process-area-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0.55rem;
      max-width: 1320px;
      margin: 0 auto;
    }

    .process-area-panel {
      min-height: 290px;
      overflow: hidden;
      background: #082235;
      border: 1px solid rgba(141, 191, 221, 0.72);
      color: #fff;
      isolation: isolate;
      transition:
        transform 280ms cubic-bezier(0.16, 1, 0.3, 1),
        background-color 280ms cubic-bezier(0.16, 1, 0.3, 1),
        border-color 280ms cubic-bezier(0.16, 1, 0.3, 1),
        clip-path 550ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .process-area-panel::after {
      position: absolute;
      z-index: -1;
      inset: 0;
      background: linear-gradient(
        145deg,
        rgba(29, 82, 112, 0.42),
        transparent 55%
      );
      content: "";
      opacity: 0;
      transition: opacity 280ms ease;
    }

    .process-area-panel:nth-child(odd) {
      clip-path: polygon(
        0 0,
        100% 0,
        100% 31%,
        88% 31%,
        88% 69%,
        100% 69%,
        100% 100%,
        0 100%
      );
    }

    .process-area-panel:nth-child(even) {
      clip-path: polygon(
        0 0,
        100% 0,
        100% 100%,
        0 100%,
        0 69%,
        12% 69%,
        12% 31%,
        0 31%
      );
    }

    .process-area-panel:nth-child(odd):hover,
    .process-area-panel:nth-child(odd):focus-within {
      clip-path: polygon(
        0 0,
        100% 0,
        100% 31%,
        100% 31%,
        100% 69%,
        100% 69%,
        100% 100%,
        0 100%
      );
    }

    .process-area-panel:nth-child(even):hover,
    .process-area-panel:nth-child(even):focus-within {
      clip-path: polygon(
        0 0,
        100% 0,
        100% 100%,
        0 100%,
        0 69%,
        0 69%,
        0 31%,
        0 31%
      );
    }

    .process-area-panel:hover {
      transform: translateY(-6px);
      background: #0b2c43;
      border-color: var(--color-primary);
    }

    .process-area-panel:hover::after {
      opacity: 1;
    }

    .process-area-panel h3,
    .process-area-panel p,
    .process-area-panel span {
      position: relative;
      z-index: 1;
    }

    .process-area-panel h3 {
      color: #fff !important;
    }

    .process-area-panel p {
      color: rgba(255, 255, 255, 0.78) !important;
    }

    .process-area-panel > span:first-child {
      color: rgba(197, 227, 243, 0.2) !important;
    }

    .process-area-panel > span:last-child {
      color: var(--color-primary) !important;
    }

    @media (max-width: 1100px) {
      .process-area-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 700px) {
      .process-area-grid {
        grid-template-columns: 1fr;
      }

      .process-area-panel,
      .process-area-panel:nth-child(odd),
      .process-area-panel:nth-child(even) {
        min-height: 235px;
        clip-path: none;
      }
    }
  </style>

  <script>
    const lineTabs = document.querySelectorAll('#tabs-linea [role="tab"]');
    const panels = document.querySelectorAll('[role="tabpanel"]');

    function selectCatalogService(panel, index) {
      const services = Array.from(
        panel.querySelectorAll(".catalog-service-row"),
      );
      const details = Array.from(
        panel.querySelectorAll(".catalog-services-grid .premium-card-white"),
      );
      const grid = panel.querySelector(".catalog-services-grid");
      let activeDetail;
      services.forEach((row, serviceIndex) => {
        const active = serviceIndex === index;
        const selector = row.querySelector(".catalog-service-selector");
        const detail = details[serviceIndex];
        selector?.classList.toggle("is-active", active);
        selector?.setAttribute("aria-selected", String(active));
        selector?.setAttribute("aria-expanded", String(active));
        if (detail) {
          detail.classList.toggle("is-active", active);
          detail.hidden = !active;
          if (active) activeDetail = detail;
        }
      });

      if (
        grid &&
        activeDetail &&
        window.matchMedia("(min-width: 901px)").matches
      ) {
        requestAnimationFrame(() => {
          const selectorHeight = services.reduce((total, row) => {
            const selector = row.querySelector(".catalog-service-selector");
            return total + (selector?.getBoundingClientRect().height ?? 0);
          }, 0);
          grid.style.minHeight = `${Math.max(selectorHeight, activeDetail.getBoundingClientRect().height)}px`;
        });
      } else if (grid) {
        grid.style.minHeight = "";
      }
    }

    function syncCatalogLayout(panel) {
      const display = panel.querySelector(".catalog-service-display");
      const rows = Array.from(panel.querySelectorAll(".catalog-service-row"));
      const articles = Array.from(
        panel.querySelectorAll(".catalog-services-grid .premium-card-white"),
      );
      const isMobile = window.matchMedia("(max-width: 900px)").matches;

      articles.forEach((article, index) => {
        if (isMobile) rows[index]?.append(article);
        else display?.append(article);
      });
    }

    function initCatalogSplit(panel) {
      const grid = panel.querySelector("[data-catalog-services]");
      if (!grid || grid.dataset.catalogReady === "true") return;

      const articles = Array.from(grid.querySelectorAll(":scope > article"));
      const list = document.createElement("div");
      list.className = "catalog-service-list";
      list.setAttribute("role", "tablist");
      list.setAttribute("aria-label", "Servicios disponibles");
      const display = document.createElement("div");
      display.className = "catalog-service-display";

      articles.forEach((article, index) => {
        const detail = article.querySelector('[id^="detalle-"]');
        const heading = article.querySelector("h4");
        const descriptor =
          heading?.previousElementSibling?.textContent?.trim() ?? "";
        const title = heading?.textContent?.trim() ?? `Servicio ${index + 1}`;
        const level =
          article.querySelector("header span")?.textContent?.trim() ?? "";
        const detailId = detail?.id ?? `catalog-service-${index + 1}`;
        const articleId = `catalog-detail-${detailId}`;

        article.id = articleId;
        article.setAttribute("role", "region");
        article.setAttribute("aria-label", `Detalle: ${title}`);
        detail && (detail.hidden = false);

        const row = document.createElement("div");
        row.className = "catalog-service-row";
        const selector = document.createElement("button");
        selector.type = "button";
        selector.className = "catalog-service-selector";
        selector.setAttribute("role", "tab");
        selector.setAttribute("aria-controls", articleId);
        selector.setAttribute("aria-selected", "false");
        selector.setAttribute("aria-expanded", "false");
        selector.innerHTML = `<span class="catalog-service-indicator" aria-hidden="true">+</span><span class="catalog-service-selector-copy"><span class="catalog-service-selector-level"></span><span class="catalog-service-selector-title"></span><span class="catalog-service-selector-desc"></span></span>`;
        selector.querySelector(".catalog-service-selector-level").textContent =
          level;
        selector.querySelector(".catalog-service-selector-title").textContent =
          title;
        selector.querySelector(".catalog-service-selector-desc").textContent =
          descriptor;

        selector.addEventListener("click", () =>
          selectCatalogService(panel, index),
        );
        selector.addEventListener("keydown", (event) => {
          if (!["ArrowDown", "ArrowUp", "Home", "End"].includes(event.key))
            return;
          event.preventDefault();
          const nextIndex =
            event.key === "ArrowDown"
              ? (index + 1) % articles.length
              : event.key === "ArrowUp"
                ? (index - 1 + articles.length) % articles.length
                : event.key === "Home"
                  ? 0
                  : articles.length - 1;
          selectCatalogService(panel, nextIndex);
          row.parentElement
            ?.querySelectorAll(".catalog-service-selector")
            [nextIndex]?.focus();
        });

        row.append(selector);
        list.append(row);
        display.append(article);
      });

      grid.append(list, display);
      grid.dataset.catalogReady = "true";
      syncCatalogLayout(panel);
      selectCatalogService(panel, 0);
    }

    panels.forEach(initCatalogSplit);

    const catalogBreakpoint = window.matchMedia("(max-width: 900px)");
    catalogBreakpoint.addEventListener("change", () => {
      panels.forEach((panel) => {
        syncCatalogLayout(panel);
        const activeIndex = Array.from(
          panel.querySelectorAll(".catalog-service-selector"),
        ).findIndex(
          (selector) => selector.getAttribute("aria-selected") === "true",
        );
        selectCatalogService(panel, Math.max(activeIndex, 0));
      });
    });

    function activarTab(panelId) {
      lineTabs.forEach((tab) => {
        const active = tab.dataset.panel === panelId;
        tab.setAttribute("aria-selected", String(active));
        tab.style.color = active ? "var(--color-primary)" : "#64748b";
        tab.style.fontWeight = active ? "800" : "700";
        tab.style.borderBottomColor = active
          ? "var(--color-primary)"
          : "transparent";
      });
      panels.forEach((panel) => {
        const visible = panel.id === `panel-${panelId}`;
        panel.setAttribute("aria-hidden", String(!visible));
        panel.toggleAttribute("hidden", !visible);
        if (visible) selectCatalogService(panel, 0);
      });
    }

    lineTabs.forEach((tab) =>
      tab.addEventListener("click", () => activarTab(tab.dataset.panel)),
    );
    activarTab("research");

    const roleButtons = document.querySelectorAll("[data-rol]");
    roleButtons.forEach((button) => {
      button.addEventListener("click", () => {
        roleButtons.forEach((roleButton) => {
          roleButton.style.background = "transparent";
          roleButton.style.color = "var(--color-secondary)";
          roleButton.style.borderColor = "rgba(11, 43, 64, 0.15)";
        });
        button.style.background = "var(--color-primary)";
        button.style.color = "#fff";
        button.style.borderColor = "var(--color-primary)";
        activarTab(button.dataset.panel);
      });
    });
  </script>
</Layout>
