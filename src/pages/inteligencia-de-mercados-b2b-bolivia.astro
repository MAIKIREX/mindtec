---
import Layout from "../layouts/Layout.astro";
import BoliviaNetworkMapFilled from "../components/visual/BoliviaNetworkMapFilled.astro";
import ServiceVisualSuite from "../components/sections/ServiceVisualSuite.astro";
import HoverStepCards from "../components/cards/HoverStepCards.astro";
import ScrollStoryLeft from "../components/scroll/ScrollStoryLeftNoCover.astro";
import FaqSplit from "../components/faq/FaqSplit.astro";
import StackedSections from "../components/scroll/StackedSections.astro";
import AreaPanelCards from "../components/cards/AreaPanelCards.astro";
import ComparisonRows from "../components/cards/ComparisonRows.astro";

const problemScenarios = [
  {
    icon: `<svg viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="15" stroke-linecap="round" stroke-linejoin="round"><circle cx="128" cy="128" r="96"></circle><path d="M128 72v56l40 24"></path></svg>`,
    title: 'Decisiones de inversión basadas en reportes de 200 páginas',
    description: 'El Directorio aprueba CAPEX basado en investigaciones académicas que nadie lee. 3 meses después, el mercado no responde como el "plan maestro" predecía.',
  },
  {
    icon: `<svg viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="15" stroke-linecap="round" stroke-linejoin="round"><circle cx="128" cy="128" r="88"></circle><circle cx="128" cy="128" r="48"></circle><circle cx="128" cy="128" r="8"></circle></svg>`,
    title: 'Fusiones y adquisiciones sin diagnóstico de competencia',
    description: 'Compró un competidor basándose en datos históricos de hace 2 años. Al integrar, descubre que la participación real era 40% menor de lo reportado.',
  },
  {
    icon: `<svg viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="15" stroke-linecap="round" stroke-linejoin="round"><path d="M116 156a40 40 0 1 1 40-40"></path><path d="M172 172l40 40"></path><path d="M148 108h-4v16"></path></svg>`,
    title: 'Estrategia de precios sin medición de elasticidad real',
    description: 'Aumentó precios basándose en información del equipo de ventas. Perdió 25% de volumen porque nadie midió el umbral de dolor del cliente B2B.',
  },
  {
    icon: `<svg viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="15" stroke-linecap="round" stroke-linejoin="round"><path d="M96 32h64l16 24H80z"></path><rect x="56" y="56" width="144" height="168" rx="8"></rect><path d="M92 112h72M92 144h72M92 176h40"></path></svg>`,
    title: 'Expansión geográfica sin análisis de barreras de entrada',
    description: 'Abrió operación en Santa Cruz basándose en "instinto de mercado". 6 meses después, descubrió que la competencia local tenía estructuras de costo imposibles de igualar.',
  },
];

const comparisonRows = [
  {
    before: 'PDF estático de 150 páginas difícil de digerir y consultar',
    after: 'Dashboard ejecutivo interactivo para filtrar datos en segundos',
  },
  {
    before: 'Datos puramente históricos (una fotografía del año pasado)',
    after: 'Monitorización de competencia y tendencias comerciales dinámicas',
  },
  {
    before: 'Enfoque declarativo (el consumidor dice lo que quiere aparentar)',
    after: 'Validación cruzada con modelos de compra reales y biometría',
  },
  {
    before: 'Presentación formal de gráficos de barras sin dirección comercial',
    after: 'Brief ejecutivo de riesgos y hoja de ruta con recomendaciones prioritarias',
  },
];

const faqItems = [
  {
    question:
      "¿Cuál es la diferencia entre investigación de mercados tradicional y Market Intelligence B2B?",
    answer:
      "La investigación tradicional es descriptiva e histórica (nos dice qué pasó en el mercado). El Market Intelligence B2B es prescriptivo e interactivo: combina datos históricos, análisis de competencia en tiempo real, tendencias y simulaciones de escenarios comerciales para indicar qué acción tomar a continuación y reducir el riesgo estratégico ante el Directorio.",
  },
  {
    question: "¿Para qué perfiles directivos está diseñado este servicio?",
    answer:
      "Está diseñado específicamente para Gerentes Generales, Directores de Finanzas, Directores Comerciales y miembros de Directorios que deben justificar inversiones de capital (CAPEX) elevadas, autorizar aperturas de mercado, fusiones, compras de competencia o cambios de posicionamiento de marca.",
  },
  {
    question:
      "¿Qué tipo de entregables incluye el servicio de Inteligencia B2B de MindTEC?",
    answer:
      "Olvídese de informes teóricos de 200 páginas. Entregamos un Dashboard Ejecutivo Dinámico con las variables clave de decisión, un Brief de Riesgo de máximo 3 páginas y una sesión de alineación estratégica con consultores para discutir las implicaciones de negocio.",
  },
];

const title = "Inteligencia de Mercados B2B en Bolivia | MindTEC";
const description =
  "Inteligencia de mercados B2B en Bolivia: de los reportes teóricos a la toma de decisiones estratégicas. Para gerentes y directorios con visión de crecimiento.";

const quienUtilizaCards = [
  {
    eyebrow: "Perfil Directivo",
    title: "Gerentes Generales y CEOs",
    description:
      "Para validar planes de expansión geográfica en Bolivia (La Paz, Santa Cruz, Cochabamba), justificar fusiones o autorizar adquisiciones con datos de viabilidad neta que protejan la caja corporativa.",
  },
  {
    eyebrow: "Perfil Directivo",
    title: "Juntas Directivas y Directorios",
    description:
      "Para contar con una contraparte científica e independiente que evalúe las proyecciones del equipo de ventas interno antes de comprometer CAPEX significativo.",
  },
  {
    eyebrow: "Perfil Directivo",
    title: "Directores Comerciales y Financieros",
    description:
      "Para ajustar estructuras de precios por canal sin generar rupturas en el volumen de ventas, detectando la elasticidad real de la demanda por zona y tipo de distribuidor.",
  },
];
---

<Layout
  title={title}
  description={description}
  headerLightBg={false}
  canonicalUrl="/inteligencia-de-mercados-b2b-bolivia/"
>
  <script type="application/ld+json" slot="head">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Service",
          "@id": "https://www.mindtecbolivia.com/inteligencia-de-mercados-b2b-bolivia",
          "name": "Inteligencia de Mercados B2B en Bolivia — MindTEC",
          "description": "Servicio de Market Intelligence B2B para comités de dirección y gerencia general. Información analítica accionable y de competencia en Bolivia.",
          "provider": {
            "@type": "Organization",
            "name": "MindTEC Bolivia",
            "url": "https://www.mindtecbolivia.com"
          },
          "areaServed": { "@type": "Country", "name": "Bolivia" },
          "serviceType": "Market Intelligence B2B / Consultoría Estratégica",
          "url": "https://www.mindtecbolivia.com/inteligencia-de-mercados-b2b-bolivia"
        },
        {
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "¿Cuál es la diferencia entre investigación de mercados tradicional y Market Intelligence B2B?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "La investigación tradicional es descriptiva e histórica (nos dice qué pasó en el mercado). El Market Intelligence B2B es prescriptivo e interactivo: combina datos históricos, análisis de competencia en tiempo real, tendencias y simulaciones de escenarios comerciales para indicar qué acción tomar a continuación y reducir el riesgo estratégico ante el Directorio."
              }
            },
            {
              "@type": "Question",
              "name": "¿Para qué perfiles directivos está diseñado este servicio?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Está diseñado específicamente para Gerentes Generales, Directores de Finanzas, Directores Comerciales y miembros de Directorios que deben justificar inversiones de capital (CAPEX) elevadas, autorizar aperturas de mercado, fusiones, compras de competencia o cambios de posicionamiento de marca."
              }
            },
            {
              "@type": "Question",
              "name": "¿Qué tipo de entregables incluye el servicio de Inteligencia B2B de MindTEC?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Olvídese de informes teóricos de 200 páginas. Entregamos un Dashboard Ejecutivo Dinámico con las variables clave de decisión, un Brief de Riesgo de máximo 3 páginas y una sesión de alineación estratégica con consultores para discutir las implicaciones de negocio."
              }
            }
          ]
        },
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "Inicio",
              "item": "https://www.mindtecbolivia.com/"
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": "Servicios",
              "item": "https://www.mindtecbolivia.com/servicios"
            },
            {
              "@type": "ListItem",
              "position": 3,
              "name": "Inteligencia de Mercados B2B Bolivia",
              "item": "https://www.mindtecbolivia.com/inteligencia-de-mercados-b2b-bolivia"
            }
          ]
        }
      ]
    }
  </script>

  <main>
    <StackedSections>
    <!-- 1. HERO -->
    <section
      class="hero-section"
      style="padding-bottom: 4rem; padding-top: 4rem;"
      data-stack-section
    >
      <div class="hero-shapes" aria-hidden="true">
        <div class="hero-shape"></div><div class="hero-shape"></div><div
          class="hero-shape"
        >
        </div>
        <div class="hero-shape"></div><div class="hero-shape"></div><div
          class="hero-shape"
        >
        </div>
        <div class="hero-shape"></div><div class="hero-shape"></div><div
          class="hero-shape"
        >
        </div>
        <div class="hero-shape"></div>
      </div>
      <div
        class="hero-mobile-canvas"
        id="hero-mobile-canvas"
        aria-hidden="true"
      >
      </div>
      <div class="container hero-container">
        <div class="hero-content">
          <span class="eyebrow fade-in"
            >INTELIGENCIA ESTRATÉGICA DE NEGOCIOS</span
          >
          <span class="freshness-tag">Actualizado: julio 2026</span>
          <h1
            class="hero-title"
            style="font-size: 3.5rem; line-height: 1.25; margin-bottom: 1.5rem;"
          >
            Inteligencia de Mercados B2B — Datos que defienden decisiones en el
            Directorio.
          </h1>
        </div>
        <div
          class="hero-visual"
          style="display: flex; align-items: center; justify-content: center; max-width: 100%; overflow: visible;"
        >
          <BoliviaNetworkMapFilled size="clamp(300px, 32vw, 460px)" />
        </div>
      </div>
    </section>

    <!-- Nueva sección debajo del hero -->
    <section
      class="hero-details-section"
      style="background: var(--color-secondary-deep, #061c2b); padding: 4rem 0;"
      data-stack-section
    >
      <div class="container" style="max-width: 900px;">
        <div class="direct-answer-box">
          <strong>En resumen</strong>
          <p>
            MindTEC ofrece Market Intelligence B2B para comités de dirección y
            gerencia general en Bolivia, con información analítica accionable y
            de competencia.
          </p>
        </div>
        <p
          class="hero-subtitle"
          style="font-size: 1.25rem; margin-bottom: 1.5rem; max-width: 800px; color: #fff; line-height: 1.6;"
        >
          Deje atrás los reportes académicos e históricos. Construimos modelos
          de Inteligencia Competitiva accionables para gerentes y comités
          directivos en Bolivia.
        </p>
        <p
          style="font-size: 1.05rem; color: rgba(255,255,255,0.75); max-width: 800px; margin-bottom: 2.5rem; line-height: 1.7;"
        >
          No medimos por curiosidad intelectual. Mapeamos competidores, barreras
          reales de entrada y elasticidad comercial para proteger sus márgenes
          financieros y acelerar el retorno de inversión.
        </p>
        <div
          style="display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 2.5rem;"
        >
          <span
            style="background: rgba(242,101,34,0.25); border: 1px solid rgba(242,101,34,0.5); color: var(--color-primary); padding: 0.4rem 1rem; border-radius: 20px; font-size: 0.85rem; font-weight: 700;"
            >Enfoque en Toma de Decisiones</span
          >
          <span
            style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #fff; padding: 0.4rem 1rem; border-radius: 20px; font-size: 0.85rem; font-weight: 600;"
            >Dashboards Ejecutivos</span
          >
          <span
            style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #fff; padding: 0.4rem 1rem; border-radius: 20px; font-size: 0.85rem; font-weight: 600;"
            >Eje Troncal e Interiores</span
          >
        </div>
        <a href="/contacto/" class="btn btn-primary lg"
          >Agendar sesión estratégica de diagnóstico →</a
        >
      </div>
    </section>

    <!-- 2. EL PROBLEMA -->
    <section class="bg-slate" style="padding: 5rem 0;" data-stack-section>
      <div class="container">
        <div style="max-width: 900px; margin: 0 auto;">
          <span class="eyebrow">EL PROBLEMA REAL</span>
          <h2 class="text-navy" style="font-size: 2.5rem; margin-top: 1rem; margin-bottom: 2rem; line-height: 1.2;">¿Cuánto cuesta una decisión de inversión basada en reportes académicos que nadie lee?</h2>
          <p class="text-gray-dark leading-relaxed" style="font-size: 1.15rem; margin-bottom: 1.5rem; line-height: 1.7;">
            El mayor pecado de la investigación tradicional en Bolivia es la teorización desconectada del negocio. Es común recibir documentos llenos de datos censales desactualizados, metodologías complejas explicadas en jerga inaccesible y ninguna recomendación comercial clara.
          </p>
          <p class="text-gray-dark leading-relaxed" style="font-size: 1.05rem; line-height: 1.7;">
            ¿Reconoce alguno de estos escenarios?
          </p>
        </div>

        <AreaPanelCards items={problemScenarios} columns={4} theme="navy" class="problem-panels" />

        <div style="max-width: 900px; margin: 2.5rem auto 0; background: var(--color-secondary); color: #fff; padding: 1.5rem 2rem; border-radius: var(--radius-md, 8px); font-weight: 600; font-size: 1.1rem; text-align: center;">
          Sin inteligencia de mercados accionable, su Directorio está aprobando CAPEX basado en suposiciones disfrazadas de datos.
        </div>
      </div>
    </section>

    <!-- 3. MINDTEC+ -->
    <section style="padding: 5rem 0; background: #fff;" data-stack-section>
      <div class="container">
        <div class="section-title-center" style="text-align: center; margin-bottom: 3rem;">
          <span class="eyebrow">MINDTEC+</span>
          <h2 class="text-navy" style="font-size: 2.2rem; line-height: 1.2; margin-top: 1rem; margin-bottom: 1rem;">Más que investigación académica: inteligencia de markets diseñada para decisiones de Directorio.</h2>
        </div>

        <ComparisonRows
          columnLabels={{ left: 'Investigación tradicional', right: 'Inteligencia de Mercados B2B' }}
          rows={comparisonRows}
        />

        <p class="text-gray-dark" style="font-size: 1.05rem; margin-top: 1.5rem; max-width: 800px; margin-left: auto; margin-right: auto; text-align: center; line-height: 1.7;">
          La diferencia no está en la cantidad de datos. Está en cómo los presentamos y qué tan rápido pueden traducirse en decisiones de negocio.
        </p>
      </div>
    </section>

    <!-- 4. A QUIÉN LE SIRVE (B2B TARGET) -->
    <section style="padding: 5rem 0; background: var(--color-accent);" data-stack-section>
      <div class="container">
        <div
          class="section-title-center"
          style="text-align: center; margin-bottom: 4rem;"
        >
          <span class="eyebrow">TOMA DE DECISIONES</span>
          <h2 class="text-navy" style="font-size: 2.2rem; line-height: 1.2;">
            ¿Quién utiliza el Market Intelligence de MindTEC?
          </h2>
          <p
            class="text-gray-dark"
            style="font-size: 1.1rem; max-width: 700px; margin: 0 auto; margin-top: 1rem;"
          >
            La información no es poder por sí misma. Es poder cuando reduce el
            riesgo financiero de quienes tienen la responsabilidad legal y
            operativa de la firma.
          </p>
        </div>

        <HoverStepCards items={quienUtilizaCards} />
      </div>
    </section>
    </StackedSections>

    <!-- 5. ENTREGABLES DE VALOR (VILMA NUÑEZ STYLE: FRAMEWORK OF DELIVERABLES) -->
    <ScrollStoryLeft
      scrub={0.9}
      sceneDistance={1.1}
      cardBackground="#f7f7f5"
      cardTextColor="#0B2B40"
      cardMutedColor="rgba(11, 43, 64, 0.62)"
      intro={{
        background:
          "/imagenes-mindtec/generated/inteligencia-b2b/entregables/intro.webp",
        number: "00",
        eyebrow: "LOS ENTREGABLES",
        title: "Lo que recibe la Dirección General en su escritorio",
        description:
          "Herramientas diseñadas para la toma de decisiones estratégicas con datos accionables y análisis de competencia.",
      }}
      items={[
        {
          background:
            "/imagenes-mindtec/generated/inteligencia-b2b/entregables/item-01-dashboard-control-mercado.webp",
          eyebrow: "Dashboard",
          title: "Dashboard de Control de Mercado",
          description:
            "Interfaz interactiva donde puede realizar simulaciones de cambios de precios, filtros geográficos inmediatos y segmentación en tiempo real.",
          icon: "dashboard",
        },
        {
          background:
            "/imagenes-mindtec/generated/inteligencia-b2b/entregables/item-02-brief-riesgo-oportunidad.webp",
          eyebrow: "Brief",
          title: "Brief de Riesgo y Oportunidad B2B",
          description:
            "Un informe ejecutivo concentrado de 3 páginas diseñado para leer en 15 minutos. Sin paja científica, directo a las decisiones críticas.",
          icon: "document",
        },
        {
          background:
            "/imagenes-mindtec/generated/inteligencia-b2b/entregables/item-03-matriz-posicionamiento-competitivo.webp",
          eyebrow: "Matriz",
          title: "Matriz de Posicionamiento Competitivo",
          description:
            "Mapa de debilidades de los 3 competidores más importantes del país con el plan de ataque comercial recomendado para su marca.",
          icon: "matrix",
        },
        {
          background:
            "/imagenes-mindtec/generated/inteligencia-b2b/entregables/item-04-sesion-alineacion-directorio.webp",
          eyebrow: "Sesión",
          title: "Sesión Presencial o Remota de Alineación",
          description:
            "Presentación interactiva ante su Directorio para resolver objeciones, profundizar en hallazgos complejos y definir los siguientes pasos.",
          icon: "meeting",
        },
      ]}
    />

    <StackedSections>
    <!-- 6. FAQ -->
    <div data-stack-section>
      <FaqSplit
        eyebrow="RESOLVIENDO DUDAS"
        title="Preguntas de negocio recurrentes"
        items={faqItems}
      />
    </div>

    <!-- 7. FINAL B2B CTA -->
    <section class="cta-section-modern" style="padding: 6rem 0;" data-stack-section>
      <div
        class="container"
        style="max-width: 900px; margin: 0 auto; text-align: center;"
      >
        <div class="cta-content-v2">
          <h2
            style="font-size: 2.8rem; line-height: 1.25; margin-bottom: 1.5rem;"
          >
            Respalde su plan comercial con datos defendibles ante su Directorio.
          </h2>
          <p
            class="cta-subtitle"
            style="font-size: 1.2rem; margin-bottom: 2.5rem; opacity: 0.9;"
          >
            Analizamos la viabilidad neta de su plan de mercado en 45 minutos.
            Descubra si contamos con un diseño metodológico óptimo para su reto
            de negocio.
          </p>
          <div
            class="cta-actions"
            style="justify-content: center; flex-direction: column; align-items: center;"
          >
            <a
              href="/contacto/"
              class="btn btn-primary lg"
              style="font-size: 1.1rem; padding: 1rem 2.5rem;"
              >Agendar diagnóstico estratégico (45 min) →</a
            >
            <p
              style="margin-top: 1.5rem; font-size: 0.95rem; color: rgba(255,255,255,0.7); font-weight: 500;"
            >
              Sesión estratégica sin cargo para directivos corporativos en
              Bolivia.
            </p>
          </div>
        </div>
      </div>
    </section>
    </StackedSections>

    <!-- BREADCRUMB -->
    <nav aria-label="Breadcrumb" class="breadcrumb-bottom">
      <div class="container">
        <ol>
          <li>
            <a
              href="/"
              style="color: rgba(255,255,255,0.6); text-decoration: none;"
              >Inicio</a
            >
          </li>
          <li style="color: rgba(255,255,255,0.3);">›</li>
          <li>
            <a
              href="/servicios/"
              style="color: rgba(255,255,255,0.6); text-decoration: none;"
              >Servicios</a
            >
          </li>
          <li style="color: rgba(255,255,255,0.3);">›</li>
          <li aria-current="page" style="color: #fff; font-weight: 600;">
            Inteligencia de Mercados B2B
          </li>
        </ol>
      </div>
    </nav>
  </main>

  <style>
    /* Espacio entre la intro de "El Problema" y el grid de escenarios.
       :global() porque la clase se aplica dentro de AreaPanelCards.astro;
       doble clase para ganarle en especificidad al margin:0 auto de .areas-grid. */
    :global(.areas-grid.problem-panels) {
      margin-top: 3.5rem;
    }
  </style>
</Layout>
