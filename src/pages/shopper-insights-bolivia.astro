---
import Layout from '../layouts/Layout.astro';
import ServiceVisualSuite from '../components/sections/ServiceVisualSuite.astro';
import FaqSplit from '../components/faq/FaqSplit.astro';

const faqItems = [
  {
    question: "¿Qué es un estudio de shopper insights?",
    answer:
      "Un estudio de shopper insights analiza el comportamiento del comprador en el punto de venta: cómo navega el espacio, cuánto tiempo dedica a cada zona, qué lo detiene frente al anaquel, qué desencadena la decisión de compra y por qué elige una marca sobre otra. Se realiza en el PDV real, no en laboratorio.",
  },
  {
    question: "¿Cómo se hace un estudio de shopper en Bolivia?",
    answer:
      "Combinamos tres metodologías: observación etnográfica en el PDV (observadores entrenados siguen a compradores reales), análisis de trayectoria y tiempo de permanencia frente al anaquel, y entrevistas post-compra inmediatas para capturar la racionalización de la decisión. Cuando aplica, incorporamos eye tracking portátil para medir exactamente qué captura la atención.",
  },
  {
    question: "¿En qué tipo de puntos de venta hacen los estudios?",
    answer:
      "Trabajamos en supermercados de cadena, hipermercados, minimarkets, farmacias, ferreterías, tiendas de conveniencia y mercados populares. El tipo de PDV se define según el canal más relevante para tu categoría.",
  },
  {
    question: "¿Cuántos shoppers se observan en un estudio típico?",
    answer:
      "Para estudios exploratorios: 30–50 observaciones. Para estudios con validez estadística: 100–200 observaciones. El número final depende de la variabilidad del comportamiento en tu categoría y del nivel de confianza requerido.",
  },
  {
    question: "¿Los compradores saben que están siendo observados?",
    answer:
      "Dependiendo del diseño: en la fase etnográfica de observación pasiva, el comprador no sabe que está siendo observado. En las entrevistas post-compra, sí. Este diseño nos permite capturar el comportamiento real (sin el sesgo de saber que te observan) y luego explorar el por qué con el comprador dispuesto a hablar.",
  },
];

const title = "Shopper Insights en Bolivia | Canal y PDV | Mindtec";
const description = "Shopper insights Bolivia: etnografía, eye tracking y entrevistas en PDV para entender la decisión de compra real en el momento en que ocurre. Mindtec.";
---

<Layout
  title={title}
  description={description}
  headerLightBg={false}
  canonicalUrl="/shopper-insights-bolivia"
>
  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Service",
        "@id": "https://www.mindtecbolivia.com/shopper-insights-bolivia",
        "name": "Shopper Insights en Bolivia — Comportamiento del Comprador en PDV",
        "description": "Servicio de shopper insights en Bolivia: comprendemos el comportamiento del comprador en el punto de venta mediante etnografía, análisis de trayectoria visual y entrevistas post-compra.",
        "provider": {
          "@type": "Organization",
          "name": "MindTEC Bolivia",
          "url": "https://www.mindtecbolivia.com"
        },
        "areaServed": {"@type": "Country", "name": "Bolivia"},
        "serviceType": "Shopper Insights / Comportamiento del Comprador",
        "url": "https://www.mindtecbolivia.com/shopper-insights-bolivia"
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "¿Qué es un estudio de shopper insights?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Un estudio de shopper insights analiza el comportamiento del comprador en el punto de venta: cómo navega el espacio, cuánto tiempo dedica a cada zona, qué lo detiene frente al anaquel, qué desencadena la decisión de compra y por qué elige una marca sobre otra. Se realiza en el PDV real, no en laboratorio."
            }
          },
          {
            "@type": "Question",
            "name": "¿Cómo se hace un estudio de shopper en Bolivia?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Combinamos tres metodologías: observación etnográfica en el PDV (observadores entrenados siguen a compradores reales), análisis de trayectoria y tiempo de permanencia frente al anaquel, y entrevistas post-compra inmediatas para capturar la racionalización de la decisión. Cuando aplica, incorporamos eye tracking portátil para medir exactamente qué captura la atención."
            }
          },
          {
            "@type": "Question",
            "name": "¿En qué tipo de puntos de venta hacen los estudios?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Trabajamos en supermercados de cadena, hipermercados, minimarkets, farmacias, ferreterías, tiendas de conveniencia y mercados populares. El tipo de PDV se define según el canal más relevante para tu categoría."
            }
          },
          {
            "@type": "Question",
            "name": "¿Cuántos shoppers se observan en un estudio típico?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Para estudios exploratorios: 30–50 observaciones. Para estudios con validez estadística: 100–200 observaciones. El número final depende de la variabilidad del comportamiento en tu categoría y del nivel de confianza requerido."
            }
          },
          {
            "@type": "Question",
            "name": "¿Los compradores saben que están siendo observados?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Dependiendo del diseño: en la fase etnográfica de observación pasiva, el comprador no sabe que está siendo observado. En las entrevistas post-compra, sí. Este diseño nos permite capturar el comportamiento real (sin el sesgo de saber que te observan) y luego explorar el por qué con el comprador dispuesto a hablar."
            }
          }
        ]
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {"@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://www.mindtecbolivia.com/"},
          {"@type": "ListItem", "position": 2, "name": "Servicios", "item": "https://www.mindtecbolivia.com/servicios"},
          {"@type": "ListItem", "position": 3, "name": "Shopper Insights en Bolivia", "item": "https://www.mindtecbolivia.com/shopper-insights-bolivia"}
        ]
      }
    ]
  }
  </script>

  <main>


    <!-- 1. HERO -->
    <section class="hero-section" style="padding-bottom: 4rem; padding-top: 4rem;">
      <div class="hero-shapes" aria-hidden="true">
        <div class="hero-shape"></div><div class="hero-shape"></div><div class="hero-shape"></div>
        <div class="hero-shape"></div><div class="hero-shape"></div><div class="hero-shape"></div>
        <div class="hero-shape"></div><div class="hero-shape"></div><div class="hero-shape"></div>
        <div class="hero-shape"></div><div class="hero-shape"></div><div class="hero-shape"></div>
        <div class="hero-shape"></div><div class="hero-shape"></div><div class="hero-shape"></div>
        <div class="hero-shape"></div>
      </div>
      <div class="hero-mobile-canvas" id="hero-mobile-canvas" aria-hidden="true"></div>
      <div class="container hero-container">
        <div class="hero-content">
          <span class="eyebrow fade-in">COMPORTAMIENTO DEL COMPRADOR EN PUNTO DE VENTA</span>
          <span class="freshness-tag">Actualizado: julio 2026</span>
          <h1 class="hero-title" style="font-size: 3.5rem; line-height: 1.25; margin-bottom: 1.5rem;">
            Shopper Insights en Bolivia — La decisión de compra ocurre en 8 segundos frente al anaquel.
          </h1>
          <div class="direct-answer-box">
            <strong>En resumen</strong>
            <p>MindTEC ofrece shopper insights en Bolivia: comprende el comportamiento del comprador en el punto de venta mediante etnografía, análisis de trayectoria visual y entrevistas post-compra.</p>
          </div>
          <p class="hero-subtitle" style="font-size: 1.25rem; margin-bottom: 1.5rem; max-width: 800px;">
            Etnografía en PDV, análisis de trayectoria visual y entrevistas post-compra para entender exactamente cómo y por qué el comprador elige o descarta tu producto en el momento de verdad.
          </p>
          <p style="font-size: 1.05rem; color: rgba(255,255,255,0.75); max-width: 800px; margin-bottom: 2.5rem;">
            Diseñado para equipos de trade marketing y ventas que quieren evidencia accionable sobre qué cambia el comportamiento del shopper en el anaquel — no suposiciones.
          </p>
          <div style="display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 2.5rem;">
            <span style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #fff; padding: 0.4rem 1rem; border-radius: 20px; font-size: 0.85rem; font-weight: 600;">Etnografía en PDV Real</span>
            <span style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #fff; padding: 0.4rem 1rem; border-radius: 20px; font-size: 0.85rem; font-weight: 600;">Eye Tracking Portátil</span>
            <span style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #fff; padding: 0.4rem 1rem; border-radius: 20px; font-size: 0.85rem; font-weight: 600;">Entrevistas Post-Compra</span>
            <span style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #fff; padding: 0.4rem 1rem; border-radius: 20px; font-size: 0.85rem; font-weight: 600;">ROI de Trade Marketing</span>
          </div>
          <a href="/contacto" class="btn btn-primary lg">Agendar diagnóstico estratégico (45 min) →</a>
        </div>
        <div class="hero-visual">
          <div class="glass-card main-visual">
            <div class="neuro-visual-bg" style="background-image: url('/heroes/hero-auditoria-retail-bolivia.jpg');"></div>
          </div>
        </div>
      </div>
    </section>

    <ServiceVisualSuite variant="shopper" />

    <section class="generated-insight-section">
      <div class="container">
        <div class="section-title-center" style="text-align: center; margin-bottom: 3rem;">
          <span class="eyebrow">Evidencia visual en PDV</span>
          <h2 class="text-navy" style="font-size: 2.2rem; line-height: 1.2; margin-top: 1rem;">Encuestas retail y análisis de productos vistos antes de decidir.</h2>
          <p class="text-gray-dark" style="font-size: 1.05rem; max-width: 760px; margin: 1rem auto 0; line-height: 1.7;">El estudio shopper cruza observación en anaquel, entrevistas post-compra y conteo visual de productos expuestos para separar presencia, atención y elección.</p>
        </div>
        <div class="generated-insight-grid">
          <figure class="generated-insight-card">
            <img src="/imagenes-mindtec/generated/shopper-encuestas-retail.webp" alt="Encuestadora realizando estudio shopper en anaquel de supermercado" loading="lazy">
            <figcaption>
              <span>Encuestas retail</span>
              <strong>Captura del comportamiento real justo después de la elección en anaquel.</strong>
            </figcaption>
          </figure>
          <figure class="generated-insight-card">
            <img src="/imagenes-mindtec/generated/shopper-productos-vistos-analisis.webp" alt="Analisis de cantidad de productos vistos y zonas de atencion en anaquel" loading="lazy">
            <figcaption>
              <span>Productos vistos</span>
              <strong>Conteo de exposición, fijaciones y zonas calientes para optimizar categoría.</strong>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- 2. EL PROBLEMA -->
    <section class="problem-section bg-slate" style="padding: 5rem 0;">
      <div class="container">
        <div class="premium-card-white" style="max-width: 900px; margin: 0 auto; padding: 4rem;">
          <span class="eyebrow">EL PROBLEMA REAL</span>
          <h2 class="text-navy" style="font-size: 2.5rem; margin-top: 1rem; margin-bottom: 2rem; line-height: 1.2;">Inviertes en trade marketing sin saber qué parte de esa inversión realmente influye al comprador.</h2>
          <p class="text-gray-dark leading-relaxed" style="font-size: 1.15rem; margin-bottom: 1.5rem; line-height: 1.7;">
            La mayoría de las decisiones de inversión en trade marketing se toman sin evidencia sobre cómo se comporta el comprador en el anaquel. Se asume que más material POP, mejor posición o más facings automáticamente generan más ventas. Muchas veces no es así.
          </p>
          <p class="text-gray-dark leading-relaxed" style="font-size: 1.05rem; margin-bottom: 2rem; line-height: 1.7;">
            ¿Reconoces alguno de estos escenarios?
          </p>
          <ul class="cap-list" style="font-size: 1.05rem; margin-bottom: 2rem;">
            <li><strong class="text-navy">Tienes buena distribución pero las ventas no reflejan tu presencia en el canal.</strong> El comprador pasa frente a tu producto y no lo ve — o lo ve pero no lo elige.</li>
            <li><strong class="text-navy">Invertiste en material POP premium y no sabes si alguien lo nota.</strong> Sin datos de atención, no sabes si tu inversión en visibilidad está funcionando.</li>
            <li><strong class="text-navy">Tu producto tiene la mejor calidad del mercado pero pierde en el anaquel.</strong> El problema puede estar en el packaging, la posición, el precio percibido o el momento de decisión — sin shopper insights, no sabrás cuál.</li>
            <li><strong class="text-navy">El equipo de ventas reporta excelente ejecución, pero la conversión no mejora.</strong> La ejecución y el comportamiento del shopper son dos cosas distintas.</li>
          </ul>
          <div style="background: var(--color-secondary); color: #fff; padding: 1.5rem 2rem; border-radius: 8px; font-weight: 600; font-size: 1.1rem; text-align: center;">
            El 70% de las decisiones de compra se toman frente al anaquel. Sin shopper insights, estás adivinando qué las mueve.
          </div>
        </div>
      </div>
    </section>

    <!-- 3. MINDTEC+ -->
    <section style="padding: 5rem 0; background: #fff;">
      <div class="container">
        <div class="section-title-center" style="text-align: center; margin-bottom: 3rem;">
          <span class="eyebrow">MINDTEC+</span>
          <h2 class="text-navy" style="font-size: 2.2rem; line-height: 1.2; margin-top: 1rem; margin-bottom: 1rem;">La decisión de compra se estudia donde ocurre — no en una sala de reuniones.</h2>
        </div>
        <div class="comparison-table-wrapper">
          <table class="comparison-table">
            <thead>
              <tr>
                <th scope="col">Investigación de shopper estándar</th>
                <th scope="col">MindTEC — Shopper Insights</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Encuestas sobre comportamiento de compra declarado (lo que el comprador dice que hace)</td>
                <td>Observación directa del comportamiento real en el PDV (lo que el comprador realmente hace)</td>
              </tr>
              <tr>
                <td>Focus groups sobre preferencias de producto en sala</td>
                <td>Entrevistas post-compra inmediatas capturando la racionalización en caliente, justo después de la decisión</td>
              </tr>
              <tr>
                <td>Sin medición de atención visual</td>
                <td>Eye tracking portátil en anaquel real para saber exactamente qué captura la mirada del comprador</td>
              </tr>
              <tr>
                <td>Datos del comportamiento de un shopper genérico</td>
                <td>Segmentación del comportamiento por tipo de comprador: planificado vs. impulsivo, usuario vs. comprador</td>
              </tr>
              <tr>
                <td>Hallazgos descriptivos sin implicaciones para trade marketing</td>
                <td>Brief de activación para trade marketing: qué cambiar en packaging, posición, POP y categoría para mejorar conversión</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="text-gray-dark" style="font-size: 1.05rem; margin-top: 2rem; max-width: 800px; margin-left: auto; margin-right: auto; text-align: center; line-height: 1.7;">
          Combinamos psicoantropología, ciencias del comportamiento y neuromarketing aplicado al punto de venta para entender la decisión de compra en su contexto real.
        </p>
      </div>
    </section>

    <!-- 4. ENTREGABLES -->
    <section class="problem-section bg-slate" style="padding: 5rem 0;">
      <div class="container">
        <div class="section-title-center" style="text-align: center; margin-bottom: 3rem;">
          <span class="eyebrow">QUÉ RECIBES</span>
          <h2 class="text-navy" style="font-size: 2.2rem; line-height: 1.2; margin-top: 1rem;">Entregables que optimizan tu inversión en trade marketing.</h2>
        </div>
        <ul style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; list-style: none; padding: 0;">
          <li class="premium-card-white" style="padding: 2rem;">
            <h4 class="text-navy" style="font-size: 1.05rem; margin-bottom: 0.75rem;">Mapa del Journey del Shopper</h4>
            <p class="text-gray-dark" style="font-size: 0.9rem; line-height: 1.6;">Diagrama visual del recorrido completo del comprador en el PDV: puntos de entrada, zonas de permanencia, momentos de decisión y triggers de compra o abandono.</p>
          </li>
          <li class="premium-card-white" style="padding: 2rem;">
            <h4 class="text-navy" style="font-size: 1.05rem; margin-bottom: 0.75rem;">Análisis de Trayectoria y Tiempo de Permanencia</h4>
            <p class="text-gray-dark" style="font-size: 0.9rem; line-height: 1.6;">Cuánto tiempo pasa el comprador en cada zona, qué lo detiene, qué lo hace avanzar. Identificación de zonas frías y zonas calientes de atención en el espacio comercial.</p>
          </li>
          <li class="premium-card-white" style="padding: 2rem;">
            <h4 class="text-navy" style="font-size: 1.05rem; margin-bottom: 0.75rem;">Mapa de Atención Visual en Anaquel</h4>
            <p class="text-gray-dark" style="font-size: 0.9rem; line-height: 1.6;">Con eye tracking portátil: qué elementos del anaquel capturan la mirada, cuánto tiempo permanece la atención y qué zona del packaging concentra la fijación visual en los primeros 3 segundos.</p>
          </li>
          <li class="premium-card-white" style="padding: 2rem;">
            <h4 class="text-navy" style="font-size: 1.05rem; margin-bottom: 0.75rem;">Análisis de Decisores de Compra</h4>
            <p class="text-gray-dark" style="font-size: 0.9rem; line-height: 1.6;">Qué variables determinan la elección en el momento de verdad: precio, packaging, posición, recomendación, hábito o impulso. Ponderación de cada factor según tipo de comprador y canal.</p>
          </li>
          <li class="premium-card-white" style="padding: 2rem;">
            <h4 class="text-navy" style="font-size: 1.05rem; margin-bottom: 0.75rem;">Brief de Optimización de Trade Marketing</h4>
            <p class="text-gray-dark" style="font-size: 0.9rem; line-height: 1.6;">Recomendaciones concretas para equipo de trade: qué cambiar en posición de anaquel, diseño de POP, layout de categoría, packaging y argumentación de venta para mejorar la tasa de conversión.</p>
          </li>
          <li class="premium-card-white" style="padding: 2rem;">
            <h4 class="text-navy" style="font-size: 1.05rem; margin-bottom: 0.75rem;">Executive Brief para Directorio Comercial</h4>
            <p class="text-gray-dark" style="font-size: 0.9rem; line-height: 1.6;">Síntesis ejecutiva con el impacto estimado en conversión de cada cambio recomendado, priorizados por facilidad de implementación y potencial de mejora en ventas.</p>
          </li>
        </ul>
        <p class="text-gray-dark" style="text-align: center; margin-top: 2rem; font-size: 0.95rem; font-weight: 600;">
          Plazo de entrega: 2–4 semanas desde el inicio del campo · Cobertura: supermercados, canal moderno y mercados populares del eje troncal boliviano
        </p>
      </div>
    </section>

    <!-- 5. PROCESO -->
    <section style="padding: 5rem 0; background: #f8fafc;">
      <div class="container">
        <div class="section-title-center" style="text-align: center; margin-bottom: 4rem;">
          <span class="eyebrow">CÓMO FUNCIONA</span>
          <h2 class="text-navy" style="font-size: 2.2rem; line-height: 1.2; margin-top: 1rem;">Del diagnóstico al brief de trade marketing en 4 pasos.</h2>
        </div>
        <ol style="list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem;">
          <li class="premium-card-white" style="padding: 2rem; position: relative;">
            <span style="font-size: 2.5rem; font-weight: 900; color: rgba(242,101,34,0.12); position: absolute; top: 1rem; right: 1.25rem; line-height: 1;">01</span>
            <h4 class="text-navy" style="font-size: 1.1rem; margin-bottom: 0.75rem;">Diagnóstico estratégico</h4>
            <p class="text-gray-dark" style="font-size: 0.9rem; line-height: 1.6;">45 min para entender tu situación de trade, los indicadores de conversión que te preocupan y qué decisiones de inversión necesitas justificar con evidencia.</p>
            <span style="font-size: 0.8rem; font-weight: 700; color: var(--color-primary);">45 min · sin costo</span>
          </li>
          <li class="premium-card-white" style="padding: 2rem; position: relative;">
            <span style="font-size: 2.5rem; font-weight: 900; color: rgba(242,101,34,0.12); position: absolute; top: 1rem; right: 1.25rem; line-height: 1;">02</span>
            <h4 class="text-navy" style="font-size: 1.1rem; margin-bottom: 0.75rem;">Diseño del estudio</h4>
            <p class="text-gray-dark" style="font-size: 0.9rem; line-height: 1.6;">Definimos canales, número de observaciones, perfil de shoppers a observar, herramientas (etnografía, eye tracking, entrevistas) y variables clave a medir.</p>
            <span style="font-size: 0.8rem; font-weight: 700; color: var(--color-primary);">3–5 días hábiles</span>
          </li>
          <li class="premium-card-white" style="padding: 2rem; position: relative;">
            <span style="font-size: 2.5rem; font-weight: 900; color: rgba(242,101,34,0.12); position: absolute; top: 1rem; right: 1.25rem; line-height: 1;">03</span>
            <h4 class="text-navy" style="font-size: 1.1rem; margin-bottom: 0.75rem;">Observación en PDV</h4>
            <p class="text-gray-dark" style="font-size: 0.9rem; line-height: 1.6;">Etnógrafos entrenados observan compradores reales en el PDV. Eye tracking portátil en anaquel. Entrevistas post-compra inmediatas con compradores que aceptan participar.</p>
            <span style="font-size: 0.8rem; font-weight: 700; color: var(--color-primary);">1–2 semanas en campo</span>
          </li>
          <li class="premium-card-white" style="padding: 2rem; position: relative;">
            <span style="font-size: 2.5rem; font-weight: 900; color: rgba(242,101,34,0.12); position: absolute; top: 1rem; right: 1.25rem; line-height: 1;">04</span>
            <h4 class="text-navy" style="font-size: 1.1rem; margin-bottom: 0.75rem;">Insights y activación</h4>
            <p class="text-gray-dark" style="font-size: 0.9rem; line-height: 1.6;">Análisis de datos de observación, eye tracking y entrevistas. Entrega del brief de trade marketing con recomendaciones priorizadas. Presentación ante equipo comercial y directivo.</p>
            <span style="font-size: 0.8rem; font-weight: 700; color: var(--color-primary);">7–10 días post-campo</span>
          </li>
        </ol>
      </div>
    </section>

    <!-- 6. SECTORES -->
    <section class="problem-section bg-slate" style="padding: 5rem 0;">
      <div class="container">
        <div class="section-title-center" style="text-align: center; margin-bottom: 3rem;">
          <span class="eyebrow">SECTORES Y CANALES</span>
          <h2 class="text-navy" style="font-size: 2.2rem; line-height: 1.2; margin-top: 1rem;">¿Tu categoría está aquí?</h2>
        </div>
        <ul style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; list-style: none; padding: 0;">
          <li class="premium-card-white" style="padding: 1.5rem; text-align: center; font-weight: 700; color: var(--color-secondary); font-size: 0.95rem;">Alimentos y bebidas</li>
