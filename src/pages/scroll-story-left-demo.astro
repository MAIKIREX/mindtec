---
import ScrollStoryLeft from "../components/scroll/ScrollStoryLeft.astro";

const cover = {
  background:
    "https://images.unsplash.com/photo-1497366754035-f200968a6e72?auto=format&fit=crop&w=2400&q=88",
  alt: "Interior de una oficina moderna",
  eyebrow: "Nueva experiencia corporativa",
  title: "Conectamos espacios con oportunidades.",
  description:
    "Una historia visual controlada por scroll con fondos superpuestos y una tarjeta que se transforma hacia la izquierda."
};

const intro = {
  background:
    "https://images.unsplash.com/photo-1497366811353-6870744d04b2?auto=format&fit=crop&w=2400&q=88",
  alt: "Espacio de trabajo contemporáneo",
  number: "02",
  eyebrow: "Accesibilidad",
  title:
    "Más cerca de lo que imaginas. Un entorno conectado con la ciudad.",
  description:
    "Al hacer scroll, la tarjeta entra desde abajo ocupando gran parte de la ventana y luego se transforma continuamente."
};

const items = [
  {
    background:
      "https://images.unsplash.com/photo-1436491865332-7a61a109cc05?auto=format&fit=crop&w=2400&q=88",
    alt: "Avión en vuelo",
    eyebrow: "Conectividad",
    title: "Proximidad al aeropuerto",
    description:
      "Acceso rápido a conexiones nacionales e internacionales para equipos, clientes y socios estratégicos.",
    icon: "airport" as const
  },
  {
    background:
      "https://images.unsplash.com/photo-1449824913935-59a10b8d2000?auto=format&fit=crop&w=2400&q=88",
    alt: "Carretera urbana iluminada",
    eyebrow: "Movilidad",
    title: "Red vial en crecimiento",
    description:
      "Rutas principales y nuevos accesos que reducen tiempos de traslado y facilitan la movilidad empresarial.",
    icon: "road" as const
  },
  {
    background:
      "https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=2400&q=88",
    alt: "Edificio empresarial moderno",
    eyebrow: "Infraestructura",
    title: "Arquitectura preparada para crecer",
    description:
      "Espacios corporativos flexibles, iluminación natural y servicios adaptados a nuevas formas de trabajo.",
    icon: "building" as const
  },
  {
    background:
      "https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=2400&q=88",
    alt: "Oficina con espacios colaborativos",
    eyebrow: "Servicios",
    title: "Todo lo necesario en un mismo lugar",
    description:
      "Áreas colaborativas, restaurantes, reuniones y soporte empresarial integrados en un solo ecosistema.",
    icon: "services" as const
  }
];
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Demostración de ScrollStoryLeft con Astro y GSAP"
    />
    <title>ScrollStoryLeft — Astro + GSAP</title>
  </head>

  <body>
    <!-- El header queda fuera del wrapper -->
    <header class="demo-header">
      <button type="button" aria-label="Abrir menú" class="demo-menu">
        <span></span>
        <span></span>
      </button>

      <a class="demo-brand" href="/">NEUROLAB</a>

      <nav class="demo-nav" aria-label="Navegación principal">
        <a href="#">Espacios</a>
        <a href="#">Servicios</a>
        <a href="#">Contacto</a>
      </nav>
    </header>

    <main>
      <ScrollStoryLeft
        cover={cover}
        intro={intro}
        items={items}
        scrub={0.9}
        sceneDistance={1}
        introCardWidth={0.98}
        introCardHeight={0.6}
        sideCardWidth={0.48}
        sideCardHeight={0.82}
        cardBackground="#f6f6f3"
        cardTextColor="#070a20"
        cardMutedColor="rgba(7, 10, 32, 0.62)"
      />

      <section class="after-demo">
        <span>Final de la secuencia</span>
        <h2>El resto de la página continúa normalmente.</h2>
        <p>
          Puedes agregar más escenas añadiendo objetos al array
          <code>items</code>. El número de transiciones, indicadores y recorrido
          de scroll se actualiza automáticamente.
        </p>
      </section>
    </main>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    overflow-x: hidden;
    background: #080b20;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  .demo-header {
    position: fixed;
    z-index: 100;
    top: 0;
    left: 0;
    right: 0;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    min-height: 72px;
    padding: 0 clamp(18px, 4vw, 70px);
    color: white;
    mix-blend-mode: difference;
    pointer-events: none;
  }

  .demo-header a,
  .demo-header button {
    pointer-events: auto;
  }

  .demo-menu {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 56px;
    padding: 10px 0;
    border: 0;
    color: inherit;
    background: transparent;
    cursor: pointer;
  }

  .demo-menu span {
    display: block;
    width: 100%;
    height: 1px;
    background: currentColor;
  }

  .demo-brand {
    margin-left: clamp(28px, 5vw, 90px);
    color: inherit;
    font-size: 1.4rem;
    font-weight: 400;
    letter-spacing: 0.28em;
    text-decoration: none;
  }

  .demo-nav {
    display: flex;
    gap: clamp(22px, 4vw, 65px);
  }

  .demo-nav a {
    color: inherit;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .after-demo {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(42px, 8vw, 130px);
    color: white;
    background:
      radial-gradient(
        circle at 25% 45%,
        rgba(90, 110, 220, 0.28),
        transparent 34%
      ),
      #0a0d1c;
  }

  .after-demo > span {
    margin-bottom: 24px;
    color: #afbdff;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .after-demo h2 {
    max-width: 1000px;
    margin: 0;
    font-size: clamp(3rem, 7vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.06em;
  }

  .after-demo p {
    max-width: 680px;
    margin: 34px 0 0;
    color: rgba(255, 255, 255, 0.68);
    font-size: 1.08rem;
    line-height: 1.7;
  }

  .after-demo code {
    color: white;
  }

  @media (max-width: 700px) {
    .demo-header {
      grid-template-columns: auto 1fr;
      min-height: 62px;
      padding: 0 18px;
    }

    .demo-menu {
      width: 42px;
    }

    .demo-brand {
      justify-self: end;
      margin-left: 0;
      font-size: 1rem;
    }

    .demo-nav {
      display: none;
    }
  }
</style>
