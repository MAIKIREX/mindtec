    @media (min-width: 900px) {
      .related-products-bleed {
        width: 100vw;
        position: relative;
        left: 50%;
        right: 50%;
        margin-left: -50vw;
        margin-right: -50vw;
        padding: 0 clamp(1.5rem, 4vw, 4rem);
      }
    }

    .areas-grid {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.55rem;
        max-width: 1320px;
        margin: 0 auto;
        text-align: left;
    }

    .area-panel {
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        flex: 1 1 calc((100% - 4 * 0.55rem) / 5);
        max-width: calc((100% - 4 * 0.55rem) / 5);
        min-height: 290px;
        padding: 1.5rem 1.25rem;
        overflow: hidden;
        background: #082235;
        border: 1px solid rgba(141, 191, 221, 0.72);
        color: #fff;
        text-decoration: none;
        isolation: isolate;
        transition: transform 280ms cubic-bezier(0.16, 1, 0.3, 1), background-color 280ms cubic-bezier(0.16, 1, 0.3, 1), border-color 280ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .area-panel::after {
        position: absolute;
        z-index: -1;
        inset: 0;
        background: linear-gradient(145deg, rgba(29, 82, 112, 0.42), transparent 55%);
        content: "";
        opacity: 0;
        transition: opacity 280ms ease;
    }

    .area-panel:nth-child(odd) {
        clip-path: polygon(0 0, 100% 0, 100% 31%, 88% 31%, 88% 69%, 100% 69%, 100% 100%, 0 100%);
    }

    .area-panel:nth-child(even) {
        clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%, 0 69%, 12% 69%, 12% 31%, 0 31%);
    }

    .area-panel:hover {
        transform: translateY(-6px);
        background: #0b2c43;
        border-color: var(--color-primary, #e7a548);
    }

    .area-panel:hover::after {
        opacity: 1;
    }

    .area-panel:focus-visible {
        outline: 3px solid var(--color-primary, #e7a548);
        outline-offset: 4px;
    }

    .area-panel__icon {
        display: grid;
        width: 76px;
        height: 76px;
        place-items: center;
        align-self: center;
        margin: auto 0;
        border: 1px solid rgba(168, 207, 232, 0.86);
        border-radius: 50%;
        color: #c5e3f3;
        transition: color 280ms ease, border-color 280ms ease, transform 280ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .area-panel:hover .area-panel__icon {
        border-color: var(--color-primary, #e7a548);
        color: var(--color-primary, #e7a548);
        transform: scale(1.06);
    }

    .area-panel__icon svg {
        width: 42px;
        height: 42px;
    }

    .area-panel__title {
        display: block;
        max-width: 14ch;
        font-family: var(--font-display);
        font-size: clamp(1rem, 1.3vw, 1.2rem);
        font-weight: 700;
        line-height: 1.17;
        letter-spacing: -0.02em;
    }

    .area-panel__title small {
        display: block;
        margin-top: 0.15rem;
        color: rgba(255, 255, 255, 0.66);
        font-size: 0.78em;
        font-weight: 600;
    }

    .area-panel__arrow {
        position: absolute;
        right: 1.2rem;
        bottom: 1.15rem;
        color: var(--color-primary, #e7a548);
        font-size: 1.3rem;
        line-height: 1;
        opacity: 0;
        transform: translateX(-8px);
        transition: opacity 220ms ease, transform 280ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .area-panel:hover .area-panel__arrow,
    .area-panel:focus-visible .area-panel__arrow {
        opacity: 1;
        transform: translateX(0);
    }

    @media (max-width: 1100px) {
        .area-panel {
            flex-basis: calc((100% - 2 * 0.55rem) / 3);
            max-width: calc((100% - 2 * 0.55rem) / 3);
        }
    }

    @media (max-width: 700px) {
        .area-panel {
            flex-basis: calc((100% - 0.55rem) / 2);
            max-width: calc((100% - 0.55rem) / 2);
        }

        .area-panel,
        .area-panel:nth-child(odd),
        .area-panel:nth-child(even) {
            min-height: 235px;
            clip-path: none;
        }
    }

    @media (max-width: 460px) {
        .area-panel {
            flex-basis: 100%;
            max-width: 100%;
            min-height: 205px;
        }

        .area-panel__icon {
            width: 64px;
            height: 64px;
        }

        .area-panel__icon svg {
            width: 35px;
            height: 35px;
        }
    }
</style>
