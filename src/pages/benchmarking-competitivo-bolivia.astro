---
import Layout from "../layouts/Layout.astro";
import ServiceVisualSuite from "../components/sections/ServiceVisualSuite.astro";
import FaqSplit from "../components/faq/FaqSplit.astro";
import HoverStepCards from "../components/cards/HoverStepCards.astro";
import AreaPanelCards from "../components/cards/AreaPanelCards.astro";
import ScrollStory from "../components/scroll/ScrollStory.astro";

const processSteps = [
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>`,
    title: "Diagnóstico estratégico",
    small: "45 min · sin costo",
    description:
      "45 min para identificar tus competidores prioritarios, las dimensiones que más te preocupan y la decisión de negocio que el benchmarking debe informar.",
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>`,
    title: "Diseño del radar",
    small: "3–5 días hábiles",
    description:
      "Definimos qué dimensiones medir, qué competidores incluir, qué ciudades y canales cubrir y cómo combinar campo, percepción y análisis digital.",
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1" ry="1"/></svg>`,
    title: "Recolección de inteligencia",
    small: "1–3 semanas en campo",
    description:
      "Auditores de campo + entrevistas a consumidores + análisis de comunicación digital. Recolección simultánea en todos los competidores para comparabilidad exacta.",
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/><line x1="2" y1="20" x2="22" y2="20"/></svg>`,
    title: "Radar y recomendaciones",
    small: "5–7 días post-campo",
    description:
      "Entrega del mapa competitivo completo con análisis de vulnerabilidades y oportunidades. Presentación ante directorio con sesión de priorización de respuestas estratégicas.",
  },
];

const faqItems = [
  {
    question:
      "¿Qué variables se incluyen en el benchmarking competitivo de MindTEC?",
    answer:
      "Mapeamos: precios en anaquel y canal, distribución y presencia por zona, ejecución en punto de venta (share of shelf, POP, planograma), posicionamiento y percepción de marca, estrategia de comunicación y lanzamientos recientes. El alcance se define según la decisión que necesitas tomar.",
  },
  {
    question: "¿Cuántos competidores pueden incluirse en el radar?",
    answer:
      "El estándar incluye 3–5 competidores directos. Para estudios sectoriales o categorías complejas podemos mapear hasta 10 actores. El número óptimo depende de tu mercado y del nivel de profundidad requerido por dimensión.",
  },
  {
    question: "¿Con qué frecuencia pueden hacer el benchmarking?",
    answer:
      "Ofrecemos estudios puntuales (fotografía del mercado en un momento dado) y monitoreo continuo en olas trimestrales o semestrales. El monitoreo continuo permite detectar movimientos de la competencia antes de que impacten tu posición.",
  },
  {
    question:
      "¿Cómo obtienen la información de la competencia sin violar ninguna ética o ley?",
    answer:
      "Toda la información que recopilamos es pública u observable: precios en anaquel, presencia en PDV, comunicación en medios, posicionamiento percibido por consumidores, y distribución en canal. No utilizamos métodos de espionaje industrial ni acceso a información confidencial de terceros.",
  },
  {
    question:
      "¿El benchmarking incluye la percepción del consumidor sobre la competencia?",
    answer:
      "Sí, cuando el proyecto lo requiere. El Radar Competitivo puede incluir entrevistas o mini-encuestas para mapear cómo el consumidor percibe y diferencia tu marca de los competidores, complementando los datos de campo con la voz del mercado.",
  },
];

const title = "Análisis de la Competencia en Bolivia | Mindtec";
const description =
  "Análisis de competencia en Bolivia: evaluamos precios, ejecución y estrategias de sus competidores con datos reales de mercado. Mindtec.";
---

<Layout
  title={title}
  description={description}
  headerLightBg={false}
  canonicalUrl="/benchmarking-competitivo-bolivia"
>
  <script type="application/ld+json" slot="head">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Service",
          "@id": "https://www.mindtecbolivia.com/benchmarking-competitivo-bolivia",
          "name": "Benchmarking Competitivo en Bolivia — Radar Competitivo MindTEC",
          "description": "Servicio de benchmarking competitivo e inteligencia de mercado en Bolivia. Mapeamos precios, distribución, posicionamiento y ejecución en PDV de tus competidores con campo real y análisis de IA.",
          "provider": {
            "@type": "Organization",
            "name": "MindTEC Bolivia",
            "url": "https://www.mindtecbolivia.com"
          },
          "areaServed": { "@type": "Country", "name": "Bolivia" },
          "serviceType": "Benchmarking Competitivo / Inteligencia de Mercado",
          "url": "https://www.mindtecbolivia.com/benchmarking-competitivo-bolivia"
        },
        {
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "¿Qué variables se incluyen en el benchmarking competitivo de MindTEC?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Mapeamos: precios en anaquel y canal, distribución y presencia por zona, ejecución en punto de venta (share of shelf, POP, planograma), posicionamiento y percepción de marca, estrategia de comunicación y lanzamientos recientes. El alcance se define según la decisión que necesitas tomar."
              }
            },
            {
              "@type": "Question",
              "name": "¿Cuántos competidores pueden incluirse en el radar?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "El estándar incluye 3–5 competidores directos. Para estudios sectoriales o categorías complejas podemos mapear hasta 10 actores. El número óptimo depende de tu mercado y del nivel de profundidad requerido por dimensión."
              }
            },
            {
              "@type": "Question",
              "name": "¿Con qué frecuencia pueden hacer el benchmarking?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Ofrecemos estudios puntuales (fotografía del mercado en un momento dado) y monitoreo continuo en olas trimestrales o semestrales. El monitoreo continuo permite detectar movimientos de la competencia antes de que impacten tu posición."
              }
            },
            {
              "@type": "Question",
              "name": "¿Cómo obtienen la información de la competencia sin violar ninguna ética o ley?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Toda la información que recopilamos es pública u observable: precios en anaquel, presencia en PDV, comunicación en medios, posicionamiento percibido por consumidores, y distribución en canal. No utilizamos métodos de espionaje industrial ni acceso a información confidencial de terceros."
              }
            },
            {
              "@type": "Question",
              "name": "¿El benchmarking incluye la percepción del consumidor sobre la competencia?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Sí, cuando el proyecto lo requiere. El Radar Competitivo puede incluir entrevistas o mini-encuestas para mapear cómo el consumidor percibe y diferencia tu marca de los competidores, complementando los datos de campo con la voz del mercado."
              }
            }
          ]
        },
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "Inicio",
              "item": "https://www.mindtecbolivia.com/"
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": "Servicios",
              "item": "https://www.mindtecbolivia.com/servicios"
            },
            {
              "@type": "ListItem",
              "position": 3,
              "name": "Benchmarking Competitivo en Bolivia",
              "item": "https://www.mindtecbolivia.com/benchmarking-competitivo-bolivia"
            }
          ]
        }
      ]
    }
  </script>

  <main>
    <!-- 1. HERO -->
    <section
      class="hero-section"
      style="padding-bottom: 4rem; padding-top: 4rem;"
    >
      <div class="hero-shapes" aria-hidden="true">
        <div class="hero-shape"></div><div class="hero-shape"></div><div
          class="hero-shape"
        >
        </div>
        <div class="hero-shape"></div><div class="hero-shape"></div><div
          class="hero-shape"
        >
        </div>
        <div class="hero-shape"></div><div class="hero-shape"></div><div
          class="hero-shape"
        >
        </div>
        <div class="hero-shape"></div><div class="hero-shape"></div><div
          class="hero-shape"
        >
        </div>
        <div class="hero-shape"></div><div class="hero-shape"></div><div
          class="hero-shape"
        >
        </div>
        <div class="hero-shape"></div>
      </div>
      <div
        class="hero-mobile-canvas"
        id="hero-mobile-canvas"
        aria-hidden="true"
      >
      </div>
      <div class="container hero-container">
        <div class="hero-content">
          <span class="eyebrow fade-in"
            >INTELIGENCIA COMPETITIVA DE MERCADO</span
          >
          <span class="freshness-tag">Actualizado: julio 2026</span>
          <h1
            class="hero-title"
            style="font-size: 3.5rem; line-height: 1.25; margin-bottom: 1.5rem;"
          >
            Benchmarking Competitivo en Bolivia — Lo que tu competencia hace y
            tú no estás viendo.
          </h1>
          <div class="direct-answer-box">
            <strong>En resumen</strong>
            <p>
              MindTEC ofrece benchmarking competitivo e inteligencia de mercado
              en Bolivia, mapeando precios, distribución, posicionamiento y
              ejecución en PDV de la competencia con campo real y análisis de
              IA.
            </p>
          </div>
          <p
            class="hero-subtitle"
            style="font-size: 1.25rem; margin-bottom: 1.5rem; max-width: 800px;"
          >
            Inteligencia competitiva sistematizada en campo, percepción de
            mercado y análisis digital. Mapeamos precios, distribución,
            posicionamiento y ejecución en PDV de tus competidores más
            relevantes.
          </p>
          <p
            style="font-size: 1.05rem; color: rgba(255,255,255,0.75); max-width: 800px; margin-bottom: 2.5rem;"
          >
            No son datos de fuentes secundarias ni reportes de industria
            genéricos. Es inteligencia de campo recolectada en el mercado
            boliviano real, combinada con análisis de percepción del consumidor
            y seguimiento digital.
          </p>
          <div
            style="display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 2.5rem;"
          >
            <span
              style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #fff; padding: 0.4rem 1rem; border-radius: 20px; font-size: 0.85rem; font-weight: 600;"
              >Precios · Distribución · PDV</span
            >
            <span
              style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #fff; padding: 0.4rem 1rem; border-radius: 20px; font-size: 0.85rem; font-weight: 600;"
              >3–5 competidores</span
            >
            <span
              style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #fff; padding: 0.4rem 1rem; border-radius: 20px; font-size: 0.85rem; font-weight: 600;"
              >Percepción de consumidores</span
            >
            <span
              style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #fff; padding: 0.4rem 1rem; border-radius: 20px; font-size: 0.85rem; font-weight: 600;"
              >Monitoreo continuo disponible</span
            >
          </div>
          <a href="/contacto" class="btn btn-primary lg"
            >Agendar diagnóstico estratégico (45 min) →</a
          >
        </div>
        <div class="hero-visual">
          <div class="glass-card main-visual">
            <div
              class="neuro-visual-bg"
              style="background-image: url('/heroes/hero-auditoria-retail-bolivia.jpg');"
            >
            </div>
          </div>
        </div>
      </div>
    </section>

    <ServiceVisualSuite variant="benchmarking" />

    <!-- 2. EL PROBLEMA -->
    <section class="problem-section bg-slate" style="padding: 5rem 0;">
      <div class="container">
        <div
          class="premium-card-white"
          style="max-width: 900px; margin: 0 auto; padding: 4rem;"
        >
          <span class="eyebrow">EL PROBLEMA REAL</span>
          <h2
            class="text-navy"
            style="font-size: 2.5rem; margin-top: 1rem; margin-bottom: 2rem; line-height: 1.2;"
          >
            Las empresas que pierden cuota de mercado casi nunca lo ven venir —
            hasta que ya es tarde.
          </h2>
          <p
            class="text-gray-dark leading-relaxed"
            style="font-size: 1.15rem; margin-bottom: 1.5rem; line-height: 1.7;"
          >
            El problema no es no tener competidores. El problema es no saber qué
            están haciendo. La mayoría de las empresas en Bolivia toma
            decisiones de precio, canal y comunicación basándose en suposiciones
            sobre la competencia — no en evidencia.
          </p>
          <p
            class="text-gray-dark leading-relaxed"
            style="font-size: 1.05rem; margin-bottom: 2rem; line-height: 1.7;"
          >
            ¿Reconoces alguno de estos escenarios?
          </p>
          <ul class="cap-list" style="font-size: 1.05rem; margin-bottom: 2rem;">
            <li>
              <strong class="text-navy"
                >Tu precio ya no es competitivo — y no te enteraste hasta que el
                cliente te lo dijo.</strong
              > Sin monitoreo continuo, los cambios de precio de la competencia son
              invisibles hasta que afectan tus ventas.
            </li>
            <li>
              <strong class="text-navy"
                >Un competidor ganó distribución en canales donde tú tenías
                exclusividad.</strong
              > Cuando lo descubriste, ya tenían 3 meses de ventaja en el anaquel.
            </li>
            <li>
              <strong class="text-navy"
                >Tu campaña de lanzamiento chocó con una acción competitiva que
                no anticipaste.</strong
              > Inteligencia oportuna habría permitido ajustar el timing o la propuesta.
            </li>
            <li>
              <strong class="text-navy"
                >El directorio pide evidencia de dónde estás parado frente a la
                competencia.</strong
              > Y lo que tienes son suposiciones del equipo comercial, no datos.
            </li>
          </ul>
          <div
            style="background: var(--color-secondary); color: #fff; padding: 1.5rem 2rem; border-radius: 8px; font-weight: 600; font-size: 1.1rem; text-align: center;"
          >
            Competir sin inteligencia competitiva es como jugar ajedrez sin ver
            el tablero completo.
          </div>
        </div>
      </div>
    </section>

    <!-- 3. MINDTEC+ -->
    <section style="padding: 5rem 0; background: #fff;">
      <div class="container">
        <div
          class="section-title-center"
          style="text-align: center; margin-bottom: 3rem;"
        >
          <span class="eyebrow">MINDTEC+</span>
          <h2
            class="text-navy"
            style="font-size: 2.2rem; line-height: 1.2; margin-top: 1rem; margin-bottom: 1rem;"
          >
            Inteligencia competitiva que va más allá del precio en anaquel.
          </h2>
        </div>
        <div class="comparison-table-wrapper">
          <table class="comparison-table">
            <thead>
              <tr>
                <th scope="col">Benchmarking estándar</th>
                <th scope="col">MindTEC — Radar Competitivo</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Revisión de precios en un momento puntual</td>
                <td
                  >Monitoreo continuo de precios, promociones y estrategias de
                  canal con alertas ante cambios significativos</td
                >
              </tr>
              <tr>
                <td
                  >Datos de fuentes secundarias (informes de industria,
                  internet)</td
                >
                <td
                  >Inteligencia primaria de campo: auditores en PDV +
                  entrevistas a consumidores + análisis digital</td
                >
              </tr>
              <tr>
                <td>Foto estática de la competencia</td>
                <td
                  >Radar dinámico que detecta movimientos y tendencias antes de
                  que impacten tu posición</td
                >
              </tr>
              <tr>
                <td>Sin voz del consumidor</td>
                <td
                  >Percepción comparada: cómo diferencia el consumidor tu marca
                  de los competidores</td
                >
              </tr>
              <tr>
                <td>Datos que el equipo comercial interpreta según su sesgo</td>
                <td
                  >Análisis independiente con recomendaciones estratégicas
                  priorizadas para el directorio</td
                >
              </tr>
            </tbody>
          </table>
        </div>
        <p
          class="text-gray-dark"
          style="font-size: 1.05rem; margin-top: 2rem; max-width: 800px; margin-left: auto; margin-right: auto; text-align: center; line-height: 1.7;"
        >
          El Radar Competitivo no es un snapshot del mercado. Es el sistema de
          alerta temprana que tu equipo necesita para anticipar — no reaccionar.
        </p>
      </div>
    </section>

    <!-- 4. ENTREGABLES -->
    <ScrollStory
      scrub={0.85}
      sceneDistance={1.1}
      cover={{
        background: "/imagenes-mindtec/generated/benchmarking-competitivo/entregables/entregables-cover.webp",
        eyebrow: "Qué recibes",
        title: "Entregables que informan decisiones de precio, canal y comunicación.",
        description: "Documentos y análisis diseñados para traducir la inteligencia competitiva en decisiones accionables."
      }}
      intro={{
        background: "/imagenes-mindtec/generated/benchmarking-competitivo/entregables/entregables-intro.webp",
        number: "00",
        eyebrow: "Plazo de entrega",
        title: "2–4 semanas según alcance. Cobertura: eje troncal boliviano y ciudades intermedias.",
        description: "Recorra los seis entregables que puede esperar del Radar Competitivo."
      }}
      items={[
        {
          background: "/imagenes-mindtec/generated/benchmarking-competitivo/entregables/entregable-01-mapa-posicionamiento.webp",
          eyebrow: "Posicionamiento",
          title: "Mapa de Posicionamiento Competitivo",
          description: "Diagrama visual de dónde está cada competidor en los ejes clave de tu categoría (precio vs. calidad percibida, cobertura vs. profundidad de línea, etc.).",
          icon: "road"
        },
        {
          background: "/imagenes-mindtec/generated/benchmarking-competitivo/entregables/entregable-02-precios-canal.webp",
          eyebrow: "Precios",
          title: "Análisis de Precios y Estrategia de Canal",
          description: "Comparación de precios en canal moderno, tradicional y digital. Análisis de descuentos, promociones y estrategias de pricing de cada competidor relevante.",
          icon: "building"
        },
        {
          background: "/imagenes-mindtec/generated/benchmarking-competitivo/entregables/entregable-03-auditoria-pdv.webp",
          eyebrow: "Ejecución",
          title: "Auditoría de Ejecución en PDV de Competidores",
          description: "Share of shelf, materiales POP, exhibiciones especiales y presencia en anaquel de tus competidores. Con evidencia fotográfica georreferenciada.",
          icon: "services"
        },
        {
          background: "/imagenes-mindtec/generated/benchmarking-competitivo/entregables/entregable-04-percepcion-consumidor.webp",
          eyebrow: "Percepción",
          title: "Percepción Comparada del Consumidor",
          description: "Cómo diferencia el consumidor tu marca de los competidores: atributos percibidos, razones de elección/rechazo y posicionamiento mental real vs. declarado.",
          icon: "airport"
        },
        {
          background: "/imagenes-mindtec/generated/benchmarking-competitivo/entregables/entregable-05-vulnerabilidades.webp",
          eyebrow: "Oportunidad",
          title: "Mapa de Vulnerabilidades y Oportunidades",
          description: "Identificación de los puntos donde la competencia es débil y tú puedes ganar terreno — y de donde eres vulnerable a sus movimientos. Base para decisiones ofensivas y defensivas.",
          icon: "road"
        },
        {
          background: "/imagenes-mindtec/generated/benchmarking-competitivo/entregables/entregable-06-brief-directorio.webp",
          eyebrow: "Síntesis",
          title: "Brief Estratégico para Directorio",
          description: "Síntesis ejecutiva con las 3–5 decisiones que el hallazgo competitivo obliga a tomar, priorizadas por impacto en cuota de mercado y urgencia.",
          icon: "building"
        }
      ]}
    />

    <!-- 5. PROCESO -->
    <section style="padding: 5rem 0; background: #f8fafc;">
      <div class="container">
        <div
          class="section-title-center"
          style="text-align: center; margin-bottom: 4rem;"
        >
          <span class="eyebrow">CÓMO FUNCIONA</span>
          <h2
            class="text-navy"
            style="font-size: 2.2rem; line-height: 1.2; margin-top: 1rem;"
          >
            Del diagnóstico al radar competitivo accionable en 4 pasos.
          </h2>
        </div>
        <AreaPanelCards items={processSteps} columns={4} />
      </div>
    </section>

    <!-- 6. SECTORES -->
    <section class="problem-section bg-slate" style="padding: 5rem 0;">
      <div class="container">
        <div
          class="section-title-center"
          style="text-align: center; margin-bottom: 3rem;"
        >
          <span class="eyebrow">SECTORES</span>
          <h2
            class="text-navy"
            style="font-size: 2.2rem; line-height: 1.2; margin-top: 1rem;"
          >
            ¿Tu sector está aquí?
          </h2>
        </div>
        <ul
          style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; list-style: none; padding: 0;"
        >
          <li
            class="premium-card-white"
            style="padding: 1.5rem; text-align: center; font-weight: 700; color: var(--color-secondary); font-size: 0.95rem;"
          >
            Consumo masivo y retail
          </li>
          <li
            class="premium-card-white"
            style="padding: 1.5rem; text-align: center; font-weight: 700; color: var(--color-secondary); font-size: 0.95rem;"
          >
            Telecomunicaciones
          </li>
          <li
            class="premium-card-white"
            style="padding: 1.5rem; text-align: center; font-weight: 700; color: var(--color-secondary); font-size: 0.95rem;"
          >
            Banca y servicios financieros
          </li>
          <li
            class="premium-card-white"
            style="padding: 1.5rem; text-align: center; font-weight: 700; color: var(--color-secondary); font-size: 0.95rem;"
          >
            Agroindustria y alimentos
          </li>
          <li
            class="premium-card-white"
            style="padding: 1.5rem; text-align: center; font-weight: 700; color: var(--color-secondary); font-size: 0.95rem;"
          >
            Farmacéutico y salud
          </li>
          <li
