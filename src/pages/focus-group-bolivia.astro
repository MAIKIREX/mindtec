---
import Layout from '../layouts/Layout.astro';
import ServiceVisualSuite from '../components/ServiceVisualSuite.astro';

const title = "Focus Group y Grupos Focales en Bolivia | Mindtec";
const description = "Focus group y grupos focales en Bolivia: metodología Sensitive Groups con análisis racional, inconsciente e intuitivo. Psicoantropología e IA. Mindtec Bolivia.";
---

<Layout
  title={title}
  description={description}
  headerLightBg={false}
  canonicalUrl="/focus-group-bolivia"
>
  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Service",
        "@id": "https://www.mindtecbolivia.com/focus-group-bolivia",
        "name": "Focus Group en Bolivia — Investigación Cualitativa MindTEC",
        "description": "Focus group evolucionado a metodología Sensitive Groups en Bolivia: análisis en niveles racional, inconsciente e intuitivo con psicoantropología e IA. MindTEC Bolivia.",
        "provider": {
          "@type": "Organization",
          "name": "MindTEC Bolivia",
          "url": "https://www.mindtecbolivia.com"
        },
        "areaServed": {"@type": "Country", "name": "Bolivia"},
        "serviceType": "Focus Group / Investigación Cualitativa",
        "url": "https://www.mindtecbolivia.com/focus-group-bolivia"
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "¿Cuántos participantes tiene un focus group en MindTEC?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Los grupos estándar tienen 6–8 participantes. Para grupos especializados (profesionales de salud, directivos, segmentos de nicho) trabajamos con 5–6 participantes para mayor profundidad. También hacemos díadas (2) y tríadas (3) cuando el tema requiere mayor apertura."
            }
          },
          {
            "@type": "Question",
            "name": "¿En qué ciudades de Bolivia hacen focus group?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Tenemos instalaciones y redes de reclutamiento en La Paz, El Alto, Cochabamba y Santa Cruz. Para ciudades intermedias como Oruro, Potosí o Sucre coordinamos instalaciones locales según el proyecto."
            }
          },
          {
            "@type": "Question",
            "name": "¿Qué diferencia a un focus group de MindTEC de uno estándar?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "La diferencia está en el moderador y en el análisis. Los moderadores son psicoantropólogos, no encuestadores. Saben explorar el por qué detrás de la respuesta y detectar contradicciones entre lo que el participante dice y lo que realmente piensa. Además, el análisis de transcripciones usa IA para detectar patrones y temas emergentes no capturados en el análisis manual."
            }
          },
          {
            "@type": "Question",
            "name": "¿Cuánto tarda un proyecto de focus group en Bolivia?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "El reclutamiento de participantes toma 5–7 días. Las sesiones se realizan en 1–3 días. El análisis y reporte se entrega 7–10 días después de las sesiones. En total: 2–3 semanas para la mayoría de proyectos."
            }
          },
          {
            "@type": "Question",
            "name": "¿Pueden observar las sesiones en tiempo real?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Sí. Disponemos de sala de observación con espejo unidireccional para que tu equipo observe las sesiones sin interferir. También ofrecemos transmisión en vivo por videollamada segura para equipos en otras ciudades."
            }
          },
          {
            "@type": "Question",
            "name": "¿Qué es un Sensitive Group y cómo funciona?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "El Sensitive Group es la evolución metodológica del focus group desarrollada por MindTEC. Trabaja tres niveles simultáneos: Racional (lo que el participante declara conscientemente), Inconsciente (motivadores ocultos y tensiones no verbalizadas, accesibles mediante técnicas proyectivas psicoantropológicas) e Intuitivo (la respuesta visceral anterior al pensamiento, mediada en Bolivia por códigos culturales específicos según el segmento). El resultado es una lectura del consumidor con profundidad que el modelo estándar no puede alcanzar."
            }
          }
        ]
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {"@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://www.mindtecbolivia.com/"},
          {"@type": "ListItem", "position": 2, "name": "Servicios", "item": "https://www.mindtecbolivia.com/servicios"},
          {"@type": "ListItem", "position": 3, "name": "Focus Group en Bolivia", "item": "https://www.mindtecbolivia.com/focus-group-bolivia"}
        ]
      }
    ]
  }
  </script>

  <main>

    <!-- BREADCRUMB -->
    <nav aria-label="Breadcrumb" style="background: rgba(11,43,64,0.97); padding: 0.75rem 0; border-bottom: 1px solid rgba(255,255,255,0.08);">
      <div class="container">
        <ol style="display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; padding: 0; margin: 0; font-size: 0.85rem; color: rgba(255,255,255,0.6);">
          <li><a href="/" style="color: rgba(255,255,255,0.6); text-decoration: none;">Inicio</a></li>
          <li style="color: rgba(255,255,255,0.3);">›</li>
          <li><a href="/servicios" style="color: rgba(255,255,255,0.6); text-decoration: none;">Servicios</a></li>
          <li style="color: rgba(255,255,255,0.3);">›</li>
          <li aria-current="page" style="color: #fff; font-weight: 600;">Focus Group en Bolivia</li>
        </ol>
      </div>
    </nav>

    <!-- 1. HERO -->
    <section class="hero-section" style="padding-bottom: 4rem; padding-top: 4rem;">
      <div class="hero-shapes" aria-hidden="true">
        <div class="hero-shape"></div><div class="hero-shape"></div><div class="hero-shape"></div>
        <div class="hero-shape"></div><div class="hero-shape"></div><div class="hero-shape"></div>
        <div class="hero-shape"></div><div class="hero-shape"></div><div class="hero-shape"></div>
        <div class="hero-shape"></div><div class="hero-shape"></div><div class="hero-shape"></div>
        <div class="hero-shape"></div><div class="hero-shape"></div><div class="hero-shape"></div>
        <div class="hero-shape"></div>
      </div>
      <div class="hero-mobile-canvas" id="hero-mobile-canvas" aria-hidden="true"></div>
      <div class="container hero-container">
        <div class="hero-content">
          <span class="eyebrow fade-in">INVESTIGACIÓN CUALITATIVA PROFUNDA</span>
          <h1 class="hero-title" style="font-size: 3.5rem; line-height: 1.25; margin-bottom: 1.5rem;">
            Focus Group en Bolivia — Más allá de lo que el consumidor declara.
          </h1>
          <p class="hero-subtitle" style="font-size: 1.25rem; margin-bottom: 1.5rem; max-width: 800px;">
            Grupos focales moderados por psicoantropólogos con análisis de IA. Llegamos al por qué detrás de la respuesta — la capa que un focus group estándar nunca alcanza.
          </p>
          <p style="font-size: 1.05rem; color: rgba(255,255,255,0.75); max-width: 800px; margin-bottom: 2.5rem;">
            Ideal para validar conceptos, explorar territorios nuevos, entender barreras de adopción y descubrir los motivadores reales de compra antes de comprometer presupuesto en campañas o lanzamientos.
          </p>
          <div style="display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 2.5rem;">
            <span style="background: rgba(242,101,34,0.25); border: 1px solid rgba(242,101,34,0.5); color: var(--color-primary); padding: 0.4rem 1rem; border-radius: 20px; font-size: 0.85rem; font-weight: 700;">Metodología Sensitive Groups</span>
            <span style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #fff; padding: 0.4rem 1rem; border-radius: 20px; font-size: 0.85rem; font-weight: 600;">Moderadores Psicoantropólogos</span>
            <span style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #fff; padding: 0.4rem 1rem; border-radius: 20px; font-size: 0.85rem; font-weight: 600;">Análisis con IA</span>
            <span style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #fff; padding: 0.4rem 1rem; border-radius: 20px; font-size: 0.85rem; font-weight: 600;">La Paz · Cochabamba · Santa Cruz</span>
            <span style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #fff; padding: 0.4rem 1rem; border-radius: 20px; font-size: 0.85rem; font-weight: 600;">Resultados en 2–3 semanas</span>
          </div>
          <a href="/contacto" class="btn btn-primary lg">Agendar diagnóstico estratégico (45 min) →</a>
        </div>
        <div class="hero-visual">
          <div class="glass-card main-visual">
            <div class="neuro-visual-bg" style="background-image: url('/heroes/hero-neuromarketing-bolivia.jpg');"></div>
          </div>
        </div>
      </div>
    </section>

    <ServiceVisualSuite variant="focus" />

    <!-- 2. EL PROBLEMA -->
    <section class="problem-section bg-slate" style="padding: 5rem 0;">
      <div class="container">
        <div class="premium-card-white" style="max-width: 900px; margin: 0 auto; padding: 4rem;">
          <span class="eyebrow">EL PROBLEMA REAL</span>
          <h2 class="text-navy" style="font-size: 2.5rem; margin-top: 1rem; margin-bottom: 2rem; line-height: 1.2;">El focus group tradicional captura lo que la gente quiere que pienses de ella — no lo que realmente piensa.</h2>
          <p class="text-gray-dark leading-relaxed" style="font-size: 1.15rem; margin-bottom: 1.5rem; line-height: 1.7;">
            En un grupo focal mal moderado, el participante más vocal domina la conversación. Los demás se alinean por conformidad social. El moderador sigue el guion sin explorar las contradicciones. Y al final recibes respuestas políticamente correctas que no predicen el comportamiento real de compra.
          </p>
          <p class="text-gray-dark leading-relaxed" style="font-size: 1.05rem; margin-bottom: 2rem; line-height: 1.7;">
            ¿Reconoces alguno de estos escenarios?
          </p>
          <ul class="cap-list" style="font-size: 1.05rem; margin-bottom: 2rem;">
            <li><strong class="text-navy">Lanzaste un producto que el focus group aprobó — y no funcionó en el mercado.</strong> La brecha entre lo que dicen y lo que hacen nunca fue explorada.</li>
            <li><strong class="text-navy">El reporte del focus group describe pero no explica.</strong> Sabes qué piensa el consumidor pero no por qué ni qué lo haría cambiar.</li>
            <li><strong class="text-navy">Necesitas insights que justifiquen una decisión de inversión ante el directorio.</strong> Pero el informe cualitativo no tiene la credibilidad metodológica suficiente.</li>
            <li><strong class="text-navy">Tu consumidor es culturalmente complejo — y el modelo estándar no lo captura.</strong> La cosmovisión andina, el mercado popular y el segmento urbano-formal tienen lógicas de compra completamente distintas.</li>
          </ul>
          <div style="background: var(--color-secondary); color: #fff; padding: 1.5rem 2rem; border-radius: 8px; font-weight: 600; font-size: 1.1rem; text-align: center;">
            Un focus group vale lo que vale quien lo modera y quien lo analiza. El resto es teatro.
          </div>
        </div>
      </div>
    </section>

    <!-- 3. MINDTEC+ -->
    <section style="padding: 5rem 0; background: #fff;">
      <div class="container">
        <div class="section-title-center" style="text-align: center; margin-bottom: 3rem;">
          <span class="eyebrow">MINDTEC+</span>
          <h2 class="text-navy" style="font-size: 2.2rem; line-height: 1.2; margin-top: 1rem; margin-bottom: 1rem;">La diferencia no está en el grupo. Está en quién lo modera y cómo se analiza.</h2>
        </div>
        <div class="comparison-table-wrapper">
          <table class="comparison-table">
            <thead>
              <tr>
                <th scope="col">Focus group estándar</th>
                <th scope="col">MindTEC — Focus Group con Psicoantropología + IA</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Moderador con guion fijo que recoge respuestas</td>
                <td>Psicoantropólogo que explora el por qué detrás de cada respuesta y detecta contradicciones</td>
              </tr>
              <tr>
                <td>Análisis manual basado en lo que el moderador recordó o anotó</td>
                <td>Transcripción completa + análisis semántico con IA para detectar patrones y temas emergentes</td>
              </tr>
              <tr>
                <td>Riesgo de influencia del participante más vocal</td>
                <td>Técnicas de moderación que aíslan la opinión individual antes de la dinámica grupal</td>
              </tr>
              <tr>
                <td>Informe descriptivo de lo que dijo cada grupo</td>
                <td>Mapa de motivadores, barreras y tensiones no resueltas en la relación consumidor-producto</td>
              </tr>
              <tr>
                <td>Sin integración con evidencia cuantitativa</td>
                <td>Diseño que integra hallazgos cualitativos con hipótesis para validación cuantitativa posterior</td>
              </tr>
              <tr>
                <td>Un solo nivel de análisis: lo que el participante puede verbalizar</td>
                <td><strong>Metodología Sensitive Groups:</strong> tres niveles simultáneos — Racional, Inconsciente e Intuitivo — con lectura cultural boliviana</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="text-gray-dark" style="font-size: 1.05rem; margin-top: 2rem; max-width: 800px; margin-left: auto; margin-right: auto; text-align: center; line-height: 1.7;">
          La psicoantropología no busca la respuesta correcta. Busca la respuesta real — incluyendo lo que el participante no se atreve a decir en voz alta.
        </p>
      </div>
    </section>

    <!-- 4. SENSITIVE GROUPS -->
    <section style="padding: 6rem 0; background: var(--color-secondary);">
      <div class="container">

        <div style="text-align: center; margin-bottom: 4rem;">
          <span style="display: inline-block; background: rgba(242,101,34,0.2); border: 1px solid rgba(242,101,34,0.5); color: var(--color-primary); font-size: 0.8rem; font-weight: 800; padding: 0.35rem 1rem; border-radius: 4px; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 1.5rem;">Metodología Propia MindTEC</span>
          <h2 style="font-size: 2.5rem; color: #fff; line-height: 1.2; margin-bottom: 1.5rem;">De Focus Group a Sensitive Group</h2>
          <p style="font-size: 1.15rem; color: rgba(255,255,255,0.8); max-width: 760px; margin: 0 auto; line-height: 1.7;">
            El focus group captura lo que las personas pueden articular. El Sensitive Group accede a los tres niveles que gobiernan la decisión real: lo que piensan, lo que sienten sin saberlo, y lo que reaccionan antes de pensar.
          </p>
        </div>

        <!-- Los tres niveles -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: 1.5rem; margin-bottom: 4rem;">

          <!-- Nivel Racional -->
          <div style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.12); border-radius: 12px; padding: 2.5rem;">
            <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem;">
              <span style="background: rgba(255,255,255,0.1); color: #fff; font-size: 0.75rem; font-weight: 900; padding: 0.3rem 0.75rem; border-radius: 4px; letter-spacing: 1px; text-transform: uppercase;">Nivel 01</span>
            </div>
            <h3 style="font-size: 1.4rem; color: #fff; margin-bottom: 0.5rem;">Racional</h3>
            <p style="color: rgba(255,255,255,0.5); font-size: 0.85rem; margin-bottom: 1rem; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 700;">Lo que el consumidor puede decir</p>
            <p style="color: rgba(255,255,255,0.8); font-size: 1rem; line-height: 1.7; margin-bottom: 1.5rem;">
              Opiniones explícitas, preferencias declaradas, razones conscientes de compra. Es el único nivel que un focus group estándar alcanza — y no predice el comportamiento real porque el consumidor dice lo que cree que se espera de él.
            </p>
            <div style="border-top: 1px solid rgba(255,255,255,0.1); padding-top: 1.5rem;">
              <p style="color: rgba(255,255,255,0.45); font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 0.75rem;">Herramientas MindTEC</p>
              <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.5rem;">
                <li style="color: rgba(255,255,255,0.75); font-size: 0.9rem; display: flex; align-items: flex-start; gap: 0.5rem;"><span style="color: var(--color-primary); flex-shrink: 0;">▸</span> Exploración directa estructurada</li>
                <li style="color: rgba(255,255,255,0.75); font-size: 0.9rem; display: flex; align-items: flex-start; gap: 0.5rem;"><span style="color: var(--color-primary); flex-shrink: 0;">▸</span> Mapeo de atributos declarados y jerarquías de valor</li>
                <li style="color: rgba(255,255,255,0.75); font-size: 0.9rem; display: flex; align-items: flex-start; gap: 0.5rem;"><span style="color: var(--color-primary); flex-shrink: 0;">▸</span> Análisis de verbatims con IA semántica</li>
              </ul>
            </div>
          </div>

          <!-- Nivel Inconsciente -->
          <div style="background: rgba(242,101,34,0.08); border: 1px solid rgba(242,101,34,0.35); border-radius: 12px; padding: 2.5rem;">
            <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem;">
              <span style="background: rgba(242,101,34,0.25); color: var(--color-primary); font-size: 0.75rem; font-weight: 900; padding: 0.3rem 0.75rem; border-radius: 4px; letter-spacing: 1px; text-transform: uppercase;">Nivel 02</span>
            </div>
            <h3 style="font-size: 1.4rem; color: #fff; margin-bottom: 0.5rem;">Inconsciente</h3>
            <p style="color: rgba(255,255,255,0.5); font-size: 0.85rem; margin-bottom: 1rem; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 700;">Lo que guía la decisión sin que lo sepa</p>
            <p style="color: rgba(255,255,255,0.8); font-size: 1rem; line-height: 1.7; margin-bottom: 1.5rem;">
              Asociaciones implícitas, tensiones no resueltas, motivadores ocultos y creencias que el participante no puede — o no quiere — verbalizar. Aquí vive el 70–80% del proceso de decisión. No se accede preguntando directamente: se accede con psicoantropología y técnicas proyectivas específicas.
            </p>
            <div style="border-top: 1px solid rgba(242,101,34,0.2); padding-top: 1.5rem;">
              <p style="color: rgba(255,255,255,0.45); font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 0.75rem;">Herramientas MindTEC</p>
              <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.5rem;">
                <li style="color: rgba(255,255,255,0.75); font-size: 0.9rem; display: flex; align-items: flex-start; gap: 0.5rem;"><span style="color: var(--color-primary); flex-shrink: 0;">▸</span> Técnicas proyectivas psicoantropológicas</li>
                <li style="color: rgba(255,255,255,0.75); font-size: 0.9rem; display: flex; align-items: flex-start; gap: 0.5rem;"><span style="color: var(--color-primary); flex-shrink: 0;">▸</span> Análisis de contradicciones entre lo dicho y lo actuado</li>
                <li style="color: rgba(255,255,255,0.75); font-size: 0.9rem; display: flex; align-items: flex-start; gap: 0.5rem;"><span style="color: var(--color-primary); flex-shrink: 0;">▸</span> Narrativa indirecta y metáforas elicitantes</li>
                <li style="color: rgba(255,255,255,0.75); font-size: 0.9rem; display: flex; align-items: flex-start; gap: 0.5rem;"><span style="color: var(--color-primary); flex-shrink: 0;">▸</span> Mapeo semántico de patrones latentes con IA</li>
              </ul>
            </div>
          </div>

          <!-- Nivel Intuitivo -->
          <div style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.12); border-radius: 12px; padding: 2.5rem;">
            <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem;">
              <span style="background: rgba(255,255,255,0.1); color: #fff; font-size: 0.75rem; font-weight: 900; padding: 0.3rem 0.75rem; border-radius: 4px; letter-spacing: 1px; text-transform: uppercase;">Nivel 03</span>
            </div>
            <h3 style="font-size: 1.4rem; color: #fff; margin-bottom: 0.5rem;">Intuitivo</h3>
            <p style="color: rgba(255,255,255,0.5); font-size: 0.85rem; margin-bottom: 1rem; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 700;">La reacción antes de que llegue el pensamiento</p>
            <p style="color: rgba(255,255,255,0.8); font-size: 1rem; line-height: 1.7; margin-bottom: 1.5rem;">
              La respuesta visceral primaria — el "me atrae / me rechaza" que ocurre en milisegundos antes de cualquier racionalización. En Bolivia, este nivel está fuertemente anclado en códigos culturales específicos que un investigador sin formación psicoantropológica simplemente no puede leer.
            </p>
            <div style="border-top: 1px solid rgba(255,255,255,0.1); padding-top: 1.5rem;">
              <p style="color: rgba(255,255,255,0.45); font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 0.75rem;">Herramientas MindTEC</p>
              <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.5rem;">
                <li style="color: rgba(255,255,255,0.75); font-size: 0.9rem; display: flex; align-items: flex-start; gap: 0.5rem;"><span style="color: var(--color-primary); flex-shrink: 0;">▸</span> Lectura de lenguaje no verbal y micro-expresiones</li>
                <li style="color: rgba(255,255,255,0.75); font-size: 0.9rem; display: flex; align-items: flex-start; gap: 0.5rem;"><span style="color: var(--color-primary); flex-shrink: 0;">▸</span> Captura de respuestas espontáneas pre-reflexivas</li>
                <li style="color: rgba(255,255,255,0.75); font-size: 0.9rem; display: flex; align-items: flex-start; gap: 0.5rem;"><span style="color: var(--color-primary); flex-shrink: 0;">▸</span> Análisis semiótico cultural aplicado</li>
              </ul>
            </div>
          </div>

        </div>

        <!-- Capa Cultural -->
        <div style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 3rem; max-width: 1000px; margin: 0 auto;">
          <div style="display: flex; flex-wrap: wrap; gap: 3rem; align-items: flex-start;">

            <div style="flex: 1; min-width: 260px;">
              <span style="display: inline-block; background: rgba(242,101,34,0.2); color: var(--color-primary); font-size: 0.75rem; font-weight: 800; padding: 0.25rem 0.75rem; border-radius: 4px; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 1rem;">Capa Cultural</span>
              <h3 style="font-size: 1.4rem; color: #fff; margin-bottom: 1rem; line-height: 1.3;">El código que cambia todo en Bolivia</h3>
              <p style="color: rgba(255,255,255,0.75); font-size: 0.95rem; line-height: 1.7; margin-bottom: 1rem;">
                No existe un consumidor boliviano genérico. Los tres niveles se leen diferente según el segmento cultural: los motivadores inconscientes de un consumidor andino no son los mismos que los de un consumidor urbano-formal, aunque ambos declaren la misma preferencia en el nivel racional.
              </p>
              <p style="color: rgba(255,255,255,0.75); font-size: 0.95rem; line-height: 1.7;">
                La psicoantropología es la disciplina que permite decodificar esos sistemas de valores, símbolos y motivadores con rigor científico — no con intuición cultural. Es lo que convierte un Sensitive Group en una herramienta estratégica y no solo en una técnica de investigación.
              </p>
            </div>

            <div style="flex: 1; min-width: 260px; display: flex; flex-direction: column; gap: 1rem;">
              <div style="background: rgba(255,255,255,0.05); border-radius: 8px; padding: 1.25rem 1.5rem; border-left: 3px solid var(--color-primary);">
                <p style="font-size: 0.8rem; font-weight: 800; color: rgba(255,255,255,0.45); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 0.5rem;">Segmento andino</p>
                <p style="color: rgba(255,255,255,0.8); font-size: 0.9rem; line-height: 1.5; margin: 0;">Valores de reciprocidad, colectividad y estatus con lógica propia. El Nivel Intuitivo está mediado por cosmovisión: la reacción visceral frente a una marca no es estética — es simbólica.</p>
              </div>
              <div style="background: rgba(255,255,255,0.05); border-radius: 8px; padding: 1.25rem 1.5rem; border-left: 3px solid rgba(255,255,255,0.25);">
                <p style="font-size: 0.8rem; font-weight: 800; color: rgba(255,255,255,0.45); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 0.5rem;">Mercado popular urbano</p>
                <p style="color: rgba(255,255,255,0.8); font-size: 0.9rem; line-height: 1.5; margin: 0;">Pragmatismo económico combinado con aspiraciones de ascenso social. El Nivel Inconsciente opera con tensiones entre identidad cultural propia y deseo de modernidad — tensión que ninguna encuesta detecta.</p>
              </div>
              <div style="background: rgba(255,255,255,0.05); border-radius: 8px; padding: 1.25rem 1.5rem; border-left: 3px solid rgba(255,255,255,0.25);">
                <p style="font-size: 0.8rem; font-weight: 800; color: rgba(255,255,255,0.45); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 0.5rem;">Segmento urbano-formal</p>
                <p style="color: rgba(255,255,255,0.8); font-size: 0.9rem; line-height: 1.5; margin: 0;">Mayor capacidad de racionalización explícita, pero con tensiones inconscientes propias de una identidad híbrida. Aquí el Nivel Racional es el más desarrollado — y el que más frecuentemente enmascara los otros dos.</p>
              </div>
            </div>

          </div>

          <div style="margin-top: 2.5rem; padding-top: 2.5rem; border-top: 1px solid rgba(255,255,255,0.08); text-align: center;">
