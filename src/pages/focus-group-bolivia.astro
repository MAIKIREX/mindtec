---
import Layout from '../layouts/Layout.astro';
import ServiceVisualSuite from '../components/sections/ServiceVisualSuite.astro';
import FaqSplit from '../components/faq/FaqSplit.astro';
import HoverStepCards from '../components/cards/HoverStepCards.astro';
import StackedSections from '../components/scroll/StackedSections.astro';
import AreaPanelCards from '../components/cards/AreaPanelCards.astro';
import ComparisonRows from '../components/cards/ComparisonRows.astro';

const problemScenarios = [
  {
    icon: `<svg viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="15" stroke-linecap="round" stroke-linejoin="round"><circle cx="128" cy="128" r="96"></circle><path d="M128 72v56l40 24"></path></svg>`,
    title: 'Lanzamientos basados en "lo que la gente dice"',
    description: 'Invirtió $50,000 en un producto que focus groups tradicionales aprobaron por unanimidad. Tres meses después, las ventas están estancadas porque la compra es emocional, no racional.',
  },
  {
    icon: `<svg viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="15" stroke-linecap="round" stroke-linejoin="round"><circle cx="128" cy="128" r="88"></circle><circle cx="128" cy="128" r="48"></circle><circle cx="128" cy="128" r="8"></circle></svg>`,
    title: 'Campañas que "tienen buena intención" pero no conectan',
    description: 'El brief creativo dice "conectar con las emociones", pero el spot resulta genérico. Nadie midió si las escenas realmente activan las emociones que busca.',
  },
  {
    icon: `<svg viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="15" stroke-linecap="round" stroke-linejoin="round"><path d="M116 156a40 40 0 1 1 40-40"></path><path d="M172 172l40 40"></path><path d="M148 108h-4v16"></path></svg>`,
    title: 'Mensajes que no activan los gatillos culturales',
    description: 'La campaña está producida, el media plan definido, pero el mensaje usa códigos culturales que no resuenan con el mercado objetivo boliviano.',
  },
  {
    icon: `<svg viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="15" stroke-linecap="round" stroke-linejoin="round"><path d="M96 32h64l16 24H80z"></path><rect x="56" y="56" width="144" height="168" rx="8"></rect><path d="M92 112h72M92 144h72M92 176h40"></path></svg>`,
    title: 'Packaging que "se ve bien" pero no elige',
    description: 'El rediseño pasó por tres rondas de aprobación interna y focus groups que dijeron "me gusta". En góndola, sigue sin destacar frente a la competencia.',
  },
];

const comparisonRows = [
  {
    before: 'Sesgado por líderes de opinión en la mesa de discusión',
    after: 'Grupos reducidos y técnicas de apertura gregoriana y cultural para neutralizar sesgos de dominancia',
  },
  {
    before: 'Registra únicamente lo verbalizado (nivel consciente)',
    after: 'Técnicas de investigación profunda subconsciente, cultural e instintiva con dinámicas proyectivas',
  },
  {
    before: 'Moderadores genéricos que siguen un cuestionario lineal',
    after: 'Psicoantropólogos especializados que elicitan metáforas inconscientes de compra',
  },
  {
    before: 'Ideal para "aprobar" ideas de forma superficial',
    after: 'Ideal para predecir tasas de conversión, rechazo y memorabilidad real de marca',
  },
];

const applicationCards = [
  {
    title: "Testeo y Validación de Packaging",
    description: "Identifique si el rediseño de su empaque destaca en la góndola o si pasa desapercibido frente a la competencia en supermercados y mercados locales.",
  },
  {
    title: "Pre-Lanzamiento de Spots Audiovisuales",
    description: "Audite segundo a segundo qué escenas de su comercial generan confusión, aburrimiento o picos de conexión emocional antes de comprar pauta.",
  },
  {
    title: "Optimización de Interfaces UX/UI",
    description: "Mida la fricción no verbalizada de usuarios reales al navegar en pasarelas de pago, aplicaciones de banca digital y e-commerce corporativos.",
  },
];

const faqItems = [
  {
    question:
      "¿Qué diferencia el focus group de MindTEC (Sensitive Groups) de uno tradicional?",
    answer:
      "El focus group tradicional recopila opiniones conscientes y racionales que suelen estar sesgadas por la presión social y el deseo de complacer. MindTEC conduce \"Sensitive Groups\" liderados por psicoantropólogos que utilizan técnicas de apertura y dinámicas proyectivas para acceder al subconsciente, capturando los motivadores culturales e instintivos reales del consumidor boliviano.",
  },
  {
    question:
      "¿Por qué se utilizan grupos reducidos y técnicas de apertura cultural?",
    answer:
      "En Bolivia, las opiniones varían enormemente según la región y el segmento socioeconómico. Utilizar grupos pequeños (de 5 a 6 participantes) y técnicas de apertura cultural específicas nos permite evitar que los participantes dominantes silencien a otros, logrando una conversación honesta e íntima sobre hábitos de compra reales.",
  },
  {
    question:
      "¿Cuándo es crítico contratar un focus group con la metodología MindTEC?",
    answer:
      "Es crítico antes de realizar grandes inversiones de capital, tales como lanzamientos de nuevos productos o servicios, reposicionamiento de marcas o rediseño de campañas publicitarias nacionales. Evita el riesgo de lanzar propuestas basadas en respuestas de cortesía que no se traducirán en compras reales.",
  },
];

const title = "Focus Group en Bolivia | Psicoantropología | MindTEC";
const description = "Focus group en Bolivia: evolucionado con neurociencia y psicoantropología. Acceda a la respuesta inconsciente real de su consumidor. Evite sesgos.";
---

<Layout
  title={title}
  description={description}
  headerLightBg={false}
  canonicalUrl="/focus-group-bolivia/"
>
  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Service",
        "@id": "https://www.mindtecbolivia.com/focus-group-bolivia",
        "name": "Focus Group en Bolivia — Metodología de Psicoantropología MindTEC",
        "description": "Grupos focales conducidos con psicoantropología aplicada para identificar motivadores de compra inconscientes y culturales en Bolivia.",
        "provider": {
          "@type": "Organization",
          "name": "MindTEC Bolivia",
          "url": "https://www.mindtecbolivia.com"
        },
        "areaServed": {"@type": "Country", "name": "Bolivia"},
        "serviceType": "Focus Group / Investigación Cualitativa con Psicoantropología",
        "url": "https://www.mindtecbolivia.com/focus-group-bolivia"
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "¿Qué diferencia el focus group de MindTEC (Sensitive Groups) de uno tradicional?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "El focus group tradicional recopila opiniones conscientes y racionales que suelen estar sesgadas por la presión social y el deseo de complacer. MindTEC conduce 'Sensitive Groups' liderados por psicoantropólogos que utilizan técnicas de apertura y dinámicas proyectivas para acceder al subconsciente, capturando los motivadores culturales e instintivos reales del consumidor boliviano."
            }
          },
          {
            "@type": "Question",
            "name": "¿Por qué se utilizan grupos reducidos y técnicas de apertura cultural?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "En Bolivia, las opiniones varían enormemente según la región y el segmento socioeconómico. Utilizar grupos pequeños y técnicas de apertura cultural nos permite evitar que los participantes dominantes silencien a otros, logrando una conversación honesta sobre hábitos de compra reales."
            }
          },
          {
            "@type": "Question",
            "name": "¿Cuándo es crítico contratar un focus group con la metodología MindTEC?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Es crítico antes de realizar grandes inversiones de capital, tales como lanzamientos de nuevos productos o servicios, reposicionamiento de marcas o rediseño de campañas publicitarias nacionales. Evita el riesgo de lanzar propuestas basadas en respuestas de cortesía que no se traducirán en compras reales."
            }
          }
        ]
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {"@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://www.mindtecbolivia.com/"},
          {"@type": "ListItem", "position": 2, "name": "Servicios", "item": "https://www.mindtecbolivia.com/servicios"},
          {"@type": "ListItem", "position": 3, "name": "Focus Group en Bolivia", "item": "https://www.mindtecbolivia.com/focus-group-bolivia"}
        ]
      }
    ]
  }
  </script>

  <main>
    <StackedSections>
    <!-- 1. HERO -->
    <section class="hero-section" style="padding-bottom: 4rem; padding-top: 4rem;" data-stack-section>
      <div class="hero-shapes" aria-hidden="true">
        <div class="hero-shape"></div><div class="hero-shape"></div><div class="hero-shape"></div>
        <div class="hero-shape"></div><div class="hero-shape"></div><div class="hero-shape"></div>
        <div class="hero-shape"></div>
      </div>
      <div class="hero-mobile-canvas" id="hero-mobile-canvas" aria-hidden="true"></div>
      <div class="container hero-container">
        <div class="hero-content">
          <span class="eyebrow fade-in">FOCUS GROUP EVOLUCIONADO</span>
          <span class="freshness-tag">Actualizado: julio 2026</span>
          <h1 class="hero-title" style="font-size: 3.5rem; line-height: 1.25; margin-bottom: 1.5rem;">
            Focus Group en Bolivia — Más allá de lo que el cliente declara.
          </h1>
          <div class="direct-answer-box">
            <strong>En resumen</strong>
            <p>MindTEC conduce grupos focales con psicoantropología aplicada para identificar motivadores de compra inconscientes y culturales en Bolivia.</p>
          </div>
          <p class="hero-subtitle" style="font-size: 1.25rem; margin-bottom: 1.5rem; max-width: 800px;">
            Grupos focales dirigidos por psicoantropólogos y validados en laboratorio neurocientífico. Capturamos la reacción visceral y emocional libre de la presión social del grupo.
          </p>
          <div style="display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 2.5rem;">
            <span style="background: rgba(242,101,34,0.25); border: 1px solid rgba(242,101,34,0.5); color: var(--color-primary); padding: 0.4rem 1rem; border-radius: 20px; font-size: 0.85rem; font-weight: 700;">Metodología Sensitive Groups</span>
            <span style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #fff; padding: 0.4rem 1rem; border-radius: 20px; font-size: 0.85rem; font-weight: 600;">Validación Biométrica</span>
            <span style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #fff; padding: 0.4rem 1rem; border-radius: 20px; font-size: 0.85rem; font-weight: 600;">Eje Troncal Boliviano</span>
          </div>
          <a href="/contacto/" class="btn btn-primary lg">Agendar diagnóstico de focus group (45 min) →</a>
        </div>
        <div class="hero-visual">
          <div class="glass-card main-visual">
            <div class="neuro-visual-bg" style="background-image: url('/heroes/hero-neuromarketing-bolivia.jpg');"></div>
          </div>
        </div>
      </div>
    </section>

    <div data-stack-section>
      <ServiceVisualSuite variant="focus" />
    </div>

    <!-- 2. EL PROBLEMA -->
    <section class="bg-slate" style="padding: 5rem 0;" data-stack-section>
      <div class="container">
        <div style="max-width: 900px; margin: 0 auto;">
          <span class="eyebrow">EL PROBLEMA REAL</span>
          <h2 class="text-navy" style="font-size: 2.5rem; margin-top: 1rem; margin-bottom: 2rem; line-height: 1.2;">Las respuestas racionalizadas en focus groups tradicionales rara vez predicen la compra real.</h2>
          <p class="text-gray-dark leading-relaxed" style="font-size: 1.2rem; margin-bottom: 2rem;">
            En Bolivia, la presión social y el deseo de complacer generan sesgos sistemáticos: los participantes dicen lo que "deberían" sentir, no lo que realmente sienten. El resultado es un falso sentido de seguridad que lleva a lanzamientos fallidos y campañas que no conectan emocionalmente.
          </p>
          <p class="text-gray-dark leading-relaxed" style="font-size: 1.1rem; line-height: 1.7;">
            Los focus groups tradicionales sufren de una brecha crítica: recopilan opiniones conscientes y racionalizadas mientras ignoran los motivadores culturales, instintivos e inconscientes que realmente determinan el comportamiento de compra en el mercado boliviano.
          </p>
        </div>

        <AreaPanelCards items={problemScenarios} columns={4} theme="navy" class="problem-panels" />

        <div style="max-width: 900px; margin: 2.5rem auto 0; background: var(--color-secondary); color: #fff; padding: 1.5rem 2rem; border-radius: var(--radius-md, 8px); font-weight: 600; font-size: 1.1rem; text-align: center;">
          Sin acceder al nivel inconsciente y cultural del consumidor boliviano, su estrategia se basa en opiniones racionalizadas que no se traducen en comportamientos de compra reales.
        </div>
      </div>
    </section>

    <!-- 3. MINDTEC+ -->
    <section style="padding: 5rem 0; background: #fff;" data-stack-section>
      <div class="container">
        <div class="section-title-center" style="text-align: center; margin-bottom: 3rem;">
          <span class="eyebrow">MINDTEC+</span>
          <h2 class="text-navy" style="font-size: 2.2rem; line-height: 1.2; margin-top: 1rem; margin-bottom: 1rem;">Más que un moderador con cuestionario: psicoantropólogos que acceden al nivel inconsciente del consumidor boliviano.</h2>
        </div>

        <ComparisonRows
          columnLabels={{ left: 'Focus Group Tradicional', right: 'Sensitive Groups — Psicoantropología' }}
          rows={comparisonRows}
        />

        <p class="text-gray-dark" style="font-size: 1.05rem; margin-top: 1.5rem; max-width: 800px; margin-left: auto; margin-right: auto; text-align: center; line-height: 1.7;">
          La diferencia no está en el formato de grupo. Está en quién lo conduce y qué técnicas usa para acceder más allá de la respuesta racionalizada.
        </p>
      </div>
    </section>

    <!-- 4. CUÁNDO USARLO (B2B DECISION MATRIX) -->
    <section style="padding: 5rem 0; background: var(--color-accent);" data-stack-section>
      <div class="container">
        <div class="section-title-center" style="text-align: center; margin-bottom: 4rem;">
          <span class="eyebrow">CASOS DE APLICACIÓN</span>
          <h2 class="text-navy" style="font-size: 2.2rem; line-height: 1.2;">¿Cuándo debe su empresa implementar un Sensitive Group?</h2>
          <p class="text-gray-dark" style="font-size: 1.1rem; max-width: 700px; margin: 0 auto; margin-top: 1rem;">
            Existen momentos clave donde la opinión del Directorio o del equipo de diseño creativo no es suficiente. Aplique este estudio en escenarios de alto riesgo comercial:
          </p>
        </div>

        <HoverStepCards items={applicationCards} minColumnWidth="280px" />
      </div>
    </section>

    <!-- 5. FAQ -->
    <div data-stack-section>
      <FaqSplit
        eyebrow="PREGUNTAS COMUNES"
        title="Resolviendo dudas metodológicas"
        items={faqItems}
      />
    </div>

    <!-- 6. FINAL CTA -->
    <section class="cta-section-modern" style="padding: 6rem 0;" data-stack-section>
      <div class="container" style="max-width: 900px; margin: 0 auto; text-align: center;">
        <div class="cta-content-v2">
          <h2 style="font-size: 2.8rem; line-height: 1.25; margin-bottom: 1.5rem;">Antes de invertir en producción a gran escala, valide el impacto.</h2>
          <p class="cta-subtitle" style="font-size: 1.2rem; margin-bottom: 2.5rem; opacity: 0.9;">
            Descubra las contradicciones entre lo que su cliente dice y lo que realmente siente. Minimice el riesgo estratégico.
          </p>
          <div class="cta-actions" style="justify-content: center; flex-direction: column; align-items: center;">
            <a href="/contacto/" class="btn btn-primary lg" style="font-size: 1.1rem; padding: 1rem 2.5rem;">Agendar diagnóstico estratégico (45 min) →</a>
            <p style="margin-top: 1.5rem; font-size: 0.95rem; color: rgba(255,255,255,0.7); font-weight: 500;">Confidencial · Sin costo inicial · Red nacional de reclutamiento.</p>
          </div>
        </div>
      </div>
    </section>
    </StackedSections>

    <!-- BREADCRUMB -->
    <nav aria-label="Breadcrumb" class="breadcrumb-bottom">
      <div class="container">
        <ol>
          <li><a href="/" style="color: rgba(255,255,255,0.6); text-decoration: none;">Inicio</a></li>
          <li style="color: rgba(255,255,255,0.3);">›</li>
          <li><a href="/servicios/" style="color: rgba(255,255,255,0.6); text-decoration: none;">Servicios</a></li>
          <li style="color: rgba(255,255,255,0.3);">›</li>
          <li aria-current="page" style="color: #fff; font-weight: 600;">Focus Group en Bolivia</li>
        </ol>
      </div>
    </nav>
  </main>

</Layout>
