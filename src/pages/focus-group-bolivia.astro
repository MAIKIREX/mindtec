---
import Layout from '../layouts/Layout.astro';
import ServiceVisualSuite from '../components/ServiceVisualSuite.astro';

const title = "Focus Group en Bolivia - Neurociencia y Psicoantropología | MindTEC";
const description = "Focus group en Bolivia: evolucionado con neurociencia y psicoantropología. Acceda a la respuesta inconsciente real de su consumidor. Evite sesgos.";
---

<Layout
  title={title}
  description={description}
  headerLightBg={false}
  canonicalUrl="/focus-group-bolivia"
>
  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Service",
        "@id": "https://www.mindtecbolivia.com/focus-group-bolivia",
        "name": "Focus Group en Bolivia — Metodología de Psicoantropología MindTEC",
        "description": "Grupos focales conducidos con psicoantropología aplicada para identificar motivadores de compra inconscientes y culturales en Bolivia.",
        "provider": {
          "@type": "Organization",
          "name": "MindTEC Bolivia",
          "url": "https://www.mindtecbolivia.com"
        },
        "areaServed": {"@type": "Country", "name": "Bolivia"},
        "serviceType": "Focus Group / Investigación Cualitativa con Psicoantropología",
        "url": "https://www.mindtecbolivia.com/focus-group-bolivia"
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "¿Qué diferencia el focus group de MindTEC (Sensitive Groups) de uno tradicional?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "El focus group tradicional recopila opiniones conscientes y racionales que suelen estar sesgadas por la presión social y el deseo de complacer. MindTEC conduce 'Sensitive Groups' liderados por psicoantropólogos que utilizan técnicas de apertura y dinámicas proyectivas para acceder al subconsciente, capturando los motivadores culturales e instintivos reales del consumidor boliviano."
            }
          },
          {
            "@type": "Question",
            "name": "¿Por qué se utilizan grupos reducidos y técnicas de apertura cultural?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "En Bolivia, las opiniones varían enormemente según la región y el segmento socioeconómico. Utilizar grupos pequeños y técnicas de apertura cultural nos permite evitar que los participantes dominantes silencien a otros, logrando una conversación honesta sobre hábitos de compra reales."
            }
          },
          {
            "@type": "Question",
            "name": "¿Cuándo es crítico contratar un focus group con la metodología MindTEC?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Es crítico antes de realizar grandes inversiones de capital, tales como lanzamientos de nuevos productos o servicios, reposicionamiento de marcas o rediseño de campañas publicitarias nacionales. Evita el riesgo de lanzar propuestas basadas en respuestas de cortesía que no se traducirán en compras reales."
            }
          }
        ]
      }
    ]
  }
  </script>

  <main>
    <!-- 1. HERO -->
    <section class="hero-section" style="padding-bottom: 4rem; padding-top: 4rem;">
      <div class="hero-shapes" aria-hidden="true">
        <div class="hero-shape"></div><div class="hero-shape"></div><div class="hero-shape"></div>
        <div class="hero-shape"></div><div class="hero-shape"></div><div class="hero-shape"></div>
        <div class="hero-shape"></div>
      </div>
      <div class="hero-mobile-canvas" id="hero-mobile-canvas" aria-hidden="true"></div>
      <div class="container hero-container">
        <div class="hero-content">
          <span class="eyebrow fade-in">FOCUS GROUP EVOLUCIONADO</span>
          <h1 class="hero-title" style="font-size: 3.5rem; line-height: 1.25; margin-bottom: 1.5rem;">
            Focus Group en Bolivia — Más allá de lo que el cliente declara.
          </h1>
          <p class="hero-subtitle" style="font-size: 1.25rem; margin-bottom: 1.5rem; max-width: 800px;">
            Grupos focales dirigidos por psicoantropólogos y validados en laboratorio neurocientífico. Capturamos la reacción visceral y emocional libre de la presión social del grupo.
          </p>
          <div style="display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 2.5rem;">
            <span style="background: rgba(242,101,34,0.25); border: 1px solid rgba(242,101,34,0.5); color: var(--color-primary); padding: 0.4rem 1rem; border-radius: 20px; font-size: 0.85rem; font-weight: 700;">Metodología Sensitive Groups</span>
            <span style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #fff; padding: 0.4rem 1rem; border-radius: 20px; font-size: 0.85rem; font-weight: 600;">Validación Biométrica</span>
            <span style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #fff; padding: 0.4rem 1rem; border-radius: 20px; font-size: 0.85rem; font-weight: 600;">Eje Troncal Boliviano</span>
          </div>
          <a href="/contacto" class="btn btn-primary lg">Agendar diagnóstico de focus group (45 min) →</a>
        </div>
        <div class="hero-visual">
          <div class="glass-card main-visual">
            <div class="neuro-visual-bg" style="background-image: url('/heroes/hero-neuromarketing-bolivia.jpg');"></div>
          </div>
        </div>
      </div>
    </section>

    <ServiceVisualSuite variant="focus" />

    <!-- 2. QUÉ ES Y CÓMO MINDTEC LO CONDUCE (MAIDER TOMASENA STYLE: STORYTELLING AND EMOTION) -->
    <section class="problem-section bg-slate" style="padding: 5rem 0;">
      <div class="container">
        <div class="premium-card-white" style="max-width: 900px; margin: 0 auto; padding: 4rem;">
          <span class="eyebrow">EL ENFOQUE EN SENSITIVE GROUPS</span>
          <h2 class="text-navy" style="font-size: 2.5rem; margin-top: 1rem; margin-bottom: 2rem; line-height: 1.2;">El focus group tradicional captura respuestas políticamente correctas. Nosotros capturamos la verdad.</h2>
          <p class="text-gray-dark leading-relaxed" style="font-size: 1.15rem; margin-bottom: 1.5rem; line-height: 1.7;">
            ¿Alguna vez ha presenciado un focus group tradicional detrás del espejo unidireccional? Un participante dominante monopoliza el debate, los más tímidos asienten por inercia social y el moderador apura el cuestionario. ¿El resultado? Un reporte descriptivo que valida lo que sus gerentes querían oír, pero que falla rotundamente en predecir el comportamiento real de compra.
          </p>
          <p class="text-gray-dark leading-relaxed" style="font-size: 1.05rem; margin-bottom: 2rem; line-height: 1.7;">
            En <strong>MindTEC Bolivia</strong>, rediseñamos este formato mediante la metodología <strong>Sensitive Groups</strong>. No permitimos que los participantes intelectualicen sus respuestas. Combinamos dinámicas psicoantropológicas proyectivas para separar la opinión declarada de la respuesta inconsciente.
          </p>

          <div style="margin-top: 2.5rem; margin-bottom: 2.5rem; border-top: 1px solid #e2e8f0; padding-top: 2rem;">
            <h3 class="text-navy" style="font-size: 1.3rem; margin-bottom: 1.25rem; font-weight: 700;">Áreas de aplicación del Sensitive Group:</h3>
            <ul style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem; list-style: none; padding: 0;">
              <li style="font-size: 0.95rem; color: #475569; display: flex; align-items: center; gap: 0.5rem;"><span style="color: var(--color-primary); font-weight: bold;">✔</span> Conocimiento profundo del consumidor boliviano</li>
              <li style="font-size: 0.95rem; color: #475569; display: flex; align-items: center; gap: 0.5rem;"><span style="color: var(--color-primary); font-weight: bold;">✔</span> Lanzamientos de productos y servicios</li>
              <li style="font-size: 0.95rem; color: #475569; display: flex; align-items: center; gap: 0.5rem;"><span style="color: var(--color-primary); font-weight: bold;">✔</span> Brand Tracking y posicionamiento de marca</li>
              <li style="font-size: 0.95rem; color: #475569; display: flex; align-items: center; gap: 0.5rem;"><span style="color: var(--color-primary); font-weight: bold;">✔</span> Etnografía y códigos culturales locales</li>
              <li style="font-size: 0.95rem; color: #475569; display: flex; align-items: center; gap: 0.5rem;"><span style="color: var(--color-primary); font-weight: bold;">✔</span> Identificación de motivadores emocionales de compra</li>
              <li style="font-size: 0.95rem; color: #475569; display: flex; align-items: center; gap: 0.5rem;"><span style="color: var(--color-primary); font-weight: bold;">✔</span> Testeo de campañas publicitarias y brief creativo</li>
            </ul>
          </div>
          <div style="background: var(--color-secondary); color: #fff; padding: 1.5rem 2rem; border-radius: 8px; font-weight: 600; font-size: 1.1rem; text-align: center;">
            No buscamos la respuesta lógica y filtrada. Buscamos la reacción instintiva y real de su mercado.
          </div>
        </div>
      </div>
    </section>

    <!-- 3. TRADICIONAL VS PSICOANTROPOLOGÍA (VILMA NUÑEZ STYLE: ACTIONABLE COMPARISON FRAMEWORK) -->
    <section style="padding: 5rem 0; background: #fff;">
      <div class="container">
        <div class="section-title-center" style="text-align: center; margin-bottom: 3rem;">
          <span class="eyebrow">EL GRAN CONTRASTE</span>
          <h2 class="text-navy" style="font-size: 2.2rem; line-height: 1.2; margin-top: 1rem; margin-bottom: 1rem;">Diferencias entre el Focus Group Tradicional y el Enfoque de Psicoantropología</h2>
        </div>
        <div class="comparison-table-wrapper">
          <table class="comparison-table">
            <thead>
              <tr>
                <th scope="col">Focus Group Tradicional</th>
                <th scope="col">Focus Group con Psicoantropología (MindTEC)</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Sesgado por líderes de opinión en la mesa de discusión</td>
                <td>Grupos reducidos y técnicas de apertura gregoriana y cultural</td>
              </tr>
              <tr>
                <td>Registra únicamente lo verbalizado (nivel consciente)</td>
                <td>Técnicas de investigación profunda subconsciente, cultural e instintiva</td>
              </tr>
              <tr>
                <td>Moderadores genéricos que siguen un cuestionario lineal</td>
                <td>Psicoantropólogos que elicitan metáforas inconscientes de compra</td>
              </tr>
              <tr>
                <td>Ideal para 'aprobar' ideas de forma superficial</td>
                <td>Ideal para predecir tasas de conversión, rechazo y memorabilidad de marca</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- 4. CUÁNDO USARLO (B2B DECISION MATRIX) -->
    <section style="padding: 5rem 0; background: var(--color-accent);">
      <div class="container">
        <div class="section-title-center" style="text-align: center; margin-bottom: 4rem;">
          <span class="eyebrow">CASOS DE APLICACIÓN</span>
          <h2 class="text-navy" style="font-size: 2.2rem; line-height: 1.2;">¿Cuándo debe su empresa implementar un Sensitive Group?</h2>
          <p class="text-gray-dark" style="font-size: 1.1rem; max-width: 700px; margin: 0 auto; margin-top: 1rem;">
            Existen momentos clave donde la opinión del Directorio o del equipo de diseño creativo no es suficiente. Aplique este estudio en escenarios de alto riesgo comercial:
          </p>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">
          <div class="premium-card-white" style="padding: 2.5rem; border-left: 4px solid var(--color-primary);">
            <h4 class="text-navy" style="font-size: 1.1rem; margin-bottom: 0.5rem; font-weight: 700;">Testeo y Validación de Packaging</h4>
            <p style="font-size: 0.95rem; color: #475569; line-height: 1.6;">Identifique si el rediseño de su empaque destaca en la góndola o si pasa desapercibido frente a la competencia en supermercados y mercados locales.</p>
          </div>

          <div class="premium-card-white" style="padding: 2.5rem; border-left: 4px solid var(--color-primary);">
            <h4 class="text-navy" style="font-size: 1.1rem; margin-bottom: 0.5rem; font-weight: 700;">Pre-Lanzamiento de Spots Audiovisuales</h4>
            <p style="font-size: 0.95rem; color: #475569; line-height: 1.6;">Audite segundo a segundo qué escenas de su comercial generan confusión, aburrimiento o picos de conexión emocional antes de comprar pauta.</p>
          </div>

          <div class="premium-card-white" style="padding: 2.5rem; border-left: 4px solid var(--color-primary);">
            <h4 class="text-navy" style="font-size: 1.1rem; margin-bottom: 0.5rem; font-weight: 700;">Optimización de Interfaces UX/UI</h4>
            <p style="font-size: 0.95rem; color: #475569; line-height: 1.6;">Mida la fricción no verbalizada de usuarios reales al navegar en pasarelas de pago, aplicaciones de banca digital y e-commerce corporativos.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. FAQ -->
    <section style="padding: 5rem 0; background: #f8fafc;">
      <div class="container" style="max-width: 800px;">
        <div style="text-align: center; margin-bottom: 3rem;">
          <span class="eyebrow">PREGUNTAS COMUNES</span>
          <h2 class="text-navy" style="font-size: 2.2rem; line-height: 1.2; margin-top: 1rem;">Resolviendo dudas metodológicas</h2>
        </div>
        <dl style="display: flex; flex-direction: column; gap: 1rem;">
          <div class="premium-card-white" style="padding: 0; overflow: hidden;">
            <dt>
              <button aria-expanded="false" aria-controls="faq-fg-1" style="width: 100%; text-align: left; padding: 1.5rem 2rem; border: none; background: none; font-size: 1rem; font-weight: 700; color: var(--color-secondary); cursor: pointer; display: flex; justify-content: space-between; align-items: center;">
                ¿Qué diferencia el focus group de MindTEC (Sensitive Groups) de uno tradicional?
                <span aria-hidden="true" style="font-size: 1.25rem; color: var(--color-primary);">+</span>
              </button>
            </dt>
            <dd id="faq-fg-1" hidden style="padding: 0 2rem 1.5rem; margin: 0;">
              <p class="text-gray-dark" style="font-size: 0.95rem; line-height: 1.7;">El focus group tradicional recopila opiniones conscientes y racionales que suelen estar sesgadas por la presión social y el deseo de complacer. MindTEC conduce "Sensitive Groups" liderados por psicoantropólogos que utilizan técnicas de apertura y dinámicas proyectivas para acceder al subconsciente, capturando los motivadores culturales e instintivos reales del consumidor boliviano.</p>
            </dd>
          </div>

          <div class="premium-card-white" style="padding: 0; overflow: hidden;">
            <dt>
              <button aria-expanded="false" aria-controls="faq-fg-2" style="width: 100%; text-align: left; padding: 1.5rem 2rem; border: none; background: none; font-size: 1rem; font-weight: 700; color: var(--color-secondary); cursor: pointer; display: flex; justify-content: space-between; align-items: center;">
                ¿Por qué se utilizan grupos reducidos y técnicas de apertura cultural?
                <span aria-hidden="true" style="font-size: 1.25rem; color: var(--color-primary);">+</span>
              </button>
            </dt>
            <dd id="faq-fg-2" hidden style="padding: 0 2rem 1.5rem; margin: 0;">
              <p class="text-gray-dark" style="font-size: 0.95rem; line-height: 1.7;">En Bolivia, las opiniones varían enormemente según la región y el segmento socioeconómico. Utilizar grupos pequeños (de 5 a 6 participantes) y técnicas de apertura cultural específicas nos permite evitar que los participantes dominantes silencien a otros, logrando una conversación honesta e íntima sobre hábitos de compra reales.</p>
            </dd>
          </div>

          <div class="premium-card-white" style="padding: 0; overflow: hidden;">
            <dt>
              <button aria-expanded="false" aria-controls="faq-fg-3" style="width: 100%; text-align: left; padding: 1.5rem 2rem; border: none; background: none; font-size: 1rem; font-weight: 700; color: var(--color-secondary); cursor: pointer; display: flex; justify-content: space-between; align-items: center;">
                ¿Cuándo es crítico contratar un focus group con la metodología MindTEC?
                <span aria-hidden="true" style="font-size: 1.25rem; color: var(--color-primary);">+</span>
              </button>
            </dt>
            <dd id="faq-fg-3" hidden style="padding: 0 2rem 1.5rem; margin: 0;">
              <p class="text-gray-dark" style="font-size: 0.95rem; line-height: 1.7;">Es crítico antes de realizar grandes inversiones de capital, tales como lanzamientos de nuevos productos o servicios, reposicionamiento de marcas o rediseño de campañas publicitarias nacionales. Evita el riesgo de lanzar propuestas basadas en respuestas de cortesía que no se traducirán en compras reales.</p>
            </dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- 6. FINAL CTA -->
    <section class="cta-section-modern" style="padding: 6rem 0;">
      <div class="container" style="max-width: 900px; margin: 0 auto; text-align: center;">
        <div class="cta-content-v2">
          <h2 style="font-size: 2.8rem; line-height: 1.25; margin-bottom: 1.5rem;">Antes de invertir en producción a gran escala, valide el impacto.</h2>
          <p class="cta-subtitle" style="font-size: 1.2rem; margin-bottom: 2.5rem; opacity: 0.9;">
            Descubra las contradicciones entre lo que su cliente dice y lo que realmente siente. Minimice el riesgo estratégico.
          </p>
          <div class="cta-actions" style="justify-content: center; flex-direction: column; align-items: center;">
            <a href="/contacto" class="btn btn-primary lg" style="font-size: 1.1rem; padding: 1rem 2.5rem;">Agendar diagnóstico estratégico (45 min) →</a>
            <p style="margin-top: 1.5rem; font-size: 0.95rem; color: rgba(255,255,255,0.7); font-weight: 500;">Confidencial · Sin costo inicial · Red nacional de reclutamiento.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- BREADCRUMB -->
    <nav aria-label="Breadcrumb" class="breadcrumb-bottom">
      <div class="container">
        <ol>
          <li><a href="/" style="color: rgba(255,255,255,0.6); text-decoration: none;">Inicio</a></li>
          <li style="color: rgba(255,255,255,0.3);">›</li>
          <li><a href="/servicios" style="color: rgba(255,255,255,0.6); text-decoration: none;">Servicios</a></li>
          <li style="color: rgba(255,255,255,0.3);">›</li>
          <li aria-current="page" style="color: #fff; font-weight: 600;">Focus Group en Bolivia</li>
        </ol>
      </div>
    </nav>
  </main>

  <script>
    document.querySelectorAll('dt button[aria-expanded]').forEach(btn => {
      btn.addEventListener('click', () => {
        const ddId = btn.getAttribute('aria-controls');
        const dd = document.getElementById(ddId);
        const expandido = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', expandido ? 'false' : 'true');
        const icon = btn.querySelector('span[aria-hidden]');
        if (icon) icon.textContent = expandido ? '+' : '−';
        if (dd) dd.hidden = expandido;
      });
    });
  </script>
</Layout>
