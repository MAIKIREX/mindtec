---
import PinnedSection from "../components/scroll/PinnedSection.astro";

const cases = [
    {
        id: "short",
        zIndex: 1,
        tone: "sand",
        label: "Caso 1 — Cabe en el viewport",
        title: "Altura ≤ 100svh",
        text: "Se pinea desde \"top top\" hasta \"bottom top\": la sección se fija apenas su borde superior toca el techo, y la siguiente sección sube por encima de ella.",
        height: "70svh",
    },
    {
        id: "exact",
        zIndex: 2,
        tone: "orange",
        label: "Caso 2 — Altura igual al viewport",
        title: "Altura = 100svh",
        text: "Umbral exacto: sigue tratándose como \"cabe en el viewport\", así que se pinea al inicio igual que el caso anterior.",
        height: "100svh",
    },
    {
        id: "tall",
        zIndex: 3,
        tone: "blue",
        label: "Caso 3 — Más alta que el viewport",
        title: "Altura > 100svh",
        text: "Se pinea desde \"bottom bottom\" hasta \"bottom top\": el usuario primero hace scroll por todo el contenido interno, y solo al llegar al final la sección se fija para que la siguiente la cubra.",
        height: "180svh",
    },
    {
        id: "forced",
        zIndex: 4,
        tone: "sand",
        label: "Caso 4 — forceEndPin en sección corta",
        title: "Altura ≤ 100svh, pero forzada al final",
        text: "Con forceEndPin={true} se fuerza la estrategia de pineo al final aunque la sección quepa en el viewport.",
        height: "60svh",
        forceEndPin: true,
    },
];
---

<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="description" content="Demo de PinnedSection con distintas alturas de sección." />
        <title>Demo — PinnedSection</title>
    </head>
    <body>
        <header class="header"><a href="/">MINDTEC</a><span>Demo / PinnedSection</span></header>
        <main>
            <section class="intro">
                <span>Componente / PinnedSection</span>
                <h1>Pineo adaptativo según la altura de cada sección.</h1>
                <p>Cada bloque compara su altura contra el viewport para decidir si se fija al entrar o al salir. Reduce y agranda la ventana del navegador para ver cómo cambia el comportamiento en tiempo real.</p>
            </section>

            {cases.map((item) => (
                <PinnedSection zIndex={item.zIndex} forceEndPin={item.forceEndPin} class={`scene scene--${item.tone}`}>
                    <div class="scene__inner" style={`min-height: ${item.height};`}>
                        <div class="scene__copy">
                            <span>{item.label}</span>
                            <h2>{item.title}</h2>
                            <p>{item.text}</p>
                            <code>height: {item.height}{item.forceEndPin ? " · forceEndPin" : ""}</code>
                        </div>
                    </div>
                </PinnedSection>
            ))}

            <section class="outro"><span>Fin de la demo</span><h2>La página continúa normalmente.</h2></section>
        </main>
    </body>
</html>

<style is:global>
    :root { font-family: Inter, ui-sans-serif, system-ui, sans-serif; background: #071c2a; }
    * { box-sizing: border-box; }
    body { margin: 0; overflow-x: hidden; color: #f8f3ea; }
    .header { position: fixed; z-index: 20; top: 0; display: flex; justify-content: space-between; width: 100%; padding: 1.5rem clamp(1.25rem, 4vw, 4rem); mix-blend-mode: difference; color: white; font-size: .72rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; pointer-events: none; }
    .header a { color: inherit; text-decoration: none; pointer-events: auto; }
    .intro, .outro { min-height: 100svh; display: flex; flex-direction: column; justify-content: center; padding: clamp(2rem, 7vw, 8rem); }
    .intro { background: radial-gradient(circle at 75% 28%, #e5673a 0 10%, transparent 34%), #071c2a; }
    .intro > span, .outro > span, .scene__copy > span { font-size: .72rem; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
    .intro h1, .outro h2 { max-width: 1050px; margin: 1.5rem 0 2rem; font-size: clamp(3rem, 8vw, 7rem); line-height: .88; letter-spacing: -.07em; }
    .intro p { max-width: 620px; margin: 0; font-size: 1.1rem; line-height: 1.65; opacity: .72; }

    .scene { width: 100%; }
    .scene--sand { color: #122839; background: #e8dfce; }
    .scene--orange { background: #e5673a; }
    .scene--blue { background: #1a4c70; }

    .scene__inner { display: flex; align-items: center; padding: clamp(2rem, 7vw, 6rem); }
    .scene__copy { max-width: 780px; }
    .scene__copy h2 { margin: 1.25rem 0 1.25rem; font-size: clamp(2.4rem, 6vw, 5rem); line-height: .9; letter-spacing: -.06em; }
    .scene__copy p { max-width: 560px; margin: 0 0 1.25rem; font-size: 1.05rem; line-height: 1.6; }
    .scene__copy code { display: inline-block; padding: .35rem .7rem; font-size: .8rem; font-weight: 700; background: rgba(0, 0, 0, .18); border-radius: 4px; }

    .outro { color: #071c2a; background: #f8f3ea; }
    @media (max-width: 700px) { .header span { display: none; } .scene__copy p { font-size: 1rem; } }
</style>
