---
import Layout from '../layouts/Layout.astro';

const title = "Witmind Consulting LLC | Florida Registered B2B Consulting";
const description = "Witmind Consulting LLC — market research, business consulting, software development, and import consultancy. Florida registered, serving Latin America and the world.";
---

<Layout
  title={title}
  description={description}
  headerLightBg={false}
  canonicalUrl="/witmind-consulting/"
>
  <main class="witmind-page">

    <!-- Section 1: Hero -->
    <section class="hero-section">
      <div class="hero-shapes" aria-hidden="true">
        <div class="hero-shape"></div>
        <div class="hero-shape"></div>
        <div class="hero-shape"></div>
        <div class="hero-shape"></div>
      </div>
      <div class="hero-mobile-canvas" id="hero-mobile-canvas" aria-hidden="true"></div>
      
      <div class="container hero-container text-center">
        <div class="hero-content">
          <div class="hero-logo-container animate-on-observe stagger-1">
            <img src="/logos/logo-witmind-horizontal.png" alt="Witmind Consulting LLC Logo" class="hero-logo" />
          </div>
          <span class="eyebrow-light animate-on-observe stagger-2">Florida Registered LLC — USA</span>
          <h1 class="animate-on-observe stagger-3" style="font-size: 2.2rem; margin-top: 1.5rem; color: #fff; font-weight: 700; letter-spacing: -0.5px;">Witmind Consulting LLC</h1>
          <p class="hero-subtitle animate-on-observe stagger-4">
            Your strategic partner for market research, business consulting, software development, and import consultancy — registered in Florida and serving Latin America and the world.
          </p>
          <div class="hero-ctas animate-on-observe stagger-5">
            <a href="#contact" class="btn btn-primary">Contact Us</a>
            <a href="/" class="btn btn-outline-light">Mindtec N&C</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 2: About -->
    <section id="about" class="about-section premium-section-padding">
      <div class="container">
        <div class="grid-about">
          <div class="about-content animate-on-observe stagger-1">
            <span class="eyebrow">Who We Are</span>
            <h2>About Witmind Consulting LLC</h2>
            <p class="about-desc">
              Witmind Consulting LLC is the holding entity that bridges the expertise of the Witmind ecosystem with the international market. Registered in Florida, we serve Spanish-speaking organizations across Latin America and the world that require professional consulting, strategic intelligence, and technology solutions with a rigorous, business-focused approach.
            </p>
            <p class="about-desc">
              We work at the intersection of strategy, data, and decision-making — helping businesses navigate complex challenges with clarity and confidence. Whether you are entering a new market, optimizing operations, or developing technology, Witmind Consulting provides the structure and intelligence to move forward decisively.
            </p>
          </div>
          <div class="about-extra animate-on-observe stagger-3">
            <div class="about-logo-container animate-on-observe stagger-2">
              <img src="/logos/logo-witmind-vertical.png" alt="Witmind Corporate Symbol Logo" class="about-logo" />
            </div>
            <div class="glass-card ecosystem-card">
              <h3>Ecosystem Origin</h3>
              <p>
                Witmind Consulting LLC is part of the Witmind ecosystem, a group of complementary companies united by a shared philosophy: identify real problems in the market and build solutions with rigor, strategy, and impact. Our Bolivian roots give us a deep understanding of Latin American markets — and our Florida structure gives us the international framework to serve clients globally.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 3: Our Services -->
    <section id="services" class="services-section premium-section-padding">
      <div class="container">
        <div class="section-header text-center animate-on-observe stagger-1">
          <span class="eyebrow">Solutions</span>
          <h2>Our Services</h2>
          <p style="color: rgba(255, 255, 255, 0.6); max-width: 650px; margin: 0 auto;">
            Rigorous, data-driven solutions designed to empower organizations and facilitate critical decision-making.
          </p>
        </div>
        
        <div class="services-grid">
          <!-- Card 1 -->
          <div class="service-card glass-card animate-on-observe stagger-1">
            <div class="service-icon">
              <svg viewBox="0 0 24 24" width="28" height="28" stroke="var(--color-primary)" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="16 18 22 12 16 6"></polyline>
                <polyline points="8 6 2 12 8 18"></polyline>
                <line x1="14" y1="4" x2="10" y2="20"></line>
              </svg>
            </div>
            <h3>Software Design & Development</h3>
            <p>
              We design and develop custom software solutions tailored to your business needs, ensuring efficiency, scalability, and long-term maintainability. From process automation to enterprise platforms.
            </p>
          </div>

          <!-- Card 2 -->
          <div class="service-card glass-card animate-on-observe stagger-2">
            <div class="service-icon">
              <svg viewBox="0 0 24 24" width="28" height="28" stroke="var(--color-primary)" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                <line x1="11" y1="8" x2="11" y2="14"></line>
                <line x1="8" y1="11" x2="14" y2="11"></line>
              </svg>
            </div>
            <h3>Market Research & Intelligence</h3>
            <p>
              We deliver comprehensive market analysis to help you understand your industry landscape, identify strategic opportunities, and make decisions grounded in real consumer behavior — not assumptions.
            </p>
          </div>

          <!-- Card 3 -->
          <div class="service-card glass-card animate-on-observe stagger-3">
            <div class="service-icon">
              <svg viewBox="0 0 24 24" width="28" height="28" stroke="var(--color-primary)" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="20" x2="18" y2="10"></line>
                <line x1="12" y1="20" x2="12" y2="4"></line>
                <line x1="6" y1="20" x2="6" y2="14"></line>
              </svg>
            </div>
            <h3>Data Analytics & Insights</h3>
            <p>
              We transform raw market data into actionable intelligence. Trend analysis, performance measurement, segmentation, and data-driven decision frameworks that move the needle.
            </p>
          </div>

          <!-- Card 4 -->
          <div class="service-card glass-card animate-on-observe stagger-4">
            <div class="service-icon">
              <svg viewBox="0 0 24 24" width="28" height="28" stroke="var(--color-primary)" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
            </div>
            <h3>Business Consulting & Strategy</h3>
            <p>
              Our senior consultants provide strategic guidance to optimize your operations, improve processes, and align your organizational structure with your long-term growth objectives.
            </p>
          </div>

          <!-- Card 5 -->
          <div class="service-card glass-card animate-on-observe stagger-5">
            <div class="service-icon">
              <svg viewBox="0 0 24 24" width="28" height="28" stroke="var(--color-primary)" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                <line x1="8" y1="21" x2="16" y2="21"></line>
                <line x1="12" y1="17" x2="12" y2="21"></line>
              </svg>
            </div>
            <h3>Import Consultancy</h3>
            <p>
              Navigate the complexities of international trade with our import consultancy services. We help you streamline import processes, ensure regulatory compliance, and reduce operational friction in cross-border operations.
            </p>
          </div>

          <!-- Card 6 -->
          <div class="service-card glass-card animate-on-observe stagger-6">
            <div class="service-icon">
              <svg viewBox="0 0 24 24" width="28" height="28" stroke="var(--color-primary)" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
            </div>
            <h3>Sales Training & Capability Building</h3>
            <p>
              Our sales training programs equip your team with the skills, frameworks, and strategies needed to drive performance, improve conversion, and build lasting client relationships.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 4: Why Witmind -->
    <section id="why-witmind" class="why-section premium-section-padding">
      <div class="container">
        <div class="section-header text-center animate-on-observe stagger-1">
          <span class="eyebrow">Differentiators</span>
          <h2>Why Witmind Consulting</h2>
          <p style="color: rgba(255, 255, 255, 0.6); max-width: 650px; margin: 0 auto;">
            Unifying regional depth with international operational structures to deliver secure, impactful results.
          </p>
        </div>
        
        <div class="why-grid">
          <!-- Differentiator 1 -->
          <div class="why-item animate-on-observe stagger-1">
            <div class="why-number">01</div>
            <h3>Latin American Expertise</h3>
            <p>
              We understand the cultural, economic, and behavioral context of Latin American markets. Our team operates in Spanish, with deep roots in the region, which means our recommendations are grounded in local reality — not imported templates.
            </p>
          </div>

          <!-- Differentiator 2 -->
          <div class="why-item animate-on-observe stagger-2">
            <div class="why-number">02</div>
            <h3>International Structure</h3>
            <p>
              As a Florida-registered LLC, Witmind Consulting provides the legal and operational framework required for international contracts, assistance with cross-border payments using licensed third-party platforms, and projects that demand a U.S.-based entity.
            </p>
          </div>

          <!-- Differentiator 3 -->
          <div class="why-item animate-on-observe stagger-3">
            <div class="why-number">03</div>
            <h3>Integrated Ecosystem</h3>
            <p>
              Witmind Consulting is backed by a multidisciplinary ecosystem that includes consumer intelligence (MindTEC), lighting and automation technology (Witronix LED), and assistance with international payments through licensed platforms (Guira). When your project requires it, the full ecosystem engages.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 5: Get in Touch -->
    <section id="contact" class="contact-section-witmind premium-section-padding">
      <div class="container text-center">
        <div class="contact-card glass-card animate-on-observe stagger-1">
          <span class="eyebrow">Connect</span>
          <h2>Get in Touch</h2>
          <p class="contact-intro">
            To connect with Witmind Consulting LLC, reach us directly via WhatsApp. Our team responds in Spanish and English.
          </p>
          
          <div class="whatsapp-box">
            <a href="https://wa.me/59172599201" class="btn btn-primary" target="_blank" rel="noopener noreferrer" style="padding: 16px 36px;">
              <svg viewBox="0 0 448 512" width="18" height="18" fill="currentColor" style="vertical-align: middle; margin-right: 8px;">
                <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-23.1-115-65-157.1zm-157 341.1h-.1c-33 0-65.3-8.9-93.6-25.6l-6.7-4-69.5 18.2 18.5-67.8-4.4-7C48.2 323.5 38.3 289.4 38.3 254c0-102.3 83.2-185.5 185.6-185.5 49.6 0 96.3 19.3 131.4 54.4 35.1 35.1 54.4 81.8 54.4 131.4 0 102.3-83.2 185.5-185.5 185.5zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7 .9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/>
              </svg>
              Send a WhatsApp Message
            </a>
          </div>
          <p class="contact-footnote">
            We work from Bolivia to all the world, primarily in Spanish-speaking markets.
          </p>
        </div>
      </div>
    </section>

    <!-- Section 6: Legal Information (Tabular Footer Reference) -->
    <section class="legal-section">
      <div class="container">
        <div class="legal-box animate-on-observe stagger-1">
          <h3>Legal Information</h3>
          <div class="legal-grid">
            <div class="legal-item">
              <strong>Company Name</strong>
              <span>Witmind Consulting LLC</span>
            </div>
            <div class="legal-item">
              <strong>EIN (Tax ID)</strong>
              <span>32-2142250</span>
            </div>
            <div class="legal-item">
              <strong>Document Number</strong>
              <span>L24000205484</span>
            </div>
            <div class="legal-item">
              <strong>Active Since</strong>
              <span>May 7, 2024</span>
            </div>
            <div class="legal-item">
              <strong>Registered State</strong>
              <span>Florida — United States of America</span>
            </div>
            <div class="legal-item">
              <strong>Registered Address</strong>
              <span>2 S Biscayne Boulevard, Suite 3200 #3670, Miami, FL 33131</span>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>
</Layout>

<style>
  /* Global Contrast & Readability Overrides for Dark Mode */
  .witmind-page h1,
  .witmind-page h2,
  .witmind-page h3,
  .witmind-page h4 {
    color: var(--color-white) !important;
  }

  .witmind-page p,
  .witmind-page li,
  .witmind-page span:not(.eyebrow):not(.eyebrow-light) {
    color: rgba(255, 255, 255, 0.85) !important;
  }

  /* Ensure glass cards have a dark, high-contrast background instead of standard light/white glass */
  .witmind-page .glass-card {
    background: rgba(255, 255, 255, 0.03) !important;
    border: 1px solid rgba(255, 255, 255, 0.08) !important;
    backdrop-filter: blur(20px) !important;
    -webkit-backdrop-filter: blur(20px) !important;
  }

  .witmind-page .glass-card:hover {
    background: rgba(255, 255, 255, 0.06) !important;
    border-color: rgba(242, 101, 34, 0.3) !important;
  }

  /* Force transparent background on services-section to prevent global theme light overrides */
  .witmind-page .services-section {
    background: transparent !important;
  }

  .witmind-page .hero-subtitle {
    color: rgba(255, 255, 255, 0.9) !important;
  }

  .witmind-page .service-card p {
    color: rgba(255, 255, 255, 0.7) !important;
  }

  .witmind-page .why-item p {
    color: rgba(255, 255, 255, 0.75) !important;
  }

  .witmind-page .eyebrow {
    color: var(--color-primary) !important;
    background: rgba(242, 101, 34, 0.15) !important;
    border: 1px solid rgba(242, 101, 34, 0.3) !important;
  }

  .witmind-page .eyebrow-light {
    color: rgba(255, 255, 255, 0.9) !important;
    background: rgba(255, 255, 255, 0.08) !important;
    border: 1px solid rgba(255, 255, 255, 0.15) !important;
  }
  
  .witmind-page .why-number {
    color: var(--color-primary) !important;
    opacity: 0.85;
  }

  .witmind-page .legal-item strong {
    color: rgba(255, 255, 255, 0.45) !important;
  }

  .witmind-page .legal-item span {
    color: rgba(255, 255, 255, 0.85) !important;
  }

  .witmind-page .contact-intro {
    color: rgba(255, 255, 255, 0.85) !important;
  }

  .witmind-page .whatsapp-number {
    color: rgba(255, 255, 255, 0.9) !important;
  }

  /* Core Layout */
  .witmind-page {
    background-color: var(--color-secondary-deep);
    color: var(--color-text-light);
    position: relative;
    overflow: hidden;
  }

  /* Decorative background radial glow details */
  .witmind-page::before {
    content: "";
    position: absolute;
    top: 5%;
    right: -10%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(242, 101, 34, 0.07) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .witmind-page::after {
    content: "";
    position: absolute;
    bottom: 15%;
    left: -10%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(11, 43, 64, 0.5) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  /* Hero Adjustments */
  .hero-container {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    padding-top: 80px;
  }
  .hero-content {
    max-width: 800px;
    margin: 0 auto;
    z-index: 2;
  }
  .hero-logo-container {
    margin-bottom: 2rem;
    display: inline-flex;
    justify-content: center;
  }
  .hero-logo {
    max-width: min(380px, 80vw);
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.25));
  }
  .hero-subtitle {
    font-size: clamp(1.1rem, 2.5vw, 1.4rem);
    line-height: 1.6;
    margin-bottom: 2.5rem;
    max-width: 70ch;
  }
  .hero-ctas {
    display: flex;
    justify-content: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  /* About Section styles */
  .grid-about {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 4rem;
    align-items: center;
  }
  .about-logo-container {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 2.5rem;
  }
  .about-logo {
    max-width: 140px;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.25));
  }
  .about-desc {
    margin-bottom: 1.5rem;
    font-size: 1.05rem;
    line-height: 1.7;
    max-width: 100%;
  }
  .ecosystem-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: var(--radius-lg);
    padding: 3rem;
    box-shadow: var(--shadow-md);
  }
  .ecosystem-card h3 {
    margin-bottom: 1.25rem;
    position: relative;
    padding-bottom: 0.75rem;
    font-size: 1.3rem;
  }
  .ecosystem-card h3::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 30px;
    height: 2px;
    background: var(--color-primary);
  }
  .ecosystem-card p {
    font-size: 0.95rem;
    line-height: 1.7;
  }

  /* Services section */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 3.5rem;
  }
  .service-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    transition: all var(--transition-base);
  }
  .service-card:hover {
    transform: translateY(-6px);
    border-color: var(--color-primary);
    background: rgba(255, 255, 255, 0.05);
    box-shadow: var(--shadow-lg), 0 0 30px rgba(242, 101, 34, 0.08);
  }
  .service-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 54px;
    height: 54px;
    background: rgba(242, 101, 34, 0.1);
    border-radius: var(--radius-sm);
    margin-bottom: 1.5rem;
    border: 1px solid rgba(242, 101, 34, 0.2);
  }
  .service-card h3 {
    font-size: 1.25rem;
    margin-bottom: 0.8rem;
    letter-spacing: -0.01em;
  }
  .service-card p {
    font-size: 0.92rem;
    line-height: 1.6;
    margin: 0;
  }

  /* Why Witmind section */
  .why-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3.5rem;
    margin-top: 3.5rem;
  }
  .why-item {
    position: relative;
  }
  .why-number {
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 800;
    line-height: 1;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }
  .why-item h3 {
    font-size: 1.35rem;
    margin-bottom: 0.8rem;
  }
  .why-item p {
    font-size: 0.92rem;
    line-height: 1.6;
    margin: 0;
  }

  @media (min-width: 992px) {
    .why-item:not(:last-child)::after {
      content: "";
      position: absolute;
      right: -1.75rem;
      top: 10%;
      height: 80%;
      width: 1px;
      background: rgba(255, 255, 255, 0.08);
    }
  }

  /* Contact section styles */
  .contact-section-witmind {
    position: relative;
    z-index: 2;
  }
  .contact-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: var(--radius-xl);
    padding: 4.5rem;
    max-width: 800px;
    margin: 0 auto;
    box-shadow: var(--shadow-xl);
  }
  .contact-intro {
    font-size: 1.1rem;
    margin: 0 auto 2.5rem auto;
    max-width: 600px;
    line-height: 1.6;
  }
  .whatsapp-box {
    margin-bottom: 1.5rem;
  }
  .contact-footnote {
    font-size: 0.85rem;
    margin: 0 auto;
  }

  /* Legal info section */
  .legal-section {
    padding: 4rem 0;
    background: var(--color-secondary-deep);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }
  .legal-box {
    max-width: 900px;
    margin: 0 auto;
  }
  .legal-box h3 {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.4);
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 2.5rem;
    text-align: center;
  }
  .legal-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem 4rem;
  }
  .legal-item {
    display: flex;
    flex-direction: column;
    gap: 6px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    padding-bottom: 12px;
  }
  .legal-item strong {
