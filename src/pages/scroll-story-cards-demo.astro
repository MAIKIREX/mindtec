---
import ScrollStoryCards from "../components/scroll/ScrollStoryCards.astro";
import ScrollStoryCardsItem from "../components/scroll/ScrollStoryCardsItem.astro";

const cover = {
  background:
    "https://images.unsplash.com/photo-1497366754035-f200968a6e72?auto=format&fit=crop&w=2400&q=88",
  alt: "Oficina empresarial moderna",
  eyebrow: "Experiencia corporativa",
  title: "Espacios creados para avanzar.",
  description:
    "Una narrativa visual donde cada nueva escena asciende y transforma la composición."
};

const intro = {
  background:
    "https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=2400&q=88",
  alt: "Edificio corporativo",
  number: "02",
  eyebrow: "Descubre el entorno",
  title: "Una experiencia más cerca de lo que imaginas.",
  description:
    "Primero entra el fondo; después, la tarjeta horizontal asciende desde la parte inferior."
};

const items = [
  {
    background:
      "https://images.unsplash.com/photo-1534438327276-14e5300c3a48?auto=format&fit=crop&w=2400&q=88",
    alt: "Gimnasio moderno",
    position: "left" as const,
    eyebrow: "Bienestar",
    title: "Fitness Club",
    description:
      "Un espacio preparado para entrenar, recuperar energía y mantener una rutina saludable.",
    bg: "#05091f",
    color: "#ffffff",
    muted: "rgba(255,255,255,0.62)"
  },
  {
    background:
      "https://images.unsplash.com/photo-1497366811353-6870744d04b2?auto=format&fit=crop&w=2400&q=88",
    alt: "Espacio colaborativo",
    position: "center" as const,
    eyebrow: "Colaboración",
    title: "Creative Hub",
    description:
      "Áreas centrales para reuniones, intercambio de ideas y trabajo flexible entre equipos.",
    bg: "#f3f1ec",
    color: "#080b20",
    muted: "rgba(8,11,32,0.62)"
  },
  {
    background:
      "https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=2400&q=88",
    alt: "Zona social corporativa",
    position: "right" as const,
    eyebrow: "Experiencias",
    title: "Communal Spaces",
    description:
      "Ambientes para conversar, descansar y crear conexiones profesionales fuera del escritorio.",
    bg: "#05091f",
    color: "#ffffff",
    muted: "rgba(255,255,255,0.62)"
  },
  {
    background:
      "https://images.unsplash.com/photo-1436491865332-7a61a109cc05?auto=format&fit=crop&w=2400&q=88",
    alt: "Avión sobre una ciudad",
    position: "left" as const,
    eyebrow: "Conectividad",
    title: "Global Access",
    description:
      "Conexiones rápidas con los principales puntos de la ciudad y destinos internacionales.",
    bg: "#d9e1e4",
    color: "#07101e",
    muted: "rgba(7,16,30,0.62)"
  }
];
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Demostración de escenas con tarjetas independientes y GSAP"
    />
    <title>ScrollStoryCards — Astro + GSAP</title>
  </head>

  <body>
    <header class="demo-header">
      <button class="demo-menu" type="button" aria-label="Abrir menú">
        <span></span>
        <span></span>
      </button>

      <a href="/" class="demo-brand">NEUROLAB</a>

      <nav class="demo-nav" aria-label="Navegación principal">
        <a href="#">Espacios</a>
        <a href="#">Servicios</a>
        <a href="#">Contacto</a>
      </nav>
    </header>

    <main>
      <ScrollStoryCards
        cover={cover}
        intro={intro}
        scrub={0.9}
        sceneDistance={1}
        holdDistance={0.4}
        cardDelay={0.08}
        internalParallax={24}
        introCardWidth={0.98}
        introCardHeight={0.6}
      >
        {
          items.map((item, index) => (
            <ScrollStoryCardsItem
              background={item.background}
              alt={item.alt}
              index={index}
              total={items.length}
              cardPosition={item.position}
              cardWidth="32vw"
              cardHeight="72vh"
              cardBackground={item.bg}
              cardTextColor={item.color}
              cardMutedColor={item.muted}
            >
              <div class="demo-card-content">
                <span class="demo-card-eyebrow">
                  {item.eyebrow}
                </span>

                <h2>{item.title}</h2>

                <div class="demo-card-art" aria-hidden="true">
                  <span></span>
                  <span></span>
                  <span></span>
                  <span></span>
                  <span></span>
                </div>

                <p>{item.description}</p>
              </div>
            </ScrollStoryCardsItem>
          ))
        }
      </ScrollStoryCards>

      <section class="after-demo">
        <span>Final de la secuencia</span>
        <h2>La página continúa después del wrapper.</h2>
        <p>
          Las tarjetas pueden ubicarse a la izquierda, al centro o a la
          derecha. Cada item tiene su propio fondo, forma, colores y contenido.
        </p>
      </section>
    </main>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    overflow-x: hidden;
    background: #05091f;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  .demo-header {
    position: fixed;
    z-index: 100;
    top: 0;
    left: 0;
    right: 0;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    min-height: 72px;
    padding: 0 clamp(18px, 4vw, 70px);
    color: white;
    mix-blend-mode: difference;
    pointer-events: none;
  }

  .demo-header a,
  .demo-header button {
    pointer-events: auto;
  }

  .demo-menu {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 56px;
    padding: 10px 0;
    border: 0;
    color: inherit;
    background: transparent;
    cursor: pointer;
  }

  .demo-menu span {
    width: 100%;
    height: 1px;
    background: currentColor;
  }

  .demo-brand {
    margin-left: clamp(28px, 5vw, 90px);
    color: inherit;
    font-size: 1.4rem;
    letter-spacing: 0.28em;
    text-decoration: none;
  }

  .demo-nav {
    display: flex;
    gap: clamp(22px, 4vw, 65px);
  }

  .demo-nav a {
    color: inherit;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .demo-card-content {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    height: 100%;
  }

  .demo-card-eyebrow {
    display: block;
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.72;
  }

  .demo-card-content h2 {
    max-width: 430px;
    margin: 18px 0 0;
    font-size: clamp(1.8rem, 3vw, 3.5rem);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  .demo-card-art {
    align-self: center;
    justify-self: center;
    display: flex;
    align-items: center;
    gap: 8px;
    height: 180px;
  }

  .demo-card-art span {
    width: 2px;
    height: 50%;
    background: currentColor;
    opacity: 0.4;
  }

  .demo-card-art span:nth-child(2),
  .demo-card-art span:nth-child(4) {
    height: 72%;
  }

  .demo-card-art span:nth-child(3) {
    height: 100%;
  }

  .demo-card-content p {
    max-width: 470px;
    margin: 0;
    font-size: clamp(0.85rem, 1vw, 1rem);
    line-height: 1.35;
    text-transform: uppercase;
    opacity: 0.65;
  }

  .after-demo {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(42px, 8vw, 130px);
    color: white;
    background:
      radial-gradient(
        circle at 70% 45%,
        rgba(94, 66, 190, 0.25),
        transparent 34%
      ),
      #0b0d19;
  }

  .after-demo > span {
    margin-bottom: 24px;
    color: #b9adff;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .after-demo h2 {
    max-width: 1000px;
    margin: 0;
    font-size: clamp(3rem, 7vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.06em;
  }

  .after-demo p {
    max-width: 680px;
    margin: 34px 0 0;
    color: rgba(255, 255, 255, 0.68);
    font-size: 1.08rem;
    line-height: 1.7;
  }

  @media (max-width: 700px) {
    .demo-header {
      grid-template-columns: auto 1fr;
      min-height: 62px;
      padding: 0 18px;
    }

    .demo-menu {
      width: 42px;
    }

    .demo-brand {
      justify-self: end;
      margin-left: 0;
      font-size: 1rem;
    }

    .demo-nav {
      display: none;
    }

    .demo-card-art {
      height: 110px;
    }
  }
</style>
