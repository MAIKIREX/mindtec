        <script>
            import { gsap } from "gsap";
            import { ScrollTrigger } from "gsap/ScrollTrigger";

            gsap.registerPlugin(ScrollTrigger);

            document
                .querySelectorAll<HTMLElement>("[data-problem-statement]")
                .forEach((statement) => {
                    const lines = statement.querySelectorAll<HTMLElement>(
                        ".problem-statement__line",
                    );

                    if (!lines.length) return;

                    const motionQuery = window.matchMedia(
                        "(prefers-reduced-motion: reduce)",
                    );

                    if (motionQuery.matches) {
                        gsap.set(lines, { clearProps: "transform,opacity,visibility" });
                        return;
                    }

                    gsap.context(() => {
                        const timeline = gsap.timeline({
                            scrollTrigger: {
                                trigger: statement,
                                start: "top 80%",
                                end: "bottom 40%",
                                scrub: 0.35,
                                invalidateOnRefresh: true,
                            },
                        });

                        timeline.fromTo(
                            lines,
                            {
                                autoAlpha: 0,
                                yPercent: 110,
                                filter: "blur(5px)",
                            },
                            {
                                autoAlpha: 1,
                                yPercent: 0,
                                filter: "blur(0px)",
                                ease: "none",
                                duration: 1,
                                stagger: 0.65,
                            },
                        );
                    }, statement);
                });
        </script>

