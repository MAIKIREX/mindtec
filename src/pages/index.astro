import ScrollStoryLeft from "../components/scroll/ScrollStoryLeft.astro";
import ScrollReveal from "../components/scroll/ScrollReveal.astro";
import StatCounter from "../components/scroll/StatCounter.astro";
---

<Layout
    title="Investigación de Mercados en Bolivia | Estudios con Neurociencia e IA | Mindtec"
    description="Investigación de mercados en Bolivia para banca, seguros e industria. Neurociencia, IA y validación en terreno para decisiones que su Directorio puede defender. Mindtec."
    headerLightBg={false}
>
    <script type="application/ld+json" slot="head">
        {
            "@context": "https://schema.org",
            "@type": "WebPage",
            "@id": "https://www.mindtecbolivia.com/#webpage",
            "url": "https://www.mindtecbolivia.com",
            "name": "Investigación de Mercados en Bolivia | Estudios con Neurociencia e IA | Mindtec",
            "description": "Firma boliviana que integra neurociencia, inteligencia artificial y consultoría de mercados para decisiones críticas de alta dirección en banca, seguros, industria y consumo masivo.",
            "isPartOf": { "@id": "https://www.mindtecbolivia.com/#website" },
            "about": { "@id": "https://www.mindtecbolivia.com/#organization" },
            "knowsAbout": [
                "Investigación de mercados",
                "Neuromarketing",
                "Psicoantropología del consumidor",
                "Estudios de precios",
                "Percepción de marca",
                "Auditoría retail"
            ]
        }
    </script>
    <section id="zoom-reveal" class="zoom-reveal-section">
        <div class="zoom-reveal-bg" aria-hidden="true">
            <div class="zoom-image">
                <iframe
                    class="zoom-video-iframe"
                    src="https://www.youtube.com/embed/6LihrtzPoAc?autoplay=1&mute=1&loop=1&playlist=6LihrtzPoAc&controls=0&showinfo=0&modestbranding=1&rel=0&iv_load_policy=3&disablekb=1&playsinline=1&fs=0&cc_load_policy=0"
                    title=""
                    frameborder="0"
                    allow="autoplay; encrypted-media"
                    tabindex="-1"></iframe>
            </div>
            <div class="zoom-reveal-tint"></div>
        </div>
        <div class="zoom-text-wrapper" aria-hidden="true">
            <h1 class="zoom-giant-text">
                <span>MIND</span><span class="accent">TEC</span>
            </h1>
        </div>
        <div class="reveal-content"></div>
    </section>

    <script>
        import { gsap } from "gsap";
        import { ScrollTrigger } from "gsap/ScrollTrigger";

        gsap.registerPlugin(ScrollTrigger);

        const section = document.getElementById("zoom-reveal");

        if (section) {
            const textWrapper = section.querySelector(".zoom-text-wrapper");
            const image = section.querySelector(".zoom-image");
            const content = section.querySelector(".reveal-content");
            const prefersReducedMotion = window.matchMedia(
                "(prefers-reduced-motion: reduce)",
            ).matches;

            // Evita instancias duplicadas del mismo trigger si el script llegara
            // a ejecutarse más de una vez (p. ej. recargas en caliente en dev).
            ScrollTrigger.getAll().forEach((st) => {
                if (st.vars.trigger === section) st.kill();
            });

            if (prefersReducedMotion) {
                gsap.set(textWrapper, { autoAlpha: 0 });
                gsap.set(image, {
                    scale: 1,
                    filter: "blur(0px) brightness(0.8)",
                });
                gsap.set(content, { opacity: 1, y: 0 });
            } else {
                const tl = gsap.timeline({
                    scrollTrigger: {
                        trigger: section,
                        start: "top top",
                        end: "+=2500",
                        scrub: 1,
                        pin: true,
                        anticipatePin: 1,
                        invalidateOnRefresh: true,
                    },
                });

                // 1. Escalar el texto inmensamente hasta que desaparezca
                tl.to(
                    textWrapper,
                    {
                        scale: 80,
                        opacity: 0,
                        duration: 1,
                        ease: "power2.in",
                    },
                    0,
                );

                // 2. Escalar hacia abajo la imagen y enfocarla simultáneamente
                tl.fromTo(
                    image,
                    { scale: 1.5, filter: "blur(20px) brightness(0.5)" },
                    {
                        scale: 1,
                        filter: "blur(0px) brightness(0.8)",
                        duration: 1,
                        ease: "power2.inOut",
                    },
                    0,
                );

                // 3. Mostrar el contenido de texto que estaba oculto
                tl.fromTo(
                    content,
                    { opacity: 0, y: 50 },
                    { opacity: 1, y: 0, duration: 0.5, ease: "power2.out" },
                    0.8,
                );

                // Recalcula posiciones si fuentes web o imágenes desplazan el layout
                // después del cálculo inicial — evita que el pin quede desincronizado.
                window.addEventListener("load", () => ScrollTrigger.refresh());
                if (document.fonts && document.fonts.ready) {
                    document.fonts.ready.then(() => ScrollTrigger.refresh());
                }
            }
        }
    </script>

