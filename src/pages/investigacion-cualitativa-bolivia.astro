---
import Layout from "../layouts/Layout.astro";
import NeuroOrbitLogo from "../components/visual/NeuroOrbitLogo.astro";
import ScrollStoryLeft from "../components/scroll/ScrollStoryLeft.astro";
import ScrollStory from "../components/scroll/ScrollStory.astro";
import ScrollReveal from "../components/scroll/ScrollReveal.astro";
import StackedSections from "../components/scroll/StackedSections.astro";
import HoverStepCards from "../components/cards/HoverStepCards.astro";
import FaqSplit from "../components/faq/FaqSplit.astro";

const faqItems = [
  {
    question:
      "¿Cuándo es más útil la investigación cualitativa que la cuantitativa?",
    answer:
      "La investigación cualitativa es superior cuando necesita entender el por qué detrás de un comportamiento, no solo el qué o el cuánto. Es ideal para: explorar territorios de marca, entender barreras de adopción, identificar motivadores no declarados de compra, desarrollar conceptos antes de testearlos cuantitativamente, o diagnosticar por qué una campaña no conectó con el consumidor boliviano.",
  },
  {
    question: "¿Qué es la psicoantropología y cómo se aplica en Bolivia?",
    answer:
      "La psicoantropología combina psicología del comportamiento con antropología cultural para entender cómo los códigos culturales bolivianos influyen en las decisiones de compra. Mindtec es la única firma en Bolivia que aplica esta disciplina de forma sistemática en investigación de mercados, identificando los significados simbólicos que determinan la preferencia de marca en cada región.",
  },
  {
    question: "¿Cuántos grupos focales necesita un estudio cualitativo?",
    answer:
      "Depende de la heterogeneidad de su mercado objetivo. Un estudio básico en una ciudad con un segmento homogéneo puede requerir 2 grupos. Un estudio que compare segmentos por ciudad, género o nivel socioeconómico puede necesitar entre 6 y 12 grupos para alcanzar saturación teórica. Diseñamos el número óptimo para responder su pregunta de investigación sin desperdiciar presupuesto.",
  },
  {
    question: "¿Cuánto tarda una investigación cualitativa en Bolivia?",
    answer:
      "Un estudio cualitativo estándar (2–4 grupos focales en una ciudad) tarda entre 3 y 5 semanas. Estudios etnográficos o de mayor alcance geográfico pueden requerir de 6 a 10 semanas. La profundidad que requiere el análisis de psicoantropología toma tiempo, pero garantiza hallazgos que las encuestas nunca revelarán.",
  },
  {
    question: "¿Cómo integra Mindtec la IA en la investigación cualitativa?",
    answer:
      "Usamos IA para el análisis semántico de transcripciones, análisis facial en tiempo real durante las sesiones para detectar respuestas emocionales no verbalizadas, y síntesis asistida de grandes volúmenes de material etnográfico. Esto acelera el análisis sin sacrificar la profundidad interpretativa del equipo humano.",
  },
];

const title = "Investigación Cualitativa en Bolivia | Mindtec";
const description =
  "Investigación cualitativa en Bolivia: focus groups y etnografía para descubrir insights y los motivadores reales del consumidor boliviano. Mindtec.";

const relatedProductsCards = [
  {
    href: "/investigacion-cuantitativa-bolivia",
    eyebrow: "Investigación Cuantitativa",
    title: "Investigación Cuantitativa",
    description:
      "Cuando ya sabe el por qué, mida el cuánto con encuestas representativas y análisis estadístico.",
  },
  {
    href: "/focus-group-bolivia",
    eyebrow: "Sensitive Groups",
    title: "Focus Group",
    description:
      "La evolución del focus group tradicional: 3 niveles de análisis con psicoantropología e IA.",
  },
  {
    href: "/neuromarketing-bolivia",
    eyebrow: "Biometría & Neurociencia",
    title: "Neuromarketing",
    description:
      "Mida lo que el consumidor no puede verbalizar: atención, emoción y respuesta no consciente con biometría.",
  },
];
---

<Layout
  title={title}
  description={description}
  headerLightBg={false}
  canonicalUrl="/investigacion-cualitativa-bolivia"
>
  <script type="application/ld+json" slot="head">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Service",
          "@id": "https://www.mindtecbolivia.com/investigacion-cualitativa-bolivia",
          "name": "Investigación Cualitativa en Bolivia",
          "description": "Servicio de investigación cualitativa en Bolivia: grupos focales, etnografía, entrevistas en profundidad y psicoantropología para entender motivaciones, barreras y comportamientos del consumidor boliviano.",
          "provider": {
            "@type": "Organization",
            "name": "Mindtec Bolivia",
            "url": "https://www.mindtecbolivia.com"
          },
          "areaServed": { "@type": "Country", "name": "Bolivia" },
          "serviceType": "Investigación Cualitativa / Grupos Focales / Etnografía",
          "url": "https://www.mindtecbolivia.com/investigacion-cualitativa-bolivia"
        },
        {
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "¿Cuándo es más útil la investigación cualitativa que la cuantitativa?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "La investigación cualitativa es superior cuando necesita entender el por qué detrás de un comportamiento, no solo el qué o el cuánto. Es ideal para: explorar territorios de marca, entender barreras de adopción, identificar motivadores no declarados de compra, desarrollar conceptos antes de testearlos cuantitativamente, o diagnosticar por qué una campaña no conectó con el consumidor boliviano."
              }
            },
            {
              "@type": "Question",
              "name": "¿Qué es la psicoantropología y cómo se aplica en la investigación de mercados en Bolivia?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "La psicoantropología combina psicología del comportamiento con antropología cultural para entender cómo los códigos culturales bolivianos — desde la cosmovisión andina hasta las identidades urbanas de Santa Cruz o El Alto — influyen en las decisiones de compra. Mindtec es la única firma en Bolivia que aplica esta disciplina de forma sistemática en investigación de mercados, permitiendo identificar los significados simbólicos que determinan la preferencia de marca en cada región."
              }
            },
            {
              "@type": "Question",
              "name": "¿Cuántos grupos focales necesita un estudio cualitativo?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Depende de la heterogeneidad de su mercado objetivo. Un estudio básico en una ciudad con un segmento homogéneo puede requerir 2 grupos. Un estudio que compare segmentos por ciudad, género o nivel socioeconómico puede necesitar entre 6 y 12 grupos para alcanzar saturación teórica. Diseñamos el número óptimo para responder su pregunta de investigación sin desperdiciar presupuesto."
              }
            },
            {
              "@type": "Question",
              "name": "¿Cuánto tarda una investigación cualitativa en Bolivia?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Un estudio cualitativo estándar (2–4 grupos focales en una ciudad) tarda entre 3 y 5 semanas. Estudios etnográficos o de mayor alcance geográfico pueden requerir de 6 a 10 semanas. La profundidad que requiere un análisis de psicoantropología toma tiempo, pero garantiza hallazgos que las encuestas nunca revelarán."
              }
            },
            {
              "@type": "Question",
              "name": "¿Cómo integra Mindtec la IA en la investigación cualitativa?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Usamos IA para el análisis semántico de transcripciones (identificación de patrones de lenguaje, emociones y discursos recurrentes), análisis facial en tiempo real durante las sesiones para detectar respuestas emocionales no verbalizadas, y síntesis asistida de grandes volúmenes de material etnográfico. Esto acelera el análisis sin sacrificar la profundidad interpretativa del equipo humano."
              }
            }
          ]
        },
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "Inicio",
              "item": "https://www.mindtecbolivia.com/"
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": "Servicios",
              "item": "https://www.mindtecbolivia.com/servicios"
            },
            {
              "@type": "ListItem",
              "position": 3,
              "name": "Investigación Cualitativa en Bolivia",
              "item": "https://www.mindtecbolivia.com/investigacion-cualitativa-bolivia"
            }
          ]
        }
      ]
    }
  </script>

  <main>
    <!-- 1. HERO -->
    <section
      class="hero-section"
      style="padding-bottom: 4rem; padding-top: 4rem;"
    >
      <div class="hero-shapes" aria-hidden="true">
        <div class="hero-shape"></div><div class="hero-shape"></div><div
          class="hero-shape"
        >
        </div>
        <div class="hero-shape"></div><div class="hero-shape"></div><div
          class="hero-shape"
        >
        </div>
        <div class="hero-shape"></div><div class="hero-shape"></div><div
          class="hero-shape"
        >
        </div>
        <div class="hero-shape"></div><div class="hero-shape"></div><div
          class="hero-shape"
        >
        </div>
        <div class="hero-shape"></div><div class="hero-shape"></div><div
          class="hero-shape"
        >
        </div>
        <div class="hero-shape"></div>
      </div>
      <div
        class="hero-mobile-canvas"
        id="hero-mobile-canvas"
        aria-hidden="true"
      >
      </div>
      <div class="container hero-container">
        <div class="hero-content">
          <span class="eyebrow fade-in"
            >GRUPOS FOCALES · ETNOGRAFÍA · ENTREVISTAS EN PROFUNDIDAD ·
            PSICOANTROPOLOGÍA</span
          >
          <span class="freshness-tag">Actualizado: julio 2026</span>
          <h1
            class="hero-title"
            style="font-size: 3.5rem; line-height: 1.25; margin-bottom: 1.5rem;"
          >
            Investigación Cualitativa en Bolivia — Descubra el por qué detrás de
            cada decisión de compra.
          </h1>
        </div>
        <div
          class="hero-visual"
          style="display: flex; align-items: center; justify-content: center; max-width: 100%; overflow: visible;"
        >
          <div
            class="hero-visual-slot"
            data-logo-slot="start"
            style="width: min(52vw, 560px); aspect-ratio: 1;"
          >
            <NeuroOrbitLogo
              size="min(68vw, 720px)"
              stageSize="clamp(260px, 30vw, 380px)"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Nueva sección debajo del hero -->
    <section class="hero-details-section" style="background: var(--color-secondary-deep, #061c2b); padding: 4rem 0;">
      <div class="container hero-details-grid">
        <div class="hero-details-logo-slot" data-logo-slot="end"></div>
        <div class="hero-details-text">
          <div class="direct-answer-box">
            <strong>En resumen</strong>
            <p>
              Mindtec ofrece investigación cualitativa en Bolivia (grupos
              focales, etnografía, entrevistas en profundidad y
              psicoantropología) para entender motivaciones, barreras y
              comportamientos del consumidor boliviano.
            </p>
          </div>
          <p
            class="hero-subtitle"
            style="font-size: 1.25rem; margin-bottom: 1.5rem; max-width: 600px; color: #fff; line-height: 1.6;"
          >
            Grupos focales, etnografía, entrevistas en profundidad y
            psicoantropología aplicada al mercado boliviano. Metodología
            Sensitive Groups para acceder a lo que el consumidor no dice pero
            siente.
          </p>
          <p
            style="font-size: 1.05rem; color: rgba(255,255,255,0.75); max-width: 600px; margin-bottom: 2.5rem; line-height: 1.7;"
          >
            La encuesta le dice cuántos. La investigación cualitativa le dice
            por qué. Y en un mercado con la diversidad cultural de Bolivia, el
            por qué cambia radicalmente entre Santa Cruz, La Paz y El Alto.
          </p>
          <div
            style="display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 2.5rem;"
          >
            <span
              style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #fff; padding: 0.4rem 1rem; border-radius: 20px; font-size: 0.85rem; font-weight: 600;"
              >Grupos focales · Etnografía</span
            >
            <span
              style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #fff; padding: 0.4rem 1rem; border-radius: 20px; font-size: 0.85rem; font-weight: 600;"
              >Entrevistas en profundidad</span
            >
            <span
              style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #fff; padding: 0.4rem 1rem; border-radius: 20px; font-size: 0.85rem; font-weight: 600;"
              >Psicoantropología boliviana</span
            >
            <span
              style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #fff; padding: 0.4rem 1rem; border-radius: 20px; font-size: 0.85rem; font-weight: 600;"
              >Análisis de IA en tiempo real</span
            >
          </div>
          <div style="text-align: center;">
            <a href="/contacto" class="btn btn-primary lg"
              >Agendar diagnóstico estratégico (45 min) →</a
            >
          </div>
        </div>
      </div>
    </section>

    <section class="generated-insight-section">
      <div class="container">
        <div
          class="section-title-center"
          style="text-align: center; margin-bottom: 3rem;"
        >
          <span class="eyebrow">Focus groups profundos</span>
          <h2
            class="text-navy"
            style="font-size: 2.2rem; line-height: 1.2; margin-top: 1rem;"
          >
            De la conversación al insight que explica la decisión.
          </h2>
          <p
            class="text-gray-dark"
            style="font-size: 1.05rem; max-width: 760px; margin: 1rem auto 0; line-height: 1.7;"
          >
            Las sesiones cualitativas se registran, codifican y sintetizan para
            revelar tensiones culturales, motivadores no declarados y
            oportunidades de posicionamiento.
          </p>
        </div>
        <div class="generated-insight-grid">
          <figure class="generated-insight-card">
            <img
              src="/imagenes-mindtec/generated/focus-group-profundo.webp"
              alt="Focus group profundo con moderadora y participantes analizando conceptos de mercado"
              loading="lazy"
            />
            <figcaption>
              <span>Sesión profunda</span>
              <strong
                >Moderación sensible al contexto cultural y a respuestas no
                verbales.</strong
              >
            </figcaption>
          </figure>
          <figure class="generated-insight-card">
            <img
              src="/imagenes-mindtec/generated/focus-group-analisis-ia.webp"
              alt="Analisis cualitativo con mapas de afinidad, transcripciones y dashboard semantico"
              loading="lazy"
            />
            <figcaption>
              <span>Análisis real</span>
              <strong
                >Mapas de afinidad, patrones semánticos y síntesis para
                decisiones de marca.</strong
              >
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- 2. EL PROBLEMA / MINDTEC+ -->
    <ScrollReveal>
    <section class="problem-section bg-slate" style="padding: 5rem 0;">
      <div class="container">
        <div
          class="premium-card-white"
          style="max-width: 900px; margin: 0 auto; padding: 4rem;"
        >
          <span class="eyebrow">EL PROBLEMA REAL</span>
          <h2
            class="text-navy"
            style="font-size: 2.5rem; margin-top: 1rem; margin-bottom: 2rem; line-height: 1.2;"
          >
            Saber cuántos no es suficiente. Las empresas pierden dinero porque
            no entienden por qué.
          </h2>
          <p
            class="text-gray-dark leading-relaxed"
            style="font-size: 1.15rem; margin-bottom: 1.5rem; line-height: 1.7;"
          >
            Una encuesta puede decirle que el 68% de su mercado objetivo
            "probablemente compraría" su producto. Pero no puede decirle por qué
            el 32% restante lo rechaza, qué barrera emocional impide que los
            indecisos actúen, ni qué código cultural hace que su mensaje
            funcione en Santa Cruz pero falle en La Paz.
          </p>
          <p
            class="text-gray-dark leading-relaxed"
            style="font-size: 1.05rem; margin-bottom: 2rem; line-height: 1.7;"
          >
            ¿Reconoce alguno de estos escenarios?
          </p>
          <ul class="cap-list" style="font-size: 1.05rem; margin-bottom: 2rem;">
            <li>
              <strong class="text-navy"
                >Lanzó un producto que "el mercado quería" según la encuesta, y
                no vendió lo esperado.</strong
              > La intención declarada no es comportamiento real. La cualitativa revela
              la brecha entre lo que la gente dice y lo que hace.
            </li>
            <li>
              <strong class="text-navy"
                >Su campaña fue bien producida pero no conectó emocionalmente.</strong
              > Sin exploración cualitativa previa, los territorios creativos se construyen
              sobre suposiciones del equipo, no sobre insights reales del consumidor.
            </li>
            <li>
              <strong class="text-navy"
                >No entiende por qué un segmento específico rechaza su marca a
                pesar de tener buen producto y precio.</strong
              > Las barreras de adopción raramente son racionales — son simbólicas,
              culturales o emocionales.
            </li>
            <li>
              <strong class="text-navy"
                >Tiene datos de lo que el consumidor hace, pero no sabe qué lo
                motiva realmente a elegirle.</strong
              > Y sin ese insight, no puede construir una propuesta de valor diferenciada.
            </li>
          </ul>
          <div
            style="background: var(--color-secondary); color: #fff; padding: 1.5rem 2rem; border-radius: 8px; font-weight: 600; font-size: 1.1rem; text-align: center;"
          >
            El consumidor boliviano no compra productos. Compra significados,
            identidades y soluciones a tensiones que ni él mismo verbaliza.
          </div>
        </div>
      </div>
    </section>
    </ScrollReveal>

    <ScrollReveal>
    <section style="padding: 5rem 0; background: #fff;">
      <div class="container">
        <div
          class="section-title-center"
          style="text-align: center; margin-bottom: 3rem;"
        >
          <span class="eyebrow">MINDTEC+</span>
          <h2
            class="text-navy"
            style="font-size: 2.2rem; line-height: 1.2; margin-top: 1rem; margin-bottom: 1rem;"
          >
            Investigación cualitativa con psicoantropología boliviana e
            inteligencia artificial.
          </h2>
        </div>
        <div class="comparison-table-wrapper">
          <table class="comparison-table">
            <thead>
              <tr>
                <th scope="col">Focus group tradicional</th>
                <th scope="col">Mindtec — Metodología Sensitive Groups</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Modera un psicólogo o comunicador con guía de tópicos</td>
                <td
                  >Equipo interdisciplinario (psicoantropólogo + analista de
                  comportamiento) con protocolo Sensitive Groups de 3 niveles:
                  racional, emocional e inconsciente</td
                >
              </tr>
              <tr>
                <td>Análisis basado en lo que los participantes verbalizan</td>
                <td
                  >Análisis semántico con IA + codificación facial en tiempo
                  real para detectar respuestas emocionales no verbalizadas</td
                >
              </tr>
              <tr>
                <td>Mismo protocolo para todas las regiones de Bolivia</td>
                <td
                  >Protocolo adaptado por código cultural regional: no se modera
                  igual en El Alto que en Santa Cruz o Cochabamba</td
                >
              </tr>
              <tr>
                <td>Reporte descriptivo de lo que se dijo en la sesión</td>
                <td
                  >Interpretación estratégica: qué implica cada hallazgo para su
                  posicionamiento, mensaje y propuesta de valor</td
                >
              </tr>
              <tr>
                <td
                  >Los participantes declaran lo que creen que quieren decir</td
                >
                <td
                  >Técnicas proyectivas y de asociación simbólica para acceder a
                  motivaciones no conscientes que la pregunta directa no revela</td
                >
              </tr>
            </tbody>
          </table>
        </div>
        <p
          class="text-gray-dark"
          style="font-size: 1.05rem; margin-top: 2rem; max-width: 800px; margin-left: auto; margin-right: auto; text-align: center; line-height: 1.7;"
        >
          No es un grupo de conversación. Es una metodología de decodificación
          cultural aplicada al consumidor boliviano.
        </p>
      </div>
    </section>
    </ScrollReveal>

    <!-- 4. ENTREGABLES -->
    <ScrollStoryLeft
      scrub={0.9}
      sceneDistance={1.1}
      cardBackground="#f7f7f5"
      cardTextColor="#0B2B40"
      cardMutedColor="rgba(11, 43, 64, 0.62)"
      cover={{
        background: "/imagenes-mindtec/generated/investigacion-cualitativa/entregables-cover.webp",
        eyebrow: "Qué recibe",
        title: "El insight que sus datos cuantitativos no explican.",
        description: "Documentos y análisis diseñados para traducir la conversación cualitativa en decisiones de marca."
      }}
      intro={{
        background: "/imagenes-mindtec/generated/investigacion-cualitativa/entregables-intro.webp",
        number: "00",
        eyebrow: "Plazo de entrega",
        title: "3–8 semanas según alcance. Presencial, online o etnografía en campo.",
        description: "Recorra los seis entregables que puede esperar de un estudio cualitativo Mindtec."
      }}
      items={[
        {
          background: "/imagenes-mindtec/generated/investigacion-cualitativa/entregable-01-mapa-motivaciones-barreras.webp",
          eyebrow: "Insight",
          title: "Mapa de Motivaciones y Barreras",
          description: "Motivadores conscientes e inconscientes de compra o rechazo, por segmento.",
          icon: "services"
        },
        {
          background: "/imagenes-mindtec/generated/investigacion-cualitativa/entregable-02-decodificacion-cultural.webp",
          eyebrow: "Cultura",
          title: "Decodificación Cultural por Región",
          description: "Cómo los códigos culturales bolivianos modulan la percepción de su marca.",
          icon: "building"
        },
        {
          background: "/imagenes-mindtec/generated/investigacion-cualitativa/entregable-03-territorios-marca.webp",
          eyebrow: "Posicionamiento",
          title: "Territorios de Marca y Oportunidades",
          description: "Espacios emocionales y simbólicos que su marca puede ocupar de forma creíble.",
          icon: "road"
        },
        {
          background: "/imagenes-mindtec/generated/investigacion-cualitativa/entregable-04-evaluacion-conceptos.webp",
          eyebrow: "Testeo",
          title: "Evaluación de Conceptos o Creatividades",
          description: "Testeo cualitativo de conceptos, nombres, empaques o piezas creativas.",
          icon: "services"
        },
        {
          background: "/imagenes-mindtec/generated/investigacion-cualitativa/entregable-05-grabaciones-transcripciones.webp",
          eyebrow: "Material",
          title: "Grabaciones y Transcripciones Analizadas",
          description: "Sesiones con análisis semántico y de comportamiento no verbal.",
          icon: "airport"
        },
        {
          background: "/imagenes-mindtec/generated/investigacion-cualitativa/entregable-06-brief-estrategico.webp",
          eyebrow: "Síntesis",
          title: "Brief Estratégico para Creatividad y Comunicación",
          description: "El insight, la tensión, el territorio y el tono en un documento accionable.",
          icon: "building"
        }
      ]}
    />

    <!-- 5. PROCESO -->
    <ScrollStory
      scrub={0.85}
      sceneDistance={1.1}
      cover={{
        background: "/imagenes-mindtec/generated/investigacion-cualitativa/proceso-cover.webp",
