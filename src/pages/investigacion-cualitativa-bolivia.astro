  <script>
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    type HeroLogoWindow = typeof window & {
      __heroLogoTransitionEventsRegistered?: boolean;
    };

    let heroLogoContext: gsap.Context | undefined;

    function destroyHeroLogoTransition(): void {
      heroLogoContext?.revert();
      heroLogoContext = undefined;
    }

    // Coordenadas en espacio de documento (no de viewport), para que el
    // logo -posicionado en position:absolute sobre <body>- se desplace de
    // forma natural junto con el scroll de la página.
    function docRect(el: HTMLElement) {
      const rect = el.getBoundingClientRect();
      return {
        top: rect.top + window.scrollY,
        left: rect.left + window.scrollX,
      };
    }

    function initHeroLogoTransition(): void {
      destroyHeroLogoTransition();

      const heroSection = document.querySelector<HTMLElement>(".hero-section");
      const startSlot = document.querySelector<HTMLElement>(
        '[data-logo-slot="start"]',
      );
      const endSlot = document.querySelector<HTMLElement>(
        '[data-logo-slot="end"]',
      );
      const logo = startSlot?.querySelector<HTMLElement>(
        "[data-neuro-orbit-logo]",
      );

      if (!heroSection || !startSlot || !endSlot || !logo) return;

      const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      const isDesktop = window.matchMedia("(min-width: 900px)").matches;

      // En mobile o con reduced-motion el logo se queda tal cual quedó
      // maquetado dentro del hero: sin flotar, sin animación de scroll.
      if (prefersReducedMotion || !isDesktop) return;

      heroLogoContext = gsap.context(() => {
        document.body.appendChild(logo);

        // Centrado sobre el slot (no top-left directo): el núcleo del
        // logo puede ser más grande que la caja del slot que reserva su
        // espacio en el layout, así que se alinea por el centro de ambos.
        const startRect = startSlot.getBoundingClientRect();
        const startDocInit = docRect(startSlot);
        gsap.set(logo, {
          position: "absolute",
          top:
            startDocInit.top + startRect.height / 2 - logo.offsetHeight / 2,
          left:
            startDocInit.left + startRect.width / 2 - logo.offsetWidth / 2,
          zIndex: 5,
        });

        // quickTo evita crear tweens nuevos en cada tick de scroll: solo
        // reapunta el mismo tween hacia el valor fresco, con una leve
        // inercia (duration) que es justamente lo que da la sensación
        // fluida al desplazamiento en X/Y.
        const setTop = gsap.quickTo(logo, "top", {
          duration: 0.5,
          ease: "power3.out",
        });
        const setLeft = gsap.quickTo(logo, "left", {
          duration: 0.5,
          ease: "power3.out",
        });
        const setScale = gsap.quickTo(logo, "scale", {
          duration: 0.4,
          ease: "power2.out",
        });

        // Tamaño natural (sin transform) del logo: offsetWidth/Height no
        // se ven afectados por el scale aplicado, a diferencia de
        // getBoundingClientRect, así el centrado no se retroalimenta con
        // el propio crecimiento del logo.
        const PEAK_SCALE_BUMP = 0.35;

        ScrollTrigger.create({
          trigger: heroSection,
          start: "top top",
          end: "bottom top",
          invalidateOnRefresh: true,
          onUpdate: (self) => {
            // Se recalcula en cada tick a partir de posiciones en vivo,
            // en vez de usar valores fijados una sola vez, porque el
            // slot de destino puede desplazarse por reflow (fuentes,
            // resize) y necesitamos siempre el valor actual.
            const startDoc = docRect(startSlot);
            const startRect = startSlot.getBoundingClientRect();
            const startTop =
              startDoc.top + startRect.height / 2 - logo.offsetHeight / 2;
            const startLeft =
              startDoc.left + startRect.width / 2 - logo.offsetWidth / 2;

            const endDoc = docRect(endSlot);
            const endRect = endSlot.getBoundingClientRect();
            const endTop =
              endDoc.top + endRect.height / 2 - logo.offsetHeight / 2;
            const endLeft =
              endDoc.left + endRect.width / 2 - logo.offsetWidth / 2;

            setTop(
              gsap.utils.interpolate(startTop, endTop, self.progress),
            );
            setLeft(
              gsap.utils.interpolate(startLeft, endLeft, self.progress),
            );

            // Curva en campana: 1 en los extremos (inicio y destino),
            // pico en el centro del recorrido -> crece al pasar por la
            // mitad de la pantalla y vuelve a su tamaño normal al llegar.
            const bump = Math.sin(self.progress * Math.PI) * PEAK_SCALE_BUMP;
            setScale(1 + bump);
          },
        });
      });
    }

    initHeroLogoTransition();

    const heroLogoWindow = window as HeroLogoWindow;

    if (!heroLogoWindow.__heroLogoTransitionEventsRegistered) {
      document.addEventListener("astro:page-load", initHeroLogoTransition);
      document.addEventListener(
        "astro:before-swap",
        destroyHeroLogoTransition,
      );
      heroLogoWindow.__heroLogoTransitionEventsRegistered = true;
    }
  </script>
</Layout>
