---
import Layout from "../layouts/Layout.astro";
import ServiceVisualSuite from "../components/sections/ServiceVisualSuite.astro";
import ScrollStoryLeft from "../components/scroll/ScrollStoryLeft.astro";
import HoverStepCards from "../components/cards/HoverStepCards.astro";
import FaqSplit from "../components/faq/FaqSplit.astro";
import StackedSections from "../components/scroll/StackedSections.astro";
import AreaPanelCards from "../components/cards/AreaPanelCards.astro";
import ComparisonRows from "../components/cards/ComparisonRows.astro";
import BoliviaNetworkMapFilled from "../components/visual/BoliviaNetworkMapFilled.astro";

const problemScenarios = [
    {
        icon: `<svg viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="15" stroke-linecap="round" stroke-linejoin="round"><circle cx="128" cy="128" r="96"></circle><path d="M92 140c8 16 28 24 36 24s28-8 36-24"></path><path d="M92 100h.1M164 100h.1"></path></svg>`,
        title: "Respuestas de cortesía, no de billetera",
        description:
            "¿Hay billeteras abiertas o solo respuestas de cortesía?: Validamos si su segmento objetivo tiene el presupuesto asignado y la urgencia real de compra, no solo una opinión positiva.",
    },
    {
        icon: `<svg viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="15" stroke-linecap="round" stroke-linejoin="round"><circle cx="128" cy="128" r="40"></circle><circle cx="128" cy="128" r="72"></circle><circle cx="128" cy="128" r="104"></circle></svg>`,
        title: "Dimensionamiento real del mercado",
        description:
            "Dimensionamiento de mercado real (TAM / SAM / SOM): Proyectamos el tamaño total facturable de su sector y la cuota neta que su empresa puede capturar de forma realista en el primer año.",
    },
    {
        icon: `<svg viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="15" stroke-linecap="round" stroke-linejoin="round"><path d="M40 216c0-48 40-88 88-88s88 40 88 88"></path><path d="M128 128V40"></path><path d="M96 64l32-24 32 24"></path></svg>`,
        title: "Barreras culturales e informales",
        description:
            "Barreras culturales e informales de adopción: Mapeamos los frenos de comercialización en el eje troncal y El Alto, donde la dinámica informal y las redes de distribución locales rigen el comportamiento de compra.",
    },
    {
        icon: `<svg viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="15" stroke-linecap="round" stroke-linejoin="round"><path d="M48 208V96l80-56 80 56v112"></path><path d="M96 208v-64h64v64"></path><path d="M128 96h.1"></path></svg>`,
        title: "Tolerancia al margen de precios",
        description:
            "Sensibilidad y tolerancia al margen de precios: Determinamos si el mercado local absorberá el margen proyectado o si su estructura financiera se verá arrastrada a una guerra de precios destructiva.",
    },
];

const comparisonRows = [
    {
        before: "Encuesta puramente descriptiva",
        after: "Evaluación estratégica de decisión Stop/Go",
    },
    {
        before: "Datos planos sin cruce de variables",
        after: "Modelo híbrido (Macro + Campo + Neurociencia)",
    },
    {
        before: "Reportes pesados y redundantes",
        after: "Brief ejecutivo claro diseñado para directorio",
    },
    {
        before: "Falta de control territorial",
        after: "Red nacional activa y validaciones en terreno",
    },
    {
        before: "Opiniones racionales declaradas",
        after: "Medición profunda de comportamiento e inconsciente",
    },
    {
        before: "Finalización tras la entrega del PDF",
        after: "Acompañamiento post-estudio y asesoría táctica",
    },
];

const faqItems = [
    {
        question: "¿Cuánto tiempo toma un estudio de mercado en Bolivia?",
        answer: "El cronograma depende de la complejidad y alcance geográfico. Usualmente una evaluación de viabilidad rápida puede tardar de 3 a 5 semanas, mientras un estudio profundo a nivel nacional puede extenderse a 8 semanas.",
    },
    {
        question: "¿Cuál es la diferencia frente a una encuesta?",
        answer: "Una encuesta solo recopila datos basados en lo que la gente dice (intención declarada). El estudio de mercado de Mindtec cruza métodos cualitativos, cuantitativos, de neurociencia y análisis competitivo para revelar el comportamiento real y entregar una recomendación de negocio accionable (Stop/Go).",
    },
    {
        question: "¿Se puede realizar por ciudad específica?",
        answer: "Sí. Evaluamos factibilidad comercial a nivel local (ej. Santa Cruz, La Paz o Cochabamba), regional o nacional, ajustando el dimensionamiento a las variables y códigos culturales únicos de cada territorio.",
    },
    {
        question: "¿Qué pasa si el resultado indica inviabilidad?",
        answer: "Un resultado que indica inviabilidad comercial es un éxito estratégico rotundo, ya que evita la pérdida de capital estructural de su empresa. En estos casos, detallamos qué variables del producto o precio deberían pivotar para volverse viables.",
    },
];

const cuandoEsCriticoCards = [
    {
        title: "Lanzamiento de nuevo producto",
        description:
            "Evite la pérdida de capital estructural validando la tracción real del mercado antes de fabricar.",
    },
    {
        title: "Expansión a nuevas regiones",
        description:
            "Entienda las diferencias competitivas y demográficas del eje metropolitano boliviano.",
    },
    {
        title: "Sustento de Inversión B2B",
        description:
            "Presente datos robustos y defendibles ante su directorio o junta de inversores.",
    },
];

const otrasAreasCards = [
    {
        title: "Estudio de Precios",
        description:
            "Defina la política de pricing óptima basándose en el valor y demanda.",
        href: "/estudio-de-precios-bolivia",
    },
    {
        title: "Percepción de Marca",
        description:
            "Incorpore el análisis de reputación y posicionamiento actual.",
        href: "/percepcion-de-marca-bolivia",
    },
    {
        title: "Comportamiento del Consumidor Boliviano",
        description:
            "Datos reales de Mindtec sobre hábitos de compra por región y contexto económico.",
        href: "/comportamiento-consumidor-boliviano",
    },
];
---

<Layout
    title="Estudio de Mercado en Bolivia | Viabilidad | Mindtec"
    description="Estudio de mercado en Bolivia para evaluar viabilidad y reducir riesgo de inversión. Dimensionamiento, demanda real y análisis competitivo."
    headerLightBg={false}
>
    <script type="application/ld+json" slot="head">
        {
            "@context": "https://schema.org",
            "@graph": [
                {
                    "@type": "Service",
                    "name": "Estudio de Mercado en Bolivia",
                    "provider": {
                        "@type": "LocalBusiness",
                        "name": "Mindtec Bolivia"
                    },
                    "description": "Estudios de viabilidad y análisis de mercado en Bolivia para dimensionar demanda real, competencia y mitigar riesgos de inversión.",
                    "areaServed": [
                        "La Paz",
                        "Santa Cruz",
                        "Cochabamba",
                        "El Alto"
                    ]
                },
                {
                    "@type": "BreadcrumbList",
                    "itemListElement": [
                        {
                            "@type": "ListItem",
                            "position": 1,
                            "name": "Inicio",
                            "item": "https://www.mindtecbolivia.com/"
                        },
                        {
                            "@type": "ListItem",
                            "position": 2,
                            "name": "Servicios",
                            "item": "https://www.mindtecbolivia.com/servicios"
                        },
                        {
                            "@type": "ListItem",
                            "position": 3,
                            "name": "Estudio de mercado en Bolivia",
                            "item": "https://www.mindtecbolivia.com/estudio-de-mercado-bolivia"
                        }
                    ]
                }
            ]
        }
    </script>
    <script type="application/ld+json" slot="head">
        {
            "@context": "https://schema.org",
            "@type": "FAQPage",
            "mainEntity": [
                {
                    "@type": "Question",
                    "name": "¿Cuánto tiempo toma un estudio de mercado en Bolivia?",
                    "acceptedAnswer": {
                        "@type": "Answer",
                        "text": "El cronograma depende de la complejidad y alcance geográfico. Usualmente una evaluación de viabilidad rápida puede tardar de 3 a 5 semanas, mientras un estudio profundo a nivel nacional puede extenderse a 8 semanas."
                    }
                },
                {
                    "@type": "Question",
                    "name": "¿Cuál es la diferencia entre un estudio de mercado y una encuesta?",
                    "acceptedAnswer": {
                        "@type": "Answer",
                        "text": "Una encuesta solo recopila datos basados en lo que la gente dice (intención declarada). El estudio de mercado de Mindtec cruza métodos cualitativos, cuantitativos, de neurociencia y análisis competitivo para revelar el comportamiento real y entregar una recomendación de negocio accionable (Stop/Go)."
                    }
                },
                {
                    "@type": "Question",
                    "name": "¿Se puede realizar un estudio de mercado por ciudad específica en Bolivia?",
                    "acceptedAnswer": {
                        "@type": "Answer",
                        "text": "Sí. Evaluamos factibilidad comercial a nivel local (ej. Santa Cruz, La Paz o Cochabamba), regional o nacional, ajustando el dimensionamiento a las variables y códigos culturales únicos de cada territorio."
                    }
                },
                {
                    "@type": "Question",
                    "name": "¿Qué pasa si el resultado del estudio indica inviabilidad?",
                    "acceptedAnswer": {
                        "@type": "Answer",
                        "text": "Un resultado que indica inviabilidad comercial es un éxito estratégico rotundo, ya que evita la pérdida de capital estructural de su empresa. En estos casos, detallamos qué variables del producto o precio deberían pivotar para volverse viables."
                    }
                }
            ]
        }
    </script>
    <main>
        <StackedSections>
            <!-- 🟦 1️⃣ HERO -->
            <section
                class="hero-section"
                style="padding-bottom: 4rem; padding-top: 4rem;"
                data-stack-section
            >
                <!-- Geometric floating shapes (always visible, CSS-animated) -->
                <div class="hero-shapes" aria-hidden="true">
                    <div class="hero-shape"></div>
                    <div class="hero-shape"></div>
                    <div class="hero-shape"></div>
                    <div class="hero-shape"></div>
                    <div class="hero-shape"></div>
                    <div class="hero-shape"></div>
                    <div class="hero-shape"></div>
                    <div class="hero-shape"></div>
                    <div class="hero-shape"></div>
                    <div class="hero-shape"></div>
                    <div class="hero-shape"></div>
                    <div class="hero-shape"></div>
                    <div class="hero-shape"></div>
                    <div class="hero-shape"></div>
                    <div class="hero-shape"></div>
                    <div class="hero-shape"></div>
                </div>
                <!-- Mobile-first neural canvas background -->
                <div
                    class="hero-mobile-canvas"
                    id="hero-mobile-canvas"
                    aria-hidden="true"
                >
                </div>
                <div class="container hero-container">
                    <div class="hero-content">
                        <span class="eyebrow fade-in"
                            >VALIDACIÓN Y VIABILIDAD COMERCIAL</span
                        >
                        <span class="freshness-tag"
                            >Actualizado: julio 2026</span
                        >
                        <h1
                            class="hero-title"
                            style="font-size: 3.5rem; line-height: 1.25; margin-bottom: 1.5rem;"
                        >
                            Estudio de Mercado en Bolivia para Evaluar
                            Viabilidad y Reducir Riesgo de Inversión
                        </h1>
                        <div class="direct-answer-box">
                            <strong>En resumen</strong>
                            <p>
                                Mindtec realiza estudios de viabilidad y
                                análisis de mercado en Bolivia para dimensionar
                                la demanda real, evaluar a la competencia y
                                mitigar riesgos de inversión.
                            </p>
                        </div>
                        <p
                            class="hero-subtitle"
                            style="font-size: 1.25rem; margin-bottom: 2.5rem; max-width: 800px;"
                        >
                            Antes de lanzar, expandirse o invertir capital
                            estructural, valide tamaño real de mercado, barreras
                            de entrada y cuota alcanzable. Un estudio de mercado
                            estructurado transforma especulación en decisión
                            defendible.
                        </p>
                        <div
                            class="cta-actions"
                            style="margin-top: 2rem; display: flex; flex-wrap: wrap; gap: 1rem; align-items: center;"
                        >
                            <a href="/contacto" class="btn btn-primary lg"
                                >Agendar sesión de diagnóstico (45 min)</a
                            >
                            <a href="/contacto" class="btn btn-navy-outline lg"
                                >Solicitar evaluación preliminar</a
                            >
                        </div>
                        <p
                            style="margin-top: 1rem; font-size: 0.9rem; color: #64748b; font-weight: 500;"
                        >
                            Primera sesión: 45 minutos | Confidencial | Sin
                            compromiso
                        </p>
                    </div>
                    <div
                        class="hero-visual"
                        style="display: flex; align-items: center; justify-content: center; max-width: 100%; overflow: visible;"
                    >
                        <BoliviaNetworkMapFilled
                            size="clamp(300px, 32vw, 460px)"
                        />
                    </div>
                </div>
            </section>

            <div data-stack-section>
                <ServiceVisualSuite variant="mercado" />
            </div>

            <!-- 🟦 2️⃣ EL COSTO DE NO VALIDAR -->
            <section
                class="bg-slate"
                style="padding: 5rem 0;"
                data-stack-section
            >
                <div class="container">
                    <div style="max-width: 900px; margin: 0 auto;">
                        <h2
                            class="text-navy"
                            style="font-size: 2.5rem; margin-bottom: 2rem; line-height: 1.2;"
                        >
                            El costo real de lanzar a ciegas en Bolivia:
                            ¿Opiniones amables o dinero real sobre la mesa?
                        </h2>
                        <p
                            class="text-gray-dark leading-relaxed"
                            style="font-size: 1.2rem; margin-bottom: 2rem;"
                        >
                            En el mercado boliviano, las encuestas superficiales
                            suelen arrojar intenciones de compra infladas por
                            cortesía cultural. Sin embargo, cuando llega el
                            momento de facturar, esa "intención declarada" rara
                            vez se traduce en transacciones reales. Comprometer
                            capital de trabajo, inventario o infraestructura sin
                            una validación de campo rigurosa es uno de los
                            errores más costosos para directorios y gerencias
                            generales.
                        </p>
                        <p
                            class="text-gray-dark leading-relaxed"
                            style="font-size: 1.1rem; margin-bottom: 1.5rem; font-weight: 600;"
                        >
                            Un estudio de mercado de alta fidelidad elimina el
                            sesgo del optimismo interno y responde con datos de
                            comportamiento real:
                        </p>
                    </div>

                    <AreaPanelCards
                        items={problemScenarios}
                        columns={4}
                        theme="navy"
                        class="problem-panels"
                    />

                    <div
                        style="max-width: 900px; margin: 2.5rem auto 0; background: var(--color-secondary); color: #fff; padding: 1.5rem 2rem; border-radius: var(--radius-md, 8px); font-weight: 600; font-size: 1.1rem; text-align: center;"
                    >
                        La viabilidad comercial de su proyecto no se estima
                        desde un escritorio. Se valida en el terreno donde
                        ocurre la transacción.
                    </div>
                </div>
            </section>
        </StackedSections>

        <!-- 🟦 3️⃣ MODELO DE EVALUACIÓN DE VIABILIDAD MINDTEC -->
        <ScrollStoryLeft
            scrub={0.9}
            sceneDistance={1.1}
            cardBackground="#f7f7f5"
            cardTextColor="#0B2B40"
            cardMutedColor="rgba(11, 43, 64, 0.62)"
            cover={{
                background:
                    "/imagenes-mindtec/generated/estudio-mercado-viabilidad/cover.webp",
                eyebrow: "Modelo de viabilidad",
                title: "Inteligencia comercial para decisiones de alto impacto.",
                description:
                    "Un modelo científico de cuatro dimensiones que convierte datos de campo en una recomendación de negocio defendible.",
            }}
            intro={{
                background:
                    "/imagenes-mindtec/generated/estudio-mercado-viabilidad/intro.webp",
                number: "00",
                eyebrow: "Cómo se construye",
                title: "Cuatro dimensiones cruzadas para una sola recomendación: invertir o no invertir.",
                description:
                    "Recorra el modelo científico que sostiene cada evaluación de viabilidad de Mindtec.",
            }}
            items={[
                {
                    background:
                        "/imagenes-mindtec/generated/estudio-mercado-viabilidad/item-01-arquitectura-financiera.webp",
                    eyebrow: "Dimensionamiento",
                    title: "Arquitectura Financiera (TAM / SAM / SOM)",
                    description:
                        "Dimensionamos el mercado real y la cuota que su empresa puede capturar, antes de comprometer capital.",
                    icon: '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5.5"/><circle cx="12" cy="12" r="2"/></svg>',
                    list: [
                        "Evita la sobreestimación del tamaño de mercado facturable.",
                        "Define la cuota neta real que su canal puede capturar de forma realista.",
                        "Establece metas de venta alineadas con la capacidad de compra local.",
                        "Reduce el riesgo de sobredimensionar la inversión inicial en infraestructura.",
                    ],
                },
                {
                    background:
                        "/imagenes-mindtec/generated/estudio-mercado-viabilidad/item-02-validacion-demanda.webp",
                    eyebrow: "Comportamiento",
                    title: "Validación de Demanda Involuntaria",
                    description:
                        "Medimos la disposición real a pagar, más allá de las respuestas de cortesía.",
                    icon: '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M5.5 12h2.7l1.4-4.2 2 8.4 1.4-4.2h5"/></svg>',
                    list: [
                        "Desactiva el sesgo de respuestas socialmente aceptables o amables.",
                        "Mide la disposición real a pagar del decisor corporativo o consumidor final.",
                        "Revela las fricciones silenciosas que bloquean el proceso de decisión de compra.",
                        "Separa el deseo de uso del comportamiento de pago efectivo y recurrente.",
                    ],
                },
                {
                    background:
                        "/imagenes-mindtec/generated/estudio-mercado-viabilidad/item-03-inteligencia-competitiva.webp",
                    eyebrow: "Competencia",
                    title: "Inteligencia de Ataque Competitivo",
                    description:
                        "Mapeamos a los competidores clave para identificar vacíos de entrada y riesgos de represalia.",
                    icon: '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><path d="M12 2v3.5M12 18.5V22M2 12h3.5M18.5 12H22"/><circle cx="12" cy="12" r="2"/></svg>',
                    list: [
                        "Identifica la cuota neta retenida por los competidores clave del sector.",
                        "Analiza la estructura de costos y debilidades operativas del líder de categoría.",
                        "Detecta vacíos de posicionamiento para un ingreso comercial de menor costo.",
                        "Evalúa el riesgo de represalias de precios por parte de las marcas incumbentes.",
                    ],
                },
                {
                    background:
                        "/imagenes-mindtec/generated/estudio-mercado-viabilidad/item-04-stop-go.webp",
                    eyebrow: "Decisión",
                    title: "Viabilidad Crítica Stop/Go",
                    description:
                        "Diagnóstico en terreno que culmina en una recomendación de inversión explícita y defendible.",
                    icon: '<svg viewBox="0 0 24 24"><rect x="8" y="2" width="8" height="20" rx="4"/><circle cx="12" cy="7.2" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="12" cy="16.8" r="1.5"/></svg>',
                    list: [
                        "Diagnóstico en terreno de canales y cadenas de distribución tradicionales.",
                        "Identificación de regulaciones, trabas burocráticas y factores informales del país.",
                        "Mapeo de la viabilidad logística real en el eje troncal y regiones intermedias.",
                        "Recomendación de inversión explícita y defendible basada en el retorno financiero.",
                    ],
                },
            ]}
        />

        <StackedSections>
            <!-- 🟦 4️⃣ TABLA COMPARATIVA -->
            <section
                class="premium-section-padding bg-white"
                data-stack-section
            >
                <div class="container">
                    <div
                        class="section-title-center"
                        style="max-width: 800px; margin: 0 auto 3rem auto;"
                    >
                        <h2 class="text-navy" style="font-size: 2.2rem;">
                            ¿Por qué Mindtec no es una agencia de encuestas
                            tradicional?
                        </h2>
                        <p
                            class="text-gray-dark"
                            style="font-size: 1.1rem; margin-top: 1rem;"
                        >
                            Diferenciamos la captura de datos básica de la
                            inteligencia comercial accionable para directorios.
                        </p>
                    </div>

                    <ComparisonRows
                        columnLabels={{
                            left: "Enfoque Tradicional",
                            right: "Método Mindtec",
                        }}
                        rows={comparisonRows}
                    />
                </div>
            </section>

            <!-- 🟦 5️⃣ ENTREGABLES PARA GERENCIA Y DIRECTORIO -->
            <section
                class="premium-section-padding bg-slate"
                data-stack-section
            >
                <div
                    class="container premium-grid-2-split"
                    style="align-items: center;"
                >
                    <div>
                        <h2
                            class="text-navy"
                            style="font-size: 2.5rem; margin-bottom: 1.5rem; line-height: 1.2;"
                        >
                            Activos de decisión listos para su Junta Directiva
                        </h2>
                        <p
                            class="text-gray-dark"
                            style="font-size: 1.1rem; margin-bottom: 2rem;"
                        >
                            No entregamos reportes para archivar; proveemos
                            herramientas de control y mitigación financiera
                            directa.
                        </p>
                        <ul
                            class="cap-list text-gray-dark"
                            style="margin-bottom: 3rem;"
                        >
                            <li>
                                <strong class="text-navy"
                                    >Matriz de Riesgo con Mitigantes
                                    Financieros:</strong
                                > Mapeo detallado de vulnerabilidades competitivas
                                y macro, con planes de acción específicos para blindar
                                su capital de trabajo.
                            </li>
                            <li>
                                <strong class="text-navy"
                                    >Recomendación Estratégica Stop / Go:</strong
                                > Un análisis binario y defendible respaldado por
                                datos que concluye si debe invertir, pivotar el modelo
                                o detener el proyecto comercial.
                            </li>
                            <li>
                                <strong class="text-navy"
                                    >Escenarios Comparativos de Sensibilidad:</strong
                                > Proyecciones numéricas de cómo responderá la demanda
                                boliviana ante fluctuaciones de precio en las principales
                                plazas.
                            </li>
                            <li>
                                <strong class="text-navy"
                                    >Dimensionamiento de Cuota Realista (SOM):</strong
                                > Un cálculo preciso de la cuota de mercado neta capturable,
                                descontando la inercia de los competidores establecidos.
                            </li>
                            <li>
                                <strong class="text-navy"
                                    >Executive Brief de Alta Dirección:</strong
                                > Un resumen de negocio libre de jerga técnica, estructurado
                                para justificar decisiones de inversión ante directores
                                y socios.
                            </li>
                        </ul>
                    </div>
                    <div>
                        <div
                            class="premium-card-white"
                            style="background: linear-gradient(145deg, #ffffff, #f8fafc); border: 1px solid #e2e8f0; display: flex; flex-direction: column; align-items: flex-start;"
                        >
                            <div
                                style="display: flex; align-items: center; margin-bottom: 1.5rem; gap: 1rem; border-bottom: 1.5px solid rgba(11, 43, 64, 0.06); width: 100%; padding-bottom: 1rem;"
                            >
                                <div
                                    class="cap-icon"
                                    style="margin: 0; width: 44px; height: 44px; min-width: 44px;"
                                >
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="20"
                                        height="20"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        ><path
