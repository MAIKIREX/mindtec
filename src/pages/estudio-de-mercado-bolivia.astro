                    place-items: center;
                    align-self: center;
                    margin: auto 0;
                    border: 1px solid rgba(11, 43, 64, 0.2);
                    border-radius: 50%;
                    color: var(--color-secondary, #0b2b40);
                    transition:
                        color 280ms ease,
                        border-color 280ms ease,
                        transform 280ms cubic-bezier(0.16, 1, 0.3, 1);
                }

                .area-panel--light:hover .area-panel__icon {
                    border-color: var(--color-primary, #f26522);
                    color: var(--color-primary, #f26522);
                    transform: scale(1.06);
                }

                .area-panel--light .area-panel__icon svg {
                    width: 42px;
                    height: 42px;
                }

                .area-panel--light .area-panel__title {
                    display: block;
                    max-width: 16ch;
                    font-family: var(--font-display);
                    font-size: clamp(1rem, 1.3vw, 1.2rem);
                    font-weight: 700;
                    line-height: 1.17;
                    letter-spacing: -0.02em;
                    color: var(--color-secondary, #0b2b40);
                }

                .area-panel--light .area-panel__title small {
                    display: block;
                    margin-top: 0.15rem;
                    color: rgba(11, 43, 64, 0.6);
                    font-size: 0.78em;
                    font-weight: 600;
                    letter-spacing: 0;
                }

                .area-panel--light .area-panel__arrow {
                    position: absolute;
                    right: 1.2rem;
                    bottom: 1.15rem;
                    color: var(--color-primary, #f26522);
                    font-size: 1.3rem;
                    line-height: 1;
                    opacity: 0;
                    transform: translateX(-8px);
                    transition:
                        opacity 220ms ease,
                        transform 280ms cubic-bezier(0.16, 1, 0.3, 1);
                }

                .area-panel--light:hover .area-panel__arrow,
                .area-panel--light:focus-visible .area-panel__arrow {
                    opacity: 1;
                    transform: translateX(0);
                }

                @media (max-width: 900px) {
                    .area-panel--light {
                        flex-basis: calc((100% - 0.55rem) / 2);
                        max-width: calc((100% - 0.55rem) / 2);
                    }

                    .area-panel--light,
                    .area-panel--light:nth-child(odd),
                    .area-panel--light:nth-child(even) {
                        min-height: 235px;
                        clip-path: none;
                    }
                }

                @media (max-width: 460px) {
                    .area-panel--light {
                        flex-basis: 100%;
                        max-width: 100%;
                        min-height: 205px;
                    }

                    .area-panel--light .area-panel__icon {
                        width: 64px;
                        height: 64px;
                    }

                    .area-panel--light .area-panel__icon svg {
                        width: 35px;
                        height: 35px;
                    }
                }
            </style>

            <!-- 🟦 9️⃣ FAQ -->
            <div data-stack-section>
                <FaqSplit title="Preguntas Frecuentes" items={faqItems} />
            </div>

            <!-- 🟦 CROSS-LINKING ESTRATÉGICO -->
            <section
                class="premium-section-padding bg-slate"
                style="background-color: #f8fafc; border-top: 1px solid #e2e8f0; border-bottom: 1px solid #e2e8f0;"
                data-stack-section
            >
                <div class="container" style="max-width: 1320px;">
                    <h3
                        class="text-navy"
                        style="font-size: 1.8rem; margin-bottom: 2rem; text-align: center;"
                    >
                        Otras áreas de inteligencia relacionadas
                    </h3>
                    <HoverStepCards
                        items={otrasAreasCards}
                        class="otras-areas-cards"
                        minColumnWidth="220px"
                    />
                </div>
            </section>

            <style is:global>
                .otras-areas-cards.hover-step-cards {
                    grid-template-columns: repeat(3, 1fr);
                    gap: 2rem;
                }

                .otras-areas-cards .hover-step-card {
                    aspect-ratio: auto;
                    min-height: 340px;
                }

                .otras-areas-cards .hover-step-card__inner {
                    padding: 2.75rem;
                }

                .otras-areas-cards .hover-step-card__title {
                    font-size: 1.6rem;
                    max-width: 100%;
                }

                .otras-areas-cards .hover-step-card__desc {
                    font-size: 1.05rem;
                }

                @media (max-width: 900px) {
                    .otras-areas-cards.hover-step-cards {
                        grid-template-columns: 1fr;
                    }
                }
            </style>

            <!-- 🟦 CTA FINAL -->
            <section
                class="cta-section-modern"
                style="padding: 6rem 0;"
                data-stack-section
            >
                <div
                    class="container"
                    style="max-width: 900px; margin: 0 auto; text-align: center;"
                >
                    <div class="cta-content-v2">
                        <h2
                            style="font-size: 3rem; line-height: 1.25; margin-bottom: 1.5rem;"
                        >
                            Antes de comprometer capital estructural, valide el
                            terreno.
                        </h2>
                        <p
                            class="cta-subtitle"
                            style="font-size: 1.25rem; margin-bottom: 2.5rem; opacity: 0.9;"
                        >
                            Si su decisión involucra inversión, expansión o
                            reposicionamiento, una evaluación de viabilidad
                            reducirá el margen de error.
                        </p>
                        <div
                            class="cta-actions"
                            style="justify-content: center; flex-direction: column; align-items: center;"
                        >
                            <a
                                href="/contacto"
                                class="btn btn-primary lg"
                                style="font-size: 1.1rem; padding: 1rem 2.5rem;"
                                >Agendar sesión de diagnóstico (45 min)</a
                            >
                            <p
                                style="margin-top: 1.5rem; font-size: 0.95rem; color: rgba(255,255,255,0.7); font-weight: 500;"
                            >
                                Primera sesión: 45 minutos | Confidencial | Sin
                                compromiso
                            </p>
                        </div>
                    </div>
                </div>
            </section>
        </StackedSections>

        <!-- BREADCRUMB -->
        <nav aria-label="Breadcrumb" class="breadcrumb-bottom">
            <div class="container">
                <ol>
                    <li>
                        <a
                            href="/"
                            style="color: rgba(255,255,255,0.6); text-decoration: none;"
                            >Inicio</a
                        >
                    </li>
                    <li style="color: rgba(255,255,255,0.3);">›</li>
                    <li>
                        <a
                            href="/servicios"
                            style="color: rgba(255,255,255,0.6); text-decoration: none;"
                            >Servicios</a
                        >
                    </li>
                    <li style="color: rgba(255,255,255,0.3);">›</li>
                    <li
                        aria-current="page"
                        style="color: #fff; font-weight: 600;"
                    >
                        Estudio de mercado en Bolivia
                    </li>
                </ol>
            </div>
        </nav>
    </main>
</Layout>
