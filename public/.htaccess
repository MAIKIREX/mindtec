# Redirects from legacy/html URLs to clean Astro URLs
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirect specific legacy/HTML files to clean URLs
    RewriteRule ^articulo-3-ejemplos-de-neuromarketing-en-la-vida-diaria-que-quiza-no-sabias\.html$ /blog/3-ejemplos-de-neuromarketing-en-la-vida-diaria-que-quiza-no-sabias/ [R=301,L]
    RewriteRule ^articulo-5-tips-diferenciar-tu-marca\.html$ /blog/5-tips-diferenciar-tu-marca/ [R=301,L]
    RewriteRule ^articulo-codigo-cultural\.html$ /blog/codigo-cultural/ [R=301,L]
    RewriteRule ^articulo-como-emocionar-a-mis-clientes\.html$ /blog/como-emocionar-a-mis-clientes/ [R=301,L]
    RewriteRule ^articulo-conoce-las-5c-del-neuromarketing-y-potenciate\.html$ /blog/conoce-las-5c-del-neuromarketing-y-potenciate/ [R=301,L]
    RewriteRule ^articulo-diferencias-hombres-y-mujeres-al-comprar-i\.html$ /blog/diferencias-hombres-y-mujeres-al-comprar-i/ [R=301,L]
    RewriteRule ^articulo-eres-capaz-de-descubrir-mentiras-de-tu-cliente-aprende-como-hacerlo-parte-i\.html$ /blog/eres-capaz-de-descubrir-mentiras-de-tu-cliente-aprende-como-hacerlo-parte-i/ [R=301,L]
    RewriteRule ^articulo-fidelizar_cliente\.html$ /blog/fidelizar_cliente/ [R=301,L]
    RewriteRule ^articulo-herramientas-recoleccion-datos-cualitativos\.html$ /blog/herramientas-recoleccion-datos-cualitativos/ [R=301,L]
    RewriteRule ^articulo-investigacion-de-mercado-en-bolivia-consumer-behavior\.html$ /blog/investigacion-de-mercado-en-bolivia-consumer-behavior/ [R=301,L]
    RewriteRule ^articulo-investigacion-de-mercado-en-pymes-paso-a-paso\.html$ /blog/investigacion-de-mercado-en-pymes-paso-a-paso/ [R=301,L]
    RewriteRule ^articulo-investigacion-de-mercados-con-neuromarketing\.html$ /blog/investigacion-de-mercados-con-neuromarketing/ [R=301,L]
    RewriteRule ^articulo-investigacion-de-mercados-consumidor\.html$ /blog/investigacion-de-mercados-consumidor/ [R=301,L]
    RewriteRule ^articulo-investigacion-de-mercados-cuantitativa-vs-cualitativa\.html$ /blog/investigacion-de-mercados-cuantitativa-vs-cualitativa/ [R=301,L]
    RewriteRule ^articulo-mente_del_consumidor\.html$ /blog/mente_del_consumidor/ [R=301,L]
    RewriteRule ^articulo-por-que-utilizar-neuromarketing-en-mi-publicidad\.html$ /blog/por-que-utilizar-neuromarketing-en-mi-publicidad/ [R=301,L]
    RewriteRule ^articulo-publicidad-efectiva-en-tu-campana-como-saber-si-lo-sera\.html$ /blog/publicidad-efectiva-en-tu-campana-como-saber-si-lo-sera/ [R=301,L]
    RewriteRule ^articulo-que-es-el-neuromarketing\.html$ /blog/que-es-el-neuromarketing/ [R=301,L]
    RewriteRule ^articulo-sabes-la-diferencia-entre-marketing-de-emociones-y-neuromarketing\.html$ /blog/sabes-la-diferencia-entre-marketing-de-emociones-y-neuromarketing/ [R=301,L]
    RewriteRule ^auditoria-retail-bolivia\.html$ /auditoria-retail-bolivia/ [R=301,L]
    RewriteRule ^benchmarking-competitivo-bolivia\.html$ /benchmarking-competitivo-bolivia/ [R=301,L]
    RewriteRule ^blog\.html$ /blog/ [R=301,L]
    RewriteRule ^cliente-misterioso-bolivia\.html$ /cliente-misterioso-bolivia/ [R=301,L]
    RewriteRule ^comportamiento-consumidor-boliviano\.html$ /comportamiento-consumidor-boliviano/ [R=301,L]
    RewriteRule ^contacto\.html$ /contacto/ [R=301,L]
    RewriteRule ^estudio-de-mercado-bolivia\.html$ /estudio-de-mercado-bolivia/ [R=301,L]
    RewriteRule ^estudio-de-precios-bolivia\.html$ /estudio-de-precios-bolivia/ [R=301,L]
    RewriteRule ^firma\.html$ /firma/ [R=301,L]
    RewriteRule ^focus-group-bolivia\.html$ /focus-group-bolivia/ [R=301,L]
    RewriteRule ^index\.html$ / [R=301,L]
    RewriteRule ^inteligencia-de-mercados-b2b-bolivia\.html$ /inteligencia-de-mercados-b2b-bolivia/ [R=301,L]
    RewriteRule ^investigacion-cualitativa-bolivia\.html$ /investigacion-cualitativa-bolivia/ [R=301,L]
    RewriteRule ^investigacion-cuantitativa-bolivia\.html$ /investigacion-cuantitativa-bolivia/ [R=301,L]
    RewriteRule ^metodologia\.html$ /metodologia/ [R=301,L]
    RewriteRule ^neuromarketing-bolivia\.html$ /neuromarketing-bolivia/ [R=301,L]
    RewriteRule ^neuromarketing-para-empresas-bolivia\.html$ /neuromarketing-para-empresas-bolivia/ [R=301,L]
    RewriteRule ^percepcion-de-marca-bolivia\.html$ /percepcion-de-marca-bolivia/ [R=301,L]
    RewriteRule ^servicios\.html$ /servicios/ [R=301,L]
    RewriteRule ^shopper-insights-bolivia\.html$ /shopper-insights-bolivia/ [R=301,L]
    RewriteRule ^witmind-consulting\.html$ /witmind-consulting/ [R=301,L]

    # Generic rule to strip .html extension and redirect to trailing slash
    RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
    RewriteRule ^ /%1/ [R=301,L]
</IfModule>

# Serve custom 404 page for missing files
ErrorDocument 404 /404.html
